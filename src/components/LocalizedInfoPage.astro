---
import { availableCourseCount } from '../config/course-catalog';
import { payments } from '../config/payments';
import PaymentJourney from './PaymentJourney.astro';

type Lang = 'ru' | 'en';
type Page = 'about' | 'faq' | 'contact' | 'sponsorship' | 'pricing';
const { lang, page } = Astro.props as { lang: Lang; page: Page };
const base = import.meta.env.BASE_URL;
const prefix = `${base}${lang}/`;
const href = (slug: string) => `${prefix}${slug}/`;

const copy = {
  ru: {
    about: { eyebrow: 'О TAYANCH', h1: 'О нас', lead: 'Tayanch — практическая онлайн-платформа курсов на узбекском, которую создаёт Джавохир Кахрамонов.', focus: 'Наше направление', focusText: 'Объяснять AI, IELTS, admission, дизайн и повседневные цифровые навыки просто и на практике.', mission: 'Цель', missionText: 'Сделать практическое обучение доступнее: ясный следующий шаг, честное объяснение и пространство для практики в своём темпе.', note: 'С личным опытом основателя и историей создания Tayanch можно познакомиться на странице', journey: 'Мой путь', button: 'Связаться →' },
    faq: { h1: 'Часто задаваемые вопросы', lead: 'Краткие ответы на самые частые вопросы о наших курсах, оплате и сертификатах. Не нашли ответ?', contact: 'Свяжитесь с нами', leadEnd: '.', questions: [['В каком формате проходят курсы?', 'Каждый курс разбит на модули: короткие видеоуроки, практические задания и небольшой тест (Quiz) для проверки. Учитесь в своём темпе, а купив один раз — получаете forever access и можете пересматривать в любое время.'], ['Как мне произвести оплату?', 'По деталям оплаты пишите в Telegram:'], ['Выдаётся ли сертификат после завершения курса?', 'Да. Сертификат есть во всех наших платных и бесплатных курсах. Получив право на сертификат после освоения материала.'], ['«Forever access» — что это значит?', 'Покупаете один раз — и получаете постоянный, бессрочный доступ к курсу. Обновления тоже входят в эту цену, дополнительная плата не взимается.'], ['Бесплатные курсы действительно бесплатны?', 'Да, несколько наших курсов полностью бесплатны: «Бесплатные AI-модели и агенты», «Figma / Дизайн» и «Зачем учиться за рубежом». Регистрация и данные карты не нужны — заходите на страницу и начинайте.']], button: 'Смотреть все курсы →' },
    contact: { eyebrow: 'Контакт', h1: 'Связаться', lead: 'Есть вопросы? Напишите нам по курсам, способам оплаты или сотрудничеству — ответим в ближайшее время.', selectedEyebrow: 'ВЫБРАННЫЙ SUB-КУРС ADMISSION', selectedTitle: 'Ваш курс готов', selectedPrice: 'Выбранная цена', selectedLink: 'Посмотреть информацию о курсе →', currency: 'сум', channels: 'Каналы', payment: 'Оплата', paymentText: 'По деталям оплаты пишите в Telegram', back: '← Вернуться ко всем курсам', admission: { essays: ['Эссе', 'Сейчас доступны уроки по Personal Statement, Why Major?, supplemental essay и редактированию.'], documents: ['Подготовка документов', 'Сейчас доступны уроки по master profile, transcript, activities/CV и рекомендательным письмам.'], apply: ['Подача документов и письмо о зачислении', 'Уроки по платформам, списку университетов, финальной проверке и offer letter готовы.'] }, open: 'Открыть уроки: ', openMany: 'Открыть уроки выбранных sub-курсов →', inCourse: '— перейти к курсу', multiple: 'выбранных sub-курса — перейти к курсу' },
    sponsorship: { badge: 'Поддержка', title: 'Поддержать', lead: 'Ваша помощь нужна, чтобы курсы Tayanch оставались бесплатными и качественными. Даже небольшая поддержка помогает оплачивать сервер, домен и новые курсы.', sub: 'Это добровольно. Вы можете поддержать проект, не записываясь ни на один курс.', why: 'Зачем поддерживать?', points: ['Все основные курсы (IELTS, AI, Admission) останутся бесплатными.', 'Сайт остаётся без рекламы и не собирает ваши персональные данные.', 'Каждый сум направляется на новые уроки, новые инструменты и проекты с открытым исходным кодом.'], methods: 'Способы оплаты', card: 'Карта (UZCARD / HUMO)', copy: 'Копировать', copied: 'Скопировано ✓', failed: 'Не удалось скопировать', soon: 'Скоро', note: 'Поддержка добровольна и не создаёт дополнительных обязательств. Спасибо!', courses: 'Смотреть курсы' },
    pricing: { h1: 'Цены', lead: 'Купите один курс или все сразу. Во всех пакетах forever access — купили один раз, пользуетесь всегда.', single: 'Один курс', singleDesc: 'Полный доступ к выбранному курсу.', oneCourse: '1 курс (Prompt, Obsidian, IELTS и др.)', forever: 'Forever access', cert: 'Сертификат', telegram: 'Вопросы через Telegram', choose: 'Выбрать курс →', packages: 'Пакеты', best: 'Лучшая ценность', aiDesc: 'Prompt Engineering + AI Agentы + Obsidian PKM — всё по AI в одном пакете.', save: 'Экономия против покупки по отдельности: $17 (20%)', foreverCert: 'Forever access + сертификат', buy: 'Купить →', full: 'Full access', fullDesc: 'Общий доступ к доступным сейчас курсам. Условия пакета для будущих курсов будут объявлены позже.', available: 'доступных сейчас курсов', allCert: 'Сертификат по всем', future: 'Условия по новым курсам будут объявлены позже', help: 'Не знаете, какой курс вам нужен?', quiz: 'Тест по выбору курса →', currency: 'сум', aiCourse: 'AI-агенты ($39)' }
  },
  en: {
    about: { eyebrow: 'ABOUT TAYANCH', h1: 'About us', lead: 'Tayanch is a practical online courses platform in Uzbek, being built by Javohir Qaxramonov.', focus: 'Our focus', focusText: 'Explain AI, IELTS, admission, design and everyday digital skills simply and practically.', mission: 'Mission', missionText: 'We want practical learning to feel reachable: a clear next step, an honest explanation, and room to practice at your own pace.', note: "Read about the founder's personal experience and the story behind Tayanch on the", journey: 'My journey', button: 'Contact →' },
    faq: { h1: 'Frequently asked questions', lead: "Brief answers to the most common questions about our courses, payments and certificates. Can't find your answer?", contact: 'Contact us', leadEnd: '.', questions: [['What format are the courses in?', 'Each course is split into modules: short video lessons, practical exercises and a small quiz to check yourself. Learn at your own pace; buying once gives you forever access to revisit anytime.'], ['How do I make a payment?', 'For payment details, write via Telegram:'], ['Do you get a certificate after finishing a course?', 'Yes. A certificate is available in all our paid and free courses. You earn the right to a certificate after mastering the material.'], ['What does “forever access” mean?', 'You buy once and get permanent, unlimited access to the course. Updates are included at the same price, with no extra fee.'], ['Are the free courses really free?', 'Yes, several of our courses are completely free: “Free AI models and agents”, “Figma / Design” and “Why study abroad”. No sign-up or card details are needed — open the page and start learning.']], button: 'View all courses →' },
    contact: { eyebrow: 'CONTACT', h1: 'Contact', lead: "Have questions? Write to us about courses, payment methods or partnership — we'll reply soon.", selectedEyebrow: 'SELECTED ADMISSION SUB-COURSE', selectedTitle: 'Your course is ready', selectedPrice: 'Selected price', selectedLink: 'View course information →', currency: 'UZS', channels: 'Channels', payment: 'Payment', paymentText: 'For payment details, write via Telegram', back: '← Back to all courses', admission: { essays: ['Essays', 'Personal Statement, Why Major?, supplemental essay and editing lessons are available now.'], documents: ['Document preparation', 'Master profile, transcript, activities/CV and recommendation-letter lessons are available now.'], apply: ['Submitting documents and admission letter', 'Lessons on platforms, university lists, final review and offer letters are ready.'] }, open: 'Open lessons: ', openMany: 'Open selected sub-course lessons →', inCourse: '— enter the course', multiple: 'selected sub-courses — enter the course' },
    sponsorship: { badge: 'SUPPORT', title: 'Support us', lead: 'Your help keeps Tayanch courses free and high quality. Even a small contribution helps with the site’s server, domain and new courses.', sub: 'This is voluntary. You can support the project without enrolling in any course.', why: 'Why support us?', points: ['All core courses (IELTS, AI, Admission) remain free.', 'The site stays ad-free and does not collect your personal data.', 'Every som goes toward new lessons, new tools and open-source projects.'], methods: 'Payment methods', card: 'Card (UZCARD / HUMO)', copy: 'Copy', copied: 'Copied ✓', failed: 'Could not copy', soon: 'Coming soon', note: 'Support is voluntary and creates no additional obligation. Thank you!', courses: 'View courses' },
    pricing: { h1: 'Pricing', lead: 'Buy a single course or get them all at once. Every package includes forever access — buy once, use forever.', single: 'Single course', singleDesc: 'Full access to your chosen course.', oneCourse: '1 course (Prompt, Obsidian, IELTS, etc.)', forever: 'Forever access', cert: 'Certificate', telegram: 'Questions via Telegram', choose: 'Choose course →', packages: 'Packages', best: 'Best value', aiDesc: 'Prompt Engineering + AI Agents + Obsidian PKM — everything AI in one package.', save: 'Save vs. buying separately: $17 (20%)', foreverCert: 'Forever access + certificate', buy: 'Buy →', full: 'Full access', fullDesc: 'General access to courses currently available. Package terms for future courses will be announced later.', available: 'courses currently available', allCert: 'Certificate for all', future: 'Terms for new courses will be announced soon', help: "Not sure which course you need?", quiz: 'Course selection quiz →', currency: 'UZS', aiCourse: 'AI Agents ($39)' }
  }
} as const;
const t = copy[lang][page] as any;
const card = payments.find((payment) => payment.id === 'card');
---
{page === 'about' && <section class="trust-page"><p class="eyebrow">{t.eyebrow}</p><h1>{t.h1}</h1><p class="lead">{t.lead}</p><div class="trust-grid"><article><h2>{t.focus}</h2><p>{t.focusText}</p></article><article><h2>{t.mission}</h2><p>{t.missionText}</p></article></div><p class="mission-note">{lang === 'en' ? 'Small, steady practice can become a real foundation.' : lang === 'ru' ? 'Небольшая регулярная практика может стать настоящей опорой.' : 'Kichik, izchil mashq haqiqiy tayanchga aylanishi mumkin.'}</p><p class="note">{t.note} <a href={href('mening-yolim')}>{t.journey}</a>.</p><a class="start-btn" href={href('bog-lanish')}>{t.button}</a></section>}

{page === 'faq' && <article class="lesson"><h1>{t.h1}</h1><p class="lead">{t.lead} <a href={href('bog-lanish')} class="accent-link">{t.contact}</a>{t.leadEnd}</p><section class="faq">{t.questions.map(([question, answer]: [string, string], index: number) => <details open={index === 0}><summary>{question}</summary><p>{answer}{index === 1 && <> <a href="https://t.me/progression_go" class="accent-link" target="_blank" rel="noopener noreferrer">@progression_go</a></>}</p></details>)}</section><a href={href('kurslar')} class="start-btn faq-button">{t.button}</a></article>}

{page === 'contact' && <><section class="hero"><span class="eyebrow">{t.eyebrow}</span><h1>{t.h1}</h1><p class="lead">{t.lead}</p></section><section id="selectedAdmission" class="selected-admission" hidden aria-live="polite"><p class="eyebrow">{t.selectedEyebrow}</p><h2 id="selectedAdmissionTitle">{t.selectedTitle}</h2><p id="selectedAdmissionText"></p><div class="selected-admission-bottom"><div><span>{t.selectedPrice}</span><strong id="selectedAdmissionPrice"></strong></div><a id="openAdmissionCourse" class="start-btn" href={href('kurslar/admission-process')}>{t.selectedLink}</a></div></section><PaymentJourney lang={lang} /><section class="why-us contact-channels"><div class="sec-head"><h2 class="sec-title">{t.channels}</h2></div><ul class="channels-list"><li class="course channel"><div><strong>Telegram</strong><br /><a href="https://t.me/progression_go" class="enroll">@progression_go</a></div></li><li class="course channel"><div><strong>Email</strong><br /><a href="mailto:javohirqaxramonov36@gmail.com" class="enroll">javohirqaxramonov36@gmail.com</a></div></li><li class="course channel"><div><strong>{t.payment}</strong><br /><a href="https://t.me/progression_go" class="enroll">{t.paymentText}</a></div></li></ul><p class="back-link"><a href={href('kurslar')} class="start-btn">{t.back}</a></p></section><script define:vars={{ lang, prefix, contact: t }}>{`const params = new URLSearchParams(window.location.search); const selected = (params.get('admission') || '').split(',').filter(Boolean); const total = Number(params.get('total')) || 0; const found = selected.map((item) => contact.admission[item]).filter(Boolean); if (found.length) { const block = document.querySelector('#selectedAdmission'); const title = document.querySelector('#selectedAdmissionTitle'); const text = document.querySelector('#selectedAdmissionText'); const price = document.querySelector('#selectedAdmissionPrice'); const link = document.querySelector('#openAdmissionCourse'); block.hidden = false; title.textContent = found.length === 1 ? found[0][0] + ' ' + contact.inCourse : found.length + ' ' + contact.multiple; text.textContent = found.map((item) => item[1]).join(' '); price.textContent = new Intl.NumberFormat(lang === 'ru' ? 'ru-RU' : 'en-US').format(total) + ' ' + contact.currency; link.href = prefix + 'kurslar/admission-process/#' + selected[0]; link.textContent = found.length === 1 ? contact.open + found[0][0] + ' →' : contact.openMany; }`}</script></>}

{page === 'sponsorship' && <section class="donate"><div class="donate-head"><span class="badge badge-free">{t.badge}</span><h1>{t.title}</h1><p class="lead">{t.lead}</p><p class="donate-sub">{t.sub}</p></div><div class="donate-why"><h2>{t.why}</h2><ul class="modules">{t.points.map((point: string) => <li>{point}</li>)}</ul></div><div class="donate-methods"><h2>{t.methods}</h2><div class="pay-grid">{payments.map((method) => <div class="pay-card"><h3>{method.id === 'card' ? t.card : method.label}</h3>{method.enabled && method.value ? <><div class="pay-card-number"><p class="pay-value">{method.value}</p>{method.copy && <button class="pay-copy" type="button" data-copy={method.copy}>{t.copy}</button>}</div>{method.owner && <p class="pay-owner"><b>{method.owner}</b></p>}</> : <span class="pay-soon">{t.soon}</span>}</div>)}</div><p class="donate-note">{t.note}</p></div><div class="donate-cta"><a href={href('kurslar')} class="start-btn">{t.courses}</a></div><script define:vars={{ copied: t.copied, failed: t.failed }}>{`document.querySelectorAll('.pay-copy').forEach((button) => { button.addEventListener('click', () => { const text = button.getAttribute('data-copy') || ''; if (!text) return; navigator.clipboard.writeText(text).then(() => { const old = button.textContent; button.textContent = copied; setTimeout(() => button.textContent = old, 1500); }).catch(() => button.textContent = failed); }); });`}</script></section>}

{page === 'pricing' && <article class="lesson"><h1>{t.h1}</h1><p class="lead">{t.lead}</p><div class="pricing single"><div class="plan"><span class="plan-name">{t.single}</span><p class="plan-desc">{t.singleDesc}</p><div class="plan-price">$19<span class="uzs">≈ 240 000 {t.currency}</span></div><ul><li>{t.oneCourse}</li><li>{t.forever}</li><li>{t.cert}</li><li>{t.telegram}</li></ul><a href={href('kurslar')} class="start-btn">{t.choose}</a></div></div><h2 class="paket-head">{t.packages}</h2><div class="pricing"><div class="plan featured"><span class="badge badge-new">{t.best}</span><span class="plan-name">AI Stack</span><p class="plan-desc">{t.aiDesc}</p><div class="plan-price"><span class="current-price">$70</span><s class="old-price" aria-label="Previous price">$87</s><span class="uzs">≈ 875 000 {t.currency}</span></div><p class="save-note">{t.save}</p><ul><li>Prompt Engineering ($29)</li><li>{t.aiCourse}</li><li>Obsidian PKM ($19)</li><li>{t.foreverCert}</li></ul><a href={href('bog-lanish')} class="start-btn">{t.buy}</a></div><div class="plan"><span class="plan-name">{t.full}</span><p class="plan-desc">{t.fullDesc}</p><div class="plan-price">$99<span class="uzs">≈ 1 240 000 {t.currency}</span></div><ul><li>{availableCourseCount} {t.available}</li><li>{t.forever}</li><li>{t.allCert}</li><li>{t.future}</li></ul><a href={href('bog-lanish')} class="start-btn">{t.buy}</a></div></div><p class="quiz-hint">{t.help} <a href={href('kurs-tanlash')} class="accent-link">{t.quiz}</a></p></article>}

<style>
  .trust-page,.selected-admission,.contact-channels{max-width:820px;margin:0 auto}.eyebrow{color:var(--accent);font-weight:800;letter-spacing:.12em;font-size:.76rem}.trust-page h1,.donate-head h1{font-size:clamp(2rem,5vw,3rem);margin:.25rem 0}.lead{font-size:1.15rem;color:var(--muted);line-height:1.65}.trust-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin:2rem 0}.trust-grid article,.pay-card{padding:1.25rem;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.mission-note{font-weight:700;color:var(--accent);margin:0 0 1.25rem}.trust-grid h2{font-size:1.1rem}.trust-grid p,.note{color:var(--muted);line-height:1.6}.note{margin-bottom:1.5rem}.accent-link{color:var(--accent)}.faq details{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:0 1.1rem;margin-bottom:.8rem}.faq details[open]{border-color:var(--accent)}.faq summary{cursor:pointer;padding:1rem 0;font-weight:700;list-style:none}.faq summary::before{content:'+';margin-right:10px;color:var(--accent);font-weight:800;font-size:1.2rem}.faq details[open] summary::before{content:'–'}.faq details p{color:var(--muted);padding:0 0 1rem;margin:0;line-height:1.7}.faq-button,.back-link{display:inline-block;margin-top:2rem}.selected-admission{margin-bottom:28px;padding:25px;border:1px solid color-mix(in srgb,var(--accent) 55%,var(--border));border-radius:18px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 15%,var(--surface)),var(--surface))}.selected-admission h2{margin:.15rem 0 .65rem}.selected-admission p:not(.eyebrow){margin:0;color:var(--muted);line-height:1.6}.selected-admission-bottom{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-top:20px}.selected-admission-bottom span,.selected-admission-bottom strong{display:block}.selected-admission-bottom span{color:var(--muted);font-size:.85rem}.selected-admission-bottom strong{font-size:1.2rem;color:var(--accent);margin-top:3px}.channels-list{list-style:none;padding:0;display:grid;gap:12px}.channel{display:flex;align-items:center;gap:14px}.donate{max-width:920px;margin:0 auto;padding:2.6rem 20px 3rem}.donate-head{text-align:center;margin-bottom:2.4rem}.donate-head .lead{max-width:680px;margin:0 auto}.donate-sub{color:var(--accent);font-weight:600;margin-top:.8rem}.donate-why{margin-bottom:2.6rem}.donate-why h2,.donate-methods h2{color:var(--accent);font-size:1.4rem;margin:0 0 1rem}.pay-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.1rem}.pay-card{text-align:center;box-shadow:var(--shadow)}.pay-card h3{margin:0 0 .7rem}.pay-card-number{display:flex;align-items:center;gap:10px}.pay-value{flex:1;color:var(--text);font-weight:700;letter-spacing:.02em;word-break:break-all;background:var(--accent-soft);border:1px dashed var(--accent);border-radius:10px;padding:10px 12px}.pay-copy{cursor:pointer;border:1px solid var(--accent);color:var(--accent);background:transparent;font-weight:700;font-size:.82rem;border-radius:8px;padding:8px 12px}.pay-owner{color:var(--muted);font-size:.9rem}.pay-soon{display:inline-block;font-weight:700;font-size:12px;color:var(--accent);background:var(--accent-soft);padding:6px 14px;border-radius:999px}.donate-note{text-align:center;color:var(--muted);font-size:.9rem;margin-top:1.6rem;padding:14px;border:1px dashed var(--border);border-radius:14px}.donate-cta{text-align:center;margin-top:2.4rem}.pricing.single{grid-template-columns:minmax(260px,380px)}.paket-head{margin:2.5rem 0 .5rem;font:800 22px var(--font-display);color:var(--text)}.plan-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:.35rem .65rem}.plan-price .current-price{font:inherit}.plan-price .old-price{color:var(--muted);font-size:.95rem;font-weight:600;text-decoration-thickness:2px}.plan-price .uzs{flex-basis:100%;margin-left:0}.save-note{margin:.2rem 0 .9rem;color:var(--accent);font-weight:600;font-size:.9rem}.quiz-hint{margin-top:1.5rem}@media(max-width:620px){.trust-grid{grid-template-columns:1fr}}@media(max-width:600px){.selected-admission-bottom{align-items:stretch;flex-direction:column}.selected-admission-bottom .start-btn{text-align:center}}
</style>

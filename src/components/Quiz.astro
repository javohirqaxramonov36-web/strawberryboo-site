---
const { title = "O'z bilimingizni tekshiring", questions = [], titleI18n = "", quizI18n = "", quizId = "" } = Astro.props;
---

<section class="quiz">
  <div class="sec-head" style="margin-top:0">
    <h2 class="sec-title">
      <span class="sec-ic" style="background:linear-gradient(135deg,#0ea5e9,#22c55e)"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
      {titleI18n ? <span data-i18n={titleI18n}>{title}</span> : title}
    </h2>
  </div>

  <form class="quiz-form" data-quiz data-quiz-id={quizId}>
    {questions.map((item, i) => (
      <div class="q" data-q>
        {quizI18n
          ? <p class="q-t"><span class="q-num">{i + 1}.</span> <span data-i18n={`${quizI18n}.q${i + 1}`}>{item.q}</span></p>
          : <p class="q-t">{i + 1}. {item.q}</p>}
        {item.opts.map((o, j) => (
          <label class="q-o" data-correct={j === item.answer}>
            <input type="radio" name={`q${i}`} value={j} />
            {quizI18n
              ? <span data-i18n={`${quizI18n}.q${i + 1}o${j}`}>{o}</span>
              : o}
          </label>
        ))}
        {item.explain
          ? <p class="q-explain" data-explain hidden><span class="q-explain-ic">💡</span> {item.explain}</p>
          : null}
      </div>
    ))}
    <button type="button" class="start-btn" data-check data-i18n="quiz.check">Tekshirish</button>
    <p class="quiz-res" data-res hidden></p>
    <p class="quiz-hint" data-hint hidden data-i18n="quiz.hint">Har bir savolga javob bering.</p>
  </form>
</section>

<script>
  // Natija faqat shu brauzer/qurilmada saqlanadi (backend yo'q).
  const QUIZ_RESULTS_KEY = 'tayanch.quiz.results.v1';
  const safeJson = (key, fallback) => { try { const d = JSON.parse(localStorage.getItem(key) || ''); return d == null ? fallback : d; } catch { return fallback; } };

  document.querySelectorAll('[data-quiz]').forEach(form => {
    const check = form.querySelector('[data-check]');
    if (!check) return;
    const quizId = form.dataset.quizId;
    check.addEventListener('click', () => {
      const qs = form.querySelectorAll('[data-q]');
      let correct = 0, answered = 0;
      qs.forEach(q => {
        const chosen = q.querySelector('input:checked');
        const opts = q.querySelectorAll('.q-o');
        const explainEl = q.querySelector('[data-explain]');
        opts.forEach(o => o.classList.remove('ok', 'no'));
        if (explainEl) explainEl.hidden = true;
        if (chosen) {
          answered++;
          const label = chosen.closest('.q-o');
          if (label.dataset.correct === 'true') { correct++; label.classList.add('ok'); }
          else { label.classList.add('no'); const right = q.querySelector('.q-o[data-correct="true"]'); if (right) right.classList.add('ok'); }
          if (explainEl) explainEl.hidden = false;
        }
      });
      const res = form.querySelector('[data-res]');
      const hint = form.querySelector('[data-hint]');
      if (answered < qs.length) { hint.hidden = false; res.hidden = true; return; }
      hint.hidden = true; res.hidden = false;
      const pct = Math.round((correct / qs.length) * 100);
      res.textContent = `Natija: ${correct}/${qs.length} to'g'ri (${pct}%). ${correct === qs.length ? 'Ajoyib! Kursga tayyorsiz.' : 'Yaxshi, lekin kurs sizga foyda beradi.'}`;
      if (quizId) {
        const all = safeJson(QUIZ_RESULTS_KEY, {});
        all[quizId] = { score: correct, total: qs.length, date: new Date().toISOString() };
        try { localStorage.setItem(QUIZ_RESULTS_KEY, JSON.stringify(all)); } catch {}
        window.dispatchEvent(new StorageEvent('storage', { key: QUIZ_RESULTS_KEY }));
      }
    });
  });
</script>

<style>
  .quiz-form { display: grid; gap: 1rem; }
  .q { border: 1px solid var(--border); border-radius: 14px; padding: 1rem 1.1rem; background: var(--surface); }
  .q-t { margin: 0 0 .7rem; font-weight: 700; line-height: 1.5; }
  .q-num { color: var(--accent); margin-right: .35rem; }
  .q-o { display: flex; align-items: center; gap: .6rem; padding: .55rem .7rem; margin: .4rem 0; border: 1px solid var(--border); border-radius: 10px; cursor: pointer; transition: border-color .18s, background .18s, transform .12s; }
  .q-o:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .q-o:active { transform: scale(.99); }
  .q-o input { accent-color: var(--accent); }
  .q-o.ok { border-color: var(--good); background: color-mix(in srgb, var(--good) 14%, transparent); }
  .q-o.no { border-color: #ef4444; background: color-mix(in srgb, #ef4444 12%, transparent); }
  .q-explain { display: flex; gap: .5rem; margin: .7rem 0 0; padding: .65rem .8rem; border-radius: 10px; border: 1px solid color-mix(in srgb, var(--accent) 38%, var(--border)); background: color-mix(in srgb, var(--accent) 9%, var(--surface)); color: var(--muted); font-size: .9rem; line-height: 1.5; }
  .q-explain-ic { flex: 0 0 auto; }
  .quiz-res { font-weight: 800; font-size: 1.05rem; margin: .4rem 0 0; color: var(--text); }
  .quiz-hint { margin: .3rem 0 0; color: var(--muted); font-size: .9rem; }
  @media (prefers-reduced-motion: reduce) { .q-o { transition: none; } .q-o:active { transform: none; } }
</style>

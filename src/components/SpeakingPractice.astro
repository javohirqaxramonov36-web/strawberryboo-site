---
import days from '../data/ielts-speaking-week-1.json';
---
<section class="speaking-app" aria-label="IELTS Speaking 1-haftalik mashq">
  <header class="speaking-hero">
    <p class="eyebrow">AI BILAN 30 KUNLIK KURS · 1-HAFTA</p>
    <h1>IELTS Speaking: aniqroq gapiring, o‘sishni kuzating</h1>
    <p>Har kuni talaffuz, shadowing va IELTS formatidagi Speaking Set. Ushbu MVP’da 1-hafta tayyor; keyingi haftalar sifat nazoratidan so‘ng qo‘shiladi.</p>
    <div class="notice"><b>AI practice estimate:</b> natija rasmiy IELTS bahosi emas. Talaffuzning akustik tahlili keyingi bosqichda qo‘shiladi; hozir AI transkript asosida tavsiya beradi.</div>
  </header>

  <section class="auth-card" id="speakingAuth" aria-live="polite">
    <div><b>Progressni saqlash uchun kiring</b><p>Email magic link orqali kirsangiz audio, feedback va kunlik progress Supabase profilingizga saqlanadi.</p></div>
    <form id="speakingLogin"><label class="sr-only" for="speakingEmail">Email</label><input id="speakingEmail" type="email" autocomplete="email" placeholder="email@example.com" required /><button class="sp-btn secondary" type="submit">Kirish havolasini yuborish</button></form>
    <p id="authMessage" class="small"></p>
  </section>

  <div class="day-grid" id="dayGrid" aria-label="1-hafta kunlari"></div>

  <section class="day-workspace" id="workspace" hidden>
    <div class="workspace-top"><div><p class="eyebrow" id="weekFocus"></p><h2 id="dayTitle"></h2></div><button id="completeDay" class="sp-btn secondary" type="button">✓ Bugungi 3 qismni bajardim</button></div>
    <div class="tabs" role="tablist" aria-label="Mashq qismlari"><button class="tab active" role="tab" aria-selected="true" data-tab="pronunciation">01 · Pronunciation</button><button class="tab" role="tab" aria-selected="false" data-tab="shadowing">02 · Shadowing</button><button class="tab" role="tab" aria-selected="false" data-tab="speaking">03 · Speaking Set</button></div>

    <div class="panel active" id="panel-pronunciation" role="tabpanel">
      <div class="panel-head"><div><p class="eyebrow">5–10 DAQIQA</p><h3>Daily Pronunciation</h3><p>So‘zni eshiting, keyin ovoz chiqarib takrorlang. Browser TTS qurilmangizdagi inglizcha ovozdan foydalanadi.</p></div><button class="sp-btn" id="playAllWords" type="button">🔊 Barchasini eshitish</button></div>
      <div class="word-list" id="wordList"></div>
    </div>

    <div class="panel" id="panel-shadowing" role="tabpanel">
      <div class="panel-head"><div><p class="eyebrow">10–15 DAQIQA</p><h3>Shadowing mashqi</h3><p>Avval tinglang, keyin transcript bilan birga takrorlang va ovozingizni yozib oling.</p></div><span class="duration" id="shadowDuration"></span></div>
      <blockquote id="shadowText"></blockquote>
      <div class="shadow-actions"><button class="sp-btn" id="playShadow" type="button">▶ Namuna audio</button><button class="sp-btn secondary" id="recordShadow" type="button">● Yozishni boshlash</button><button class="sp-btn secondary" id="stopRecording" type="button" disabled>■ To‘xtatish</button></div>
      <p class="record-status" id="recordStatus" aria-live="polite">Yozuv hali boshlanmagan.</p><audio id="recordingPlayer" controls hidden></audio>
      <label class="transcript-label">Yozuvingiz transkripti <span>Web Speech ishlamasa, matnni qo‘lda tahrirlang.</span><textarea id="shadowTranscript" rows="5" placeholder="Yozuv boshlanganda yoki tugagach transcript shu yerda paydo bo‘ladi."></textarea></label>
    </div>

    <div class="panel" id="panel-speaking" role="tabpanel">
      <div class="panel-head"><div><p class="eyebrow">15–20 DAQIQA</p><h3>Speaking Question Set</h3><p>Part 1, Part 2 va Part 3 savollarini IELTS uslubida bajaring. Javobdan keyin “Tugatdim” orqali feedback oling.</p></div><span class="format-badge">AI feedback</span></div>
      <section class="question-block"><h4>Part 1 — qisqa savollar</h4><ol id="part1"></ol></section>
      <section class="question-block cue"><div><h4>Part 2 — Cue Card</h4><p id="cueCard"></p><ul id="cueBullets"></ul></div><div class="timers"><div><span>Tayyorlanish</span><strong id="prepTimer">01:00</strong><button class="timer-btn" data-timer="prep">Boshlash</button></div><div><span>Gapirish</span><strong id="speakTimer">02:00</strong><button class="timer-btn" data-timer="speak">Boshlash</button></div></div></section>
      <section class="question-block"><h4>Part 3 — chuqurroq muhokama</h4><ol id="part3"></ol></section>
      <label class="transcript-label">Speaking javobingiz transkripti <textarea id="speakingTranscript" rows="8" placeholder="Part 2 yoki to‘liq javobingizni yozing/yopishtiring. Mikrofon yozuvini Shadowing tabida yoqib transcriptni shu yerga ham ko‘chirishingiz mumkin."></textarea></label>
      <button class="sp-btn feedback-btn" id="getFeedback" type="button">Tugatdim — AI feedback olish</button><p class="record-status" id="feedbackStatus" aria-live="polite"></p>
      <section id="feedbackResult" hidden aria-live="polite"></section>
    </div>
  </section>

  <section class="fallback"><h2>Safari/iPhone haqida</h2><p>Ba’zi Safari versiyalarida live transkript ishlamasligi mumkin. Ovoz yozuvi saqlanadi; transcriptni qo‘lda tahrirlab keyin feedbackga yuboring. Audio-based pronunciation scoring bu MVP’da yo‘q.</p></section>
</section>

<script define:vars={{ days }}>
  window.__TAYANCH_SPEAKING_DAYS__ = days;
</script>
<script>
  import { supabase } from '../lib/supabase';
  const days = window.__TAYANCH_SPEAKING_DAYS__;
  const state = { day: null, recording: null, chunks: [], blob: null, recognition: null, timers: {} };
  const $ = (s) => document.querySelector(s);
  const esc = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const localKey = 'tayanch-speaking-mvp-progress';
  const saved = () => JSON.parse(localStorage.getItem(localKey) || '{}');
  const save = (v) => localStorage.setItem(localKey, JSON.stringify(v));
  function speak(text, rate=.86){ if(!('speechSynthesis' in window)) return alert('Bu brauzerda audio o‘qish ishlamaydi.'); speechSynthesis.cancel(); const u=new SpeechSynthesisUtterance(text); u.lang='en-GB'; u.rate=rate; speechSynthesis.speak(u); }
  function renderDays(){ const done=saved(); $('#dayGrid').innerHTML=days.map(d=>`<button class="day-card ${done[d.day]?'done':''}" data-day="${d.day}" type="button"><span>DAY</span><b>${String(d.day).padStart(2,'0')}</b><small>${esc(d.speaking_set.topic)}</small>${done[d.day]?'<i>✓</i>':''}</button>`).join(''); $('#dayGrid').querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>openDay(Number(b.dataset.day)))); }
  function openDay(n){ state.day=days.find(d=>d.day===n); const d=state.day; $('#workspace').hidden=false; $('#weekFocus').textContent=d.week_focus; $('#dayTitle').textContent=`${d.day}-kun · ${d.speaking_set.topic}`; $('#wordList').innerHTML=d.pronunciation.map((w,i)=>`<article class="word"><b>${esc(w[0])}</b><span>${esc(w[1])}</span><small>${esc(w[2])}</small><button class="word-play" type="button" data-word="${i}" aria-label="${esc(w[0])} so‘zini eshitish">🔊</button></article>`).join(''); $('#wordList').querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>speak(d.pronunciation[Number(b.dataset.word)][0]))); $('#shadowText').textContent=d.shadowing.audio_text; $('#shadowDuration').textContent=`${d.shadowing.target_duration_sec} soniya`; $('#part1').innerHTML=d.speaking_set.part1.map(q=>`<li>${esc(q)}</li>`).join(''); $('#cueCard').textContent=d.speaking_set.part2.cue_card; $('#cueBullets').innerHTML=d.speaking_set.part2.bullets.map(x=>`<li>${esc(x)}</li>`).join(''); $('#part3').innerHTML=d.speaking_set.part3.map(q=>`<li>${esc(q)}</li>`).join(''); resetTimers(); $('#feedbackResult').hidden=true; $('#feedbackStatus').textContent=''; window.location.hash='speaking-workspace'; }
  function resetTimers(){ clearInterval(state.timers.prep); clearInterval(state.timers.speak); setTimer('prep',60); setTimer('speak',120); }
  function setTimer(type, secs){ state.timers[`${type}Secs`]=secs; const out=$(`#${type}Timer`); out.textContent=`${String(Math.floor(secs/60)).padStart(2,'0')}:${String(secs%60).padStart(2,'0')}`; }
  function runTimer(type){ clearInterval(state.timers[type]); state.timers[type]=setInterval(()=>{ let s=--state.timers[`${type}Secs`]; if(s<=0){clearInterval(state.timers[type]);s=0;speak('Time is up',1)} setTimer(type,s); },1000); }
  async function auth(){ const {data:{session}}=await supabase.auth.getSession(); if(session){ $('#authMessage').textContent=`Kirish tasdiqlandi: ${session.user.email}`; $('#speakingLogin').hidden=true; } }
  async function startRecording(){ if(!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder){ $('#recordStatus').textContent='Bu qurilmada audio yozish qo‘llab-quvvatlanmaydi. Transcriptni qo‘lda yozing.';return; } try{ const stream=await navigator.mediaDevices.getUserMedia({audio:true}); state.chunks=[]; state.recording=new MediaRecorder(stream,{mimeType:MediaRecorder.isTypeSupported('audio/webm')?'audio/webm':undefined}); state.recording.ondataavailable=e=>{if(e.data.size)state.chunks.push(e.data)}; state.recording.onstop=()=>{state.blob=new Blob(state.chunks,{type:state.recording.mimeType||'audio/webm'}); const url=URL.createObjectURL(state.blob); $('#recordingPlayer').src=url; $('#recordingPlayer').hidden=false; stream.getTracks().forEach(t=>t.stop()); $('#recordStatus').textContent='Yozuv tayyor. Transcriptni tekshiring va kerak bo‘lsa tahrirlang.';}; state.recording.start(); $('#recordStatus').textContent='● Yozilmoqda…'; $('#recordShadow').disabled=true; $('#stopRecording').disabled=false; startRecognition(); }catch(e){$('#recordStatus').textContent='Mikrofon ruxsati berilmadi yoki qurilmada mavjud emas.';} }
  function startRecognition(){ const Recognition=window.SpeechRecognition||window.webkitSpeechRecognition; if(!Recognition)return; const r=new Recognition(); state.recognition=r; r.lang='en-GB'; r.continuous=true; r.interimResults=true; r.onresult=e=>{let t='';for(let i=0;i<e.results.length;i++)t+=e.results[i][0].transcript+' ';$('#shadowTranscript').value=t.trim();}; r.onerror=()=>{}; try{r.start()}catch{} }
  function stopRecording(){ if(state.recognition)try{state.recognition.stop()}catch{}; if(state.recording?.state==='recording')state.recording.stop(); $('#recordShadow').disabled=false; $('#stopRecording').disabled=true; }
  async function uploadAudio(){ if(!state.blob)return null; const {data:{user}}=await supabase.auth.getUser(); if(!user)return null; const path=`${user.id}/speaking/day-${state.day.day}-${Date.now()}.webm`; const {error}=await supabase.storage.from('attempt-audio').upload(path,state.blob,{contentType:state.blob.type||'audio/webm',upsert:false}); if(error) throw error; return path; }
  async function feedback(){ const transcript=$('#speakingTranscript').value.trim()||$('#shadowTranscript').value.trim(); if(!transcript){$('#feedbackStatus').textContent='Avval kamida bir javob transcriptini kiriting.';return;} const {data:{session}}=await supabase.auth.getSession(); if(!session){$('#feedbackStatus').textContent='AI feedback olish va progressni saqlash uchun email orqali kiring.';return;} const b=$('#getFeedback');b.disabled=true;$('#feedbackStatus').textContent='Audio yuklanmoqda va AI feedback tayyorlanmoqda…';try{ const audioPath=await uploadAudio(); const question=`Part 2: ${state.day.speaking_set.part2.cue_card}`; const {data,error}=await supabase.functions.invoke('speaking-feedback',{body:{day:state.day.day,part:'part2',question,transcript,audioPath,completed:false}}); if(error)throw error;if(data?.error)throw new Error(data.error); renderFeedback(data.feedback); $('#feedbackStatus').textContent='Feedback tayyor.';}catch(e){$('#feedbackStatus').textContent=`Feedback olinmadi: ${e.message||'keyinroq qayta urinib ko‘ring.'}`;}finally{b.disabled=false;} }
  function renderFeedback(f){ const card=(title,x)=>`<article class="feedback-card"><h4>${title} ${x.band==null?'—':`${esc(x.band)}/9`}</h4><p>${(x.notes||[]).map(esc).join('<br>')}</p><ul>${(x.next||[]).map(v=>`<li>${esc(v)}</li>`).join('')}</ul></article>`; $('#feedbackResult').innerHTML=`<div class="estimate"><span>AI practice estimate</span><strong>${esc(f.overall||'—')} / 9</strong><small>Ishonchlilik: ${esc(f.confidence||'medium')}. Bu rasmiy IELTS bahosi emas.</small></div><p>${esc(f.summary||'')}</p><div class="feedback-grid">${card('Fluency',f.fluency||{})}${card('Lexical',f.lexical||{})}${card('Grammar',f.grammar||{})}${card('Pronunciation',f.pronunciation||{band:null,notes:['Transkript talaffuzning akustik sifatini o‘lchamaydi.'],next:['Audio-based scoring keyingi bosqichda qo‘shiladi.']})}</div>${f.retry?'<p class="retry">Javobni kengaytirib, yana urinib ko‘ring.</p>':''}`; $('#feedbackResult').hidden=false; }
  $('#playAllWords').addEventListener('click',()=>speak(state.day.pronunciation.map(w=>w[0]).join('. '),.7)); $('#playShadow').addEventListener('click',()=>speak(state.day.shadowing.audio_text,.86)); $('#recordShadow').addEventListener('click',startRecording); $('#stopRecording').addEventListener('click',stopRecording); $('#getFeedback').addEventListener('click',feedback); $('#completeDay').addEventListener('click',()=>{if(!state.day)return;const d=saved();d[state.day.day]=true;save(d);renderDays();$('#completeDay').textContent='✓ Bajarildi'; setTimeout(()=>$('#completeDay').textContent='✓ Bugungi 3 qismni bajardim',1400)}); document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{document.querySelectorAll('.tab,.panel').forEach(x=>x.classList.remove('active'));t.classList.add('active');t.setAttribute('aria-selected','true');$(`#panel-${t.dataset.tab}`).classList.add('active')})); document.querySelectorAll('.timer-btn').forEach(b=>b.addEventListener('click',()=>runTimer(b.dataset.timer))); $('#speakingLogin').addEventListener('submit',async e=>{e.preventDefault();const email=$('#speakingEmail').value;const {error}=await supabase.auth.signInWithOtp({email,options:{emailRedirectTo:window.location.href}});$('#authMessage').textContent=error?'Xatolik: '+error.message:'Emailga kirish havolasi yuborildi.'}); renderDays();auth();
</script>

<style>
.speaking-app{max-width:1050px;margin:0 auto;padding:1.2rem 0 3rem}.speaking-hero{padding:clamp(1.2rem,3vw,2.2rem);border:1px solid color-mix(in srgb,var(--accent) 42%,var(--border));border-radius:20px;background:radial-gradient(circle at 90% 15%,rgba(52,211,153,.14),transparent 23%),linear-gradient(135deg,rgba(125,125,245,.18),var(--surface) 60%)}.speaking-hero h1{margin:.25rem 0 .65rem;max-width:720px}.speaking-hero>p{max-width:760px;color:var(--muted);line-height:1.6}.notice{margin-top:1rem;padding:.75rem .9rem;border-left:3px solid #fbbf24;background:rgba(251,191,36,.08);color:var(--muted);font-size:.91rem}.auth-card{margin:1.2rem 0;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.15rem;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.auth-card b{color:var(--text)}.auth-card p{margin:.25rem 0 0;color:var(--muted);font-size:.9rem}.auth-card form{display:flex;gap:.5rem;flex-wrap:wrap}.auth-card input,.transcript-label textarea{box-sizing:border-box;border:1px solid var(--border);border-radius:9px;background:var(--bg);color:var(--text);padding:.65rem;font:inherit}.small{font-size:.85rem}.day-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:.55rem;margin:1.2rem 0}.day-card{position:relative;min-height:94px;padding:.7rem;text-align:left;border:1px solid var(--border);border-radius:12px;background:var(--surface);color:var(--text);cursor:pointer}.day-card:hover{border-color:var(--accent);transform:translateY(-2px)}.day-card span,.day-card small{display:block;color:var(--muted);font-size:.68rem}.day-card b{display:block;margin:.15rem 0;font-size:1.2rem;color:var(--accent)}.day-card i{position:absolute;right:.5rem;top:.45rem;color:#34d399;font-style:normal}.day-card.done{border-color:#34d399}.day-workspace{padding:1.2rem;border:1px solid var(--border);border-radius:18px;background:var(--surface)}.workspace-top,.panel-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.workspace-top h2,.panel-head h3{margin:.2rem 0}.tabs{display:flex;gap:.5rem;overflow:auto;margin:1.25rem 0;border-bottom:1px solid var(--border)}.tab{padding:.7rem .8rem;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted);font:inherit;font-weight:700;white-space:nowrap;cursor:pointer}.tab.active{color:var(--text);border-color:var(--accent)}.panel{display:none}.panel.active{display:block}.panel-head p{color:var(--muted);line-height:1.55}.sp-btn{border:0;border-radius:9px;padding:.7rem .9rem;background:var(--accent);color:#fff;font:700 .9rem inherit;cursor:pointer}.sp-btn.secondary{background:transparent;border:1px solid var(--accent);color:var(--accent)}.sp-btn:disabled{opacity:.5;cursor:not-allowed}.word-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}.word{position:relative;padding:.8rem 3rem .8rem .9rem;border:1px solid var(--border);border-radius:11px;background:color-mix(in srgb,var(--bg) 50%,var(--surface))}.word b,.word span,.word small{display:block}.word span{color:var(--accent);margin:.15rem 0}.word small{color:var(--muted);font-size:.84rem}.word-play{position:absolute;right:.7rem;top:50%;transform:translateY(-50%);border:0;border-radius:50%;height:32px;width:32px;background:var(--accent-soft);cursor:pointer}.duration,.format-badge{border:1px solid var(--border);padding:.3rem .55rem;border-radius:999px;color:var(--muted);font-size:.82rem;white-space:nowrap}blockquote{margin:1rem 0;padding:1rem;border-left:3px solid var(--accent);background:var(--bg);color:var(--text);line-height:1.65}.shadow-actions{display:flex;gap:.6rem;flex-wrap:wrap}.record-status{min-height:1.2rem;color:var(--muted);font-size:.9rem}.transcript-label{display:grid;gap:.4rem;margin-top:1rem;color:var(--text);font-weight:700}.transcript-label span{color:var(--muted);font-size:.82rem;font-weight:400}.transcript-label textarea{width:100%;resize:vertical;line-height:1.5}.question-block{margin:1rem 0;padding:1rem;border:1px solid var(--border);border-radius:12px}.question-block h4{margin:0 0 .6rem}.question-block li{margin:.45rem 0;color:var(--muted);line-height:1.5}.cue{display:flex;justify-content:space-between;gap:1rem}.cue p{color:var(--text);font-weight:700}.timers{display:grid;grid-template-columns:repeat(2,minmax(110px,1fr));gap:.6rem;min-width:250px}.timers>div{padding:.7rem;border-radius:10px;background:var(--bg);text-align:center}.timers span,.timers strong{display:block}.timers span{font-size:.78rem;color:var(--muted)}.timers strong{font-size:1.3rem;color:var(--accent);margin:.35rem}.timer-btn{border:1px solid var(--border);border-radius:7px;background:transparent;color:var(--text);padding:.35rem .55rem;cursor:pointer}.feedback-btn{margin-top:1rem}.estimate{display:flex;align-items:baseline;gap:.7rem;flex-wrap:wrap;padding:1rem;margin:1.1rem 0;border-radius:12px;background:linear-gradient(135deg,rgba(125,125,245,.18),var(--bg))}.estimate span,.estimate small{color:var(--muted)}.estimate strong{font-size:1.55rem;color:var(--accent)}.feedback-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.feedback-card{padding:1rem;border:1px solid var(--border);border-radius:12px}.feedback-card h4{margin:0}.feedback-card p,.feedback-card li{color:var(--muted);font-size:.9rem;line-height:1.5}.retry{color:#fbbf24;font-weight:700}.fallback{margin-top:1.2rem;padding:1rem;border:1px dashed var(--border);border-radius:13px}.fallback h2{font-size:1rem;margin:0}.fallback p{color:var(--muted);margin:.5rem 0 0;line-height:1.5}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:760px){.auth-card,.workspace-top,.panel-head,.cue{display:block}.auth-card form{margin-top:.8rem}.day-grid{grid-template-columns:repeat(4,1fr)}.word-list,.feedback-grid{grid-template-columns:1fr}.timers{min-width:0;margin-top:.75rem}.sp-btn{margin-top:.5rem}}@media(max-width:430px){.day-grid{grid-template-columns:repeat(3,1fr)}}
</style>

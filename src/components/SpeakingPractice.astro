---
import days from '../data/ielts-speaking-days.json';
---
<section class="speaking-app" aria-label="IELTS Speaking 30 kunlik mashq">
  <header class="speaking-hero"><p class="eyebrow">AI BILAN 30 KUNLIK KURS</p><h1>IELTS Speaking: muntazam mashq, aniq progress</h1><p>Har kuni talaffuz, original course-script shadowing va IELTS uslubidagi Part 1, Part 2, Part 3 mashqlari.</p><div class="notice"><b>AI practice estimate:</b> rasmiy IELTS bahosi emas. Transcript asosida talaffuz bandi berilmaydi; akustik talaffuz scoring bu kursda yo‘q.</div></header>
  <section class="auth-card" id="speakingAuth" aria-live="polite"><div><b>Progressni saqlash uchun kiring</b><p>Magic link bilan kirilganda kunlar, urinishlar va trend profilingizda saqlanadi. Offlayn holatda qurilmangizdagi vaqtinchalik nusxa ishlaydi.</p></div><form id="speakingLogin"><label class="sr-only" for="speakingEmail">Email</label><input id="speakingEmail" type="email" autocomplete="email" placeholder="email@example.com" required><button class="sp-btn secondary" type="submit">Kirish havolasi</button></form><p id="authMessage" class="small"></p></section>
  <section class="progress-strip" aria-live="polite"><div><b id="progressCount">0/30</b><span>kun tugallandi</span></div><div><b id="trendLabel">—</b><span>so‘nggi urinishlar trendi</span></div><button id="showCertificate" class="sp-btn secondary" type="button">Sertifikat</button></section>
  <div class="day-grid" id="dayGrid" aria-label="30 kunlik kurs kalendari"></div>
  <section class="day-workspace" id="workspace" hidden>
    <div class="workspace-top"><div><p class="eyebrow" id="weekFocus"></p><h2 id="dayTitle"></h2></div><button id="completeDay" class="sp-btn secondary" type="button">Kun yakunini tekshirish</button></div>
    <div class="tabs" role="tablist" aria-label="Mashq qismlari"><button class="tab active" role="tab" aria-selected="true" aria-controls="panel-pronunciation" data-tab="pronunciation">01 · Pronunciation</button><button class="tab" role="tab" aria-selected="false" aria-controls="panel-shadowing" data-tab="shadowing">02 · Shadowing</button><button class="tab" role="tab" aria-selected="false" aria-controls="panel-speaking" data-tab="speaking">03 · Speaking Set</button></div>
    <div class="panel active" id="panel-pronunciation" role="tabpanel"><div class="panel-head"><div><p class="eyebrow">5–10 DAQIQA</p><h3>Daily Pronunciation</h3><p>So‘zlarni eshiting va ovoz chiqarib takrorlang. Bu qism audio baholanmaydi.</p></div><button class="sp-btn" id="playAllWords" type="button">Barchasini eshitish</button></div><div class="word-list" id="wordList"></div><button class="sp-btn secondary mark" data-section="pronunciation" type="button">Talaffuz mashqini belgilash</button></div>
    <div class="panel" id="panel-shadowing" role="tabpanel"><div class="panel-head"><div><p class="eyebrow">10–15 DAQIQA</p><h3>Shadowing mashqi</h3><p>Namuna matni original course script. Browser ovozi faqat reference; litsenziyalangan inson ovozi hali qo‘shilmagan.</p></div><span class="duration" id="shadowDuration"></span></div><blockquote id="shadowText"></blockquote><div class="shadow-actions"><button class="sp-btn" id="playShadow" type="button">Namuna ovozi</button><button class="sp-btn secondary" id="recordShadow" type="button">Yozishni boshlash</button><button class="sp-btn secondary" id="stopRecording" type="button" disabled>To‘xtatish</button></div><p class="record-status" id="recordStatus" aria-live="polite">Yozuv hali boshlanmagan.</p><audio id="recordingPlayer" controls hidden></audio><label class="transcript-label">Yozuvingiz transkripti <span>Safari/iOS yoki Web Speech ishlamasa, transcriptni qo‘lda yozing. Audio yuklanishi shart emas.</span><textarea id="shadowTranscript" rows="5" placeholder="Transcriptni shu yerga yozing yoki tahrirlang."></textarea></label><button class="sp-btn secondary mark" data-section="shadowing" type="button">Shadowing mashqini belgilash</button></div>
    <div class="panel" id="panel-speaking" role="tabpanel"><div class="panel-head"><div><p class="eyebrow">15–25 DAQIQA</p><h3>Speaking Question Set</h3><p>Bir partni baholating yoki Full simulation bilan barcha qismlarni ketma-ket bajaring.</p></div><span class="format-badge">AI feedback</span></div><div class="attempt-mode" role="group" aria-label="Feedback turi"><button data-mode="part1" class="mode active" type="button">Part 1</button><button data-mode="part2" class="mode" type="button">Part 2</button><button data-mode="part3" class="mode" type="button">Part 3</button><button data-mode="full" class="mode" type="button">Full simulation</button></div><section id="attemptPrompt" class="question-block"></section><section id="fullFlow" class="full-flow" hidden></section><label class="transcript-label" id="responseLabel">Javob transkripti<textarea id="speakingTranscript" rows="8" placeholder="Javobingizni yozing yoki recording transcriptini bu yerga ko‘chiring."></textarea></label><button class="sp-btn feedback-btn" id="getFeedback" type="button">AI feedback olish · 1 Qadam</button><p class="record-status" id="feedbackStatus" aria-live="polite"></p><section id="feedbackResult" hidden aria-live="polite"></section></div>
  </section>
  <section class="certificate" id="certificate" hidden aria-live="polite"><div class="certificate-paper"><p class="eyebrow">TAYANCH IELTS SPEAKING</p><h2>30 kunlik mashq sertifikati</h2><p id="certificateText">Sertifikat uchun 30 kunning uchala mashq qismi yakunlangan bo‘lishi kerak.</p><p class="small">Bu qatnashuv sertifikati; rasmiy IELTS natijasi emas.</p><button class="sp-btn" id="printCertificate" type="button">Print / PDF saqlash</button></div></section>
  <section class="fallback"><h2>Safari/iPhone uchun aniq fallback</h2><p>Safari live SpeechRecognition’ni qo‘llamasligi mumkin. Mikrofon yozuvi ishlasa, uni eshiting va transcriptni qo‘lda kiriting; yozuv ham ishlamasa, faqat matnli mashq va AI feedback mavjud. Hech qanday server-STT yoki transcriptdan pronunciation scoring ishlatilmaydi.</p></section>
</section>
<script define:vars={{ days }}>window.__TAYANCH_SPEAKING_DAYS__ = days;</script>
<script>
 import { supabase } from '../lib/supabase';
 const days=window.__TAYANCH_SPEAKING_DAYS__, $=s=>document.querySelector(s), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const key='tayanch-speaking-progress-v2'; const state={day:null,mode:'part1',recording:null,chunks:[],blob:null,recognition:null,timers:{},progress:{},requesting:false,fullStep:0,fullParts:{part1:'',part2:'',part3:''},feedbackRequestId:null,authenticated:false,serverProgress:false};
 const load=()=>{try{return JSON.parse(localStorage.getItem(key)||'{}')}catch{return {}}}; const persist=()=>localStorage.setItem(key,JSON.stringify(state.progress)); const token=()=>crypto.randomUUID?crypto.randomUUID():`${Date.now()}-${Math.random()}`;
 function speak(text,rate=.86){if(!('speechSynthesis'in window)){setStatus('recordStatus','Browser ovozi mavjud emas; matnni o‘zingiz o‘qing.');return}speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(text);u.lang='en-GB';u.rate=rate;speechSynthesis.speak(u)}
 function setStatus(id,text){$("#"+id).textContent=text}
 function isDone(p){return p?.pronunciation_done&&p?.shadowing_done&&p?.speaking_done}
 function renderDays(){const n=Object.values(state.progress).filter(isDone).length;$('#progressCount').textContent=`${n}/30`;$('#dayGrid').innerHTML=days.map(d=>{let p=state.progress[d.day],c=isDone(p)?'done':p?'started':'';return `<button class="day-card ${c}" data-day="${d.day}" type="button"><span>${Math.ceil(d.day/7)}-HAFTA · DAY</span><b>${String(d.day).padStart(2,'0')}</b><small>${esc(d.speaking_set.topic)}</small>${isDone(p)?'<i aria-label="Tugallangan">✓</i>':''}</button>`}).join('');$('#dayGrid').querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>openDay(+b.dataset.day)))}
 function openDay(n){state.day=days.find(x=>x.day===n);let d=state.day;$('#workspace').hidden=false;$('#weekFocus').textContent=d.week_focus;$('#dayTitle').textContent=`${d.day}-kun · ${d.speaking_set.topic}`;$('#wordList').innerHTML=d.pronunciation.map((w,i)=>`<article class="word"><b>${esc(w[0])}</b><span>${esc(w[1])}</span><small>${esc(w[2])}</small><button class="word-play" data-word="${i}" type="button" aria-label="${esc(w[0])} so‘zini eshitish">🔊</button></article>`).join('');$('#wordList').querySelectorAll('button').forEach(b=>b.onclick=()=>speak(d.pronunciation[+b.dataset.word][0]));$('#shadowText').textContent=d.shadowing.audio_text;$('#shadowDuration').textContent=`${d.shadowing.target_duration_sec} soniya`;$('#shadowTranscript').value='';$('#speakingTranscript').value='';state.fullParts={part1:'',part2:'',part3:''};state.fullStep=0;state.feedbackRequestId=null;setMode('part1');resetTimers();window.location.hash='speaking-workspace';$('#workspace').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}
 function setTimer(name,secs){state.timers[name+'Secs']=secs;let x=$('#'+name+'Timer');if(x)x.textContent=`${String(Math.floor(secs/60)).padStart(2,'0')}:${String(secs%60).padStart(2,'0')}`}
 function resetTimers(){clearInterval(state.timers.prep);clearInterval(state.timers.speak);setTimer('prep',state.day?.speaking_set.part2.prep_time_sec||60);setTimer('speak',state.day?.speaking_set.part2.speak_time_sec||120)}
 function runTimer(name){clearInterval(state.timers[name]);state.timers[name]=setInterval(()=>{let v=Math.max(0,--state.timers[name+'Secs']);setTimer(name,v);if(!v){clearInterval(state.timers[name]);speak('Time is up',1);setStatus('feedbackStatus',name==='prep'?'Tayyorlanish tugadi. Endi gapiring.':'Gapirish vaqti tugadi. Transcriptni tekshiring.')}},1000)}
 async function invoke(body){const {data,error}=await supabase.functions.invoke('speaking-feedback',{body});if(error)throw error;if(data?.error)throw new Error(data.error);return data}
 async function syncProgress(){const {data:{session}}=await supabase.auth.getSession();if(!session)return;try{let r=await invoke({action:'progress'});state.progress=r.progress||{};state.serverProgress=true;persist();renderDays();let h=await invoke({action:'history'});renderTrend(h.attempts||[])}catch(e){setStatus('authMessage','Server progressi vaqtincha olinmadi; qurilmadagi nusxa ko‘rsatilmoqda.')}}
 async function mark(section){if(!state.day)return;let p=state.progress[state.day.day]||{};p[section+'_done']=true;state.progress[state.day.day]=p;persist();renderDays();setStatus('feedbackStatus',`${section} bajarildi deb belgilandi.`);const {data:{session}}=await supabase.auth.getSession();if(!session)return;if(state.requesting)return;try{let r=await invoke({action:'progress',day:state.day.day,sections:[section],idempotencyKey:token()});state.progress={...state.progress,...(r.progress||{})};persist();renderDays()}catch(e){setStatus('feedbackStatus','Serverga saqlanmadi; kirish yoki tarmoqni tekshiring. Qurilmadagi nusxa qoladi.')}}
 function startRecognition(){let R=window.SpeechRecognition||window.webkitSpeechRecognition;if(!R){setStatus('recordStatus','Live transcript Safari/iOS’da mavjud emas. Audio tayyor bo‘lgach transcriptni qo‘lda kiriting.');return}let r=new R();state.recognition=r;r.lang='en-GB';r.continuous=true;r.interimResults=true;r.onresult=e=>{let t='';for(let i=0;i<e.results.length;i++)t+=e.results[i][0].transcript+' ';$('#shadowTranscript').value=t.trim()};r.onerror=()=>setStatus('recordStatus','Live transcript uzildi. Qo‘lda tahrirlash mumkin.');try{r.start()}catch{}}
 async function startRecording(){if(!navigator.mediaDevices?.getUserMedia||!window.MediaRecorder){setStatus('recordStatus','Bu qurilmada audio yozish yo‘q. Transcriptni qo‘lda kiriting.');return}try{let stream=await navigator.mediaDevices.getUserMedia({audio:true});state.chunks=[];let mime=MediaRecorder.isTypeSupported?.('audio/webm')?'audio/webm':'';state.recording=mime?new MediaRecorder(stream,{mimeType:mime}):new MediaRecorder(stream);state.recording.ondataavailable=e=>e.data.size&&state.chunks.push(e.data);state.recording.onstop=()=>{state.blob=new Blob(state.chunks,{type:state.recording.mimeType||'audio/webm'});let url=URL.createObjectURL(state.blob);$('#recordingPlayer').src=url;$('#recordingPlayer').hidden=false;stream.getTracks().forEach(t=>t.stop());setStatus('recordStatus',state.blob.size<4000?'Yozuv juda qisqa yoki jim. Transcriptni qo‘lda tekshiring.':'Yozuv tayyor. Transcriptni tekshiring va tahrirlang.')};state.recording.start(1000);$('#recordShadow').disabled=true;$('#stopRecording').disabled=false;setStatus('recordStatus','● Yozilmoqda…');startRecognition()}catch{setStatus('recordStatus','Mikrofon ruxsati berilmadi yoki qurilmada mavjud emas. Transcriptni qo‘lda kiriting.')}}
 function stopRecording(){try{state.recognition?.stop()}catch{};if(state.recording?.state==='recording')state.recording.stop();$('#recordShadow').disabled=false;$('#stopRecording').disabled=true}
 async function uploadAudio(){if(!state.blob||state.blob.size<4000)return null;let {data:{user}}=await supabase.auth.getUser();if(!user)return null;let ext=state.blob.type.includes('mp4')?'m4a':'webm',path=`${user.id}/speaking/day-${state.day.day}-${Date.now()}.${ext}`;let {error}=await supabase.storage.from('attempt-audio').upload(path,state.blob,{contentType:state.blob.type||'audio/webm',upsert:false});if(error)throw error;return path}
 function partContent(mode){let d=state.day,s=d.speaking_set;if(mode==='part1')return {question:`Part 1: ${s.part1.join(' | ')}`,html:`<h4>Part 1 — qisqa savollar</h4><ol>${s.part1.map(q=>`<li>${esc(q)}</li>`).join('')}</ol><p class="small">2–3 savolga tabiiy, kengaytirilgan javob bering.</p>`};if(mode==='part2')return {question:`Part 2: ${s.part2.cue_card}`,html:`<div class="cue"><div><h4>Part 2 — Cue Card</h4><p>${esc(s.part2.cue_card)}</p><ul>${s.part2.bullets.map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div><div class="timers"><div><span>Tayyorlanish</span><strong id="prepTimer">01:00</strong><button class="timer-btn" data-timer="prep" type="button">Boshlash</button></div><div><span>Gapirish</span><strong id="speakTimer">02:00</strong><button class="timer-btn" data-timer="speak" type="button">Boshlash</button></div></div></div>`};return {question:`Part 3: ${s.part3.join(' | ')}`,html:`<h4>Part 3 — chuqurroq muhokama</h4><ol>${s.part3.map(q=>`<li>${esc(q)}</li>`).join('')}</ol><p class="small">Sabab, misol va natijani bog‘lab javob bering.</p>`}}
 function bindTimers(){$('#attemptPrompt').querySelectorAll('.timer-btn').forEach(b=>b.onclick=()=>runTimer(b.dataset.timer))}
 function setMode(mode){if(!state.day)return;state.mode=mode;state.feedbackRequestId=null;document.querySelectorAll('.mode').forEach(b=>{let a=b.dataset.mode===mode;b.classList.toggle('active',a);b.setAttribute('aria-pressed',a)});let full=mode==='full';$('#fullFlow').hidden=!full;$('#attemptPrompt').hidden=full;$('#responseLabel').hidden=full;if(full)renderFull();else{let c=partContent(mode);$('#attemptPrompt').innerHTML=c.html;bindTimers();$('#getFeedback').textContent='AI feedback olish · 1 Qadam'}}
 function renderFull(){let labels=['Part 1','Part 2','Part 3'],part=['part1','part2','part3'][state.fullStep],c=partContent(part);$('#fullFlow').innerHTML=`<p class="small">${labels.map((x,i)=>`<b class="${i===state.fullStep?'current':''}">${i+1}. ${x}</b>`).join(' · ')}</p>${c.html}<label class="transcript-label">${labels[state.fullStep]} transkripti<textarea id="fullTranscript" rows="6" placeholder="${labels[state.fullStep]} javobingizni yozing.">${esc(state.fullParts[part])}</textarea></label><button id="nextFull" class="sp-btn secondary" type="button">${state.fullStep===2?'Full feedbackga o‘tish':'Keyingi qism'}</button>`;bindTimers();$('#nextFull').onclick=()=>{state.fullParts[part]=$('#fullTranscript').value.trim();if(state.fullParts[part].length<20){setStatus('feedbackStatus','Davom etish uchun mazmunli transcript kiriting.');return}if(state.fullStep<2){state.fullStep++;renderFull()}else feedback()};$('#getFeedback').textContent='Full simulation yakunlanishini kuting'}
 async function feedback(){if(state.requesting)return;let full=state.mode==='full',content;if(full){let last=['part1','part2','part3'][state.fullStep];let el=$('#fullTranscript');if(el)state.fullParts[last]=el.value.trim();content=Object.entries(state.fullParts).map(([k,v])=>`${k.toUpperCase()}: ${v}`).join('\n\n')}else content=$('#speakingTranscript').value.trim()||$('#shadowTranscript').value.trim();if(!content){setStatus('feedbackStatus','Avval transcript kiriting.');return}state.requesting=true;let b=$('#getFeedback');b.disabled=true;setStatus('feedbackStatus','Transcript tekshirilmoqda; AI feedback tayyorlanmoqda…');try{let audioPath=await uploadAudio(),q=full?'Full simulation: Part 1, Part 2 and Part 3 answers':partContent(state.mode).question;let r=await invoke({action:'feedback',day:state.day.day,part:state.mode,question:q,transcript:content,audioPath,completed:true,idempotencyKey:(state.feedbackRequestId||(state.feedbackRequestId=token())),segments:full?state.fullParts:null});renderFeedback(r.feedback);await mark('speaking');state.feedbackRequestId=null;setStatus('feedbackStatus',r.reused?'Oldingi bir xil urinish natijasi qaytarildi.':'Feedback tayyor.')}catch(e){setStatus('feedbackStatus',`Feedback olinmadi: ${e.message||'keyinroq qayta urinib ko‘ring.'}`)}finally{state.requesting=false;b.disabled=false}}
 function renderFeedback(f){let card=(t,x)=>`<article class="feedback-card"><h4>${t} ${x?.band==null?'—':`${esc(x.band)}/9`}</h4><p>${(x?.notes||[]).map(esc).join('<br>')}</p><ul>${(x?.next||[]).slice(0,3).map(v=>`<li>${esc(v)}</li>`).join('')}</ul></article>`;$('#feedbackResult').innerHTML=`<div class="estimate"><span>AI practice estimate</span><strong>${esc(f.overall||'—')} / 9</strong><small>Ishonchlilik: ${esc(f.confidence||'medium')}. Rasmiy IELTS bahosi emas.</small></div><p>${esc(f.summary||'')}</p><div class="feedback-grid">${card('Fluency',f.fluency)}${card('Lexical',f.lexical)}${card('Grammar',f.grammar)}${card('Pronunciation',f.pronunciation||{band:null,notes:['Transcript talaffuzning akustik sifatini o‘lchamaydi.'],next:['Aniq talaffuz uchun recordingni o‘zingiz tinglang.']})}</div>${f.retry?`<p class="retry">${esc(f.retry_reason||'Javobni kengaytirib, yana urinib ko‘ring.')}</p>`:''}`;$('#feedbackResult').hidden=false}
 function renderTrend(attempts){let completed=attempts.filter(a=>a.status==='completed'&&Number.isFinite(Number(a.score?.overall))).slice(0,6);if(completed.length<2){$('#trendLabel').textContent='Ma’lumot kam';return}let newer=Number(completed[0].score.overall),older=Number(completed.at(-1).score.overall),diff=newer-older;$('#trendLabel').textContent=`${diff>0?'+':''}${diff.toFixed(1)} band`}
 async function showCert(){let n=Object.values(state.progress).filter(isDone).length,eligible=state.authenticated&&state.serverProgress&&n===30;$('#certificateText').textContent=eligible?'Tabriklaymiz — server siz 30 kunning uchala mashq qismini yakunlaganingizni tasdiqladi. Print/PDF orqali saqlashingiz mumkin.':`Hozir ${n}/30 kun ko‘rinmoqda. Sertifikat faqat kirilgan profilning 30 kuni serverda tasdiqlanganda ochiladi.`;$('#printCertificate').disabled=!eligible;$('#certificate').hidden=false;$('#certificate').scrollIntoView({behavior:'smooth'})}
 $('#playAllWords').onclick=()=>state.day&&speak(state.day.pronunciation.map(w=>w[0]).join('. '),.7);$('#playShadow').onclick=()=>state.day&&speak(state.day.shadowing.audio_text,.86);$('#recordShadow').onclick=startRecording;$('#stopRecording').onclick=stopRecording;$('#getFeedback').onclick=feedback;$('#completeDay').onclick=()=>{let p=state.progress[state.day.day]||{};setStatus('feedbackStatus',isDone(p)?'Bu kunning uchala qismi yakunlangan.':`Yakunlash uchun: ${!p.pronunciation_done?'talaffuz ':''}${!p.shadowing_done?'shadowing ':''}${!p.speaking_done?'speaking ':''}`)};document.querySelectorAll('.mark').forEach(b=>b.onclick=()=>mark(b.dataset.section));document.querySelectorAll('.mode').forEach(b=>b.onclick=()=>setMode(b.dataset.mode));document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{document.querySelectorAll('.tab,.panel').forEach(x=>x.classList.remove('active'));t.classList.add('active');t.setAttribute('aria-selected','true');$('#panel-'+t.dataset.tab).classList.add('active')});$('#showCertificate').onclick=showCert;$('#printCertificate').onclick=()=>window.print();$('#speakingLogin').onsubmit=async e=>{e.preventDefault();let {error}=await supabase.auth.signInWithOtp({email:$('#speakingEmail').value,options:{emailRedirectTo:window.location.href}});setStatus('authMessage',error?'Xatolik: '+error.message:'Emailga kirish havolasi yuborildi.')};(async()=>{state.progress=load();renderDays();let {data:{session}}=await supabase.auth.getSession();if(session){state.authenticated=true;$('#authMessage').textContent=`Kirish tasdiqlandi: ${session.user.email}`;$('#speakingLogin').hidden=true;syncProgress()}})();
</script>
<style>
.speaking-app{max-width:1050px;margin:auto;padding:1.2rem 0 3rem}.speaking-hero,.day-workspace,.certificate-paper{padding:clamp(1.1rem,3vw,2.2rem);border:1px solid color-mix(in srgb,var(--accent) 42%,var(--border));border-radius:20px;background:radial-gradient(circle at 90% 15%,rgba(52,211,153,.14),transparent 24%),var(--surface)}.speaking-hero h1{margin:.25rem 0 .6rem}.speaking-hero>p,.small,.fallback p{color:var(--muted);line-height:1.55}.notice{margin-top:1rem;padding:.75rem;border-left:3px solid #fbbf24;background:#fbbf2414}.auth-card,.progress-strip,.workspace-top,.panel-head,.shadow-actions,.cue{display:flex;gap:1rem;align-items:center;justify-content:space-between}.auth-card{margin:1.2rem 0;padding:1rem;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.auth-card p{margin:.25rem 0}.auth-card form{display:flex;gap:.5rem;flex-wrap:wrap}.auth-card input,.transcript-label textarea{box-sizing:border-box;width:100%;padding:.65rem;border:1px solid var(--border);border-radius:9px;background:var(--bg);color:var(--text);font:inherit}.progress-strip{margin:1rem 0;padding:.8rem 1rem;border:1px solid var(--border);border-radius:12px}.progress-strip div{display:grid}.progress-strip span{font-size:.8rem;color:var(--muted)}.day-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:.5rem;margin:1rem 0}.day-card{position:relative;min-height:88px;padding:.65rem;text-align:left;border:1px solid var(--border);border-radius:12px;background:var(--surface);color:var(--text);cursor:pointer}.day-card:hover,.day-card:focus-visible{border-color:var(--accent);outline:none}.day-card span,.day-card small{display:block;color:var(--muted);font-size:.66rem}.day-card b{display:block;margin:.12rem 0;color:var(--accent);font-size:1.15rem}.day-card i{position:absolute;right:.5rem;top:.4rem;color:#34d399}.day-card.done{border-color:#34d399}.day-card.started{border-color:#fbbf24}.tabs,.attempt-mode{display:flex;gap:.4rem;flex-wrap:wrap;border-bottom:1px solid var(--border);margin:1.1rem 0}.tab,.mode,.timer-btn{border:0;border-bottom:2px solid transparent;padding:.65rem .7rem;background:transparent;color:var(--muted);cursor:pointer;font:inherit}.tab.active,.mode.active{color:var(--text);border-color:var(--accent)}.panel{display:none}.panel.active{display:block}.word-list{display:grid;grid-template-columns:repeat(2,1fr);gap:.55rem;margin:1rem 0}.word{display:grid;grid-template-columns:1fr auto;gap:.15rem;padding:.7rem;border:1px solid var(--border);border-radius:10px}.word span,.word small{color:var(--muted)}.word small{grid-column:1}.word-play{grid-column:2;grid-row:1/3;background:none;border:0;cursor:pointer}.transcript-label{display:block;margin:1rem 0}.transcript-label span{display:block;color:var(--muted);font-size:.84rem;margin:.25rem 0}.record-status{min-height:1.3rem;color:var(--muted)}.duration,.format-badge{color:#34d399;font-size:.9rem}.question-block{padding:1rem;border:1px solid var(--border);border-radius:12px}.timers{display:flex;gap:.7rem}.timers>div{display:grid;gap:.25rem;padding:.55rem;border:1px solid var(--border);border-radius:10px}.timers span{font-size:.75rem;color:var(--muted)}.full-flow .current{color:var(--accent)}.estimate{display:flex;gap:.8rem;align-items:baseline;margin-top:1rem}.estimate strong{font-size:1.5rem;color:var(--accent)}.feedback-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem}.feedback-card{padding:.8rem;border:1px solid var(--border);border-radius:12px}.feedback-card h4{margin:0}.retry{padding:.6rem;border-left:3px solid #fbbf24}.fallback{margin-top:1.2rem;padding:1rem;border:1px solid var(--border);border-radius:14px}.certificate{margin-top:1rem;text-align:center}.certificate-paper{max-width:700px;margin:auto}.mark{margin-top:.3rem}@media(max-width:700px){.auth-card,.progress-strip,.workspace-top,.panel-head,.cue{align-items:stretch;flex-direction:column}.day-grid{grid-template-columns:repeat(4,1fr)}.word-list,.feedback-grid{grid-template-columns:1fr}.timers{width:100%}.timers>div{flex:1}}@media(max-width:360px){.day-grid{grid-template-columns:repeat(3,1fr)}}@media print{.speaking-app>*:not(.certificate){display:none!important}.certificate{display:block!important;border:0}.certificate-paper{border:1px solid #333;background:white;color:black}}
</style>

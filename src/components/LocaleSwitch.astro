---
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
const langs = [
  { code: 'uz', label: 'UZ', path: 'kurslar/ielts-listening/' },
  { code: 'ru', label: 'RU', path: 'ru/kurslar/ielts-listening/' },
  { code: 'en', label: 'EN', path: 'en/kurslar/ielts-listening/' }
];
---
<nav class="locale-switch" aria-label="Til tanlash / Выбор языка / Language">
  {langs.map((l) => <a href={base + l.path} class={l.code === current ? 'active' : ''} hreflang={l.code}>{l.label}</a>)}
</nav>
<style>
  .locale-switch{display:flex;gap:.5rem;justify-content:center;margin:1rem 0 0}
  .locale-switch a{padding:.35rem .85rem;border:1px solid var(--border);border-radius:999px;font-weight:700;color:var(--muted);text-decoration:none;font-size:.85rem}
  .locale-switch a.active{background:var(--accent);color:#fff;border-color:var(--accent)}
</style>

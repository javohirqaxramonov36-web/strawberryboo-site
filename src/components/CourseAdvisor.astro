---
const {lang='uz'}=Astro.props as {lang?:'uz'|'ru'|'en'};
const c={uz:{h:'Tezkor kurs yo‘naltirgichi',level:'Hozirgi daraja',goal:'Maqsad',time:'Haftalik vaqt',begin:'Boshlang‘ich',mid:'O‘rta',adv:'Yuqori',english:'Ingliz / IELTS',admission:'Admission',digital:'Raqamli ko‘nikma',short:'1–2 soat',regular:'3–5 soat',deep:'6+ soat',go:'Tavsiyani ko‘rish',r:'Siz uchun tavsiya:'},ru:{h:'Быстрый выбор направления',level:'Текущий уровень',goal:'Цель',time:'Время в неделю',begin:'Начальный',mid:'Средний',adv:'Продвинутый',english:'Английский / IELTS',admission:'Поступление',digital:'Цифровые навыки',short:'1–2 часа',regular:'3–5 часов',deep:'6+ часов',go:'Показать рекомендацию',r:'Рекомендация для вас:'},en:{h:'Quick course advisor',level:'Current level',goal:'Goal',time:'Weekly time',begin:'Beginner',mid:'Intermediate',adv:'Advanced',english:'English / IELTS',admission:'Admission',digital:'Digital skills',short:'1–2 hours',regular:'3–5 hours',deep:'6+ hours',go:'Show recommendation',r:'Your recommendation:'}}[lang];
const base=import.meta.env.BASE_URL; const admission=lang==='uz'?'kurslar/admission-process/':`${lang}/kurslar/admission-process/`;const english=lang==='uz'?'kurslar/general-english-beginner/':`${lang}/kurslar/general-english-beginner/`;const digital=lang==='uz'?'kurslar/tekin-ai/':`${lang}/kurslar/tekin-ai/`;
---
<section class="advisor" data-advisor data-copy={JSON.stringify(c)} data-links={JSON.stringify({admission:base+admission,english:base+english,digital:base+digital})}><h2>{c.h}</h2><p class="note">No personal or sensitive data is requested. The recommendation is deterministic and runs in this browser.</p><fieldset><legend>{c.level}</legend><label><input type="radio" name="level" value="begin" checked /> {c.begin}</label><label><input type="radio" name="level" value="mid" /> {c.mid}</label><label><input type="radio" name="level" value="adv" /> {c.adv}</label></fieldset><fieldset><legend>{c.goal}</legend><label><input type="radio" name="goal" value="english" checked /> {c.english}</label><label><input type="radio" name="goal" value="admission" /> {c.admission}</label><label><input type="radio" name="goal" value="digital" /> {c.digital}</label></fieldset><fieldset><legend>{c.time}</legend><label><input type="radio" name="time" value="short" checked /> {c.short}</label><label><input type="radio" name="time" value="regular" /> {c.regular}</label><label><input type="radio" name="time" value="deep" /> {c.deep}</label></fieldset><button type="button" class="start-btn" data-advisor-go>{c.go}</button><p data-advisor-result aria-live="polite"></p></section>
<script>const root=document.querySelector('[data-advisor]');if(root){const links=JSON.parse(root.dataset.links||'{}'),copy=JSON.parse(root.dataset.copy||'{}');root.querySelector('[data-advisor-go]').addEventListener('click',()=>{const goal=root.querySelector('input[name=goal]:checked').value;const key=goal==='admission'?'admission':goal==='digital'?'digital':'english';root.querySelector('[data-advisor-result]').innerHTML=`${copy.r} <a href="${links[key]}">${goal}</a>`})}</script>
<style>.advisor{margin:2rem 0;padding:1.3rem;border:1px solid var(--border);border-radius:15px;background:var(--surface)}.advisor h2{margin:0 0 .5rem}.advisor fieldset{margin:1rem 0;border:0;padding:0}.advisor legend{font-weight:700;margin-bottom:.4rem}.advisor label{display:block;padding:.25rem 0;color:var(--muted)}.advisor .note{color:var(--muted);font-size:.86rem}</style>

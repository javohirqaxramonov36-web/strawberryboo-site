---
import universities from '../data/universities.json';
import { communityConfig } from '../data/community-config';
const { lang='uz' }=Astro.props as {lang?:'uz'|'ru'|'en'};
const c={uz:{h:'Admission yordamchi vositalari',sop:'SOP / Personal Statement ko‘rib chiqish',sopHint:'Matn va shaxsiy API kalitingiz brauzerdan bevosita AI provayderiga yuboriladi. Maxfiy ma’lumot kiritmang. Kalit faqat brauzeringizda saqlanadi. Mahalliy himoya so‘rovlarni qisqa vaqt ichida takrorlashni cheklaydi; provayder limiti kalitingiz rejasiga bog‘liq.',review:'Ko‘rib chiqish',need:'Avval Tayanch AI sozlamalaridan API kalitni kiriting.',wait:'Iltimos, keyingi so‘rovdan oldin biroz kuting.',match:'Universitet qidiruvi',region:'Hudud',field:'Yo‘nalish',pref:'Afzallik',profile:'SAT / IELTS / byudjet (faqat profilingizda ko‘rsatiladi; moslik mezoni emas)',find:'Ko‘rish',warning:'Bu boshlang‘ich ro‘yxat. Talablar, xarajatlar, muddatlar va mavjudlik tasdiqlanmagan — rasmiy universitet sahifasidan tekshiring.',peer:'Haftalik essay almashinuvi',peerText:'Telegram’da haftalik esse almashinuvi uchun taklif yuboring. Bu peer-review platformasi emas.',open:'Telegram shablonini ochish',leader:'Owner uchun leaderboard posti',alumni:'Mentor / alumni joyi',consent:'Faqat yozma rozilik olingandan keyin ism, foto, universitet yoki fikr qo‘shiladi. Hozir profil ko‘rsatilmaydi.',event:'Webinar',upcoming:'Tasdiqlangan tadbir hali kiritilmagan.',audio:'Podcast / audio',feedback:'30 kun tugadimi? Fikringizni Telegram orqali qo‘lda yuborishingiz mumkin. Email yoki telefon so‘ralmaydi.',feedbackDisabled:'Fikr qabul qiluvchi Telegram manzili hali sozlanmagan.'},ru:{h:'Инструменты для поступления',sop:'Проверка SOP / Personal Statement',sopHint:'Текст и ваш личный API-ключ отправляются из браузера напрямую AI-провайдеру. Не вводите конфиденциальные данные. Ключ хранится только в вашем браузере. Локальная защита ограничивает повторные запросы за короткое время; лимит провайдера зависит от плана ключа.',review:'Проверить',need:'Сначала добавьте API-ключ в настройках Tayanch AI.',wait:'Подождите перед следующим запросом.',match:'Подбор университетов',region:'Регион',field:'Направление',pref:'Предпочтение',profile:'SAT / IELTS / бюджет (только показывается в вашем профиле; не является критерием подбора)',find:'Показать',warning:'Это стартовый список. Требования, стоимость, сроки и доступность не подтверждены — проверьте официальный сайт университета.',peer:'Еженедельный обмен эссе',peerText:'Отправьте приглашение на обмен эссе в Telegram. Это не платформа peer review.',open:'Открыть шаблон Telegram',leader:'Пост leaderboard для владельца',alumni:'Место для ментора / alumni',consent:'Имя, фото, университет или отзыв добавляются только после письменного согласия. Сейчас профили не показываются.',event:'Вебинар',upcoming:'Подтверждённое событие ещё не добавлено.',audio:'Подкаст / аудио',feedback:'Завершили 30 дней? Можно вручную отправить отзыв через Telegram. Email и телефон не запрашиваются.',feedbackDisabled:'Telegram-адрес для отзывов ещё не настроен.'},en:{h:'Admission support tools',sop:'SOP / Personal Statement review',sopHint:'Your text and personal API key are sent directly from the browser to the AI provider. Do not enter confidential information. The key is stored only in your browser. A local guard limits repeat requests in a short window; provider limits depend on your key plan.',review:'Review',need:'First add an API key in Tayanch AI settings.',wait:'Please wait before another request.',match:'University matcher',region:'Region',field:'Field',pref:'Preference',profile:'SAT / IELTS / budget (shown only with your profile; not used as matching criteria)',find:'Show matches',warning:'This is a discovery list. Requirements, costs, deadlines and availability are unverified—check each official university page.',peer:'Weekly essay exchange',peerText:'Send a Telegram invitation for a weekly essay exchange. This is not a peer-review platform.',open:'Open Telegram template',leader:'Leaderboard post for owner',alumni:'Mentor / alumni slot',consent:'Names, photos, universities or testimonials are added only after written consent. No profiles are displayed now.',event:'Webinar',upcoming:'No confirmed event has been configured yet.',audio:'Podcast / audio',feedback:'Finished 30 days? You may manually send feedback through Telegram. No email or phone is collected.',feedbackDisabled:'A Telegram feedback destination has not been configured yet.'}}[lang];
const tg=communityConfig.telegramUrl; const feedback=communityConfig.feedbackTelegramUrl;
---
<section class="admission-tools" data-admission-tools data-universities={JSON.stringify(universities.universities)} data-copy={JSON.stringify(c)} data-tg={tg} data-feedback={feedback} data-webinar={JSON.stringify(communityConfig.webinar)}><p class="eyebrow">STATIC, BROWSER-ONLY</p><h2>{c.h}</h2><div class="tool-grid"><article><h3>{c.sop}</h3><p>{c.sopHint}</p><label><span>Essay</span><textarea data-sop rows="8"></textarea></label><button class="start-btn" data-sop-submit type="button">{c.review}</button><div data-sop-result aria-live="polite"></div></article><article><h3>{c.match}</h3><label>{c.region}<select data-region><option value="">—</option><option>Canada</option><option>United States</option><option>Australia</option><option>United Kingdom</option></select></label><label>{c.field}<select data-field><option value="">—</option><option>Engineering</option><option>Computer Science</option><option>Business</option><option>Arts</option></select></label><label>{c.pref}<select data-pref><option value="">—</option><option>research</option><option>city</option><option>campus</option></select></label><label>{c.profile}<input data-profile /></label><button class="start-btn" data-match type="button">{c.find}</button><div data-matches aria-live="polite"></div><p class="notice">{c.warning} Updated: {universities.last_updated}</p></article><article><h3>{c.peer}</h3><p>{c.peerText}</p><a class="start-btn" target="_blank" rel="noopener" href={tg + '?text=' + encodeURIComponent('Weekly essay exchange: I would like to exchange one draft this week. Please give respectful, specific feedback on structure, clarity and evidence.')}>{c.open}</a><details><summary>{c.leader}</summary><pre>Weekly learning prompt\nShare one practice win and one next step. Do not publish names, ranks or activity data without consent.</pre></details></article><article><h3>{c.alumni}</h3><p>{c.consent}</p><h3>{c.event}</h3>{communityConfig.webinar ? <button type="button" data-ics class="start-btn">.ics</button> : <p>{c.upcoming}</p>}<h3>{c.audio}</h3>{communityConfig.podcast ? <audio controls src={communityConfig.podcast.audioUrl}></audio> : <p>{c.upcoming}</p>}</article></div><section class="feedback"><p>{c.feedback}</p>{feedback ? <a class="start-btn" href={feedback} target="_blank" rel="noopener">Telegram</a> : <p class="notice">{c.feedbackDisabled}</p>}</section></section>
<script>
const root=document.querySelector('[data-admission-tools]');if(root){const copy=JSON.parse(root.dataset.copy||'{}'),us=JSON.parse(root.dataset.universities||'[]'),out=root.querySelector('[data-sop-result]'),guard='tayanch.sop-review.guard.v1'; const event=JSON.parse(root.dataset.webinar||'null'); const ics=root.querySelector('[data-ics]'); if(ics&&event&&event.title&&event.start&&event.end){ics.addEventListener('click',()=>{const stamp=(value)=>new Date(value).toISOString().replace(/[-:]/g,'').replace(/\.\d{3}Z/,'Z'); const lines=['BEGIN:VCALENDAR','VERSION:2.0','BEGIN:VEVENT','UID:tayanch-'+Date.now()+'@local','DTSTAMP:'+stamp(new Date()),'DTSTART:'+stamp(event.start),'DTEND:'+stamp(event.end),'SUMMARY:'+String(event.title).replace(/\n/g,' '),'DESCRIPTION:'+String(event.description||event.url||'').replace(/\n/g,' '),event.url?'URL:'+event.url:'','END:VEVENT','END:VCALENDAR'].filter(Boolean).join('\r\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([lines],{type:'text/calendar'}));a.download='tayanch-webinar.ics';a.click();URL.revokeObjectURL(a.href)})} root.querySelector('[data-sop-submit]').addEventListener('click',async()=>{const text=root.querySelector('[data-sop]').value.trim(),last=Number(localStorage.getItem(guard)||0);if(!text)return;if(Date.now()-last<60000){out.textContent=copy.wait;return}if(!window.TayanchAI||!window.TayanchAI.assessWriting){out.textContent=copy.need;return}localStorage.setItem(guard,String(Date.now()));out.textContent='…';try{const result=await window.TayanchAI.assessWriting({taskType:'sop_personal_statement',prompt:'Review against this SOP rubric only: structure, specificity, clarity and flow, impact. Do not use IELTS bands. Return JSON with those four criteria and summary.',response:text});out.textContent=JSON.stringify(result,null,2)}catch(e){out.textContent=e.message||String(e)}});root.querySelector('[data-match]').addEventListener('click',()=>{const r=root.querySelector('[data-region]').value,f=root.querySelector('[data-field]').value,p=root.querySelector('[data-pref]').value,profile=root.querySelector('[data-profile]').value;const list=us.filter(x=>(!r||x.region===r)&&(!f||x.fields.includes(f))&&(!p||x.preferences.includes(p)));root.querySelector('[data-matches]').innerHTML=(profile?`<p>${profile}</p>`:'')+(list.length?`<ul>${list.map(x=>`<li>${x.name} — ${x.region}</li>`).join('')}</ul>`:'<p>—</p>')});}
</script>
<style>.admission-tools{margin:3rem 0;padding:1.5rem;border:1px solid var(--border);border-radius:18px;background:color-mix(in srgb,var(--accent) 6%,var(--surface))}.tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.tool-grid article,.feedback{padding:1rem;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.tool-grid h3{margin:0 0 .6rem}.tool-grid p,.notice{color:var(--muted);line-height:1.55;font-size:.88rem}.tool-grid label{display:block;margin:.6rem 0;font-size:.85rem}.tool-grid textarea,.tool-grid input,.tool-grid select{box-sizing:border-box;width:100%;margin-top:.25rem;padding:.55rem;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text)}[data-sop-result]{white-space:pre-wrap;max-height:260px;overflow:auto;margin-top:.8rem;font-size:.8rem}.feedback{margin-top:1rem}.eyebrow{color:var(--accent);font-size:.75rem;font-weight:800;letter-spacing:.1em}pre{white-space:pre-wrap;font:inherit;font-size:.82rem}@media(max-width:700px){.tool-grid{grid-template-columns:1fr}}</style>

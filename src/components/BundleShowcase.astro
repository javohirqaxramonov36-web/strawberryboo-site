---
import { bundles, generalEnglishPath } from '../data/course-enrichment';
import coursesData from '../data/courses.json';
const { lang = 'uz' } = Astro.props as { lang?: 'uz' | 'ru' | 'en' };
const base = import.meta.env.BASE_URL;
const courses = coursesData.courses as any[];
const label = lang === 'ru' ? { title: 'Новые связки', path: 'Путь General English', open: 'Открыть курс →', price: 'Цена', placeholder: 'Цена будет указана позже' } : lang === 'en' ? { title: 'New bundles', path: 'General English path', open: 'Open course →', price: 'Price', placeholder: 'Price will be added later' } : { title: 'Yangi paketlar', path: 'General English yo‘nalishi', open: 'Kursni ochish →', price: 'Narx', placeholder: 'Narx keyin kiritiladi' };
const courseTitle = (slug: string) => courses.find((course) => course.slug === slug)?.title?.[lang] ?? slug;
---
<section class="bundle-showcase">
  <div class="section-heading"><p class="eyebrow">PAKETLAR VA YO‘NALISHLAR</p><h2>{label.title}</h2></div>
  <div class="bundle-grid">
    {bundles.map((bundle) => <article class="bundle-card"><h3>{bundle.title}</h3><p>{bundle.description}</p><ul>{bundle.courses.map((slug) => <li>{courseTitle(slug)}</li>)}</ul><strong>{label.price}: {bundle.price}</strong><small>{bundle.saving}</small><a href={base + 'kurslar/' + bundle.courses[0] + '/'}>{label.open}</a></article>)}
  </div>
  <article class="path-card"><div><p class="eyebrow">GENERAL ENGLISH</p><h2>{label.path}</h2><p>Noldan C1 gacha tartibli yo‘l. Har bir daraja $15, 6 darajalik path narxi $81.</p></div><div class="path-steps">{generalEnglishPath.map((slug, index) => <a href={base + 'kurslar/' + slug + '/'}><span>{index + 1}/6</span><b>{courseTitle(slug)}</b></a>)}</div></article>
</section>
<style>
.bundle-showcase{margin:2rem 0}.section-heading h2{margin:.2rem 0 .8rem}.bundle-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.bundle-card,.path-card{padding:1.15rem;border:1px solid var(--border);border-radius:15px;background:var(--surface)}.bundle-card h3,.bundle-card p{margin:.15rem 0 .55rem}.bundle-card p,.bundle-card li,.bundle-card small,.path-card p{color:var(--muted);line-height:1.5}.bundle-card ul{padding-left:1.2rem;min-height:4.5rem}.bundle-card strong,.bundle-card small{display:block}.bundle-card small{margin-top:.25rem}.bundle-card a,.path-steps a{display:block;margin-top:.8rem;color:var(--accent);font-weight:800}.path-card{display:grid;grid-template-columns:.8fr 1.2fr;gap:1rem;margin-top:1rem;background:linear-gradient(145deg,var(--surface),var(--accent-soft))}.path-steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.path-steps a{margin:0;padding:.7rem;border:1px solid var(--border);border-radius:10px;text-decoration:none;color:var(--text)}.path-steps span{display:block;color:var(--accent);font-size:.75rem}.path-steps b{display:block;margin-top:.25rem;font-size:.9rem}@media(max-width:820px){.bundle-grid,.path-card{grid-template-columns:1fr}.path-steps{grid-template-columns:1fr}}
</style>

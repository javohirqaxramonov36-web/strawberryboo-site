---
interface Props { name: string; description: string; }
const { name, description } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name,
  description,
  provider: { '@type': 'Organization', name: 'Tayanch', url: 'https://javohirqaxramonov36-web.github.io/strawberryboo-site/' },
  url: Astro.url.href,
  inLanguage: 'uz'
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

---
/**
 * A truthful, reusable syllabus preview. It intentionally contains no video
 * player or lesson links: these three course pages do not expose standalone
 * preview lessons that can be verified as publicly available.
 */
type Locale = 'uz' | 'ru' | 'en';
type Preview = { eyebrow: string; title: string; note: string; learnTitle: string; learn: string[]; syllabusTitle: string; syllabus: string[]; detail: string };

const { slug, lang = 'uz' } = Astro.props as { slug: 'prompt-engineering' | 'ai-agentlar' | 'obsidian'; lang?: Locale };

const previews: Record<string, Record<Locale, Preview>> = {
  'prompt-engineering': {
    uz: { eyebrow: 'BEPUL KURS KO‘RINISHI', title: 'Kurs ichida nimalar borligini oldindan ko‘ring', note: 'Bu sahifadagi bepul ko‘rinish — tasdiqlangan modul rejasi. Hozir alohida bepul video dars havolasi mavjud emas; shuning uchun video bor deb da’vo qilmaymiz.', learnTitle: 'Nimani o‘rganasiz', learn: ['AI uchun aniq vazifa, rol, kontekst va javob formatini yozish.', 'Noaniq ko‘rsatmani cheklovlar va misollar bilan foydali promptga aylantirish.', 'Murakkab vazifani bosqichlarga bo‘lish va few-shot misollardan foydalanish.', 'Promptlarni yozish, kod, tadqiqot va biznes vazifalariga moslashtirish.'], syllabusTitle: 'Syllabus: 7 modul', syllabus: ['Nima uchun Prompt Engineering kerak?', 'Prompt tuzilmasi: rol, kontekst, misollar, format', 'Amaliy mashq: IELTS essay uchun prompt', 'Chain-of-thought: murakkab vazifani bo‘lish', 'Few-shot: misollar orqali o‘rgatish', 'Qo‘llanish sohalari: yozish, kod, tadqiqot, biznes', 'Tayanch orqali avtomatik capture'], detail: 'To‘liq sahifada yomon/yaxshi prompt taqqoslanishi, modullar va mini-quiz mavjud.' },
    ru: { eyebrow: 'БЕСПЛАТНЫЙ ОБЗОР', title: 'Посмотрите, что входит в курс', note: 'Это бесплатный обзор подтверждённой программы. Отдельный бесплатный видеоурок не опубликован, поэтому мы не заявляем о его наличии.', learnTitle: 'Чему вы научитесь', learn: ['Формулировать задачу, роль, контекст и формат ответа для ИИ.', 'Превращать неясную инструкцию в полезный prompt с ограничениями и примерами.', 'Делить сложную задачу на шаги и использовать few-shot примеры.', 'Применять prompts к письму, коду, исследованию и бизнес-задачам.'], syllabusTitle: 'Программа: 7 модулей', syllabus: ['Зачем нужен Prompt Engineering?', 'Структура prompt: роль, контекст, примеры, формат', 'Практика: prompt для IELTS essay', 'Chain-of-thought: разделение сложной задачи', 'Few-shot: обучение на примерах', 'Где применять: письмо, код, исследование, бизнес', 'Автоматический capture через Tayanch'], detail: 'На полной странице есть сравнение плохого и хорошего prompt, программа и мини-quiz.' },
    en: { eyebrow: 'FREE COURSE OVERVIEW', title: 'See what the course covers first', note: 'This is a free overview of the verified syllabus. No standalone free video lesson is published, so this page does not imply that one exists.', learnTitle: 'What you will learn', learn: ['Write a clear task, role, context and answer format for AI.', 'Turn a vague instruction into a useful prompt with constraints and examples.', 'Break a complex task into steps and use few-shot examples.', 'Adapt prompts for writing, code, research and business tasks.'], syllabusTitle: 'Syllabus: 7 modules', syllabus: ['Why Prompt Engineering matters', 'Prompt structure: role, context, examples and format', 'Practice: a prompt for an IELTS essay', 'Chain-of-thought: splitting a complex task', 'Few-shot: teaching through examples', 'Where to apply it: writing, code, research and business', 'Automatic capture with Tayanch'], detail: 'The full page includes a bad/good prompt comparison, modules and a mini quiz.' },
  },
  'ai-agentlar': {
    uz: { eyebrow: 'BEPUL KURS KO‘RINISHI', title: 'AI agentlar kursining aniq rejasi', note: 'Bu bepul ko‘rinish mavjud sahifadagi modul mavzulariga asoslangan. Alohida bepul video dars havolasi tasdiqlanmagan, shuning uchun video bor deb ko‘rsatilmaydi.', learnTitle: 'Nimani o‘rganasiz', learn: ['Oddiy chat va rejalashtirib, ko‘p bosqichli vazifa bajaradigan agent o‘rtasidagi farq.', 'Planner, Researcher va Writer kabi rollarga bo‘lingan CrewAI jamoasi asoslari.', 'LangGraph bilan agentlar oqimini boshqarish va Letta bilan xotira tushunchasi.', 'MacBook’da mahalliy vositalar yordamida xavfsiz kichik agent tajribasini boshlash.'], syllabusTitle: 'Syllabus: 7 modul', syllabus: ['Oddiy AI va agent: farqi nima?', 'CrewAI: Planner, Researcher, Writer jamoasi', 'LangGraph: agentlar oqimini boshqarish', 'Letta: agent uchun uzoq muddatli xotira', 'MacBook’da o‘z agentingizni yaratish', 'Qo‘llanish: tadqiqot, kontent, biznes', 'AI va agentlar nimani tezlashtiradi?'], detail: 'To‘liq sahifada agentni maqsad uchun vosita sifatida ishlatish va Mac uchun lokal vositalar bo‘yicha material bor.' },
    ru: { eyebrow: 'БЕСПЛАТНЫЙ ОБЗОР', title: 'Понятная программа курса об AI-агентах', note: 'Этот бесплатный обзор основан на темах модулей на существующей странице. Отдельный бесплатный видеоурок не подтверждён, поэтому он не заявлен.', learnTitle: 'Чему вы научитесь', learn: ['Отличать обычный чат от агента, который планирует и выполняет многошаговую задачу.', 'Понимать основы команды CrewAI с ролями Planner, Researcher и Writer.', 'Разбирать поток агентов в LangGraph и понятие памяти в Letta.', 'Начинать безопасный небольшой локальный эксперимент с агентом на MacBook.'], syllabusTitle: 'Программа: 7 модулей', syllabus: ['Обычный AI и агент: в чём разница?', 'CrewAI: команда Planner, Researcher и Writer', 'LangGraph: управление потоком агентов', 'Letta: долгосрочная память агента', 'Создание своего агента на MacBook', 'Применение: исследование, контент, бизнес', 'Что ускоряют AI и агенты?'], detail: 'Полная страница объясняет, как использовать агента как инструмент для цели, и содержит материал о локальных инструментах для Mac.' },
    en: { eyebrow: 'FREE COURSE OVERVIEW', title: 'A clear AI agents course outline', note: 'This free overview is based on module topics on the existing course page. A standalone free video lesson is not verified, so none is claimed.', learnTitle: 'What you will learn', learn: ['Tell a standard chat from an agent that plans and completes a multi-step task.', 'Understand a CrewAI team with Planner, Researcher and Writer roles.', 'Understand agent flow control in LangGraph and the memory concept in Letta.', 'Start a safe, small local AI-agent experiment on a MacBook.'], syllabusTitle: 'Syllabus: 7 modules', syllabus: ['Standard AI versus an agent: what is the difference?', 'CrewAI: a Planner, Researcher and Writer team', 'LangGraph: controlling agent flow', 'Letta: long-term memory for an agent', 'Build your own agent on a MacBook', 'Applications: research, content and business', 'What AI and agents can speed up'], detail: 'The full page explains using agents as a means to a goal and includes material on local Mac tools.' },
  },
  obsidian: {
    uz: { eyebrow: 'BEPUL KURS KO‘RINISHI', title: 'Obsidian PKM kursining rejasi', note: 'Bu bepul ko‘rinish mavjud sahifadagi modul va amaliy materiallarga asoslangan. Alohida bepul video dars havolasi tasdiqlanmagan; shu sabab video mavjudligi aytilmaydi.', learnTitle: 'Nimani o‘rganasiz', learn: ['Markdown fayllariga asoslangan shaxsiy bilim bazasi va tashqi xotira tamoyili.', 'Vault, MOC, papkalar va ichki linklar yordamida notalarni bog‘lash.', 'Markdown, calloutlar, tezkor tugmalar va Graph view bilan kundalik ishlash.', 'Community pluginlar, spaced repetition hamda xavfsiz backup bo‘yicha ehtiyotkor amaliyot.'], syllabusTitle: 'Syllabus: 6 modul', syllabus: ['Nima uchun Obsidian? Tashqi xotira', 'Vault tuzilmasi: MOC, papkalar, linklar', 'AutoConnect: yangi notalarni avtomatik ulash', 'Tayanch: Telegram → Obsidian capture', 'Graph view: bilimlar bog‘lanishi', 'Qo‘llanish: o‘qish, ish, tadqiqot'], detail: 'To‘liq sahifada Markdown, YouTube embed, shortcuts, calloutlar, pluginlar, xavfsizlik va Graph view bo‘yicha amaliy material mavjud.' },
    ru: { eyebrow: 'БЕСПЛАТНЫЙ ОБЗОР', title: 'Программа курса Obsidian PKM', note: 'Этот бесплатный обзор основан на модулях и практических материалах существующей страницы. Отдельный бесплатный видеоурок не подтверждён, поэтому его наличие не заявляется.', learnTitle: 'Чему вы научитесь', learn: ['Работать с личной базой знаний на Markdown-файлах как с внешней памятью.', 'Связывать заметки через vault, MOC, папки и внутренние ссылки.', 'Использовать Markdown, callouts, shortcuts и Graph view в ежедневной работе.', 'Осторожно работать с community plugins, spaced repetition и резервными копиями.'], syllabusTitle: 'Программа: 6 модулей', syllabus: ['Зачем нужен Obsidian? Внешняя память', 'Структура vault: MOC, папки и ссылки', 'AutoConnect: автоматическое связывание новых заметок', 'Tayanch: capture из Telegram в Obsidian', 'Graph view: связи между знаниями', 'Применение: учёба, работа и исследование'], detail: 'На полной странице есть практические материалы по Markdown, YouTube embed, shortcuts, callouts, plugins, безопасности и Graph view.' },
    en: { eyebrow: 'FREE COURSE OVERVIEW', title: 'The Obsidian PKM course outline', note: 'This free overview is based on modules and practical material on the existing page. A standalone free video lesson is not verified, so this page does not claim one exists.', learnTitle: 'What you will learn', learn: ['Use a Markdown-file personal knowledge base as an external memory.', 'Connect notes with a vault, MOCs, folders and internal links.', 'Use Markdown, callouts, shortcuts and Graph view in everyday work.', 'Use community plugins, spaced repetition and backups with care.'], syllabusTitle: 'Syllabus: 6 modules', syllabus: ['Why Obsidian? External memory', 'Vault structure: MOCs, folders and links', 'AutoConnect: linking new notes automatically', 'Tayanch: Telegram → Obsidian capture', 'Graph view: connections between knowledge', 'Applications: study, work and research'], detail: 'The full page includes practical material on Markdown, YouTube embed, shortcuts, callouts, plugins, security and Graph view.' },
  },
};

const preview = previews[slug]?.[lang];
if (!preview) throw new Error(`No course preview configured for ${slug}/${lang}`);
---
<section class="course-preview" aria-labelledby={`${slug}-preview-title`}>
  <div class="preview-intro">
    <p class="preview-eyebrow">{preview.eyebrow}</p>
    <h2 id={`${slug}-preview-title`}>{preview.title}</h2>
    <p class="preview-note">{preview.note}</p>
  </div>
  <div class="preview-grid">
    <section aria-labelledby={`${slug}-learn-title`}>
      <h3 id={`${slug}-learn-title`}>{preview.learnTitle}</h3>
      <ul>{preview.learn.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section aria-labelledby={`${slug}-syllabus-title`}>
      <h3 id={`${slug}-syllabus-title`}>{preview.syllabusTitle}</h3>
      <ol>{preview.syllabus.map((module) => <li>{module}</li>)}</ol>
    </section>
  </div>
  <p class="preview-detail">{preview.detail}</p>
</section>

<style>
  .course-preview{margin:2rem 0;padding:clamp(1.1rem,3vw,1.6rem);border:1px solid color-mix(in srgb,var(--accent) 48%,var(--border));border-radius:18px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent-soft) 68%,transparent),var(--surface));}
  .preview-eyebrow{margin:0 0 .35rem;color:var(--accent);font-weight:850;font-size:.75rem;letter-spacing:.11em}.preview-intro h2{margin:.1rem 0 .55rem}.preview-note,.preview-detail{color:var(--muted);line-height:1.6}.preview-note{max-width:850px}.preview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.15rem}.preview-grid section{padding:1rem 1.1rem;border:1px solid var(--border);border-radius:13px;background:color-mix(in srgb,var(--surface) 88%,transparent)}.preview-grid h3{margin:0 0 .65rem}.preview-grid ul,.preview-grid ol{margin:0;padding-left:1.2rem}.preview-grid li{margin:.52rem 0;color:var(--muted);line-height:1.5}.preview-detail{margin:.95rem 0 0;font-size:.94rem}@media(max-width:680px){.preview-grid{grid-template-columns:1fr}}
</style>

---
import courses from "../data/courses.json";
interface Props {
  course: any;
  lang?: "uz" | "ru" | "en";
  base?: string;
}
const { course, lang = "uz", base = import.meta.env.BASE_URL } = Astro.props;
const t = (o: any) => (o && typeof o === "object" ? (o[lang] ?? o.uz) : o);

const icons: Record<string, string> = {
  sparkle: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/><path d="M19 14l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>',
  book: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
  agent: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 8V4M9 2h6M9 12h.01M15 12h.01M9 16h6"/></svg>',
  document: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z"/><path d="M8 3v4M16 3v4M7 11h10M7 15h6"/></svg>',
  code: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg>',
  doccheck: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg>',
  chip: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8M12 8v13M12 8S10 3 7.5 4.5 9 8 12 8zM12 8s2-5 4.5-3.5S15 8 12 8z"/></svg>',
  lightning: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-14h-7l1-8z"/></svg>',
  figma: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>',
  cad: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3zM3 9h18M9 3v18M15 9v12"/></svg>',
  cap: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.5 3 6 3s6-2 6-3v-5"/></svg>',
  chart: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="11" width="3" height="7"/><rect x="12" y="7" width="3" height="11"/><rect x="17" y="13" width="3" height="5"/></svg>',
  trophy: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M12 4V2M9 2h6"/></svg>',
  box: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z"/><path d="M3 7l2-3h11l2 3"/><circle cx="17" cy="13" r="1.6"/></svg>',
  monitor: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="11" rx="2"/><path d="M2 20h20"/></svg>',
};
const certSvg = '<svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>';
const all = courses.courses as any[];
const miniIndex = (slug: string) => all.filter((c) => c.type === "ielts-mini").findIndex((c: any) => c.slug === slug) + 1;
---

{course.type === "ielts-mini" && (
  <a class={`ielts-mini-card ${course.slug}`} href={base + course.href} data-gumroad-product={course.gumroadSlug} target={course.gumroadSlug ? "_blank" : undefined} rel={course.gumroadSlug ? "noopener noreferrer" : undefined}>
    {course.progressCourseId && <span class="course-card-progress" data-course-progress-meter data-course-id={course.progressCourseId} data-total={course.progressTotal} aria-live="polite"></span>}
    <b>{String(miniIndex(course.slug)).padStart(2, "0")}</b>
    <h3>{t(course.title)}</h3>
    <p>{t(course.description)}</p>
    <span>{t(course.price)} →</span>
  </a>
)}

{course.type === "coming-soon" && (
  <div class="card" style={`--c:${course.accent}`} data-cat={course.cats.join(" ")}>
    <span class="badge badge-soon">{lang === "uz" ? "Kelayotgan" : lang === "ru" ? "Скоро" : "Coming soon"}</span>
    <div class="c-ic" aria-hidden="true" set:html={icons[course.icon] ?? icons.book}></div>
    <h2>{t(course.title)}</h2>
    <span class="cat">{t(course.cat)}</span>
    {course.certificate && <span class="cert-line" set:html={certSvg + (course.certLabel ? t(course.certLabel) : (lang === "uz" ? "Sertifikat bilan" : lang === "ru" ? "С сертификатом" : "With certificate"))}></span>}
    <p>{t(course.description)}</p>
    <p class="upcoming-status">{lang === "uz" ? "Narx va dastur tez orada e'lon qilinadi" : lang === "ru" ? "Цена и программа скоро" : "Price and syllabus coming soon"}</p>
    <span class="start-btn is-disabled" aria-disabled="true">{lang === "uz" ? "Tayyorlanmoqda" : lang === "ru" ? "Готовится" : "In preparation"}</span>
  </div>
)}

{(course.type === "standard" || course.type === "mock") && (
  <div class="card" style={`--c:${course.accent}`} data-cat={course.cats.join(" ")}>
    {course.badge && <span class="badge">{t(course.badge)}</span>}
    <div class="c-ic" aria-hidden="true" set:html={icons[course.icon] ?? icons.book}></div>
    <h2>{t(course.title)}</h2>
    {course.cat && <span class="cat">{t(course.cat)}</span>}
    {course.certificate && <span class="cert-line" set:html={certSvg + (course.certLabel ? t(course.certLabel) : (lang === "uz" ? "Sertifikat bilan" : lang === "ru" ? "С сертификатом" : "With certificate"))}></span>}
    <p>{t(course.description)}</p>
    <p class="price">{t(course.price)}{course.priceUzs ? <span class="uzs"> {t(course.priceUzs)}</span> : null}</p>
    {course.progressCourseId && <span class="course-card-progress" data-course-progress-meter data-course-id={course.progressCourseId} data-total={course.progressTotal} aria-live="polite"></span>}
    {course.free ? (
      <a href={base + course.href} class="start-btn">{lang === "uz" ? "Bepul kursni ko'rish →" : lang === "ru" ? "Смотреть бесплатный курс →" : "View free course →"}</a>
    ) : course.gumroadSlug ? (
      <a href={base + course.href} class="start-btn" data-gumroad-product={course.gumroadSlug} target="_blank" rel="noopener noreferrer">{lang === "uz" ? "Kursga yozilish →" : lang === "ru" ? "Записаться на курс →" : "Enroll in course →"}</a>
    ) : (
      <a href={base + course.href} class="start-btn">{lang === "uz" ? "Kursni ko'rish →" : lang === "ru" ? "Смотреть курс →" : "View course →"}</a>
    )}
  </div>
)}

---
import Base from '../layouts/Base.astro';
type Lang = 'uz' | 'en' | 'ru';
const { lang } = Astro.props as { lang: Lang };
import LearningJourneyPlan from './LearningJourneyPlan.astro';
const base = import.meta.env.BASE_URL;
const paths = { uz: 'mening-yolim/', en: 'en/my-journey/', ru: 'ru/moy-put/' };
const alternates = Object.entries(paths).map(([locale, path]) => ({ lang: locale, href: base + path }));
const story = {
uz: {title:"Mening yo'lim | Tayanch",description:"Tayanch asoschisining halol hikoyasi: mustaqil o'rganish, admission yo'li, o'qituvchilik va AI bilan amaliy muammolarni yechish haqida.",eyebrow:'ASOSCHI HIKOYASI',h1:"Mening yo'lim",lead:"Bu reklama emas. Bu men nimani boshdan kechirganim, nimani o'rganganim va nima uchun Tayanch’ni yaratayotganim haqidagi halol hikoya.",aria:'Qisqa tanishuv',quote:"“Ikki marta o'lcha, bir marta kes.”",intro:"Bu otamdan o'rgangan qoida. Men uchun u faqat qurilish haqida emas: qarorni tekshirish, resursni qadrlash va shoshmasdan ish qilish haqida.",steps:[['BOSHLANISH NUQTASI','Otam bilan qurilishda',"Otam bilan qurilish ishlarida yurgan paytlarimda beton quyish, devor pardozlash, kafel yotqizish va material hisoblash bilan tanishdim. Oshxonamizdagi ta'mirda o'lchovni xato olganimda, otam kesishdan oldin uni yana tekshirdi.","O'shanda bitta xato faqat bitta detalni emas, keyingi ishlarni ham buzishini ko'rdim. Muhandislikka qiziqishim ham shu yerdan boshlandi: yechim topishdan oldin muammoni aniq ko'rish kerak.","Saboq: Asos mustahkam bo'lmasa, ustiga hech narsa turmaydi — nafaqat devorda, hayotda ham."],['QIYIN DAVR',"Pullik kurs kutmasdan o'rganish","Oilamizdagi moliyaviy qiyinchiliklar sabab IELTS kursini tark etib, mustaqil tayyorlandim. Menda mukammal sharoit yo'q edi: bepul Telegram materiallari, muntazam amaliy testlar va bor resursni to'g'ri ishlatish bor edi.","IELTS imtihoniga ro'yxatdan o'tish to'lovini qoplash uchun hovlimizdagi daraxtlar ham sotilgan. Bu tajriba men uchun juda shaxsiy, lekin aynan u bilimning narxini boshqacha tushunishga yordam berdi.","Shu yo'lda IELTS 7.0 va SAT 1420 natijalariga erishdim.","Saboq: To'g'ri usul va izchillik bo'lsa, qimmat kurs imkoniyatning yagona yo'li emas."],['DAVOM ETISH','Gap year va mehnat',"2025–2026-yillardagi gap year davrida oilamni qo'llab-quvvatlash uchun yuk ortish-tushirish ishida ishladim. Ayrim kunlari tungi va kunduzgi smenalar ulanib, juda kam uxlab davom etishga to'g'ri kelgan.","Bu davr oson bo'lmagan. Ammo u menga intizom motivatsiya kelishini kutish emasligini o'rgatdi: natija darhol ko'rinmasa ham, davom etish kerak.","Saboq: Qiyin sharoit rejangizni o'zgartirishi mumkin, lekin maqsadingizni bekor qilishi shart emas."],['BURILISH NUQTASI',"AI — vaqtni bo'shatadigan vosita","Bo'sh vaqt topilganida BIM, Revit, AutoCAD, Digital Twin, Calculus I va prompt engineeringni mustaqil o'rgandim. AutoCAD’dagi takrorlanuvchi chizma detalini qo'lda qayta-qayta bajarish o'rniga, AI yordamida AutoLISP skripti yaratdim.","Natijada avval ikki soat ketadigan ish 15 daqiqaga tushdi. Shu tajriba AI insonning fikrlashi o'rnini bosishi uchun emas, balki muhimroq tekshiruv, hisob-kitob va qarorlar uchun vaqt bo'shatishi kerakligini ko'rsatdi.","Saboq: Texnologiya maqsad emas. U tartib, mas'uliyat va aniq natija bilan birga ishlaydigan vosita."],['BILIMNI ULASHISH',"O'qituvchilik tajribasi","Sydney School’da 40 dan ortiq o'quvchiga ingliz tili, speaking va IELTS/CEFR tayyorgarligi bo'yicha dars berdim. Har bir o'quvchining savoli, tezligi va qiyinchiligi boshqacha edi.","O'rgatish uchun avval o'zingiz tushunishingiz, keyin esa fikrni boshqaga sodda va amaliy qilib yetkazishingiz kerak. O'quvchining natijasi o'zgarganini ko'rish bilimni tizimlashtirish qanchalik katta mas'uliyat ekanini his qildirdi.","Saboq: Bilim uni boshqalar ham ochib, foydalana olganida kuchliroq bo'ladi."],['BUGUNGI HOLAT','Nega Tayanch bor?',"Admission yo'limda 18 ta tasdiqlangan qabul xati va jami $1.1M dan ortiq stipendiya takliflariga erishdim. Lekin bu yo'l menga bitta narsani ko'rsatdi: qobiliyatning o'zi kamlik qiladi. Ko'p odamga tizim, aniq yo'l va ishonch yetishmaydi.","Shuning uchun Tayanch’da AI, IELTS va Admission bo'yicha kurslarni yaratmoqdaman. Ular tayyor javob berish uchun emas, o'quvchiga o'z muammosini tushunish, tizim qurish va keyingi qadamini tanlashga yordam berish uchun yaratiladi.","Uzoq muddatli maqsadim — imkoniyati cheklangan, ammo iqtidorli yoshlar uchun grant asosidagi STEM ta'limini beradigan Muhandislik Akademiyasini qurish. Tayanch — shu katta maqsadning kichik, ammo real boshlanishi."]],proof:['YO‘LIMDAGI NATIJALAR','Hujjatlar bilan tasdiqlangan namunalar','Bu yerda faqat zarur natija ko‘rsatkichlari qoldirilgan. Shaxsiy ma’lumotlar, identifikatorlar va moliyaviy tafsilotlar yashirilgan.','TAJRIBA VA ARIZA HIKOYASI','Quyidagi kartalar original sahifalarning nusxasi emas: ular maxfiy ma’lumotlarsiz, umumlashtirilgan excerpt sifatida qayta tuzilgan.','ta tasdiqlangan qabul xati','Quyida turli yo‘nalish va mamlakatlardagi oltita namuna. Har birida faqat universitet, ijobiy qaror, dastur va qabul yili qoldirilgan.','Qolgan 12 ta tasdiqlangan qabul xati','Previewlar faqat ma’lumot uchun: original hujjat emas va verifikatsiya uchun yaroqsiz. Saqlash/yuklab olish funksiyasi berilmagan; screenshot olishning oldini to‘liq olib bo‘lmasligini yodda tuting.'],cta:['KEYINGI QADAM',"Sizning yo'lingiz ham shu yerdan boshlanishi mumkin.","Hozir qaysi yo'nalish sizga ko'proq mosligini aniqlang va o'zingiz uchun amaliy reja tuzishni boshlang.",'Kurs tanlash testini boshlash →']},
en: {title:'My journey | Tayanch',description:'An honest story from Tayanch’s founder: independent learning, the admission path, teaching, and using AI to solve practical problems.',eyebrow:'FOUNDER STORY',h1:'My journey',lead:'This is not an advertisement. It is an honest story about what I went through, what I learned, and why I am building Tayanch.',aria:'A brief introduction',quote:'“Measure twice, cut once.”',intro:'This is a rule I learned from my father. To me, it is not only about construction: it is about checking decisions, valuing resources, and working without rushing.',steps:[['STARTING POINT','Construction with my father','While working in construction with my father, I learned about pouring concrete, finishing walls, laying tile, and calculating materials. When I measured incorrectly during our kitchen renovation, my father checked it again before cutting.','I saw then that one mistake can disrupt not only one detail, but the work that follows. That is where my interest in engineering began: before finding a solution, you need to see the problem clearly.','Lesson: If the foundation is not strong, nothing stands on it—not only in a wall, but in life.'],['A DIFFICULT PERIOD','Learning without waiting for a paid course','Because of financial difficulties in my family, I left an IELTS course and prepared independently. I did not have ideal conditions: I had free Telegram materials, regular practice tests, and a commitment to use the resources available well.','Trees in our yard were even sold to cover the IELTS registration fee. This experience is very personal, but it helped me understand the value of knowledge differently.','Along this path, I achieved IELTS 7.0 and SAT 1420.','Lesson: With the right method and consistency, an expensive course is not the only path to opportunity.'],['KEEPING GOING','A gap year and work','During my 2025–2026 gap year, I worked loading and unloading goods to support my family. On some days, night and day shifts connected, and I had to continue with very little sleep.','That period was not easy. But it taught me that discipline is not waiting for motivation: you have to continue even when the result is not immediately visible.','Lesson: Difficult circumstances can change your plan, but they do not have to cancel your goal.'],['TURNING POINT','AI as a tool that frees up time','When I found free time, I independently learned BIM, Revit, AutoCAD, Digital Twin, Calculus I, and prompt engineering. Instead of repeatedly drawing a recurring AutoCAD detail by hand, I created an AutoLISP script with AI.','As a result, work that previously took two hours took 15 minutes. This showed me that AI should not replace human thinking; it should free time for more important checking, calculations, and decisions.','Lesson: Technology is not the goal. It is a tool that works alongside order, responsibility, and clear results.'],['SHARING KNOWLEDGE','Teaching experience','At Sydney School, I taught English, speaking, and IELTS/CEFR preparation to more than 40 students. Each student had different questions, pace, and difficulties.','To teach, you first need to understand something yourself, then communicate it to someone else simply and practically. Seeing students’ results change showed me how much responsibility comes with organizing knowledge.','Lesson: Knowledge becomes stronger when others can access and use it too.'],['TODAY','Why does Tayanch exist?','In my admission journey, I received 18 confirmed admission letters and more than $1.1M in total scholarship offers. But that journey showed me one thing: ability alone is not enough. Many people lack a system, a clear path, and confidence.','That is why I am creating AI, IELTS, and Admission courses at Tayanch. They are not designed to give ready-made answers, but to help learners understand their own problem, build a system, and choose their next step.','My long-term goal is to build an Engineering Academy that provides grant-based STEM education for talented young people with limited opportunities. Tayanch is a small but real beginning toward that larger goal.']],proof:['RESULTS ALONG THE WAY','Examples supported by documents','Only the necessary outcome indicators are shown here. Personal data, identifiers, and financial details have been redacted.','EXPERIENCE AND APPLICATION STORY','The cards below are not copies of the original pages: they have been recreated as generalized excerpts without confidential information.','confirmed admission letters','Below are six examples across different fields and countries. Each retains only the university, positive decision, program, and admission year.','The remaining 12 confirmed admission letters','Previews are for information only: they are not original documents and cannot be used for verification. Saving/downloading is not provided; please note that screenshots cannot be completely prevented.'],cta:['NEXT STEP','Your journey can start here too.','Identify which direction suits you best right now, and begin building a practical plan for yourself.','Start the course-selection quiz →']},
ru: {title:'Мой путь | Tayanch',description:'Честная история основателя Tayanch: самостоятельное обучение, путь к поступлению, преподавание и применение AI для решения практических задач.',eyebrow:'ИСТОРИЯ ОСНОВАТЕЛЯ',h1:'Мой путь',lead:'Это не реклама. Это честная история о том, через что я прошёл, чему научился и почему создаю Tayanch.',aria:'Краткое знакомство',quote:'«Семь раз отмерь, один раз отрежь».',intro:'Это правило я узнал от отца. Для меня оно не только о строительстве: оно о проверке решений, бережном отношении к ресурсам и работе без спешки.',steps:[['НАЧАЛЬНАЯ ТОЧКА','Строительство с отцом','Работая с отцом на строительстве, я познакомился с заливкой бетона, отделкой стен, укладкой плитки и расчётом материалов. Когда при ремонте нашей кухни я ошибся в измерении, отец проверил его ещё раз перед резкой.','Тогда я увидел, что одна ошибка может испортить не только одну деталь, но и последующую работу. Так начался мой интерес к инженерии: прежде чем найти решение, нужно ясно увидеть проблему.','Урок: если фундамент непрочен, на нём ничего не устоит — не только стена, но и жизнь.'],['ТРУДНЫЙ ПЕРИОД','Учёба без ожидания платного курса','Из-за финансовых трудностей в семье я ушёл с курса IELTS и готовился самостоятельно. У меня не было идеальных условий: были бесплатные материалы в Telegram, регулярные пробные тесты и умение правильно использовать имеющиеся ресурсы.','Чтобы покрыть регистрационный взнос за экзамен IELTS, пришлось продать даже деревья в нашем дворе. Этот опыт очень личный для меня, но именно он помог по-другому понять цену знаний.','На этом пути я получил IELTS 7.0 и SAT 1420.','Урок: при правильном методе и последовательности дорогой курс — не единственный путь к возможностям.'],['ПРОДОЛЖАТЬ','Gap year и работа','Во время gap year в 2025–2026 годах я работал на погрузке и разгрузке, чтобы поддерживать семью. В некоторые дни ночные и дневные смены шли подряд, и приходилось продолжать почти без сна.','Этот период был нелёгким. Но он научил меня, что дисциплина — это не ожидание мотивации: нужно продолжать, даже когда результат не виден сразу.','Урок: трудные обстоятельства могут изменить план, но не обязаны отменять цель.'],['ПОВОРОТНЫЙ МОМЕНТ','AI — инструмент, который освобождает время','Когда появлялось свободное время, я самостоятельно изучал BIM, Revit, AutoCAD, Digital Twin, Calculus I и prompt engineering. Вместо того чтобы вручную снова и снова выполнять повторяющуюся деталь чертежа в AutoCAD, я создал с помощью AI скрипт AutoLISP.','В результате работа, которая раньше занимала два часа, стала занимать 15 минут. Этот опыт показал мне, что AI должен не заменять человеческое мышление, а освобождать время для более важных проверок, расчётов и решений.','Урок: технология — не цель. Это инструмент, который работает вместе с порядком, ответственностью и ясным результатом.'],['ДЕЛИТЬСЯ ЗНАНИЯМИ','Опыт преподавания','В Sydney School я преподавал английский язык, speaking и подготовку к IELTS/CEFR более чем 40 ученикам. У каждого были свои вопросы, темп и трудности.','Чтобы обучать, сначала нужно самому понять, а затем просто и практично объяснить мысль другому. Наблюдая, как меняются результаты учеников, я почувствовал, насколько велика ответственность за систематизацию знаний.','Урок: знания становятся сильнее, когда другие тоже могут их открыть и использовать.'],['СЕГОДНЯ','Зачем существует Tayanch?','На моём пути поступления я получил 18 подтверждённых писем о зачислении и предложения стипендий на общую сумму более $1.1M. Но этот путь показал мне одно: одних способностей недостаточно. Многим не хватает системы, ясного пути и уверенности.','Поэтому я создаю в Tayanch курсы по AI, IELTS и Admission. Они созданы не для того, чтобы давать готовые ответы, а чтобы помочь ученику понять свою проблему, построить систему и выбрать следующий шаг.','Моя долгосрочная цель — создать Инженерную академию, которая будет давать STEM-образование на грантовой основе талантливой молодёжи с ограниченными возможностями. Tayanch — небольшое, но реальное начало на пути к этой большой цели.']],proof:['РЕЗУЛЬТАТЫ НА МОЁМ ПУТИ','Примеры, подтверждённые документами','Здесь оставлены только необходимые показатели результатов. Личные данные, идентификаторы и финансовые детали скрыты.','ОПЫТ И ИСТОРИЯ ЗАЯВКИ','Карточки ниже — не копии оригинальных страниц: они заново составлены как обобщённые отрывки без конфиденциальных данных.','подтверждённых писем о зачислении','Ниже приведены шесть примеров по разным направлениям и странам. В каждом оставлены только университет, положительное решение, программа и год поступления.','Оставшиеся 12 подтверждённых писем о зачислении','Превью приведены только для информации: это не оригинальные документы и они не пригодны для верификации. Функции сохранения/скачивания не предусмотрены; помните, что полностью предотвратить создание скриншотов невозможно.'],cta:['СЛЕДУЮЩИЙ ШАГ','Ваш путь тоже может начаться здесь.','Определите, какое направление вам сейчас подходит больше, и начните составлять практический план для себя.','Начать тест по выбору курса →']}
}[lang];
const proofImages = [
['cv-project-leadership-preview.webp','CV excerpt · self-reported background'],['essay-learning-excerpt.webp','Personal essay · learning reflection'],['essay-gap-year-excerpt.webp','Personal essay · gap-year reflection'],['ielts-score-preview.webp','IELTS Academic · Overall 7.0'],['sat-score-preview.webp','SAT · Total score 1420'],['purdue-university.webp','Purdue University · Fall 2026'],['university-of-birmingham.webp','University of Birmingham · Conditional offer'],['university-of-oregon.webp','University of Oregon · Fall 2026'],['university-of-alberta.webp','University of Alberta · Unconditional admission'],['university-of-victoria.webp','University of Victoria · Letter of acceptance'],['miami-university.webp','Miami University · Fall 2026']];
const additional = 'ASU London · Hope College · Illinois College · Kent State University · Le Moyne College · Missouri University of Science and Technology · University of Cincinnati · University of Delaware · University of New Haven · University of Southern Mississippi · University of Oklahoma · Western New England University';
---
<Base title={story.title} description={story.description} lang={lang} localeAlternates={alternates}>
<LearningJourneyPlan lang={lang} />
<section class="hero-j"><span class="eyebrow">{story.eyebrow}</span><h1>{story.h1}</h1><p class="lead">{story.lead}</p></section>
<section class="story-intro" aria-label={story.aria}><p class="story-quote">{story.quote}</p><p>{story.intro}</p></section>
<div class="journey">{story.steps.map((step, i) => <article class="step"><div class="step-no">{String(i + 1).padStart(2, '0')}</div><div class="step-body"><p class="step-kicker">{step[0]}</p><h2>{step[1]}</h2>{step.slice(2, -1).map((paragraph) => <p>{paragraph}</p>)}<p class="lesson"><b>{step[step.length - 1].split(':')[0]}:</b>{step[step.length - 1].slice(step[step.length - 1].indexOf(':') + 1)}</p></div></article>)}</div>
<section class="proof-section" aria-labelledby="proof-title"><div class="proof-heading"><p class="step-kicker">{story.proof[0]}</p><h2 id="proof-title">{story.proof[1]}</h2><p>{story.proof[2]}</p></div><div class="excerpt-intro"><p class="excerpt-label">{story.proof[3]}</p><p>{story.proof[4]}</p></div><div class="excerpt-grid">{proofImages.slice(0,3).map(([file,caption]) => <figure class="proof-card"><img class="proof-image" src={base + 'proof/mening-yolim/' + file} alt={caption} loading="lazy" decoding="async" draggable="false"/><figcaption>{caption}</figcaption></figure>)}</div><div class="score-proof-grid">{proofImages.slice(3,5).map(([file,caption]) => <figure class="proof-card score-proof"><img class="proof-image" src={base + 'proof/mening-yolim/' + file} alt={caption} loading="lazy" decoding="async" draggable="false"/><figcaption>{caption}</figcaption></figure>)}</div><div class="acceptance-intro"><div><span class="proof-count">18</span><span>{story.proof[5]}</span></div><p>{story.proof[6]}</p></div><div class="acceptance-grid">{proofImages.slice(5).map(([file,caption]) => <figure class="proof-card"><img class="proof-image" src={base + 'proof/mening-yolim/' + file} alt={caption} loading="lazy" decoding="async" draggable="false"/><figcaption>{caption}</figcaption></figure>)}</div><details class="more-acceptances"><summary>{story.proof[7]}</summary><p>{additional}</p></details><p class="proof-note">{story.proof[8]}</p></section>
<section class="story-cta"><p class="story-cta-kicker">{story.cta[0]}</p><h2>{story.cta[1]}</h2><p>{story.cta[2]}</p><a class="start-btn" href={base + 'kurs-tanlash/'}>{story.cta[3]}</a></section>
<script>document.querySelectorAll('.proof-image').forEach((image) => { image.addEventListener('contextmenu', (event) => event.preventDefault()); image.addEventListener('dragstart', (event) => event.preventDefault()); });</script>
</Base>
<style>.hero-j{text-align:center;padding:64px 20px 24px}.hero-j .eyebrow,.step-kicker,.story-cta-kicker{display:inline-block;margin:0 0 .6rem;color:var(--accent);font-size:.78rem;letter-spacing:.12em;font-weight:800}.hero-j h1{margin:0 0 .9rem;font-size:clamp(2.2rem,5vw,3.6rem);letter-spacing:-.035em}.hero-j .lead{max-width:720px;margin:0 auto;color:var(--muted);font-size:1.08rem;line-height:1.7}.story-intro{max-width:760px;margin:1.6rem auto 0;padding:1.5rem 1.7rem;border-left:3px solid var(--accent);background:var(--accent-soft);border-radius:0 14px 14px 0}.story-intro p{margin:.45rem 0 0;color:var(--text);line-height:1.7}.story-intro .story-quote{margin:0;color:var(--accent);font-size:1.25rem;font-weight:800}.journey{position:relative;max-width:820px;margin:3.2rem auto 0;padding:0 20px}.journey::before{content:"";position:absolute;left:46px;top:20px;bottom:44px;width:1px;background:var(--border)}.step{position:relative;display:grid;grid-template-columns:54px 1fr;gap:22px;margin:0 0 2.2rem}.step-no{position:relative;z-index:1;width:54px;height:54px;display:grid;place-items:center;border:1px solid color-mix(in srgb,var(--accent) 60%,var(--border));border-radius:50%;background:var(--surface);color:var(--accent);font-size:.82rem;font-weight:800}.step-body{padding:1.55rem 1.65rem;border:1px solid var(--border);border-radius:16px;background:var(--surface);box-shadow:var(--shadow)}.step-body h2{margin:0 0 .75rem;font-size:1.38rem;letter-spacing:-.015em}.step-body p{margin:.65rem 0;color:var(--muted);line-height:1.75}.step-body .step-kicker{margin:0 0 .35rem}.step-body .lesson{margin:1rem 0 0;padding:.9rem 1rem;border-radius:10px;background:var(--accent-soft);color:var(--text)}.proof-section{max-width:820px;margin:1rem auto 3rem;padding:2.25rem;border:1px solid color-mix(in srgb,var(--accent) 45%,var(--border));border-radius:20px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 10%,var(--surface)),var(--surface))}.proof-heading{max-width:650px}.proof-hea
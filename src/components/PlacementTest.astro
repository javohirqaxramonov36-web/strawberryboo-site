---
import {
  placementQuestions,
  type PlacementLevel,
} from '../data/placement-test';

interface Props {
  lang?: 'uz' | 'ru' | 'en';
}

const { lang = 'uz' } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const copy = {
  uz: {
    eyebrow: 'GENERAL ENGLISH · CEFR',
    title: 'Ingliz tili darajangizni aniqlang',
    intro: 'Savollarga javob bering — natijada sizga mos CEFR darajasi va General English kursi tavsiya qilinadi.',
    question: 'Savol',
    choose: 'Variantlardan birini tanlang.',
    next: 'Javobni tekshirish →',
    missing: 'Davom etish uchun variant tanlang.',
    result: 'Sizning darajangiz',
    score: 'Natija',
    recommended: 'Tavsiya etilgan kurs',
    openCourse: 'Kursni ko‘rish →',
    restart: 'Testni qayta boshlash',
    note: 'Test mexanizmi hozircha placeholder savollar bilan ishlaydi. To‘liq savollar keyin JSON fayllarga kiritiladi.',
  },
  ru: {
    eyebrow: 'GENERAL ENGLISH · CEFR',
    title: 'Определите свой уровень английского',
    intro: 'Ответьте на вопросы — мы покажем уровень CEFR и рекомендуемый курс General English.',
    question: 'Вопрос',
    choose: 'Выберите один вариант.',
    next: 'Проверить ответ →',
    missing: 'Выберите вариант, чтобы продолжить.',
    result: 'Ваш уровень',
    score: 'Результат',
    recommended: 'Рекомендуемый курс',
    openCourse: 'Открыть курс →',
    restart: 'Начать тест заново',
    note: 'Механизм теста пока работает с placeholder-вопросами. Полный список будет добавлен в JSON-файлы позже.',
  },
  en: {
    eyebrow: 'GENERAL ENGLISH · CEFR',
    title: 'Check your English level',
    intro: 'Answer the questions to see your CEFR level and a recommended General English course.',
    question: 'Question',
    choose: 'Choose one option.',
    next: 'Check answer →',
    missing: 'Choose an option to continue.',
    result: 'Your level',
    score: 'Result',
    recommended: 'Recommended course',
    openCourse: 'View course →',
    restart: 'Restart test',
    note: 'The test mechanism currently uses placeholder questions. The full question set will be added to the JSON files later.',
  },
}[lang];

const courseTitles: Record<'uz' | 'ru' | 'en', Record<PlacementLevel, string>> = {
  uz: {
    A1: 'General English — Beginner (A1)',
    A2: 'General English — Elementary (A2)',
    B1: 'General English — Intermediate (B1)',
    B2: 'General English — Upper-Intermediate (B2)',
    C1: 'General English — Advanced (C1)',
  },
  ru: {
    A1: 'General English — Beginner (A1)',
    A2: 'General English — Elementary (A2)',
    B1: 'General English — Intermediate (B1)',
    B2: 'General English — Upper-Intermediate (B2)',
    C1: 'General English — Advanced (C1)',
  },
  en: {
    A1: 'General English — Beginner (A1)',
    A2: 'General English — Elementary (A2)',
    B1: 'General English — Intermediate (B1)',
    B2: 'General English — Upper-Intermediate (B2)',
    C1: 'General English — Advanced (C1)',
  },
};

const courseSlug: Record<PlacementLevel, string> = {
  A1: 'general-english-beginner',
  A2: 'general-english-elementary',
  B1: 'general-english-intermediate',
  B2: 'general-english-upper-intermediate',
  C1: 'general-english-advanced',
};

const prefix = lang === 'uz' ? '' : `${lang}/`;
const config = {
  questions: placementQuestions,
  copy,
  recommendations: Object.fromEntries(
    (['A1', 'A2', 'B1', 'B2', 'C1'] as PlacementLevel[]).map((level) => [level, {
      title: courseTitles[lang][level],
      url: `${base}${prefix}kurslar/${courseSlug[level]}/`,
    }])
  ),
};
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<section class="placement-test" data-placement-test>
  <div class="placement-test__head">
    <p class="placement-test__eyebrow">{copy.eyebrow}</p>
    <h2>{copy.title}</h2>
    <p class="placement-test__intro">{copy.intro}</p>
  </div>

  <div class="placement-test__progress" data-placement-progress aria-live="polite"></div>
  <div class="placement-test__question" data-placement-question></div>
  <div class="placement-test__options" data-placement-options></div>
  <p class="placement-test__hint" data-placement-hint hidden></p>
  <button type="button" class="placement-test__next" data-placement-next>{copy.next}</button>
  <div class="placement-test__result" data-placement-result hidden></div>
  <p class="placement-test__note">{copy.note}</p>
  <script type="application/json" data-placement-config set:html={configJson}></script>
</section>

<script>
  import { assessPlacement, selectNextPlacementQuestion } from '../lib/placement-test';

  document.querySelectorAll('[data-placement-test]').forEach((root) => {
    const configNode = root.querySelector('[data-placement-config]');
    const config = JSON.parse(configNode?.textContent || '{}');
    const progress = root.querySelector('[data-placement-progress]');
    const questionNode = root.querySelector('[data-placement-question]');
    const optionsNode = root.querySelector('[data-placement-options]');
    const hint = root.querySelector('[data-placement-hint]');
    const next = root.querySelector('[data-placement-next]');
    const resultNode = root.querySelector('[data-placement-result]');
    const allQuestions = config.questions || [];
    const state = { answers: [], current: allQuestions.find((question) => question.level === 'A1') };

    const saveResult = (result) => {
      try {
        localStorage.setItem('tayanch.placement-test.v1', JSON.stringify({ ...result, date: new Date().toISOString() }));
      } catch {}
    };

    const renderQuestion = () => {
      if (!state.current) {
        finish();
        return;
      }
      progress.textContent = `${config.copy.question} ${state.answers.length + 1}`;
      questionNode.textContent = state.current.question;
      optionsNode.replaceChildren(...state.current.options.map((option) => {
        const label = document.createElement('label');
        label.className = 'placement-test__option';
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = `placement-${state.current.id}`;
        input.value = option.id;
        const text = document.createElement('span');
        text.textContent = option.text;
        label.append(input, text);
        return label;
      }));
      hint.hidden = true;
      next.hidden = false;
      resultNode.hidden = true;
    };

    const finish = () => {
      const result = assessPlacement(state.answers);
      const recommendation = config.recommendations[result.level];
      progress.textContent = '';
      questionNode.textContent = '';
      optionsNode.replaceChildren();
      next.hidden = true;
      hint.hidden = true;
      resultNode.replaceChildren();
      const title = document.createElement('p');
      title.className = 'placement-test__result-label';
      title.textContent = config.copy.result;
      const level = document.createElement('strong');
      level.className = 'placement-test__result-level';
      level.textContent = result.level;
      const score = document.createElement('p');
      score.textContent = `${config.copy.score}: ${result.correctCount}/${result.total} (${result.percentage}%)`;
      const recommended = document.createElement('p');
      recommended.className = 'placement-test__recommendation-label';
      recommended.textContent = config.copy.recommended;
      const link = document.createElement('a');
      link.href = recommendation?.url || '#';
      link.textContent = recommendation?.title ? `${recommendation.title} — ${config.copy.openCourse}` : config.copy.openCourse;
      link.className = 'placement-test__course-link';
      const restart = document.createElement('button');
      restart.type = 'button';
      restart.className = 'placement-test__restart';
      restart.textContent = config.copy.restart;
      restart.addEventListener('click', () => {
        state.answers = [];
        state.current = allQuestions.find((question) => question.level === 'A1');
        renderQuestion();
      });
      resultNode.append(title, level, score, recommended, link, restart);
      resultNode.hidden = false;
      saveResult(result);
    };

    next.addEventListener('click', () => {
      const selected = root.querySelector(`input[name="placement-${state.current?.id}"]:checked`);
      if (!selected) {
        hint.textContent = config.copy.missing;
        hint.hidden = false;
        return;
      }
      const wasCorrect = selected.value === state.current.correctOption;
      state.answers.push({ id: state.current.id, level: state.current.level, correct: wasCorrect });
      state.current = selectNextPlacementQuestion(allQuestions, state.answers, state.current.level, wasCorrect);
      renderQuestion();
    });

    renderQuestion();
  });
</script>

<style>
  .placement-test{max-width:900px;margin:1.5rem auto;padding:clamp(1.2rem,3vw,1.8rem);border:1px solid color-mix(in srgb,#22c55e 42%,var(--border));border-radius:18px;background:radial-gradient(circle at 92% 8%,color-mix(in srgb,#22c55e 14%,transparent),transparent 25%),var(--surface)}
  .placement-test__eyebrow{margin:0 0 .3rem;color:#34d399;font-size:.73rem;font-weight:800;letter-spacing:.12em}
  .placement-test h2{margin:0;font-size:1.45rem}
  .placement-test__intro,.placement-test__note{color:var(--muted);line-height:1.55;font-size:.92rem}
  .placement-test__progress{margin:1.1rem 0 .65rem;color:#34d399;font-size:.8rem;font-weight:800;letter-spacing:.08em}
  .placement-test__question{margin:.4rem 0 .75rem;font-weight:800;line-height:1.5}
  .placement-test__options{display:grid;gap:.55rem}
  .placement-test__option{display:flex;align-items:center;gap:.6rem;padding:.75rem .85rem;border:1px solid var(--border);border-radius:11px;cursor:pointer;transition:border-color .18s,background .18s}
  .placement-test__option:hover{border-color:#34d399;background:color-mix(in srgb,#34d399 8%,transparent)}
  .placement-test__option input{accent-color:#22c55e}
  .placement-test__next,.placement-test__restart{margin-top:1rem;padding:.75rem 1rem;border:0;border-radius:10px;background:var(--btn-bg);color:#fff;font:700 .9rem inherit;cursor:pointer}
  .placement-test__hint{color:#fca5a5;font-size:.88rem}
  .placement-test__result{margin-top:1rem;padding:1rem;border:1px solid color-mix(in srgb,#34d399 45%,var(--border));border-radius:13px;background:color-mix(in srgb,#34d399 9%,var(--surface))}
  .placement-test__result-label,.placement-test__recommendation-label{margin:.1rem 0 .25rem;color:var(--muted);font-size:.88rem}
  .placement-test__result-level{display:block;margin-bottom:.45rem;color:#34d399;font-size:2rem}
  .placement-test__course-link{display:block;margin:.5rem 0;color:var(--accent);font-weight:800}
  .placement-test__restart{background:transparent;border:1px solid var(--border);color:var(--text)}
  @media (prefers-reduced-motion: reduce){.placement-test__option{transition:none}}
</style>

---
import PaymentJourney from './PaymentJourney.astro';

interface Props {
  course: string;
  price: string;
  lang?: 'uz' | 'ru' | 'en';
}

const { course, price } = Astro.props;
const path = Astro.url.pathname;
const lang = Astro.props.lang ?? (path.includes('/ru/') ? 'ru' : path.includes('/en/') ? 'en' : 'uz');
const modalId = `payment-${course.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const copy = {
  uz: { label: `${course} uchun to‘lov ma’lumoti`, eyebrow: 'TO‘LOV', title: `${course} kursini olish`, price: 'Narx:', lead: 'To‘lov Telegram orqali qo‘lda tasdiqlanadi.', open: 'To‘lov tartibini ko‘rish →', close: 'Yopish' },
  ru: { label: `Оплата курса ${course}`, eyebrow: 'ОПЛАТА', title: `Получить курс ${course}`, price: 'Цена:', lead: 'Оплата подтверждается вручную через Telegram.', open: 'Посмотреть порядок оплаты →', close: 'Закрыть' },
  en: { label: `Payment information for ${course}`, eyebrow: 'PAYMENT', title: `Get the ${course} course`, price: 'Price:', lead: 'Payment is manually confirmed through Telegram.', open: 'View payment steps →', close: 'Close' },
} as const;
const t = copy[lang];
---

<section class="payment-instructions" aria-label={t.label}>
  <div>
    <p class="payment-eyebrow">{t.eyebrow}</p>
    <h2>{t.title}</h2>
    <p class="payment-copy">{t.price} <strong>{price}</strong>. {t.lead}</p>
  </div>
  <button type="button" class="payment-open" data-payment-open={modalId}>{t.open}</button>
</section>

<dialog class="payment-dialog" id={modalId} aria-labelledby={`${modalId}-title`}>
  <div class="payment-dialog-inner">
    <button type="button" class="payment-close" data-payment-close aria-label={t.close}>×</button>
    <p class="payment-eyebrow">{t.eyebrow}</p>
    <h2 id={`${modalId}-title`}>{course}</h2>
    <p class="payment-dialog-price">{price}</p>
    <PaymentJourney lang={lang} course={course} compact />
  </div>
</dialog>

<script>
  document.querySelectorAll('[data-payment-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.getAttribute('data-payment-open');
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });
  document.querySelectorAll('.payment-dialog').forEach((dialog) => {
    dialog.querySelector('[data-payment-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .payment-instructions{display:flex;justify-content:space-between;align-items:center;gap:1.25rem;margin:2.5rem 0;padding:1.35rem 1.5rem;border:1px solid color-mix(in srgb,var(--accent) 38%,var(--border));border-radius:16px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 14%,var(--surface)),var(--surface))}.payment-eyebrow{margin:0 0 .35rem;color:var(--accent);font-size:.76rem;font-weight:800;letter-spacing:.12em}.payment-instructions h2,.payment-dialog h2{margin:0;font-size:1.25rem}.payment-copy{margin:.45rem 0 0;color:var(--muted)}.payment-open{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:10px;padding:.75rem 1rem;background: var(--btn-bg);color:#fff;font:700 .95rem var(--font-display,inherit);text-decoration:none;cursor:pointer;white-space:nowrap}.payment-open:hover{background:var(--accent-2);color:#fff}.payment-dialog{max-width:min(620px,calc(100vw - 32px));border:1px solid var(--border);border-radius:18px;padding:0;background:var(--surface);color:var(--text);box-shadow:0 20px 60px rgba(0,0,0,.45)}.payment-dialog::backdrop{background:rgba(8,9,14,.72);backdrop-filter:blur(3px)}.payment-dialog-inner{position:relative;padding:1.6rem}.payment-close{position:absolute;right:1rem;top:.9rem;border:0;background:transparent;color:var(--muted);font-size:1.7rem;line-height:1;cursor:pointer}.payment-dialog-price{margin:.5rem 0 1rem;color:var(--accent);font-weight:800;font-size:1.08rem}@media(max-width:600px){.payment-instructions{align-items:flex-start;flex-direction:column}.payment-open{width:100%}.payment-dialog-inner{padding:1.25rem}}
</style>

---
// Backward-compatible course hook. It deliberately emits no markup while the
// approved review source is empty, so course pages never show fake or blank cards.
import Testimonials from './Testimonials.astro';
const { courseSlug, lang = 'uz' } = Astro.props as { courseSlug?: string; lang?: 'uz' | 'ru' | 'en' };
---
<Testimonials courseSlug={courseSlug} lang={lang} />

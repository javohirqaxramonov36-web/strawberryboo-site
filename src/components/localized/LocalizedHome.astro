---
import { totalCourseCount } from '../../config/course-catalog';
import InstructorMiniBlock from '../InstructorMiniBlock.astro';
import CourseCard from '../CourseCard.astro';
import coursesData from '../../data/courses.json';
const courses = coursesData.courses as any[];
const { lang } = Astro.props as { lang: 'ru' | 'en' };
const base = import.meta.env.BASE_URL;
const p = lang === 'ru' ? {
  eyebrow:'Курсы AI · IELTS · поступления', count:`${totalCourseCount} курса`, free:'Есть и бесплатные', language:'На русском языке', access:'Навсегда', learn:'Учитесь:', typed:'Качественные ответы от AI за 5 минут', lead:'Освойте новый навык уже сегодня. Зачем нужен искусственный интеллект, какую пользу он даёт и где его применять — всё в практических курсах.', quiz:'Какой курс мне подойдёт?', why:'ПОЧЕМУ TAYANCH?', founder:'Почему я создал эти курсы', founderText:'Из-за финансовых трудностей я готовился к IELTS самостоятельно. Я получил IELTS 7.0 и SAT 1420 — теперь в Tayanch делюсь знаниями через понятный маршрут и практические шаги.', more:'Подробнее →', popular:'Самый популярный', agent:'Создайте собственного AI-помощника', agentDesc:'Обычный AI отвечает на один вопрос. Агент сам планирует задачу, ищет информацию и оформляет результат. С CrewAI и LangGraph вы создадите собственного агента. Для тех, кто уже знаком с AI и хочет применять его в реальной работе.', courses:'Наши курсы', all:'Смотреть все', prompt:'Качественные ответы от AI за 5 минут', promptDesc:'Научитесь получать от ChatGPT точные, структурированные и применимые результаты — сократите час работы до пяти минут. Для писателей, студентов, маркетологов и всех, кто хочет быстрее работать с AI.', obs:'База знаний, в которой прочитанное остаётся с вами', obsDesc:'Постройте систему, которая автоматически упорядочивает мысли, статьи и уроки и находит их, когда нужно. Для студентов и специалистов, которые много читают, но хотят лучше сохранять знания.', cert:'С сертификатом', enroll:'Записаться на курс →', build:'Создать базу знаний →', footer:'Не знаете, какой курс выбрать?', footerLink:'Пройти тест выбора курса →', trust:'Прозрачная информация о сертификатах →'
} : {
  eyebrow:'AI · IELTS · Admission courses', count:`${totalCourseCount} courses`, free:'Free courses included', language:'In English', access:'Lifetime access', learn:'Learn:', typed:'Get a quality AI answer in 5 minutes', lead:'Build a new skill today. What artificial intelligence is for, how it helps, and where to apply it — all through practical courses.', quiz:'Which course suits me?', why:'WHY TAYANCH?', founder:'Why I created these courses', founderText:'Because of financial constraints, I prepared for IELTS independently. I reached IELTS 7.0 and SAT 1420 — now I share that knowledge at Tayanch through a clear path and practical steps.', more:'Read more →', popular:'Most popular', agent:'Build your own AI assistant', agentDesc:'A regular AI answers one question. An agent plans the task, researches it and writes the result itself. With CrewAI and LangGraph, you will build your own agent. For people familiar with AI who want to use it in real work.', courses:'Our courses', all:'View all', prompt:'Get a quality AI answer in 5 minutes', promptDesc:'Learn to get precise, structured and usable results from ChatGPT — turn an hour of work into five minutes. For writers, students, marketers and anyone who wants to work with AI faster.', obs:'A knowledge base that helps you remember what you learn', obsDesc:'Build a system that automatically organizes daily thoughts, articles and lessons and finds them when needed. For students and professionals who read a lot but want to retain it.', cert:'With certificate', enroll:'Enroll in course →', build:'Build a knowledge base →', footer:'Not sure which course you need?', footerLink:'Take the course selection test →', trust:'Transparent certificate information →'
};
const prefix = `${base}${lang}/`;
---
<section class="hero">
  <span class="eyebrow">{p.eyebrow}</span>
  <div class="hero-badges"><span class="hero-badge">{p.count}</span><span class="hero-badge">{p.free}</span><span class="hero-badge">{p.language}</span><span class="hero-badge">{p.access}</span></div>
  <h1 class="hero-typed"><span class="typed-static">{p.learn}</span> <span class="typed-line"><span class="typed-text">{p.typed}</span></span></h1>
  <p class="lead">{p.lead}</p><div class="hero-actions"><a class="hero-cta primary" href={prefix + 'kurs-tanlash/'}>{p.quiz}</a></div>
</section>
<section class="founder-excerpt"><div><p class="eyebrow">{p.why}</p><h2>{p.founder}</h2></div><div><p>{p.founderText}</p><a class="course-nav-link" href={prefix + (lang === 'ru' ? 'moy-put/' : 'my-journey/')}>{p.more}</a></div></section>
<InstructorMiniBlock lang={lang} journeyHref={prefix + (lang === 'ru' ? 'moy-put/' : 'my-journey/')} />
<section class="spotlight"><div><span class="badge badge-hot">{p.popular}</span><h2>{p.agent}</h2><p>{p.agentDesc}</p><div class="spot-price">$39 <span class="uzs">≈ 490 000 so'm</span></div><a href={prefix + 'kurslar/ai-agentlar'} class="course-nav-link">{p.more}</a></div></section>
<section><div class="sec-head"><h2 class="sec-title">{p.courses}</h2><a class="sec-all" href={prefix + 'kurslar/'}>{p.all} <b>{totalCourseCount}</b> →</a></div><div class="features">
  {['prompt-engineering','obsidian'].map((s:string)=><CourseCard course={courses.find((c:any)=>c.slug===s)!} lang={lang} />)}
</div></section>
<p class="quiz-hint"><a href={prefix + 'sertifikat/'} style="color:var(--accent)">{p.trust}</a></p>
<p class="quiz-hint">{p.footer} <a href={prefix + 'kurs-tanlash/'} style="color:var(--accent)">{p.footerLink}</a></p>

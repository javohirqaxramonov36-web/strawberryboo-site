---
import { generalEnglishCourses } from '../../data/general-english-courses';
import { satCourses } from '../../data/sat-courses';
const { lang } = Astro.props as { lang: 'ru' | 'en' };
const base = import.meta.env.BASE_URL;
const t = lang === 'ru' ? { h1:'Курсы', all:'Все', ai:'AI', ielts:'IELTS', ge:'General English', admission:'Поступление', sat:'SAT', design:'Дизайн', life:'Жизненные навыки', free:'Бесплатные', data:'Data', dev:'Разработка', popular:'Популярный', new:'Новый', cert:'С сертификатом', details:'Подробнее →', soon:'Скоро', price:'Цена уточняется', ieltsTitle:'IELTS 6.5+: план на 30 дней', ieltsDesc:'Отдельный курс для каждого навыка и 30-дневный план speaking — двигайтесь к нужному баллу.', bundle:'Получить пакет →', upcoming:'СКОРО', preparing:'Материалы готовятся', preparingDesc:'Мы работаем над этими курсами. Полные материалы и продажи будут объявлены после готовности.', noPrice:'Цена и программа будут объявлены скоро', disabled:'Готовится', progress:'Прогресс', start:'Начать →' } : { h1:'Courses', all:'All', ai:'AI', ielts:'IELTS', ge:'General English', admission:'Admission', sat:'SAT', design:'Design', life:'Life skills', free:'Free', data:'Data', dev:'Development', popular:'Popular', new:'New', cert:'With certificate', details:'View details →', soon:'Coming soon', price:'Price to be announced', ieltsTitle:'IELTS 6.5+: 30-day plan', ieltsDesc:'A separate course for each skill, plus a 30-day speaking plan — work toward the band you need.', bundle:'Get the bundle →', upcoming:'UPCOMING COURSES', preparing:'Materials are being prepared', preparingDesc:'We are working on these courses. Full materials and sales will be announced when they are ready.', noPrice:'Price and syllabus will be announced soon', disabled:'In preparation', progress:'Progress', start:'Start →' };
const tr = lang === 'ru' ? [
 ['prompt-engineering','Качественные ответы от AI за 5 минут','Learn to get precise, structured and usable results from ChatGPT — turn an hour of work into five minutes.'],['obsidian','База знаний, в которой прочитанное остаётся с вами','Создайте систему для автоматического порядка в мыслях, статьях и уроках.'],['ai-agentlar','Создайте собственного AI-помощника','С CrewAI и LangGraph создайте агента для исследований, контента и автоматизации.'],['admission-process','Поступление за рубеж: от документов до интервью','Пройдите путь от заявки до эссе и интервью шаг за шагом.'],['tekin-ai','Используйте AI без платной подписки','Изучите бесплатные AI-инструменты и агентов, работающих на вашем компьютере.'],['mac-tezlik-sirlari','Работайте на Mac в два раза быстрее','С Raycast и сочетаниями клавиш сократите час работы до получаса.'],['figma','Бесплатный Figma: основы UI/UX за 1 день','Бесплатно изучите интерфейсы, компоненты и прототипы.'],['autocad-on-mac','Чертежи на Mac: бесплатная студенческая лицензия','Научитесь устанавливать AutoCAD, чертить и готовить первый чертёж.'],['chet-elda-oqish','Зачем учиться за рубежом (и как сделать это бесплатно)','Узнайте 5 преимуществ учёбы за рубежом и пути к бесплатным грантам.'],['data-analytics','Data Analytics — анализ данных','От Excel до SQL и Python: работа с данными и принятие решений.'],['backend-python','Backend Development — Python','Создавайте серверные приложения с Python, FastAPI и базами данных.']
] : [
 ['prompt-engineering','Get a quality AI answer in 5 minutes','Learn to get precise, structured and usable results from ChatGPT — turn an hour of work into five minutes.'],['obsidian','A knowledge base that helps you remember what you learn','Build a system that automatically organizes daily thoughts, articles and lessons.'],['ai-agentlar','Build your own AI assistant','Build an agent for research, content and automation with CrewAI and LangGraph.'],['admission-process','Study abroad admission: from documents to interview','Follow the path from application to essay and interview step by step.'],['tekin-ai','Use AI without a paid subscription','Explore free AI tools and agents that run on your computer.'],['mac-tezlik-sirlari','Work twice as fast on a Mac','Use Raycast and shortcuts to turn an hour of work into half an hour.'],['figma','Free Figma: UI/UX fundamentals in one day','Learn interface design, components and prototypes for free.'],['autocad-on-mac','Drafting on a Mac: a free student licence','Learn to install AutoCAD, draw and prepare your first technical drawing.'],['chet-elda-oqish','Why study abroad (and how to do it for free)','Learn five benefits of studying abroad and routes to free grants.'],['data-analytics','Data Analytics','From Excel to SQL and Python: work with data and make decisions.'],['backend-python','Backend Development — Python','Build server-side applications with Python, FastAPI and databases.']
];
const cats: Record<string,string>={ 'prompt-engineering':'ai','obsidian':'ai','ai-agentlar':'ai','admission-process':'admission','tekin-ai':'ai','mac-tezlik-sirlari':'hayotiy','figma':'bepul dizayn','autocad-on-mac':'dizayn','chet-elda-oqish':'bepul admission','data-analytics':'data','backend-python':'dasturlash' };
const colors=['#7d7df5','#34d399','#ef4444','#8b5cf6','#7d7df5','#3b82f6','#f59e0b','#f97316','#14b8a6','#0ea5e9','#10b981'];
const prefix = `${base}${lang}/`;
const geCopy: Record<string, Record<'ru'|'en', string>> = {
  'general-english-beginner': { ru:'Освойте базовые английские фразы, простую грамматику и уверенное общение в ежедневных ситуациях.', en:'Build foundational English phrases, simple grammar and confidence for everyday situations.' },
  'general-english-elementary': { ru:'Расширьте повседневный словарь, закрепите базовую грамматику, чтение и короткие разговоры.', en:'Expand everyday vocabulary and strengthen basic grammar, reading and short conversations.' },
  'general-english-pre-intermediate': { ru:'Развивайте грамматику, более длинные разговоры, чтение и аудирование для учёбы и повседневной жизни.', en:'Develop grammar, longer conversations, reading and listening for study and daily life.' },
  'general-english-intermediate': { ru:'Уверенно общайтесь на знакомые темы, совершенствуйте грамматику, лексику, чтение и аудирование.', en:'Communicate confidently on familiar topics while improving grammar, vocabulary, reading and listening.' },
  'general-english-upper-intermediate': { ru:'Усильте сложную грамматику, аргументацию, общение для работы и учёбы, лексику и аудирование.', en:'Strengthen advanced grammar, argument-building, work and study communication, vocabulary and listening.' },
  'general-english-advanced': { ru:'Передавайте тонкие смыслы в профессиональных и академических ситуациях: сложная речь, презентации, лексика и продвинутое аудирование.', en:'Convey nuance in professional and academic settings through advanced speaking, presentations, vocabulary and listening.' }
};
const satCopy: Record<string, Record<'ru'|'en', string>> = {
  'sat-math': {ru:'Системно изучите алгебру, геометрию и статистику для SAT Math; практикуйте типы вопросов и стратегии решения.', en:'Systematically study algebra, geometry and statistics for SAT Math, with question-type practice and solving strategies.'},
  'sat-english': {ru:'Изучите понимание прочитанного, грамматику и стратегии письменных ответов для SAT Reading & Writing, включая определение типа вопроса и управление временем.', en:'Learn reading comprehension, grammar and written-response strategies for SAT Reading & Writing, including question identification and time management.'},
  'desmos-applications': {ru:'Научитесь эффективно использовать разрешённый на SAT графический калькулятор Desmos для функций, графиков и быстрых решений.', en:'Learn to use the SAT-permitted Desmos graphing calculator effectively for functions, graphs and faster solutions.'}
};
const geDescription=(course:any)=>geCopy[course.slug][lang];
const satDescription=(course:any)=>satCopy[course.slug][lang];
---
<h1>{t.h1}</h1><div class="course-filter" id="courseFilter">{[[ 'all',t.all],['ai',t.ai],['ielts',t.ielts],['general-english',t.ge],['admission',t.admission],['sat',t.sat],['dizayn',t.design],['hayotiy',t.life],['bepul',t.free],['data',t.data],['dasturlash',t.dev]].map(([id,label],i)=><button class:list={['cf-btn',{active:i===0}]} data-filter={id}>{label}</button>)}</div>
<div class="course-list">
{tr.map(([slug,title,description],i)=><div class="card" style={`--c:${colors[i]}`} data-cat={cats[slug]}><span class="badge">{i===0?t.popular:t.new}</span><h2>{title}</h2><span class="cat">{cats[slug].replace('hayotiy',t.life).replace('dasturlash',t.dev)}</span><span class="cert-line">{t.cert}</span><p>{description}</p><p class="price">{['$29','$19','$39','49 000 so\'mdan','$19','$15','$0','$29','$0',t.soon,t.soon][i]} <span class="uzs">{i>8?t.price:''}</span></p><a href={base + `kurslar/${slug}`} class="start-btn">{t.details}</a></div>)}
<section class="ielts-collection" data-cat="ielts"><div class="ielts-collection-head"><div><span class="badge badge-new">{t.new}</span><h2>{t.ieltsTitle}</h2><p>{t.ieltsDesc}</p></div><span class="collection-price">$7.50–$14.99 · ≈ 93 750–187 500 so'm</span></div><div class="ielts-course-grid">{[['ielts-listening','Listening',lang==='ru'?'Сигналы, числа, ед./мн. и упражнения с distractors.':'Signals, numbers, singular/plural and distractor exercises.','$7.50'],['ielts-reading','Reading',lang==='ru'?'Работайте со временем, типами вопросов и паттернами ошибок.':'Work on time, question types and error patterns.','$7.50'],['ielts-writing','Writing',lang==='ru'?'30 дней оценки Task 1/2 с AI.':'30-day Task 1/2 writing assessment with AI.','$14.99'],['ielts-speaking','Speaking',lang==='ru'?'30 дней практики произношения и speaking с AI.':'30-day pronunciation and speaking practice with AI.','$7.50'],['ielts-vocabulary','Vocabulary',lang==='ru'?'Системное запоминание слов с flashcards и Obsidian.':'Systematic vocabulary learning with flashcards and Obsidian.','Mini-course']].map(([slug,title,desc,price],i)=><a class="ielts-mini-card" href={base+`kurslar/${slug}`}><b>0{i+1}</b><h3>{title}</h3><p>{desc}</p><span>{price} →</span></a>)}</div><div class="ielts-bundle"><div><span>IELTS FULL BUNDLE</span><h3>{lang==='ru'?'Возьмите 4 курса вместе — сэкономьте 20%':'Get all 4 together — save 20%'}</h3><p><s>468 750 so'm</s> → <b>375 000 so'm</b></p></div><a class="start-btn" href={base+'bog-lanish?course=ielts-full-bundle&price=375000'}>{t.bundle}</a></div></section>
{generalEnglishCourses.map((course:any)=><div class="card general-english-card" style={`--c:${course.accent}`} data-cat="general-english"><span class="badge badge-new">{t.new}</span><h2>{course.title}</h2><span class="cat">{t.ge} · {course.cefr}</span><span class="cert-line">{t.cert}</span><p>{geDescription(course)}</p><p class="price">{t.soon} <span class="uzs">{t.price}</span></p><a href={base+`kurslar/${course.slug}`} class="start-btn">{t.details}</a></div>)}
{satCourses.map((course:any)=><div class="card sat-card" style={`--c:${course.accent}`} data-cat="sat admission"><span class="badge badge-new">{t.new}</span><h2>{course.title}</h2><span class="cat">SAT · {t.admission}</span><span class="cert-line">{t.cert}</span><p>{satDescription(course)}</p><p class="price">{t.soon} <span class="uzs">{t.price}</span></p><a href={base+`kurslar/${course.slug}`} class="start-btn">{t.details}</a></div>)}
</div>
<section class="upcoming-courses"><div class="upcoming-heading"><p class="eyebrow">{t.upcoming}</p><h2>{t.preparing}</h2><p>{t.preparingDesc}</p></div><div class="upcoming-grid">{[['Financial Literacy','Financial Literacy — '+(lang==='ru'?'финансовая грамотность':'financial literacy')],['El-Yurt Umidi',lang==='ru'?'Победим в El-Yurt Umidi':'Win El-Yurt Umidi'],['Computer Literacy','Computer Literacy — '+(lang==='ru'?'цифровая грамотность':'digital literacy')]].map(([id,title])=><div class="card" data-cat="hayotiy"><span class="badge badge-soon">{t.soon}</span><h2>{title}</h2><span class="cert-line">{t.cert}</span><p>{t.preparingDesc}</p><p class="upcoming-status">{t.noPrice}</p><span class="start-btn is-disabled">{t.disabled}</span></div>)}</div></section>
<style is:global>.course-filter{display:flex;flex-wrap:wrap;gap:8px;margin:1.2rem 0 .5rem}.cf-btn{font:700 13px var(--font-display);color:var(--muted);background:var(--surface);border:1px solid var(--border);border-radius:999px;padding:7px 14px;cursor:pointer}.cf-btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}.ielts-collection{grid-column:1/-1;border:1px solid var(--border);border-radius:18px;padding:clamp(1rem,3vw,1.5rem);background:linear-gradient(135deg,rgba(34,197,94,.08),var(--surface))}.ielts-collection-head,.ielts-bundle{display:flex;justify-content:space-between;gap:1rem;align-items:center}.ielts-course-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.7rem;margin:1rem 0}.ielts-mini-card{display:block;padding:1rem;border:1px solid var(--border);border-radius:13px;text-decoration:none;color:var(--text);background:var(--surface)}.ielts-mini-card p{color:var(--muted);font-size:.88rem}@media(max-width:780px){.ielts-course-grid{grid-template-columns:repeat(2,1fr)}.ielts-collection-head,.ielts-bundle{align-items:stretch;flex-direction:column}}</style>
<script>const filter=document.getElementById('courseFilter');if(filter){const cards=document.querySelectorAll('.course-list > [data-cat]');filter.addEventListener('click',(e)=>{const btn=(e.target as Element).closest('.cf-btn') as HTMLButtonElement|null;if(!btn)return;filter.querySelectorAll('.cf-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');const f=btn.dataset.filter;cards.forEach((card:any)=>{const cats=(card.dataset.cat||'').split(' ');card.style.display=f==='all'||cats.includes(f)?'':'none'})})}</script>

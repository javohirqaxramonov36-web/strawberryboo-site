---
import CourseCard from '../CourseCard.astro';
import WaitlistForm from '../WaitlistForm.astro';
import coursesData from '../../data/courses.json';
const { lang } = Astro.props as { lang: 'ru' | 'en' };
const base = import.meta.env.BASE_URL;
const t = lang === 'ru' ? { h1:'Курсы', all:'Все', ai:'AI', ielts:'IELTS', ge:'General English', admission:'Поступление', sat:'SAT', design:'Дизайн', life:'Жизненные навыки', free:'Бесплатные', data:'Data', dev:'Разработка', popular:'Популярный', new:'Новый', cert:'С сертификатом', details:'Подробнее →', soon:'Скоро', price:'Цена уточняется', ieltsTitle:'IELTS 6.5+: план на 30 дней', ieltsDesc:'Отдельный курс для каждого навыка и 30-дневный план speaking — двигайтесь к нужному баллу.', bundle:'Получить пакет →', upcoming:'СКОРО', preparing:'Материалы готовятся', preparingDesc:'Мы работаем над этими курсами. Полные материалы и продажи будут объявлены после готовности.', noPrice:'Цена и программа будут объявлены скоро', disabled:'Готовится', progress:'Прогресс', start:'Начать →' } : { h1:'Courses', all:'All', ai:'AI', ielts:'IELTS', ge:'General English', admission:'Admission', sat:'SAT', design:'Design', life:'Life skills', free:'Free', data:'Data', dev:'Development', popular:'Popular', new:'New', cert:'With certificate', details:'View details →', soon:'Coming soon', price:'Price to be announced', ieltsTitle:'IELTS 6.5+: 30-day plan', ieltsDesc:'A separate course for each skill, plus a 30-day speaking plan — work toward the band you need.', bundle:'Get the bundle →', upcoming:'UPCOMING COURSES', preparing:'Materials are being prepared', preparingDesc:'We are working on these courses. Full materials and sales will be announced when they are ready.', noPrice:'Price and syllabus will be announced soon', disabled:'In preparation', progress:'Progress', start:'Start →' };
const courses = coursesData.courses as any[];
const collegeSlugs = ['general-english-beginner','general-english-elementary','general-english-pre-intermediate','general-english-intermediate','general-english-upper-intermediate','general-english-advanced','sat-math','sat-english','desmos-applications'];
const topStandard = courses.filter(c => c.type === 'standard' && !collegeSlugs.includes(c.slug));
const restStandard = courses.filter(c => c.type === 'standard' && collegeSlugs.includes(c.slug));
const miniCourses = courses.filter(c => c.type === 'ielts-mini');
const bundle = courses.find(c => c.type === 'bundle');
const comingSoon = courses.filter(c => c.type === 'coming-soon');
const prefix = `${base}${lang}/`;

---
<h1>{t.h1}</h1><div class="course-filter" id="courseFilter">{[[ 'all',t.all],['ai',t.ai],['ielts',t.ielts],['general-english',t.ge],['admission',t.admission],['sat',t.sat],['dizayn',t.design],['hayotiy',t.life],['bepul',t.free],['data',t.data],['dasturlash',t.dev]].map(([id,label],i)=><button class:list={['cf-btn',{active:i===0}]} data-filter={id}>{label}</button>)}</div>
<div class="course-list">
{topStandard.map((c:any) => <CourseCard course={c} lang={lang} />)}
<section class="ielts-collection" data-cat="ielts"><div class="ielts-collection-head"><div><span class="badge badge-new">{t.new}</span><h2>{t.ieltsTitle}</h2><p>{t.ieltsDesc}</p></div><span class="collection-price">$7.50–$14.99 · ≈ 93 750–187 500 so'm</span></div><div class="ielts-course-grid">{miniCourses.map((c:any,i)=><a class="ielts-mini-card" href={prefix+`kurslar/${c.slug}`} data-gumroad-product={c.gumroadSlug} target={c.gumroadSlug?'_blank':undefined} rel={c.gumroadSlug?'noopener noreferrer':undefined}><b>0{i+1}</b><h3>{c.title[lang]}</h3><p>{c.description[lang]}</p><span>{c.price} →</span></a>)}</div><div class="ielts-bundle"><div><span>IELTS FULL BUNDLE</span><h3>{lang==='ru'?'Возьмите 4 курса вместе — сэкономьте 20%':'Get all 4 together — save 20%'}</h3><p><s>468 750 so'm</s> → <b>375 000 so'm</b></p></div><a class="start-btn" href={prefix+'bog-lanish?course=ielts-full-bundle&price=375000'} data-gumroad-product="ielts-full-bundle" target="_blank" rel="noopener noreferrer">{t.bundle}</a></div></section>
{restStandard.map((c:any) => <CourseCard course={c} lang={lang} />)}
</div>
<section class="upcoming-courses"><div class="upcoming-heading"><p class="eyebrow">{t.upcoming}</p><h2>{t.preparing}</h2><p>{t.preparingDesc}</p></div><div class="upcoming-grid">{comingSoon.map((c:any)=><div class="card" data-cat="hayotiy"><span class="badge badge-soon">{t.soon}</span><h2>{c.title[lang]}</h2><span class="cert-line">{t.cert}</span><p>{t.preparingDesc}</p><p class="upcoming-status">{t.noPrice}</p><span class="start-btn is-disabled">{t.disabled}</span><WaitlistForm courseId={c.slug} courseName={c.title[lang]} lang={lang} compact /></div>)}</div></section>
<style is:global>.course-filter{display:flex;flex-wrap:wrap;gap:8px;margin:1.2rem 0 .5rem}.cf-btn{font:700 13px var(--font-display);color:var(--muted);background:var(--surface);border:1px solid var(--border);border-radius:999px;padding:7px 14px;cursor:pointer}.cf-btn.active{background: var(--btn-bg);color:#fff;border-color:var(--accent)}.ielts-collection{grid-column:1/-1;border:1px solid var(--border);border-radius:18px;padding:clamp(1rem,3vw,1.5rem);background:linear-gradient(135deg,rgba(34,197,94,.08),var(--surface))}.ielts-collection-head,.ielts-bundle{display:flex;justify-content:space-between;gap:1rem;align-items:center}.ielts-course-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.7rem;margin:1rem 0}.ielts-mini-card{display:block;padding:1rem;border:1px solid var(--border);border-radius:13px;text-decoration:none;color:var(--text);background:var(--surface)}.ielts-mini-card p{color:var(--muted);font-size:.88rem}@media(max-width:780px){.ielts-course-grid{grid-template-columns:repeat(2,1fr)}.ielts-collection-head,.ielts-bundle{align-items:stretch;flex-direction:column}}</style>
<script>const filter=document.getElementById('courseFilter');if(filter){const cards=document.querySelectorAll('.course-list > [data-cat]');filter.addEventListener('click',(e)=>{const btn=(e.target as Element).closest('.cf-btn') as HTMLButtonElement|null;if(!btn)return;filter.querySelectorAll('.cf-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');const f=btn.dataset.filter;cards.forEach((card:any)=>{const cats=(card.dataset.cat||'').split(' ');card.style.display=f==='all'||cats.includes(f)?'':'none'})})}</script>

---
import summary from '../data/impact-summary.json';
const { metrics, verifiedResponses, asOf, monthly } = summary;
const maxValue = Math.max(1, ...monthly.map((item) => Math.max(item.responses, item.employmentOutcomes, item.freelanceStarters, item.portfolioCompleted)));
---
<section class="impact-dashboard" aria-labelledby="impact-dashboard-title">
  <div class="dashboard-head"><div><p class="eyebrow">VERIFIED DASHBOARD</p><h2 id="impact-dashboard-title">Tekshirilgan natijalar</h2></div><small>Yangilangan: {asOf}</small></div>
  <div class="dashboard-cards"><article><strong>{verifiedResponses}</strong><span>tekshirilgan javob</span></article><article><strong>{metrics.employmentOutcomesVerified}</strong><span>ish natijasi</span></article><article><strong>{metrics.freelanceStartersVerified}</strong><span>freelance boshlanishi</span></article><article><strong>{metrics.portfolioCompleted}</strong><span>portfolio yakunlandi</span></article><article><strong>{metrics.salaryImprovementVerified}</strong><span>daromad o‘sishi</span></article></div>
  <div class="trend" role="img" aria-label="Oylar bo‘yicha tekshirilgan natijalar"><div class="trend-legend"><span>Javoblar</span><span>Ish</span><span>Freelance</span><span>Portfolio</span></div>{monthly.map((item) => <div class="trend-row"><b>{item.month}</b><div class="bars"><i class="bar responses" style={`--size:${(item.responses / maxValue) * 100}%`} title={`Javoblar: ${item.responses}`}></i><i class="bar employment" style={`--size:${(item.employmentOutcomes / maxValue) * 100}%`} title={`Ish: ${item.employmentOutcomes}`}></i><i class="bar freelance" style={`--size:${(item.freelanceStarters / maxValue) * 100}%`} title={`Freelance: ${item.freelanceStarters}`}></i><i class="bar portfolio" style={`--size:${(item.portfolioCompleted / maxValue) * 100}%`} title={`Portfolio: ${item.portfolioCompleted}`}></i></div><small>{item.responses} javob</small></div>)}</div>
  <p class="dashboard-note">Dashboard faqat verifikatsiyadan o‘tgan, shaxssiz va rozilik berilgan agregat ma’lumotni ko‘rsatadi. Raw email, ism yoki individual hikoya bu yerga chiqmaydi.</p>
</section>
<style>.impact-dashboard{margin:1rem 0;padding:clamp(1.2rem,3vw,2rem);border:1px solid var(--border);border-radius:18px;background:var(--surface)}.dashboard-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.dashboard-head h2{margin:.1rem 0}.dashboard-head small,.dashboard-note{color:var(--muted)}.dashboard-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.65rem;margin:1rem 0}.dashboard-cards article{padding:.85rem;border:1px solid var(--border);border-radius:12px;background:color-mix(in srgb,var(--accent) 5%,var(--surface))}.dashboard-cards strong{display:block;font-size:1.8rem;color:var(--accent)}.dashboard-cards span{font-size:.8rem;color:var(--muted)}.trend{padding:1rem;border:1px solid var(--border);border-radius:12px;overflow:auto}.trend-legend{display:flex;gap:.8rem;flex-wrap:wrap;color:var(--muted);font-size:.78rem;margin-bottom:.8rem}.trend-legend span::before{content:'';display:inline-block;width:8px;height:8px;border-radius:50%;background:#7d7df5;margin-right:.3rem}.trend-legend span:nth-child(2)::before{background:#34d399}.trend-legend span:nth-child(3)::before{background:#fbbf24}.trend-legend span:nth-child(4)::before{background:#fb7185}.trend-row{display:grid;grid-template-columns:70px minmax(240px,1fr) 70px;gap:.7rem;align-items:center;margin:.7rem 0}.trend-row b,.trend-row small{font-size:.8rem;color:var(--muted)}.bars{height:34px;display:flex;gap:3px;align-items:flex-end;background:repeating-linear-gradient(0deg,var(--border) 0 1px,transparent 1px 11px);padding:0 3px}.bar{display:block;width:12px;height:max(2px,var(--size));border-radius:4px 4px 0 0}.responses{background:#7d7df5}.employment{background:#34d399}.freelance{background:#fbbf24}.portfolio{background:#fb7185}.dashboard-note{font-size:.85rem;line-height:1.55;margin:.9rem 0 0}@media(max-width:560px){.dashboard-head{display:block}.trend-row{grid-template-columns:58px minmax(220px,1fr) 55px}}
</style>

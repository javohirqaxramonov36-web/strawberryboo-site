---
import PaymentInstructions from './PaymentInstructions.astro';
const { skill, title, eyebrow, description, accent, available, fillNeeded, practiceHref, practiceLabel, sourceNote, mockBonus = false, speakingApp = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const coursePrice = '$7.50 · ≈ 93 750 so‘m';
const bundleHref = base + 'bog-lanish?course=ielts-full-bundle&price=300000';
---
<article class="ielts-skill" style={`--skill-accent:${accent}`}>
  <header class="course-hero"><p class="eyebrow">{eyebrow} · YANGI SKILL-KURS</p><h1>{title}</h1><div class="price"><span class="now">$7.50</span><span class="uzs">≈ 93 750 so‘m · forever access</span></div><p class="lead">{description}</p></header>
  <section class="bundle-callout"><div><p class="eyebrow">IELTS FULL BUNDLE</p><h2>4 tasini birga oling — 20% tejang</h2><p>Listening + Reading + Writing + Speaking alohida: <s>375 000 so‘m</s>. Bundle: <strong>300 000 so‘m</strong>. To‘lov mavjud jarayon bo‘yicha Telegram orqali qo‘lda tasdiqlanadi.</p></div><a class="start-btn" href={bundleHref}>Bundle: 300 000 so‘m →</a></section>
  {mockBonus && <aside class="mock-bonus"><strong>IELTS Mock bonusi:</strong> Listening yoki Reading kursini xarid qilganda bir marta 2 Qadam bonus beriladi.</aside>}
  <section><p class="eyebrow">MAVJUD MATERIAL</p><h2>Shu kurs ichida nima bor?</h2><div class="content-grid">{available.map((item) => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>{practiceHref && <a class="practice-link" href={base + practiceHref}>{practiceLabel} →</a>}</section>
  {speakingApp && <section class="app-callout"><p class="eyebrow">AI AMALIYOT MODULI</p><h2>30 kunlik Speaking mashqini oching</h2><p>Pronunciation, shadowing, Part 1/2/3, timer, progress va transcript-asosidagi AI feedback mavjud.</p><a class="start-btn" href={base + 'kurslar/ielts-speaking/'}>AI Speaking modulini ochish →</a></section>}
  <section class="fill-needed"><p class="eyebrow">TO‘LDIRILISHI KERAK</p><h2>Keyingi kontent bosqichi</h2><ul>{fillNeeded.map((item) => <li>{item}</li>)}</ul><p>Bu bo‘limlar hozircha tayyor kontent deb ko‘rsatilmaydi; ular alohida material tasdiqlangandan keyin qo‘shiladi.</p></section>
  <p class="source-note">Manba: {sourceNote}</p>
  <div class="actions"><a class="start-btn" href={base + `bog-lanish?course=${skill}&price=93750`}>Kursni olish · 93 750 so‘m →</a><a class="course-nav-link" href={base + 'kurslar/#ielts-courses'}>← Barcha IELTS kurslari</a></div>
  <PaymentInstructions course={title} price={coursePrice} />
</article>
<style>
.ielts-skill{max-width:980px;margin:auto}.eyebrow{color:var(--skill-accent);font-size:.78rem;font-weight:800;letter-spacing:.1em;margin:0 0 .5rem}.ielts-skill .lead{max-width:760px;color:var(--muted);line-height:1.65}.bundle-callout,.app-callout{margin:1.5rem 0;padding:1.3rem;display:flex;justify-content:space-between;align-items:center;gap:1.2rem;border:1px solid color-mix(in srgb,var(--skill-accent) 48%,var(--border));border-radius:16px;background:linear-gradient(135deg,color-mix(in srgb,var(--skill-accent) 13%,var(--surface)),var(--surface))}.bundle-callout h2,.app-callout h2{margin:.15rem 0 .45rem}.bundle-callout p,.app-callout p,.fill-needed p{color:var(--muted);line-height:1.55}.mock-bonus{margin:1rem 0;padding:1rem;border-left:4px solid #fbbf24;background:color-mix(in srgb,#fbbf24 10%,var(--surface));border-radius:0 10px 10px 0}.content-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.85rem;margin:1rem 0}.content-grid article{padding:1rem;border:1px solid var(--border);border-radius:13px;background:var(--surface)}.content-grid h3{margin:0 0 .45rem;font-size:1rem}.content-grid p{margin:0;color:var(--muted);line-height:1.55;font-size:.92rem}.practice-link{display:inline-block;color:var(--skill-accent);font-weight:700;margin:.25rem 0;text-decoration:none}.fill-needed{margin:2rem 0;padding:1.2rem;border:1px dashed color-mix(in srgb,#fbbf24 65%,var(--border));border-radius:14px;background:color-mix(in srgb,#fbbf24 5%,var(--surface))}.fill-needed h2{margin:.2rem 0 .6rem}.fill-needed li{margin:.45rem 0;color:var(--muted)}.source-note{font-size:.86rem;color:var(--muted);border-left:3px solid var(--skill-accent);padding:.45rem .75rem;background:color-mix(in srgb,var(--skill-accent) 6%,transparent)}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin:1.5rem 0}.course-nav-link{color:var(--muted)}@media(max-width:700px){.bundle-callout,.app-callout{align-items:stretch;flex-direction:column}.content-grid{grid-template-columns:1fr}.bundle-callout .start-btn,.app-callout .start-btn{text-align:center}}
</style>

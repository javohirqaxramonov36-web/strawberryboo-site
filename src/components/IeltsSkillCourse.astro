---
import PaymentInstructions from './PaymentInstructions.astro';
import CourseProgress from './CourseProgress.astro';
import Testimonials from './Testimonials.astro';
import CourseFaq from './CourseFaq.astro';
const { skill, title, eyebrow, description, accent, available, fillNeeded, practiceHref, practiceLabel, sourceNote, mockBonus = false, speakingApp = false, whyUseful, contentTodo, bonusHref, bonusLabel, price = '$7.50', priceUzs = '93 750 so‘m', priceUzsNum = 93750, lang = 'uz' } = Astro.props;
const base = import.meta.env.BASE_URL;
const L = {
  uz: {
    newSkill: 'YANGI SKILL-KURS', progress: 'progressi', why: 'nima uchun foydali?',
    bundleEyebrow: 'IELTS FULL BUNDLE', bundleTitle: '4 tasini birga oling — 20% tejang',
    bundleText: 'To‘lov mavjud jarayon bo‘yicha Telegram orqali qo‘lda tasdiqlanadi.',
    bundleDetails: 'Listening + Reading + Writing + Speaking alohida:',
    mockBonus: 'IELTS Mock bonusi:', mockBonusText: 'Listening yoki Reading kursini xarid qilganda bir marta 2 Qadam bonus beriladi.', availableEyebrow: 'MAVJUD MATERIAL', availableTitle: 'Shu kurs ichida nima bor?',
    obsidianEyebrow: 'OBSIDIAN KONTENTI', obsidianTitle: 'Struktura va lug‘at materiallari',
    bonusEyebrow: 'BONUS MINI-KURS', bonusTitle: 'Typing: tez va aniq yozish',
    bonusText: 'Har darsdan keyin qisqa quiz hamda WPM va aniqlikni hisoblaydigan amaliy typing mashqi.',
    appEyebrow: 'AI AMALIYOT MODULI', appTitle: '30 kunlik Speaking mashqini oching',
    appText: 'Pronunciation, shadowing, Part 1/2/3, timer, progress va transcript-asosidagi AI feedback mavjud.',
    fillEyebrow: 'TO‘LDIRILISHI KERAK', fillTitle: 'Keyingi kontent bosqichi',
    fillNote: 'Bu bo‘limlar hozircha tayyor kontent deb ko‘rsatilmaydi; ular alohida material tasdiqlangandan keyin qo‘shiladi.',
    source: 'Manba:', getCourse: 'Kursni olish ·', som: '→', soum: 'so‘m', foreverAccess: 'umrbod foydalanish',
    allCourses: '← Barcha IELTS kurslari', fallbackBonus: 'Typing bonusini ochish →', speakingCta: 'AI Speaking modulini ochish →'
  },
  ru: {
    newSkill: 'НОВЫЙ SKILL-КУРС', progress: 'прогресс', why: 'почему это полезно?',
    bundleEyebrow: 'IELTS FULL BUNDLE', bundleTitle: 'Возьмите все 4 — сэкономьте 20%',
    bundleText: 'Оплата подтверждается вручную через Telegram по действующему процессу.',
    bundleDetails: 'Listening + Reading + Writing + Speaking по отдельности:',
    mockBonus: 'Бонус IELTS Mock:', mockBonusText: 'При покупке курса Listening или Reading один раз предоставляется бонус 2 Qadam.', availableEyebrow: 'ДОСТУПНЫЕ МАТЕРИАЛЫ', availableTitle: 'Что входит в этот курс?',
    obsidianEyebrow: 'OBSIDIAN КОНТЕНТ', obsidianTitle: 'Структура и словарные материалы',
    bonusEyebrow: 'БОНУСНЫЙ МИНИ-КУРС', bonusTitle: 'Typing: быстрый и точный набор',
    bonusText: 'После каждого урока — короткий квиз и практическое упражнение по печати с подсчётом WPM и точности.',
    appEyebrow: 'МОДУЛЬ AI-ПРАКТИКИ', appTitle: 'Откройте 30-дневную практику Speaking',
    appText: 'Pronunciation, shadowing, Part 1/2/3, таймер, прогресс и AI-фидбэк на основе транскрипта.',
    fillEyebrow: 'НУЖНО ЗАПОЛНИТЬ', fillTitle: 'Следующий этап контента',
    fillNote: 'Эти разделы пока не показываются как готовый контент; они добавляются после подтверждения отдельных материалов.',
    source: 'Источник:', getCourse: 'Получить курс ·', som: '→', soum: 'сум', foreverAccess: 'постоянный доступ',
    allCourses: '← Все курсы IELTS', fallbackBonus: 'Открыть бонус Typing →', speakingCta: 'Открыть AI-модуль Speaking →'
  },
  en: {
    newSkill: 'NEW SKILL-COURSE', progress: 'progress', why: 'why is this useful?',
    bundleEyebrow: 'IELTS FULL BUNDLE', bundleTitle: 'Get all 4 together — save 20%',
    bundleText: 'Payment is confirmed manually via Telegram following the current process.',
    bundleDetails: 'Listening + Reading + Writing + Speaking separately:',
    mockBonus: 'IELTS Mock bonus:', mockBonusText: 'Buy a Listening or Reading course and receive a one-time 2 Qadam bonus.', availableEyebrow: 'AVAILABLE MATERIAL', availableTitle: 'What is inside this course?',
    obsidianEyebrow: 'OBSIDIAN CONTENT', obsidianTitle: 'Structure and vocabulary materials',
    bonusEyebrow: 'BONUS MINI-COURSE', bonusTitle: 'Typing: fast and accurate',
    bonusText: 'After each lesson, a short quiz plus a practical typing drill that tracks WPM and accuracy.',
    appEyebrow: 'AI PRACTICE MODULE', appTitle: 'Open the 30-day Speaking practice',
    appText: 'Pronunciation, shadowing, Part 1/2/3, timer, progress and transcript-based AI feedback.',
    fillEyebrow: 'TO BE FILLED', fillTitle: 'Next content stage',
    fillNote: 'These sections are not shown as ready content yet; they are added after the relevant materials are confirmed.',
    source: 'Source:', getCourse: 'Get the course ·', som: '→', soum: 'soum', foreverAccess: 'lifetime access',
    allCourses: '← All IELTS courses', fallbackBonus: 'Open the Typing bonus →', speakingCta: 'Open the AI Speaking module →'
  }
};
const t = L[lang] || L.uz;
const coursePrice = `${price} · ≈ ${priceUzs}`;
const localePrefix = lang === 'uz' ? '' : `${lang}/`;
// Course routes are available in all three locales. Standalone practice pages are
// shared, so their language is carried in the query string instead of pointing to a
// route that does not exist.
const localHref = (path) => {
  const normalized = String(path || '').replace(/^\/+/, '');
  // These tools currently have a single shared route. Keep a locale marker for the
  // practice shell instead of sending RU/EN learners to a non-existent page.
  if (normalized.startsWith('ielts-practice/') || normalized.startsWith('kurslar/ielts-writing/typing/')) {
    return base + normalized + (normalized.includes('?') ? '&' : '?') + `lang=${lang}`;
  }
  return base + localePrefix + normalized;
};
const bundleHref = localHref(`bog-lanish?course=ielts-full-bundle&price=375000`);
const allCoursesHref = localHref('kurslar/#ielts-courses');
const practiceTarget = skill === 'ielts-speaking' ? 'kurslar/ielts-speaking/#speaking-practice' : practiceHref;
const faqCopy = {
  uz: { whoFor: 'IELTSning shu ko‘nikmasi bo‘yicha mavjud materiallar va amaliyotni ishlatmoqchi bo‘lganlar uchun.', notFor: 'IELTS imtihonida aniq ball yoki rasmiy ro‘yxatdan o‘tishni kafolatlaydigan xizmat izlayotganlar uchun emas.', access: 'To‘lov mavjud jarayon bo‘yicha Telegram orqali qo‘lda tasdiqlanadi. Sahifada doimiy foydalanish ko‘rsatilgan.' },
  ru: { whoFor: 'Для тех, кто хочет использовать доступные материалы и практику по этому навыку IELTS.', notFor: 'Не для тех, кто ищет гарантию конкретного балла IELTS или официальной регистрации на экзамен.', access: 'Оплата подтверждается вручную через Telegram по действующему процессу. На странице указан постоянный доступ.' },
  en: { whoFor: 'Learners who want to use the available materials and practice for this IELTS skill.', notFor: 'Not for learners looking for a guaranteed IELTS score or official exam registration.', access: 'Payment is confirmed manually via Telegram following the current process. The page lists lifetime access.' }
}[lang] || undefined;
---
<article class="ielts-skill" style={`--skill-accent:${accent}`}>
  <header class="course-hero"><p class="eyebrow">{eyebrow} · {t.newSkill}</p><h1>{title}</h1><div class="price"><span class="now">{price}</span><span class="uzs">≈ {priceUzs} · {t.foreverAccess}</span></div><p class="lead">{description}</p></header>
  <CourseProgress courseId={skill} title={`${title} ${t.progress}`} selector=".ielts-skill" itemSelector=".content-grid > article" labelSelector="h3" mode={skill === 'ielts-speaking' ? 'speaking' : 'checklist'} />
  {whyUseful && <aside class="why-useful"><strong>{title} {t.why}</strong><p>{whyUseful}</p></aside>}
  <section class="bundle-callout"><div><p class="eyebrow">{t.bundleEyebrow}</p><h2>{t.bundleTitle}</h2><p>{t.bundleDetails} <s>468 750 {t.soum}</s>. Bundle: <strong>375 000 {t.soum}</strong>. {t.bundleText}</p></div><a class="start-btn" href={bundleHref}>Bundle: 375 000 {t.soum} →</a></section>
  {mockBonus && <aside class="mock-bonus"><strong>{t.mockBonus}</strong> {t.mockBonusText}</aside>}
  <section><p class="eyebrow">{t.availableEyebrow}</p><h2>{t.availableTitle}</h2><div class="content-grid">{available.map((item) => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>{practiceTarget && <a class="practice-link" href={localHref(practiceTarget)}>{practiceLabel} →</a>}</section>
  {contentTodo && <section class="content-todo"><p class="eyebrow">{t.obsidianEyebrow}</p><h2>{t.obsidianTitle}</h2><p>{contentTodo}</p></section>}
  {bonusHref && <section class="bonus-callout"><div><p class="eyebrow">{t.bonusEyebrow}</p><h2>{t.bonusTitle}</h2><p>{t.bonusText}</p></div><a class="start-btn" href={localHref(bonusHref)}>{bonusLabel || t.fallbackBonus}</a></section>}
  {speakingApp && <section class="app-callout"><p class="eyebrow">{t.appEyebrow}</p><h2>{t.appTitle}</h2><p>{t.appText}</p><a class="start-btn" href={localHref('kurslar/ielts-speaking/#speaking-practice')}>{t.speakingCta}</a></section>}
  <section class="fill-needed"><p class="eyebrow">{t.fillEyebrow}</p><h2>{t.fillTitle}</h2><ul>{fillNeeded.map((item) => <li>{item}</li>)}</ul><p>{t.fillNote}</p></section>
  <CourseFaq facts={{ title, lang, overview: description, topics: available.map((item) => item.title), whoFor: faqCopy.whoFor, whoNotFor: faqCopy.notFor, price: coursePrice, certificate: false, accessPayment: faqCopy.access }} />
  <Testimonials courseSlug={skill} lang={lang} />
  <p class="source-note">{t.source} {sourceNote}</p>
  <div class="actions"><a class="start-btn" href={localHref(`bog-lanish?course=${skill}&price=${priceUzsNum}`)}>{t.getCourse} {priceUzs} {t.som}</a><a class="course-nav-link" href={allCoursesHref}>{t.allCourses}</a></div>
  <PaymentInstructions course={title} price={coursePrice} />
</article>
<style>
.ielts-skill{max-width:980px;margin:auto}.eyebrow{color:var(--skill-accent);font-size:.78rem;font-weight:800;letter-spacing:.1em;margin:0 0 .5rem}.ielts-skill .lead{max-width:760px;color:var(--muted);line-height:1.65}.why-useful,.content-todo,.bonus-callout{margin:1.25rem 0;padding:1.1rem;border-radius:14px}.why-useful{border-left:4px solid var(--skill-accent);background:color-mix(in srgb,var(--skill-accent) 10%,var(--surface))}.why-useful strong{display:block;margin-bottom:.3rem}.why-useful p,.content-todo p,.bonus-callout p{margin:.25rem 0;color:var(--muted);line-height:1.6}.content-todo{border:1px dashed color-mix(in srgb,#fbbf24 65%,var(--border));background:color-mix(in srgb,#fbbf24 5%,var(--surface))}.content-todo h2,.bonus-callout h2{margin:.2rem 0 .5rem}.bonus-callout{display:flex;justify-content:space-between;align-items:center;gap:1.2rem;border:1px solid color-mix(in srgb,var(--skill-accent) 48%,var(--border));background:linear-gradient(135deg,color-mix(in srgb,var(--skill-accent) 13%,var(--surface)),var(--surface))}.bundle-callout,.app-callout{margin:1.5rem 0;padding:1.3rem;display:flex;justify-content:space-between;align-items:center;gap:1.2rem;border:1px solid color-mix(in srgb,var(--skill-accent) 48%,var(--border));border-radius:16px;background:linear-gradient(135deg,color-mix(in srgb,var(--skill-accent) 13%,var(--surface)),var(--surface))}.bundle-callout h2,.app-callout h2{margin:.15rem 0 .45rem}.bundle-callout p,.app-callout p,.fill-needed p{color:var(--muted);line-height:1.55}.mock-bonus{margin:1rem 0;padding:1rem;border-left:4px solid #fbbf24;background:color-mix(in srgb,#fbbf24 10%,var(--surface));border-radius:0 10px 10px 0}.content-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.85rem;margin:1rem 0}.content-grid article{padding:1rem;border:1px solid var(--border);border-radius:13px;background:var(--surface)}.content-grid h3{margin:0 0 .45rem;font-size:1rem}.content-grid p{margin:0;color:var(--muted);line-height:1.55;font-size:.92rem}.practice-link{display:inline-block;color:var(--skill-accent);font-weight:700;margin:.25rem 0;text-decoration:none}.fill-needed{margin:2rem 0;padding:1.2rem;border:1px dashed color-mix(in srgb,#fbbf24 65%,var(--border));border-radius:14px;background:color-mix(in srgb,#fbbf24 5%,var(--surface))}.fill-needed h2{margin:.2rem 0 .6rem}.fill-needed li{margin:.45rem 0;color:var(--muted)}.source-note{font-size:.86rem;color:var(--muted);border-left:3px solid var(--skill-accent);padding:.45rem .75rem;background:color-mix(in srgb,var(--skill-accent) 6%,transparent)}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin:1.5rem 0}.course-nav-link{color:var(--muted)}@media(max-width:700px){.why-useful,.content-todo,.bonus-callout{margin:1.25rem 0;padding:1.1rem;border-radius:14px}.why-useful{border-left:4px solid var(--skill-accent);background:color-mix(in srgb,var(--skill-accent) 10%,var(--surface))}.why-useful strong{display:block;margin-bottom:.3rem}.why-useful p,.content-todo p,.bonus-callout p{margin:.25rem 0;color:var(--muted);line-height:1.6}.content-todo{border:1px dashed color-mix(in srgb,#fbbf24 65%,var(--border));background:color-mix(in srgb,#fbbf24 5%,var(--surface))}.content-todo h2,.bonus-callout h2{margin:.2rem 0 .5rem}.bonus-callout{display:flex;justify-content:space-between;align-items:center;gap:1.2rem;border:1px solid color-mix(in srgb,var(--skill-accent) 48%,var(--border));background:linear-gradient(135deg,color-mix(in srgb,var(--skill-accent) 13%,var(--surface)),var(--surface))}.bundle-callout,.app-callout{align-items:stretch;flex-direction:column}.content-grid{grid-template-columns:1fr}.bundle-callout .start-btn,.app-callout .start-btn,.bonus-callout .start-btn{text-align:center}}
</style>

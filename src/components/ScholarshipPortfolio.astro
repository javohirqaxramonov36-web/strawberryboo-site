---
type Locale = 'en' | 'uz';
const { lang = 'en' } = Astro.props as { lang?: Locale };
const isEn = lang === 'en';
const base = import.meta.env.BASE_URL;
const liveSite = 'https://javohirqaxramonov36-web.github.io/strawberryboo-site/';
const repository = 'https://github.com/javohirqaxramonov36-web/strawberryboo-site';

const copy = isEn ? {
  eyebrow: 'SCHOLARSHIP PROJECT PORTFOLIO',
  title: 'Tayanch: building a practical path into learning',
  lead: 'Tayanch is a live multilingual education platform designed to organize practical learning resources for Uzbek learners. It brings together language preparation, university-admissions guidance, and technical learning in one evolving product.',
  live: 'Visit the live platform',
  source: 'View source repository',
  quickLabel: 'Project at a glance',
  quick: [
    ['Project', 'Tayanch — live education platform'],
    ['Languages', 'Uzbek, Russian, and English'],
    ['Learning areas', 'IELTS, general English, SAT, admissions, and professional / technical learning'],
    ['Applicant role', 'Product direction, site architecture, content organization, and development iteration'],
  ],
  problemTitle: 'The problem I am working on',
  problem: 'Independent learners often find useful information in scattered formats: separate videos, notes, links, and course pages. That makes it harder to see a next step, compare resources, or build a consistent learning path—especially when accessible, locally relevant guidance is limited.',
  solutionTitle: 'The solution: a navigable learning product',
  solution: 'I am developing Tayanch as a structured, browser-based place where learners can explore practical course pathways and resources. The product groups learning around clear goals—from IELTS skill practice and general English to SAT preparation, admissions, AI tools, and technical skills—rather than presenting disconnected materials.',
  roleTitle: 'What I do',
  roles: [
    ['Set product direction', 'Define the learning areas, user pathways, and the order in which the platform develops.'],
    ['Design the site architecture', 'Organize routes, navigation, and page structures so information remains findable across languages and topics.'],
    ['Organize learning content', 'Shape course pages, resource groupings, and practical guidance around specific learner goals.'],
    ['Iterate in development', 'Build and refine the site as a live web project, reviewing how the experience, content, and structure fit together.'],
  ],
  evidenceTitle: 'Evidence and current status',
  evidenceIntro: 'This section deliberately distinguishes what is publicly verifiable from future work. It does not claim learner counts, revenue, partnerships, awards, or outcomes that are not documented here.',
  evidence: [
    ['Live platform', 'The current public Tayanch site is available online and includes multilingual navigation and course/resource pages.'],
    ['Public code', 'The project repository documents the web implementation and its ongoing development.'],
    ['Current scope', 'The platform publicly presents learning paths spanning language preparation, admissions, AI, and technical topics; availability differs by course, and some offerings are presented as upcoming.'],
  ],
  directionTitle: 'Where I want to take it',
  direction: 'Tayanch is a foundation for a longer-term goal: widening access to structured engineering and STEM education. I want to keep improving the platform’s learning design, multilingual accessibility, and technical course pathways so more learners can move from curiosity to hands-on study.',
  activitiesLabel: 'SCHOLARSHIP-READY ACTIVITIES LIST DRAFT',
  activitiesTitle: 'Activities List — Tayanch',
  activitiesNote: 'Copy and tailor this draft for the specific application. Confirm the activity category, dates, time commitment, and any claims against your own records before submitting. Do not add impact metrics unless you can document them.',
  activityFields: [
    ['Organization / activity', 'Tayanch — independent education platform'],
    ['Position / leadership', 'Founder & Developer'],
    ['Suggested category', 'Independent project / Other (select the category that matches the application)'],
    ['Activity description', 'Directed and built a multilingual learning platform; organized IELTS, English, SAT, admissions, AI, and technical-learning pathways.'],
    ['Evidence link', liveSite],
    ['Time commitment', '[Add only your verified hours/week, weeks/year, and dates]'],
  ],
  applicationTitle: 'Short application version',
  applicationText: 'Founder & Developer, Tayanch — Directed and built a multilingual education platform, organizing practical pathways in IELTS, English, SAT, admissions, AI, and technical learning.',
  integrityTitle: 'Accuracy note',
  integrity: 'This portfolio describes the project’s documented scope and the applicant’s development role. It should be updated as the product changes, and every scholarship submission should use only claims the applicant can verify.',
  back: 'Explore Tayanch',
} : {
  eyebrow: 'STIPENDIYA UCHUN LOYIHA PORTFOLIOSI',
  title: 'Tayanch: amaliy ta’limga yo‘l yaratish',
  lead: 'Tayanch — o‘zbek o‘quvchilari uchun amaliy ta’lim resurslarini tartibga solishga qaratilgan jonli, ko‘p tilli ta’lim platformasi. U til tayyorgarligi, universitetga topshirish bo‘yicha yo‘l-yo‘riq va texnik o‘rganishni bitta rivojlanayotgan mahsulotda birlashtiradi.',
  live: 'Jonli platformani ochish',
  source: 'Manba kodini ko‘rish',
  quickLabel: 'Loyiha qisqacha',
  quick: [
    ['Loyiha', 'Tayanch — jonli ta’lim platformasi'],
    ['Tillar', 'O‘zbek, rus va ingliz tillari'],
    ['Yo‘nalishlar', 'IELTS, umumiy ingliz tili, SAT, admission hamda professional / texnik o‘rganish'],
    ['Arizachining roli', 'Mahsulot yo‘nalishi, sayt arxitekturasi, kontentni tartibga solish va rivojlantirish iteratsiyasi'],
  ],
  problemTitle: 'Hal qilayotgan muammo',
  problem: 'Mustaqil o‘quvchilar foydali ma’lumotni ko‘pincha tarqoq shakllarda topadilar: alohida videolar, qaydlar, havolalar va kurs sahifalari. Bu keyingi qadamni ko‘rish, resurslarni solishtirish va izchil o‘rganish yo‘lini tuzishni qiyinlashtiradi — ayniqsa ochiq va mahalliy kontekstga mos yo‘l-yo‘riq cheklanganda.',
  solutionTitle: 'Yechim: yo‘naltiriladigan ta’lim mahsuloti',
  solution: 'Men Tayanch’ni o‘quvchilar amaliy kurs yo‘llari va resurslarni topa oladigan, brauzerda ishlaydigan tartibli makon sifatida rivojlantiryapman. Mahsulot tarqoq materiallar o‘rniga IELTS ko‘nikmalari, umumiy ingliz tili, SAT, admission, AI vositalari va texnik ko‘nikmalar kabi aniq maqsadlar atrofida o‘rganishni guruhlaydi.',
  roleTitle: 'Men qilayotgan ishlar',
  roles: [
    ['Mahsulot yo‘nalishini belgilayman', 'Ta’lim yo‘nalishlari, foydalanuvchi yo‘llari va platforma rivojlanish tartibini aniqlayman.'],
    ['Sayt arxitekturasini loyihalayman', 'Ma’lumot turli tillar va mavzularda topilishi uchun yo‘nalishlar, navigatsiya va sahifa tuzilmalarini tartiblayman.'],
    ['Ta’lim kontentini tartibga solaman', 'Kurs sahifalari, resurs guruhlari va amaliy yo‘l-yo‘riqlarni aniq o‘quvchi maqsadlari atrofida shakllantiraman.'],
    ['Rivojlantirishda iteratsiya qilaman', 'Saytni jonli veb loyiha sifatida quraman va tajriba, kontent hamda tuzilmaning bir-biriga mosligini takomillashtiraman.'],
  ],
  evidenceTitle: 'Dalillar va hozirgi holat',
  evidenceIntro: 'Bu bo‘lim ommaviy tekshirilishi mumkin bo‘lgan holatni va kelajakdagi ishlarni aniq ajratadi. Bu yerda hujjatlashtirilmagan foydalanuvchi soni, daromad, hamkorlik, mukofot yoki natijalar da’vo qilinmaydi.',
  evidence: [
    ['Jonli platforma', 'Tayanchning amaldagi ommaviy sayti onlayn va ko‘p tilli navigatsiya hamda kurs/resurs sahifalarini o‘z ichiga oladi.'],
    ['Ommaviy kod', 'Loyiha repozitoriysi veb-implementatsiya va uning davom etayotgan rivojlanishini ko‘rsatadi.'],
    ['Hozirgi ko‘lam', 'Platforma til tayyorgarligi, admission, AI va texnik mavzularni qamrab olgan o‘rganish yo‘llarini taqdim etadi; kurslar holati turlicha, ayrimlari hali kutilmoqda.'],
  ],
  directionTitle: 'Keyingi yo‘nalish',
  direction: 'Tayanch uzoq muddatli maqsad uchun poydevordir: muhandislik va STEM ta’limiga tartibli kirishni kengaytirish. Men platformaning o‘rganish dizayni, ko‘p tilli qulayligi va texnik kurs yo‘llarini takomillashtirib, ko‘proq o‘quvchilarga qiziqishdan amaliy o‘qishga o‘tishda yordam berishni xohlayman.',
  activitiesLabel: 'STIPENDIYA ARIZASI UCHUN FAOLIYATLAR RO‘YXATI QORALAMASI',
  activitiesTitle: 'Faoliyatlar ro‘yxati — Tayanch',
  activitiesNote: 'Ushbu qoralamani aniq arizaga moslab ko‘chiring. Topshirishdan oldin faoliyat kategoriyasi, sanalar, vaqt majburiyati va barcha da’volarni o‘z qaydlaringiz bo‘yicha tasdiqlang. Hujjat bilan isbotlay olmagan ta’sir metrikalarini qo‘shmang.',
  activityFields: [
    ['Tashkilot / faoliyat', 'Tayanch — mustaqil ta’lim platformasi'],
    ['Lavozim / yetakchilik', 'Asoschi va mahsulot rahbari'],
    ['Tavsiya etilgan kategoriya', 'Mustaqil loyiha / Boshqa (arizaga mos kategoriyani tanlang)'],
    ['Faoliyat tavsifi', 'Ko‘p tilli ta’lim platformasini boshqardim va qurdim; IELTS, ingliz tili, SAT, admission, AI va texnik o‘rganish yo‘llarini tartibladim.'],
    ['Dalil havolasi', liveSite],
    ['Vaqt majburiyati', '[Faqat tasdiqlangan soat/hafta, hafta/yil va sanalarni kiriting]'],
  ],
  applicationTitle: 'Ariza uchun qisqa variant',
  applicationText: 'Asoschi va mahsulot rahbari, Tayanch — Ko‘p tilli ta’lim platformasini boshqardim va qurdim; IELTS, ingliz tili, SAT, admission, AI va texnik o‘rganish bo‘yicha amaliy yo‘llarni tartibladim.',
  integrityTitle: 'Aniqlik eslatmasi',
  integrity: 'Ushbu portfolio loyihaning hujjatlashtirilgan ko‘lami va arizachining rivojlantirishdagi rolini tavsiflaydi. Mahsulot o‘zgargani sayin uni yangilash, stipendiya arizasida esa faqat tasdiqlash mumkin bo‘lgan da’volardan foydalanish kerak.',
  back: 'Tayanchni ko‘rish',
};
---
<section class="portfolio" aria-labelledby="portfolio-title">
  <header class="portfolio-hero">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="portfolio-title">{copy.title}</h1>
    <p class="lead">{copy.lead}</p>
    <div class="actions">
      <a class="button primary" href={liveSite} target="_blank" rel="noopener noreferrer">{copy.live}<span aria-hidden="true">↗</span></a>
      <a class="button secondary" href={repository} target="_blank" rel="noopener noreferrer">{copy.source}<span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <section class="quick-facts" aria-label={copy.quickLabel}>
    {copy.quick.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
  </section>

  <div class="story-grid">
    <section class="panel"><p class="section-kicker">01</p><h2>{copy.problemTitle}</h2><p>{copy.problem}</p></section>
    <section class="panel accent-panel"><p class="section-kicker">02</p><h2>{copy.solutionTitle}</h2><p>{copy.solution}</p></section>
  </div>

  <section class="role-section" aria-labelledby="role-title">
    <p class="section-kicker">03</p><h2 id="role-title">{copy.roleTitle}</h2>
    <div class="role-grid">
      {copy.roles.map(([title, description]) => <article><h3>{title}</h3><p>{description}</p></article>)}
    </div>
  </section>

  <section class="evidence" aria-labelledby="evidence-title">
    <p class="section-kicker">04</p><h2 id="evidence-title">{copy.evidenceTitle}</h2>
    <p class="disclosure">{copy.evidenceIntro}</p>
    <div class="evidence-list">
      {copy.evidence.map(([title, description], index) => <article>
        <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{description}</p>{index === 0 && <a href={liveSite} target="_blank" rel="noopener noreferrer">{liveSite}</a>}{index === 1 && <a href={repository} target="_blank" rel="noopener noreferrer">{repository}</a>}</div>
      </article>)}
    </div>
  </section>

  <section class="direction" aria-labelledby="direction-title"><p class="section-kicker">05</p><h2 id="direction-title">{copy.directionTitle}</h2><p>{copy.direction}</p></section>

  <section class="activities" aria-labelledby="activities-title">
    <p class="eyebrow">{copy.activitiesLabel}</p><h2 id="activities-title">{copy.activitiesTitle}</h2><p class="disclosure">{copy.activitiesNote}</p>
    <dl class="activity-fields">{copy.activityFields.map(([label, value]) => <div><dt>{label}</dt><dd>{value.startsWith('http') ? <a href={value} target="_blank" rel="noopener noreferrer">{value}</a> : value}</dd></div>)}</dl>
    <div class="application-copy"><h3>{copy.applicationTitle}</h3><p>{copy.applicationText}</p></div>
  </section>

  <aside class="integrity"><h2>{copy.integrityTitle}</h2><p>{copy.integrity}</p></aside>
  <p class="return-link"><a href={base}>{copy.back} <span aria-hidden="true">→</span></a></p>
</section>

<style>
  .portfolio{max-width:1060px;margin:0 auto;padding:clamp(.5rem,2vw,1.5rem) 0 4rem;color:var(--text)}
  .portfolio-hero{max-width:850px;padding:clamp(2rem,7vw,5rem) 0 2rem}.eyebrow,.section-kicker{font-size:.74rem;font-weight:800;letter-spacing:.12em;color:var(--accent);margin:0 0 .7rem}.portfolio h1{font-size:clamp(2.35rem,6vw,4.8rem);line-height:1.04;letter-spacing:-.055em;margin:0;max-width:820px}.lead{font-size:clamp(1.05rem,2.2vw,1.3rem);line-height:1.7;color:var(--muted);max-width:760px;margin:1.3rem 0 0}.actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.8rem}.button{display:inline-flex;align-items:center;gap:.5rem;padding:.78rem 1rem;border-radius:10px;font-weight:750;text-decoration:none;border:1px solid var(--border)}.button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.button.secondary{color:var(--text);background:var(--surface)}.button:hover,.return-link a:hover{text-decoration:underline;text-underline-offset:3px}
  .quick-facts{display:grid;grid-template-columns:repeat(4,1fr);margin:1.4rem 0 4rem;border:1px solid var(--border);border-radius:16px;overflow:hidden;background:var(--surface)}.quick-facts div{padding:1.1rem;border-right:1px solid var(--border)}.quick-facts div:last-child{border-right:0}.quick-facts dt,.activity-fields dt{font-size:.76rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:.45rem}.quick-facts dd{font-size:.94rem;line-height:1.45;margin:0;font-weight:650}
  .story-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.panel,.role-section,.evidence,.direction,.activities{border-top:1px solid var(--border);padding:2rem 0}.panel{border:1px solid var(--border);border-radius:16px;padding:1.5rem;background:var(--surface)}.accent-panel{background:color-mix(in srgb,var(--accent) 8%,var(--surface))}.portfolio h2{font-size:clamp(1.5rem,3.4vw,2.1rem);line-height:1.12;letter-spacing:-.03em;margin:.05rem 0 .8rem}.portfolio h3{font-size:1rem;line-height:1.3;margin:0 0 .45rem}.portfolio p{line-height:1.68}.panel p,.role-grid p,.evidence-list p,.direction>p:last-child,.integrity p{color:var(--muted);margin:0}.role-section{margin-top:3.5rem}.role-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:1.3rem}.role-grid article{padding:1.15rem;border:1px solid var(--border);border-radius:12px;background:var(--surface)}
  .evidence{margin-top:1rem}.disclosure{background:color-mix(in srgb,var(--accent) 7%,var(--surface));border-left:3px solid var(--accent);padding:.85rem 1rem;border-radius:0 10px 10px 0;color:var(--muted);margin:0 0 1.25rem}.evidence-list{display:grid;gap:.8rem}.evidence-list article{display:grid;grid-template-columns:3.1rem 1fr;gap:.8rem;padding:1.05rem 0;border-bottom:1px solid var(--border)}.evidence-list article>span{color:var(--accent);font-weight:850;font-size:.82rem}.evidence-list a,.activity-fields a,.return-link a{color:var(--accent);overflow-wrap:anywhere}.evidence-list p{margin:0 0 .4rem}.evidence-list a{font-size:.83rem}
  .direction{margin-top:1rem;max-width:830px}.activities{margin-top:2.5rem}.activity-fields{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;margin:1.3rem 0}.activity-fields>div{padding:1rem;border:1px solid var(--border);border-radius:10px;background:var(--surface)}.activity-fields dd{margin:0;line-height:1.55}.application-copy{padding:1.15rem 1.2rem;border-radius:12px;background:color-mix(in srgb,var(--accent) 8%,var(--surface));border:1px solid color-mix(in srgb,var(--accent) 30%,var(--border))}.application-copy p{margin:0;line-height:1.65}.integrity{margin-top:2.5rem;padding:1.2rem 1.3rem;border:1px solid var(--border);border-radius:14px}.integrity h2{font-size:1.05rem;margin:0 0 .35rem}.return-link{margin-top:2rem}.return-link a{font-weight:750;text-decoration:none}
  @media(max-width:720px){.portfolio{padding-left:0;padding-right:0}.quick-facts{grid-template-columns:1fr 1fr;margin-bottom:2.8rem}.quick-facts div:nth-child(2){border-right:0}.quick-facts div:nth-child(n+3){border-top:1px solid var(--border)}.story-grid,.role-grid,.activity-fields{grid-template-columns:1fr}.role-section{margin-top:2.5rem}.portfolio h1{font-size:clamp(2.2rem,12vw,3.3rem)}}
  @media(max-width:390px){.quick-facts{grid-template-columns:1fr}.quick-facts div{border-right:0!important;border-top:1px solid var(--border)}.quick-facts div:first-child{border-top:0}.actions{align-items:stretch}.button{width:100%;justify-content:center}.portfolio-hero{padding-top:1.4rem}.evidence-list article{grid-template-columns:2.2rem 1fr}}
</style>

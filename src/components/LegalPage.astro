---
import Base from '../layouts/Base.astro';
type Lang = 'uz' | 'en' | 'ru';
const { lang, kind } = Astro.props as { lang: Lang; kind: 'privacy' | 'terms' };
const base = import.meta.env.BASE_URL;
const paths = kind === 'privacy'
  ? { uz: 'maxfiylik-siyosati/', en: 'en/privacy-policy/', ru: 'ru/politika-konfidentsialnosti/' }
  : { uz: 'foydalanish-shartlari/', en: 'en/terms-of-use/', ru: 'ru/usloviya-ispolzovaniya/' };
const alternates = (Object.entries(paths) as [Lang, string][]).map(([locale, path]) => ({ lang: locale, href: base + path }));
const text = {
  privacy: {
    uz: { title: 'Maxfiylik siyosati — Tayanch', description: 'Tayanch saytida ma’lumotlar qanday yig‘ilishi, ishlatilishi va himoyalanishi haqida.', eyebrow: 'MAXFIYLIK', h1: 'Maxfiylik siyosati', updated: 'Oxirgi yangilanish: 2026-yil 24-avgust', sections: [['Qanday ma’lumot yig‘iladi', 'Tayanch xizmatdan foydalanishingiz uchun zarur bo‘lgan minimal ma’lumotlarni yig‘adi.', ['Google orqali kirish:', 'Google bilan kirganingizda ismingiz, email manzilingiz va profil rasmingizni profil yaratish uchun olamiz. Google parolingizga kira olmaymiz.', 'Speaking audio va transcript:', 'AI feedbackdan foydalanish uchun yozib olingan audio, transcript, savol konteksti hamda practice natijasi siz kirgan Supabase profilingizga bog‘lanib, private storage va ma’lumotlar bazasida saqlanishi mumkin. Audio faqat mashq natijasini yaratish va texnik nosozlikni tekshirish uchun ishlatiladi.', 'AI tahlili:', 'Speaking feedback uchun transcript va savol mazmuni Anthropic AI xizmatiga yuborilishi mumkin. AI natijasi rasmiy IELTS bahosi emas; u mashq uchun avtomatik tavsiyadir.', 'Murojaatlar:', 'Telegram yoki email orqali yuborgan xabaringiz murojaatingizga javob berish uchun ishlatiladi.', 'Google Analytics:', 'Sayt Google Analytics’dan sahifalarni ko‘rish va CTA tugmalari bosilishi kabi pseudonim foydalanish va o‘zaro ta’sir ma’lumotlarini yig‘ish uchun foydalanadi. Ushbu ma’lumotlar saytni yaxshilash uchun qo‘llanadi. Google Analytics’ni brauzer sozlamalari yoki kontent bloklagichlari orqali cheklashingiz mumkin.']], ['To‘lovlar', 'Hozircha to‘lovlar Telegram orqali qo‘lda tasdiqlanadi. Sayt karta raqami, karta CVC kodi yoki bank parolini so‘ramaydi va saqlamaydi. To‘lov rekvizitlari faqat Telegramdagi to‘g‘ridan-to‘g‘ri muloqotda beriladi.'], ['Ma’lumotni ulashish', 'Shaxsiy ma’lumotlaringiz reklama maqsadida sotilmaydi. Ma’lumot faqat xizmatni ko‘rsatish, savollarga javob berish yoki qonuniy majburiyat mavjud bo‘lganda ishlatilishi mumkin.'], ['Sizning huquqlaringiz', 'Google kirish ma’lumotlarini brauzeringizdagi sayt ma’lumotlarini tozalash yoki header’dagi “Chiqish” tugmasi orqali o‘chirishingiz mumkin. Telegram/email orqali yuborgan ma’lumotlaringiz bo‘yicha savol, tuzatish yoki o‘chirish so‘rovini yuborishingiz mumkin.'], ['Bog‘lanish', 'Maxfiylik bo‘yicha savol uchun']] },
    en: { title: 'Privacy Policy — Tayanch', description: 'How Tayanch collects, uses, and protects information.', eyebrow: 'PRIVACY', h1: 'Privacy Policy', updated: 'Last updated: August 24, 2026', sections: [['Information we collect', 'Tayanch collects the minimum information needed for you to use the service.', ['Google sign-in:', 'When you sign in with Google, we use your name, email address, and profile photo to create your profile. We cannot access your Google password.', 'Speaking audio and transcript:', 'To provide AI feedback, recorded audio, the transcript, question context, and practice results may be linked to your signed-in Supabase profile and stored in private storage and the database. Audio is used only to generate practice results and investigate technical issues.', 'AI analysis:', 'For speaking feedback, the transcript and question content may be sent to Anthropic AI. The AI result is not an official IELTS score; it is an automated practice recommendation.', 'Messages:', 'Messages you send through Telegram or email are used to respond to your request.', 'Google Analytics:', 'The site uses Google Analytics to collect pseudonymous usage and interaction data, such as pages viewed and CTA clicks. This information is used to improve the site. You can limit Google Analytics through browser controls or content blockers.']], ['Payments', 'For now, payments are confirmed manually through Telegram. The site does not request or store card numbers, card CVC codes, or banking passwords. Payment details are shared only in direct Telegram communication.'], ['Sharing information', 'Your personal information is not sold for advertising. Information may be used only to provide the service, answer questions, or meet a legal obligation.'], ['Your rights', 'You can remove Google sign-in information by clearing this site’s data in your browser or using the “Sign out” button in the header. You may ask questions about, correct, or request deletion of information sent through Telegram or email.'], ['Contact', 'For privacy questions, contact']] },
    ru: { title: 'Политика конфиденциальности — Tayanch', description: 'Как Tayanch собирает, использует и защищает информацию.', eyebrow: 'КОНФИДЕНЦИАЛЬНОСТЬ', h1: 'Политика конфиденциальности', updated: 'Последнее обновление: 24 августа 2026 г.', sections: [['Какие данные мы собираем', 'Tayanch собирает минимальный объём данных, необходимый для использования сервиса.', ['Вход через Google:', 'При входе через Google мы используем ваше имя, адрес электронной почты и фотографию профиля для создания профиля. Мы не имеем доступа к вашему паролю Google.', 'Аудио и расшифровка Speaking:', 'Для AI-обратной связи записанное аудио, расшифровка, контекст вопроса и результаты практики могут быть привязаны к вашему профилю Supabase и храниться в закрытом хранилище и базе данных. Аудио используется только для формирования результата практики и проверки технических неисправностей.', 'AI-анализ:', 'Для обратной связи по Speaking расшифровка и содержание вопроса могут передаваться сервису Anthropic AI. Результат AI не является официальной оценкой IELTS; это автоматическая рекомендация для практики.', 'Обращения:', 'Сообщения, отправленные через Telegram или email, используются для ответа на ваше обращение.', 'Google Analytics:', 'Сайт использует Google Analytics для сбора псевдонимизированных данных об использовании и взаимодействии, таких как просмотренные страницы и нажатия на CTA. Эти данные используются для улучшения сайта. Вы можете ограничить Google Analytics с помощью настроек браузера или блокировщиков контента.']], ['Платежи', 'Пока платежи подтверждаются вручную через Telegram. Сайт не запрашивает и не хранит номера карт, коды CVC или банковские пароли. Платёжные реквизиты сообщаются только в прямом общении в Telegram.'], ['Передача данных', 'Ваши персональные данные не продаются в рекламных целях. Данные могут использоваться только для оказания услуги, ответов на вопросы или выполнения юридической обязанности.'], ['Ваши права', 'Вы можете удалить данные входа через Google, очистив данные сайта в браузере или нажав кнопку «Выйти» в шапке сайта. Вы можете задать вопрос, исправить данные или запросить удаление информации, отправленной через Telegram или email.'], ['Связь', 'По вопросам конфиденциальности напишите на']] }
  },
  terms: {
    uz: { title: 'Foydalanish shartlari — Tayanch', description: 'Tayanch kurslaridan foydalanish, to‘lov va qaytarish shartlari.', eyebrow: 'HUQUQIY MA’LUMOT', h1: 'Foydalanish shartlari va qaytarish siyosati', updated: 'Oxirgi yangilanish: 2026-yil 22-avgust', sections: [['1. Xizmat haqida', 'Tayanch amaliy onlayn kurslar, mashqlar va o‘quv materiallarini taqdim etadi. Kurs tarkibi sahifadagi tavsifda ko‘rsatiladi. Ayrim materiallar vaqt o‘tishi bilan yangilanishi yoki to‘ldirilishi mumkin.'], ['2. To‘lovlar', 'Hozircha to‘lovlar Telegram orqali qo‘lda tasdiqlanadi. Foydalanuvchi kurs nomi va narxi bilan murojaat qiladi, to‘lov rekvizitlarini oladi va to‘lov cheki yuborilgach kirish havolasi qo‘lda beriladi.', 'Sayt karta raqami, CVC kodi yoki bank parolini qabul qilmaydi. To‘lov rekvizitlari va yakuniy summa Telegramdagi suhbatda yana tasdiqlanadi.'], ['3. Kursga kirish va forever access', 'To‘lov tasdiqlangach, foydalanuvchiga kursga kirish havolasi yuboriladi. “Forever access” kurs sahifada mavjud bo‘lib turgan paytda xarid qilingan materiallarga kirish niyatini bildiradi. Xizmat texnik ishlashi, kontentning qonuniyligi yoki xavfsizlik talabi sababli o‘zgarishi mumkin.'], ['4. Qaytarish siyosati', ['To‘lovdan oldin kurs tavsifi va narxini diqqat bilan tekshiring.', 'Kirish havolasi yuborilmagan yoki noto‘g‘ri kursga to‘lov qilingan holatlar individual tartibda ko‘rib chiqiladi.', 'Kirish havolasi va materiallar yuborilganidan keyin avtomatik refund va’dasi berilmaydi.', 'Texnik xato, noto‘g‘ri to‘lov summasi yoki ikki marta to‘lov bo‘lsa, Telegram orqali murojaat qiling; holat individual tekshiriladi.']], ['5. AI Speaking mashqlari', 'Speaking mashqida foydalanuvchi o‘z audio yozuvi va/yoki transcriptini yuborishi mumkin. AI yaratgan band score estimate va tavsiyalar faqat mashq uchun mo‘ljallangan; ular rasmiy IELTS bahosi, sertifikat yoki imtihon natijasi emas. Transcriptga asoslangan MVP talaffuzning akustik sifatini to‘liq baholamaydi.', 'Audio yozuv faqat foydalanuvchi mikrofon ruxsatini berganda olinadi. Foydalanuvchi o‘zining va boshqalarning maxfiy yoki ruxsatsiz audio ma’lumotlarini yubormasligi kerak.'], ['6. Foydalanuvchi majburiyatlari', 'Kurs materiallari shaxsiy o‘qish uchun beriladi. Ularni ruxsatsiz nusxalash, qayta sotish, ommaga tarqatish yoki kursga kirish havolasini boshqalarga yuborish taqiqlanadi.'], ['7. Mas’uliyat cheklovi', 'Kurslar ta’limiy maqsadda beriladi. Ular ishga joylashish, imtihon natijasi, grant, qabul yoki daromad bo‘yicha kafolat bermaydi.'], ['8. Aloqa', 'To‘lov, kirish yoki refund savollari uchun'], ['9. Intellektual mulk va mualliflik huquqi', 'Ushbu saytning barcha kontenti — kurs matnlari, darslar, diagrammalar, kod namunalari, dizayn, logotip va saytning o‘z manba kodi — mualliflik huquqi bilan himoyalangan. Muallif: Javohir Qaxramonov (Tayanch).', 'Ushbu saytning kodi, dizayni va kontentini muallif ruxsatisiz nusxalash, o‘zgartirish, qayta tarqatish yoki tijorat maqsadida ishlatish qat’iyan taqiqlanadi.', 'Materiallardan faqat shaxsiy o‘qish uchun foydalanishga ruxsat etiladi. Boshqa har qanday foydalanish (nusxalash, qayta nashr qilish, o‘quv markazida ishlatish) uchun muallifdan oldindan yozma ruxsat olish shart. Huquqbuzarlik aniqlansa, qonuniy chora ko‘rilishi mumkin.']] },
    en: { title: 'Terms of Use — Tayanch', description: 'Terms for using Tayanch courses, including payment and refund policies.', eyebrow: 'LEGAL INFORMATION', h1: 'Terms of Use and Refund Policy', updated: 'Last updated: August 22, 2026', sections: [['1. About the service', 'Tayanch provides practical online courses, exercises, and learning materials. Course contents are described on the relevant page. Some materials may be updated or expanded over time.'], ['2. Payments', 'For now, payments are confirmed manually through Telegram. The user contacts us with the course name and price, receives payment details, and receives the access link manually after sending a payment receipt.', 'The site does not accept card numbers, CVC codes, or banking passwords. Payment details and the final amount are reconfirmed in the Telegram conversation.'], ['3. Course access and forever access', 'Once payment is confirmed, the user is sent a course access link. “Forever access” expresses the intention to provide access to purchased materials while the course remains available on the site. The service may change because of technical operation, content legality, or security requirements.'], ['4. Refund policy', ['Review the course description and price carefully before paying.', 'Cases where the access link was not sent or payment was made for the wrong course are reviewed individually.', 'No automatic refund is promised after the access link and materials have been sent.', 'For a technical error, an incorrect payment amount, or a duplicate payment, contact us on Telegram; the case will be reviewed individually.']], ['5. AI Speaking practice', 'In Speaking practice, the user may submit their own audio recording and/or transcript. The AI-generated band score estimate and recommendations are for practice only; they are not an official IELTS score, certificate, or exam result. The transcript-based MVP cannot fully assess the acoustic quality of pronunciation.', 'Audio is recorded only when the user grants microphone permission. Users must not submit private or unauthorized audio information about themselves or others.'], ['6. User responsibilities', 'Course materials are provided for personal study. Copying, reselling, publicly distributing them, or sending course access links to others without permission is prohibited.'], ['7. Limitation of liability', 'Courses are provided for educational purposes. They do not guarantee employment, exam results, a grant, admission, or income.'], ['8. Contact', 'For payment, access, or refund questions,'], ['9. Intellectual property and copyright', 'All content on this site—including course texts, lessons, diagrams, code samples, design, logo, and the site’s own source code—is protected by copyright. Author: Javohir Qaxramonov (Tayanch).', 'Copying, modifying, redistributing, or using this site’s code, design, or content for commercial purposes without the author’s permission is strictly prohibited.', 'Materials may be used only for personal study. Any other use (copying, republication, or use in an educational center) requires the author’s prior written permission. Legal action may be taken if an infringement is identified.']] },
    ru: { title: 'Условия использования — Tayanch', description: 'Условия использования курсов Tayanch, включая оплату и возврат средств.', eyebrow: 'ЮРИДИЧЕСКАЯ ИНФОРМАЦИЯ', h1: 'Условия использования и политика возврата средств', updated: 'Последнее обновление: 22 августа 2026 г.', sections: [['1. О сервисе', 'Tayanch предоставляет практические онлайн-курсы, упражнения и учебные материалы. Состав курса указан в описании на его странице. Некоторые материалы со временем могут обновляться или дополняться.'], ['2. Платежи', 'Пока платежи подтверждаются вручную через Telegram. Пользователь обращается с названием и ценой курса, получает платёжные реквизиты, а ссылка для доступа выдаётся вручную после отправки чека об оплате.', 'Сайт не принимает номера карт, коды CVC или банковские пароли. Платёжные реквизиты и окончательная сумма повторно подтверждаются в переписке в Telegram.'], ['3. Доступ к курсу и forever access', 'После подтверждения оплаты пользователю отправляется ссылка для доступа к курсу. «Forever access» означает намерение предоставить доступ к приобретённым материалам, пока курс доступен на сайте. Сервис может изменяться по причинам технической работы, законности контента или требований безопасности.'], ['4. Политика возврата', ['До оплаты внимательно ознакомьтесь с описанием и ценой курса.', 'Случаи, когда ссылка для доступа не отправлена или оплата произведена за неверный курс, рассматриваются индивидуально.', 'После отправки ссылки для доступа и материалов автоматический возврат не гарантируется.', 'При технической ошибке, неверной сумме или двойной оплате напишите в Telegram; случай будет рассмотрен индивидуально.']], ['5. Практика AI Speaking', 'В практике Speaking пользователь может отправить собственную аудиозапись и/или расшифровку. Оценка band score и рекомендации, созданные AI, предназначены только для практики; это не официальная оценка IELTS, сертификат или результат экзамена. MVP на основе расшифровки не может полностью оценить акустическое качество произношения.', 'Аудиозапись производится только при предоставлении пользователем разрешения на микрофон. Пользователь не должен отправлять конфиденциальные или несанкционированные аудиоданные о себе или других лицах.'], ['6. Обязанности пользователя', 'Материалы курса предоставляются для личного обучения. Запрещается без разрешения копировать, перепродавать, публично распространять материалы или передавать другим лицам ссылку для доступа к курсу.'], ['7. Ограничение ответственности', 'Курсы предоставляются в образовательных целях. Они не гарантируют трудоустройство, результат экзамена, грант, поступление или доход.'], ['8. Связь', 'По вопросам оплаты, доступа или возврата средств'], ['9. Интеллектуальная собственность и авторское право', 'Весь контент этого сайта — тексты курсов, уроки, диаграммы, примеры кода, дизайн, логотип и исходный код сайта — защищён авторским правом. Автор: Javohir Qaxramonov (Tayanch).', 'Копирование, изменение, распространение или коммерческое использование кода, дизайна или контента сайта без разрешения автора строго запрещено.', 'Материалы разрешается использовать только для личного обучения. Любое иное использование (копирование, повторная публикация или использование в учебном центре) требует предварительного письменного разрешения автора. При выявлении нарушения могут быть приняты юридические меры.']] }
  }
}[kind][lang];
---
<Base title={text.title} description={text.description} lang={lang} localeAlternates={alternates}>
  <article class="legal-page"><p class="eyebrow">{text.eyebrow}</p><h1>{text.h1}</h1><p class="updated">{text.updated}</p>
  {text.sections.map((section) => <section><h2>{section[0]}</h2>{section.slice(1).map((item) => Array.isArray(item) ? (kind === 'privacy' && section[0] === text.sections[0][0] ? <ul>{Array.from({ length: item.length / 2 }, (_, i) => <li><strong>{item[i * 2]}</strong> {item[i * 2 + 1]}</li>)}</ul> : <ul>{item.map((entry) => <li>{entry}</li>)}</ul>) : <p>{item}</p>)}{section[0] === 'Contact' || section[0] === 'Bog‘lanish' || section[0] === 'Связь' ? <p><a href={kind === 'privacy' ? 'mailto:javohirqaxramonov36@gmail.com' : 'https://t.me/progression_go'} target={kind === 'privacy' ? undefined : '_blank'} rel={kind === 'privacy' ? undefined : 'noopener noreferrer'}>{kind === 'privacy' ? 'javohirqaxramonov36@gmail.com' : lang === 'en' ? 'write to us on Telegram' : lang === 'ru' ? 'напишите в Telegram' : 'Telegram orqali yozing'}</a>{kind === 'privacy' ? (lang === 'en' ? ' or ' : lang === 'ru' ? ' или через ' : ' yoki ') : ''}{kind === 'privacy' ? <a href="https://t.me/progression_go" target="_blank" rel="noopener noreferrer">Telegram</a> : null}.</p> : null}</section>)}
  </article>
</Base>
<style>.legal-page{max-width:820px;margin:2rem auto;padding:1rem 1.5rem 3rem}.eyebrow{color:var(--accent);font-weight:800;letter-spacing:.12em;font-size:.76rem}.legal-page h1{margin:.25rem 0 .35rem}.legal-page h2{margin:2rem 0 .65rem;font-size:1.2rem}.legal-page p,.legal-page li{color:var(--muted);line-height:1.7}.legal-page ul{padding-left:1.3rem}.legal-page li{margin:.65rem 0}.legal-page li strong{color:var(--text)}.legal-page a{color:var(--accent)}.updated{margin:0;font-size:.9rem}</style>

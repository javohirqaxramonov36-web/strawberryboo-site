---
import Base from '../layouts/Base.astro';
type Lang = 'uz'|'ru'|'en'; const {lang,kind}=Astro.props as {lang:Lang;kind:'privacy'|'terms'}; const base=import.meta.env.BASE_URL;
const paths=kind==='privacy'?{uz:'maxfiylik-siyosati/',ru:'ru/politika-konfidentsialnosti/',en:'en/privacy-policy/'}:{uz:'foydalanish-shartlari/',ru:'ru/usloviya-ispolzovaniya/',en:'en/terms-of-use/'};
const all={
 uz:{privacy:['Maxfiylik siyosati','Tayanch ma’lumotlardan qanday foydalanishini tushuntiradi.',[['Ma’lumotlar','Google orqali kirilganda ism, email va profil rasmi profil yaratish uchun ishlatilishi mumkin. Speaking mashqida audio, transcript, savol konteksti va natijalar profilingizga bog‘lanib saqlanishi mumkin.'],['Tahlil va statistika','Speaking feedback uchun transcript va savol mazmuni AI xizmatiga yuborilishi mumkin; natija rasmiy IELTS bahosi emas. Google Analytics pseudonim sahifa ko‘rishlari va CTA bosilishlarini saytni yaxshilash uchun qayd etishi mumkin.'],['To‘lov va murojaatlar','To‘lovlar Telegram orqali qo‘lda tasdiqlanadi. Sayt karta raqami, CVC yoki bank parolini so‘ramaydi va saqlamaydi. Telegram yoki email murojaatlari javob berish uchun ishlatiladi.'],['Bog‘lanish','Savol yoki ma’lumot bo‘yicha murojaat uchun Telegram yoki emaildan foydalaning.']]],terms:['Foydalanish shartlari','Tayanch kurslari va mashqlaridan foydalanish qoidalari.',[['Xizmat','Tayanch sahifalarda tasvirlangan amaliy onlayn kurslar, mashqlar va o‘quv materiallarini taqdim etadi. Materiallar vaqt o‘tishi bilan yangilanishi mumkin.'],['To‘lov va kirish','To‘lov Telegram orqali qo‘lda tasdiqlanadi: foydalanuvchi kurs nomi bilan yozadi, rekvizitlarni oladi va chek yuboradi. Tasdiqdan keyin kirish havolasi qo‘lda yuboriladi. Kurs sahifasidagi “forever access” kurs saytda mavjud bo‘lgan vaqt davomida xarid qilingan materiallardan foydalanish niyatini bildiradi.'],['Mashq vositalari','AI Speaking tavsiyalari faqat mashq uchun va rasmiy IELTS bahosi yoki sertifikat emas. Foydalanuvchi faqat o‘zining audio yoki matnini yuborishi kerak.'],['Mas’uliyatli foydalanish','Sayt va materiallardan qonuniy foydalaning, boshqalarning hisobidan foydalanmang va kontentni ruxsatsiz qayta tarqatmang.']]]},
 en:{privacy:['Privacy Policy','How Tayanch handles information.',[['Information','When you sign in with Google, your name, email, and profile photo may be used to create a profile. Speaking audio, transcript, question context, and results may be stored with your profile.'],['Analysis and analytics','A transcript and question content may be sent to an AI service for Speaking feedback; the result is not an official IELTS score. Google Analytics may record pseudonymous page views and CTA clicks to improve the site.'],['Payments and messages','Payments are manually confirmed through Telegram. The site does not request or store card numbers, CVC codes, or banking passwords. Telegram or email messages are used to respond to you.'],['Contact','Use Telegram or email for questions about information.']]],terms:['Terms of Use','Rules for using Tayanch courses and practice tools.',[['Service','Tayanch provides practical online courses, exercises, and learning materials described on its pages. Materials may be updated over time.'],['Payment and access','Payment is manually confirmed through Telegram: a learner writes with the course name, receives payment details, and sends a receipt. An access link is sent manually after confirmation. “Forever access” on a course page expresses the intention to provide purchased materials while that course remains available on the site.'],['Practice tools','AI Speaking suggestions are for practice only and are not an official IELTS score or certificate. Submit only audio or text that is yours.'],['Responsible use','Use the site and materials lawfully, do not use another person’s account, and do not redistribute content without permission.']]]},
 ru:{privacy:['Политика конфиденциальности','Как Tayanch обрабатывает информацию.',[['Данные','При входе через Google имя, email и фото профиля могут использоваться для создания профиля. Аудио Speaking, расшифровка, контекст вопроса и результаты могут храниться вместе с профилем.'],['Анализ и статистика','Расшифровка и вопрос могут передаваться AI-сервису для обратной связи по Speaking; результат не является официальной оценкой IELTS. Google Analytics может фиксировать псевдонимизированные просмотры и нажатия CTA для улучшения сайта.'],['Оплата и обращения','Оплата подтверждается вручную через Telegram. Сайт не запрашивает и не хранит номера карт, CVC или банковские пароли. Сообщения в Telegram или email используются для ответа.'],['Связь','По вопросам данных пишите в Telegram или email.']]],terms:['Условия использования','Правила использования курсов и практических инструментов Tayanch.',[['Сервис','Tayanch предоставляет практические онлайн-курсы, упражнения и учебные материалы, описанные на страницах сайта. Материалы могут обновляться.'],['Оплата и доступ','Оплата вручную подтверждается через Telegram: ученик пишет название курса, получает реквизиты и отправляет чек. После подтверждения ссылка доступа отправляется вручную. «Forever access» на странице курса означает намерение предоставлять купленные материалы, пока курс доступен на сайте.'],['Инструменты практики','AI-рекомендации по Speaking предназначены только для практики и не являются официальной оценкой IELTS или сертификатом. Отправляйте только свои аудио или тексты.'],['Ответственное использование','Используйте сайт законно, не используйте чужой аккаунт и не распространяйте материалы без разрешения.']]]}
} as const; const t=all[lang][kind]; const alternates=Object.entries(paths).map(([locale,href])=>({lang:locale,href:base+href}));
---
<Base title={`${t[0]} — Tayanch`} description={t[1]} {lang} localeAlternates={alternates}><article class="legal"><p class="eyebrow">TAYANCH</p><h1>{t[0]}</h1><p class="updated">24 August 2026</p>{t[2].map(([h,p])=><section><h2>{h}</h2><p>{p}</p></section>)}</article></Base>
<style>.legal{max-width:780px;margin:0 auto}.legal h1{font-size:clamp(2rem,5vw,3rem)}.legal h2{margin-top:2rem}.legal p{color:var(--muted);line-height:1.75}.eyebrow{color:var(--accent);font-weight:800;letter-spacing:.12em}.updated{font-size:.9rem}.refund-link{margin-top:2rem}.refund-link a{color:var(--accent);font-weight:800}</style>

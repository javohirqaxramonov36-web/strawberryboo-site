---
import Base from '../layouts/Base.astro';
type Lang = 'uz' | 'ru' | 'en';
const { lang = 'uz' } = Astro.props as { lang?: Lang };
const base = import.meta.env.BASE_URL;
const data = {
  uz: { title: 'Qaytarish siyosati', lead: 'To‘lov, raqamli kursga kirish va murojaatlarni ko‘rib chiqish tartibi.', sections: [['Amaldagi to‘lov tartibi', 'To‘lov hozircha Telegram orqali qo‘lda tasdiqlanadi. Kurs nomi, yakuniy summa va to‘lov rekvizitlarini to‘lovdan oldin yana tekshiring. Sayt karta raqami, CVC yoki bank parolini qabul qilmaydi.'], ['Kirish berilmagan yoki noto‘g‘ri kurs', 'To‘lov tasdiqlangan bo‘lsa-yu, kirish havolasi yuborilmagan yoki noto‘g‘ri kurs yuborilgan bo‘lsa, chek va murojaat tafsilotlarini Telegram orqali yuboring. Holat tekshiriladi va tuzatish yoki qaytarish imkoniyati alohida ko‘rib chiqiladi.'], ['Texnik xato yoki ikki marta to‘lov', 'Texnik xato, noto‘g‘ri summa yoki takroriy to‘lov haqida imkon qadar tez yozing. Tranzaksiya ma’lumotlari tekshirilgach, zarur tuzatish yoki qaytarish bo‘yicha javob beriladi.'], ['Raqamli kontentga kirilgandan keyin', 'Kirish havolasi va materiallar yuborilgandan keyingi qaytarish qoidasi hozircha alohida tasdiqlanmagan. Shu sababli sayt avtomatik yoki kafolatlangan refund va’dasini bermaydi; murojaatlar holat bo‘yicha ko‘rib chiqiladi.'], ['Aloqa', 'Qaytarish yoki to‘lov masalasi uchun Telegram orqali yozing. Murojaatda kurs nomi, to‘lov sanasi va chekni yuboring.'] ], contact: 'Telegram orqali yozish →', terms: 'Foydalanish shartlarini ham ko‘rish' },
  ru: { title: 'Политика возврата', lead: 'Порядок по оплате, доступу к цифровому курсу и обращениям.', sections: [['Текущий порядок оплаты', 'Оплата пока подтверждается вручную через Telegram. До оплаты ещё раз проверьте название курса, итоговую сумму и реквизиты. Сайт не принимает номера карт, CVC или банковские пароли.'], ['Нет доступа или отправлен не тот курс', 'Если оплата подтверждена, но ссылка не пришла или был отправлен другой курс, напишите в Telegram и приложите чек. Случай будет проверен; исправление или возврат рассматриваются отдельно.'], ['Техническая ошибка или двойная оплата', 'Сообщите о технической ошибке, неверной сумме или повторной оплате как можно скорее. После проверки данных транзакции будет дан ответ о необходимом исправлении или возврате.'], ['После доступа к цифровому контенту', 'Правило возврата после отправки ссылки и материалов пока не утверждено отдельно. Поэтому сайт не обещает автоматический или гарантированный возврат; обращения рассматриваются индивидуально.'], ['Контакт', 'По вопросам оплаты или возврата напишите в Telegram и укажите курс, дату оплаты и приложите чек.'] ], contact: 'Написать в Telegram →', terms: 'Также открыть условия использования' },
  en: { title: 'Refund policy', lead: 'How payment, digital-course access, and refund requests are handled.', sections: [['Current payment process', 'Payment is currently confirmed manually through Telegram. Check the course name, final amount, and payment details before paying. The site does not collect card numbers, CVC codes, or banking passwords.'], ['No access or wrong course', 'If payment was confirmed but the access link was not sent or the wrong course was sent, contact us on Telegram with the receipt. We will investigate; a correction or refund is considered case by case.'], ['Technical error or duplicate payment', 'Report a technical error, incorrect amount, or duplicate payment as soon as possible. After checking the transaction details, we will reply about the required correction or refund.'], ['After access to digital content', 'The rule for refunds after an access link and materials have been sent has not yet been approved separately. The site therefore does not promise an automatic or guaranteed refund; requests are reviewed individually.'], ['Contact', 'For a payment or refund question, message us on Telegram and include the course, payment date, and receipt.'] ], contact: 'Message us on Telegram →', terms: 'Also view the terms of use' },
} as const;
const t = data[lang];
const paths = { uz: 'qaytarish-siyosati/', ru: 'ru/politika-vozvrata/', en: 'en/refund-policy/' };
const alternates = Object.entries(paths).map(([l, href]) => ({ lang: l, href: base + href }));
---
<Base title={`${t.title} — Tayanch`} description={t.lead} {lang} localeAlternates={alternates}><article class="refund-page"><p class="eyebrow">TAYANCH</p><h1>{t.title}</h1><p class="lead">{t.lead}</p>{t.sections.map(([heading, text]) => <section><h2>{heading}</h2><p>{text}</p></section>)}<div class="refund-actions"><a class="start-btn" href="https://t.me/tayanch_go" target="_blank" rel="noopener noreferrer">{t.contact}</a><a class="course-nav-link" href={base + (lang === 'uz' ? 'foydalanish-shartlari/' : lang === 'ru' ? 'ru/usloviya-ispolzovaniya/' : 'en/terms-of-use/')}>{t.terms}</a></div></article></Base>
<style>.refund-page{max-width:780px;margin:0 auto}.refund-page h1{font-size:clamp(2rem,5vw,3rem);margin:.2rem 0}.eyebrow{color:var(--accent);font-weight:800;letter-spacing:.12em}.lead,.refund-page p{color:var(--muted);line-height:1.75}.refund-page h2{margin-top:2rem;font-size:1.2rem}.refund-actions{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin-top:2rem}</style>

---
import Base from '../layouts/Base.astro'; type Lang='uz'|'ru'|'en'; const {lang}=Astro.props as {lang:Lang}; const base=import.meta.env.BASE_URL;
const paths={uz:'ommaviy-oferta/',ru:'ru/publichnaya-oferta/',en:'en/public-offer/'}; const t={uz:{title:'Ommaviy oferta',lead:'Kurs sahifasida ko‘rsatilgan tanlangan kurs uchun kelishuv.',a:'1. Nima taklif qilinadi',b:'Tayanch tanlangan kurs sahifasida ko‘rsatilgan o‘quv materiallariga kirishni taklif qiladi. Tavsif, mavjudlik va narxni to‘lovdan oldin tekshiring.',c:'2. Qabul qilish va to‘lov',d:'Telegramda kurs nomi bilan murojaat qilish, yakuniy summa va rekvizitlarni tasdiqlash hamda chek yuborish kelishuvni qabul qilishni bildiradi. To‘lov saytda emas, Telegramdagi bevosita suhbatda qo‘lda tasdiqlanadi.',e:'3. Kirish',f:'To‘lov tasdiqlangach kirish havolasi qo‘lda yuboriladi. Kurs sahifasidagi “forever access” kurs saytda mavjud bo‘lgan vaqt davomida xarid qilingan materiallardan foydalanish niyatini bildiradi.',g:'4. Aloqa',h:'Savollar uchun Telegram orqali yozing.'},en:{title:'Public Offer',lead:'Agreement for the selected course shown on its page.',a:'1. What is offered',b:'Tayanch offers access to learning materials listed on the selected course page. Review its description, availability, and price before payment.',c:'2. Acceptance and payment',d:'Writing on Telegram with the course name, confirming the final amount and payment details, and sending a receipt indicate acceptance. Payment is not taken on the site; it is manually confirmed in direct Telegram communication.',e:'3. Access',f:'An access link is sent manually after payment confirmation. “Forever access” on a course page expresses the intention to provide purchased materials while that course remains available on the site.',g:'4. Contact',h:'Write on Telegram with questions.'},ru:{title:'Публичная оферта',lead:'Соглашение по выбранному курсу, указанному на его странице.',a:'1. Что предлагается',b:'Tayanch предлагает доступ к учебным материалам, указанным на странице выбранного курса. До оплаты проверьте описание, доступность и цену.',c:'2. Принятие и оплата',d:'Обращение в Telegram с названием курса, подтверждение итоговой суммы и реквизитов, а также отправка чека означают принятие условий. Оплата не принимается на сайте: она вручную подтверждается в прямом диалоге Telegram.',e:'3. Доступ',f:'После подтверждения оплаты ссылка доступа отправляется вручную. «Forever access» на странице курса означает намерение предоставлять купленные материалы, пока курс доступен на сайте.',g:'4. Связь',h:'По вопросам пишите в Telegram.'}}[lang]; const alts=Object.entries(paths).map(([locale,href])=>({lang:locale,href:base+href}));
---
<Base title={`${t.title} — Tayanch`} description={t.lead} {lang} localeAlternates={alts}><article class="legal"><p class="eyebrow">TAYANCH</p><h1>{t.title}</h1><p class="lead">{t.lead}</p><h2>{t.a}</h2><p>{t.b}</p><h2>{t.c}</h2><p>{t.d}</p><h2>{t.e}</h2><p>{t.f}</p><h2>{t.g}</h2><p>{t.h} <a href="https://t.me/progression_go" target="_blank" rel="noopener noreferrer">Telegram</a>.</p></article></Base><style>.legal{max-width:780px;margin:auto}.legal p{line-height:1.75;color:var(--muted)}.eyebrow{color:var(--accent);font-weight:800;letter-spacing:.12em}</style>

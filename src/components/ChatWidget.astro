---
// ChatWidget — mustaqil, cheklangan yordamchi-chat widget.
// FAQ/KB asosida ishlaydi: hech qanday API kaliti, tashqi so'rov yoki
// fayl tizimiga kirish YO'Q. Mavzu chegarasi (kurslar/narxlar/sayt) kafolatlangan.
---

<div class="cw-root" id="cwRoot">
  <button class="cw-launcher" id="cwLauncher" aria-label="Savolingiz bormi?" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8A8.5 8.5 0 1 1 21 11.5z"/></svg>
    <span class="cw-launcher-label">Savolingiz bormi?</span>
  </button>

  <div class="cw-panel" id="cwPanel" hidden>
    <div class="cw-header">
      <div class="cw-header-title">
        <span class="cw-avatar" aria-label="Tayanch">T</span>
        <div>
          <strong>Tayanch</strong>
          <span class="cw-sub">Tayanch · kurslar va narxlar</span>
        </div>
      </div>
      <button class="cw-close" id="cwClose" aria-label="Yopish">&times;</button>
    </div>

    <div class="cw-messages" id="cwMessages"></div>

    <div class="cw-chips" id="cwChips">
      <button type="button" data-q="Kurslar ro'yxati">Kurslar</button>
      <button type="button" data-q="Narxlar qanday?">Narxlar</button>
      <button type="button" data-q="Qaysi kurs menga mos?">Menga mos kurs?</button>
      <button type="button" data-q="Saytdan qanday foydalanish">Sayt haqida</button>
    </div>

    <form class="cw-input" id="cwForm">
      <input id="cwInput" type="text" placeholder="Savolingizni yozing..." autocomplete="off" />
      <button type="submit" aria-label="Yuborish">&rarr;</button>
    </form>
  </div>
</div>

<style>
  .cw-root {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 1000;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  .cw-launcher {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    border: none;
    cursor: pointer;
    padding: 12px 18px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    box-shadow: var(--shadow);
    transition: transform .15s, box-shadow .15s;
  }
  .cw-launcher:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px -8px rgba(125,125,245,.6);
  }
  .cw-launcher svg { width: 20px; height: 20px; }
  .cw-launcher-label { white-space: nowrap; }

  .cw-panel {
    position: fixed;
    right: 20px;
    bottom: 84px;
    width: 360px;
    max-width: calc(100vw - 32px);
    height: 480px;
    max-height: calc(100vh - 120px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .cw-panel[hidden] { display: none; }

  .cw-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
  }
  .cw-header-title { display: flex; align-items: center; gap: 10px; }
  .cw-avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: rgba(255,255,255,.2);
    display: grid; place-items: center; font-weight: 800;
  }
  .cw-header strong { display: block; font-size: 0.95rem; }
  .cw-sub { font-size: 0.72rem; opacity: .85; }
  .cw-close {
    background: transparent; border: none; color: #fff;
    font-size: 1.5rem; line-height: 1; cursor: pointer; padding: 0 4px;
  }

  .cw-messages {
    flex: 1;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cw-msg {
    max-width: 85%;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 0.9rem;
    line-height: 1.45;
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  .cw-msg.bot {
    align-self: flex-start;
    background: var(--accent-soft);
    color: var(--text);
    border: 1px solid var(--border);
  }
  .cw-msg.user {
    align-self: flex-end;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
  }

  .cw-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 12px 8px; }
  .cw-chips button {
    background: var(--accent-soft);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.78rem;
    cursor: pointer;
    transition: background .15s;
  }
  .cw-chips button:hover { background: rgba(125,125,245,.22); }
  .cw-chips button:disabled { opacity: .55; cursor: wait; }

  .cw-input { display: flex; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--border); }
  .cw-input input {
    flex: 1;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 12px;
    color: var(--text);
    font-size: 0.9rem;
    outline: none;
  }
  .cw-input input:focus { border-color: var(--accent); }
  .cw-input button {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 10px;
    width: 42px;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background .15s;
  }
  .cw-input button:hover { background: var(--accent-2); }
  .cw-input input:disabled, .cw-input button:disabled { opacity: .65; cursor: wait; }
  .cw-loading { font-style: italic; opacity: .8; }

  @media (max-width: 480px) {
    .cw-panel { right: 12px; left: 12px; width: auto; bottom: 78px; }
    .cw-launcher-label { display: none; }
    .cw-launcher { padding: 14px; }
  }
</style>

<script>
  const CHAT_PROXY_URL = 'https://tayanch-ai-chat.javohirqaxramonov36.workers.dev';
  const launcher = document.getElementById('cwLauncher');
  const panel = document.getElementById('cwPanel');
  const closeBtn = document.getElementById('cwClose');
  const messages = document.getElementById('cwMessages');
  const form = document.getElementById('cwForm');
  const input = document.getElementById('cwInput');
  const chips = document.getElementById('cwChips');
  const submitButton = form.querySelector('button[type="submit"]');

  const WELCOME = "Salom! Men Tayanch yordamchisiman. Kurslar, narxlar va saytdan foydalanish haqida bemalol so'rang. Javoblar ingliz tilida beriladi.";
  const REQUEST_ERROR = "Kechirasiz, hozir javob olishda muammo bo'ldi. Birozdan keyin qayta urinib ko'ring.";

  function addMsg(text, who, options = {}) {
    const el = document.createElement('div');
    el.className = `cw-msg ${who}${options.loading ? ' cw-loading' : ''}`;
    el.textContent = text;
    messages.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
    return el;
  }

  function setBusy(isBusy) {
    input.disabled = isBusy;
    submitButton.disabled = isBusy;
    chips.querySelectorAll('button').forEach((button) => { button.disabled = isBusy; });
  }

  let welcomed = false;
  function openPanel() {
    panel.hidden = false;
    launcher.setAttribute('aria-expanded', 'true');
    if (!welcomed) {
      addMsg(WELCOME, 'bot');
      welcomed = true;
    }
    input.focus();
  }

  function closePanel() {
    panel.hidden = true;
    launcher.setAttribute('aria-expanded', 'false');
  }

  async function handle(raw) {
    const message = raw.trim();
    if (!message) return;

    addMsg(message, 'user');
    setBusy(true);
    const loading = addMsg('Yozmoqda…', 'bot', { loading: true });

    try {
      const response = await fetch(CHAT_PROXY_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message })
      });
      const data = await response.json().catch(() => ({}));
      loading.remove();
      addMsg(data.reply || data.error || REQUEST_ERROR, 'bot');
    } catch (error) {
      console.error('Tayanch chat request failed:', error);
      loading.remove();
      addMsg(REQUEST_ERROR, 'bot');
    } finally {
      setBusy(false);
      input.focus();
    }
  }

  launcher.addEventListener('click', () => { panel.hidden ? openPanel() : closePanel(); });
  closeBtn.addEventListener('click', closePanel);

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const value = input.value;
    input.value = '';
    handle(value);
  });

  chips.querySelectorAll('button').forEach((button) => {
    button.addEventListener('click', () => handle(button.dataset.q || ''));
  });
</script>

---
const { lang = 'uz' } = Astro.props as { lang?: 'uz'|'ru'|'en' };
const copy = { uz:{title:'Do‘stga havola yuboring',text:'Havola ref kodi bilan nusxalanadi. Bu faqat qo‘lda kuzatuv; avtomatik mukofot yoki chegirma yo‘q.',action:'Havolani nusxalash',share:'Telegram orqali ulashish',done:'Nusxalandi.'}, ru:{title:'Отправьте ссылку другу',text:'Ссылка копируется с ref-кодом. Это только ручной учёт: автоматических наград или скидок нет.',action:'Скопировать ссылку',share:'Поделиться в Telegram',done:'Скопировано.'}, en:{title:'Share a link with a friend',text:'The link is copied with a ref code. This is manual/basic tracking only; no automatic reward or discount applies.',action:'Copy link',share:'Share via Telegram',done:'Copied.'} }[lang];
---
<section class="referral-card" data-referral-card><h2>{copy.title}</h2><p>{copy.text}</p><div><button type="button" data-referral-copy data-done={copy.done}>{copy.action}</button><a data-referral-share target="_blank" rel="noopener noreferrer">{copy.share}</a></div></section>
<script is:inline>
 document.querySelectorAll('[data-referral-card]').forEach(function(card){var ref;try{ref=localStorage.getItem('tayanch.ref.v1');if(!ref){ref=Math.random().toString(36).slice(2,10);localStorage.setItem('tayanch.ref.v1',ref)}}catch(e){return}var u=new URL(location.origin+location.pathname);u.searchParams.set('ref',ref);var share=card.querySelector('[data-referral-share]');share.href='https://t.me/share/url?url='+encodeURIComponent(u.toString())+'&text='+encodeURIComponent('ref='+ref);card.querySelector('[data-referral-copy]').addEventListener('click',async function(e){try{await navigator.clipboard.writeText(u.toString());e.currentTarget.textContent=e.currentTarget.dataset.done}catch(err){}})})
</script>
<style>.referral-card{margin-top:20px;padding:28px;border:1px solid var(--border);border-radius:16px;background:var(--card)}.referral-card h2{margin:0 0 8px;font-size:1.15rem}.referral-card p{color:var(--muted);line-height:1.6}.referral-card div{display:flex;gap:.8rem;flex-wrap:wrap}.referral-card button,.referral-card a{border:0;border-radius:9px;padding:10px 14px;background: var(--btn-bg);color:#fff;font:700 .9rem inherit;cursor:pointer;text-decoration:none}.referral-card a{background:transparent;border:1px solid var(--border);color:var(--text)}</style>

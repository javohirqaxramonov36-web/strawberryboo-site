---
// Ingliz tili darajasini aniqlash (General English) — mahalliy, scoring-based.
// Ma'lumot faqat shu brauzer/qurilmada saqlanadi (backend yo'q).
const questions = [
  { q: "Men ishlayman: 'I ___ a student.'", opts: [ { t: "am", p: 4 }, { t: "is", p: 1 }, { t: "are", p: 1 }, { t: "be", p: 0 } ] },
  { q: "Qaysi gap to'g'ri?", opts: [ { t: "She go to school.", p: 0 }, { t: "She goes to school.", p: 4 }, { t: "She going school.", p: 1 }, { t: "She to school goes.", p: 0 } ] },
  { q: "O'tgan zamon: 'They ___ to London yesterday.'", opts: [ { t: "go", p: 0 }, { t: "going", p: 0 }, { t: "went", p: 4 }, { t: "gone", p: 1 } ] },
  { q: "'I have lived here ___ 2019.'", opts: [ { t: "for", p: 1 }, { t: "since", p: 4 }, { t: "from", p: 1 }, { t: "during", p: 0 } ] },
  { q: "Passive: 'The letter ___ by Tom.'", opts: [ { t: "wrote", p: 0 }, { t: "was written", p: 4 }, { t: "is write", p: 0 }, { t: "writing", p: 1 } ] },
  { q: "Murakkabroq: 'If I ___ rich, I would travel.'", opts: [ { t: "am", p: 0 }, { t: "was", p: 1 }, { t: "were", p: 4 }, { t: "be", p: 0 } ] }
];
const maxPerQ = questions.map((item) => Math.max(...item.opts.map((o) => o.p)));
const maxScore = maxPerQ.reduce((a, b) => a + b, 0);
---

<section class="gen-eng" data-gen-eng>
  <div class="gen-eng__head">
    <p class="gen-eng__eyebrow">TEPLOV</p>
    <h2>Ingliz tili darajangizni aniqlang</h2>
    <p class="gen-eng__sub">6 ta oddiy savolga javob bering — darajangizni (Beginner → Advanced) ko'rsatamiz. Natija faqat shu qurilmada saqlanadi.</p>
  </div>

  <form class="gen-eng__form" data-gen-form>
    {questions.map((item, i) => (
      <div class="q" data-q>
        <p class="q-t"><span class="q-num">{i + 1}.</span> {item.q}</p>
        {item.opts.map((o, j) => (
          <label class="q-o">
            <input type="radio" name={`ge${i}`} value={o.p} />
            {o.t}
          </label>
        ))}
      </div>
    ))}
    <button type="button" class="start-btn" data-gen-check>Natijani ko'rish</button>
    <p class="gen-eng__res" data-gen-res hidden></p>
    <p class="gen-eng__hint" data-gen-hint hidden>Iltimos, har bir savolga javob bering.</p>
  </form>
</section>

<script>
  // Natija faqat shu brauzer/qurilmada saqlanadi (backend yo'q).
  const GEN_KEY = 'tayanch.genenglish.v1';
  const forms = document.querySelectorAll('[data-gen-eng]');
  forms.forEach((root) => {
    const check = root.querySelector('[data-gen-check]');
    const res = root.querySelector('[data-gen-res]');
    const hint = root.querySelector('[data-gen-hint]');
    if (!check) return;
    check.addEventListener('click', () => {
      const qs = root.querySelectorAll('[data-q]');
      let score = 0, answered = 0, max = 0;
      qs.forEach((q) => {
        const chosen = q.querySelector('input:checked');
        if (chosen) { answered++; score += Number(chosen.value); }
        const opts = q.querySelectorAll('input');
        max += Math.max(...Array.from(opts).map((o) => Number(o.value)));
      });
      if (answered < qs.length) { hint.hidden = false; res.hidden = true; return; }
      hint.hidden = true; res.hidden = false;
      const pct = max ? Math.round((score / max) * 100) : 0;
      let level, advice;
      if (pct < 20) { level = 'Beginner'; advice = 'Asoslardan boshlang: grammatika va kundalik so‘zlar.'; }
      else if (pct < 40) { level = 'Elementary'; advice = 'Poydevor mustahkam, ko‘proq amaliyot kerak.'; }
      else if (pct < 60) { level = 'Intermediate'; advice = 'Yaxshi bazangiz bor — gapirishga ko‘proq e’tibor bering.'; }
      else if (pct < 80) { level = 'Upper-Intermediate'; advice = 'Aniq inglizchingiz bor — murakkab matnlarga o‘ting.'; }
      else { level = 'Advanced'; advice = 'Ajoyib! Akademik yoki professional inglizchini rivojlantiring.'; }
      res.innerHTML = `Darajangiz: <strong>${level}</strong> (${pct}%). ${advice}`;
      try { localStorage.setItem(GEN_KEY, JSON.stringify({ level, pct, date: new Date().toISOString() })); } catch {}
      window.dispatchEvent(new StorageEvent('storage', { key: GEN_KEY }));
    });
  });
</script>

<style>
  .gen-eng{max-width:980px;margin:1.6rem auto;padding:clamp(1.1rem,3vw,1.6rem);border:1px solid color-mix(in srgb,#22c55e 42%,var(--border));border-radius:18px;background:radial-gradient(circle at 92% 8%,color-mix(in srgb,#22c55e 14%,transparent),transparent 25%),var(--surface)}
  .gen-eng__eyebrow{margin:0 0 .3rem;color:#34d399;font-size:.73rem;font-weight:800;letter-spacing:.12em}
  .gen-eng h2{margin:0;font-size:1.4rem}
  .gen-eng__sub{margin:.5rem 0 1rem;color:var(--muted);line-height:1.55;font-size:.92rem}
  .gen-eng__form{display:grid;gap:.9rem}
  .gen-eng .q{border:1px solid var(--border);border-radius:14px;padding:.85rem 1rem;background:var(--surface)}
  .gen-eng .q-t{margin:0 0 .6rem;font-weight:700;line-height:1.5}
  .gen-eng .q-num{color:#34d399;margin-right:.35rem}
  .gen-eng .q-o{display:flex;align-items:center;gap:.55rem;padding:.5rem .7rem;margin:.35rem 0;border:1px solid var(--border);border-radius:10px;cursor:pointer;transition:border-color .18s,background .18s,transform .12s}
  .gen-eng .q-o:hover{border-color:#34d399;background:color-mix(in srgb,#34d399 8%,transparent)}
  .gen-eng .q-o:active{transform:scale(.99)}
  .gen-eng .q-o input{accent-color:#22c55e}
  .gen-eng__res{font-size:1rem;line-height:1.55;color:var(--text)}
  .gen-eng__res strong{color:#34d399}
  .gen-eng__hint{margin:.3rem 0 0;color:var(--muted);font-size:.9rem}
  @media (prefers-reduced-motion: reduce){.gen-eng .q-o{transition:none}.gen-eng .q-o:active{transform:none}}
</style>

---
const { number, title, tagline, description, benefits, limitations, imageSrc, imageAlt, placeholderFile } = Astro.props;
---
<article class="method-card">
  <div class="method-visual">
    {imageSrc ? (
      <img src={imageSrc} alt={imageAlt || title} loading="lazy" />
    ) : (
      <div class="image-placeholder" role="img" aria-label={`${title} rasmi tez orada qo‘shiladi`}>
        <span>RASM JOYI</span>
        <strong>Tez orada rasm qo‘shiladi</strong>
        <small>{placeholderFile}</small>
      </div>
    )}
  </div>
  <div class="method-copy">
    <p class="method-number">{number} — USUL</p>
    <h2>{title}</h2>
    <p class="tagline">{tagline}</p>
    <p class="description">{description}</p>
    <div class="pros-cons">
      <section><h3>Afzalliklari</h3><ul>{benefits.map((item) => <li>{item}</li>)}</ul></section>
      <section><h3>Kamchiliklari</h3><ul>{limitations.map((item) => <li>{item}</li>)}</ul></section>
    </div>
  </div>
</article>

<style>
  .method-card{display:grid;grid-template-columns:minmax(260px,.86fr) minmax(0,1.14fr);gap:clamp(1rem,3vw,2rem);padding:clamp(1rem,3vw,1.5rem);border:1px solid var(--border);border-radius:18px;background:linear-gradient(135deg,rgba(167,139,250,.07),var(--surface))}.method-card+.method-card{margin-top:1rem}.method-visual{min-height:255px;border-radius:13px;overflow:hidden;border:1px solid var(--border);background:#171923}.method-visual img{width:100%;height:100%;min-height:255px;object-fit:cover;display:block}.image-placeholder{height:100%;min-height:255px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:.55rem;padding:1rem;background:linear-gradient(135deg,rgba(148,163,184,.16),rgba(30,41,59,.82));color:var(--muted)}.image-placeholder span{font-size:.72rem;font-weight:800;letter-spacing:.13em;color:#c4b5fd}.image-placeholder strong{color:var(--text);font-size:1.06rem}.image-placeholder small{font-family:monospace;font-size:.75rem;overflow-wrap:anywhere}.method-number{margin:0;color:#c4b5fd;font-size:.76rem;font-weight:800;letter-spacing:.12em}.method-copy h2{margin:.35rem 0}.tagline{font-weight:700;margin:.2rem 0 .7rem}.description{color:var(--muted);line-height:1.65}.pros-cons{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:1rem}.pros-cons section{padding:.8rem;border-radius:11px;background:rgba(15,23,42,.45)}.pros-cons h3{font-size:.9rem;margin:0 0 .35rem}.pros-cons ul{margin:0;padding-left:1.1rem;color:var(--muted);font-size:.88rem;line-height:1.55}.pros-cons li+li{margin-top:.2rem}@media(max-width:700px){.method-card{grid-template-columns:1fr}.method-visual,.method-visual img,.image-placeholder{min-height:205px}}@media(max-width:420px){.pros-cons{grid-template-columns:1fr}}
</style>

      .modules li::before { content: counter(m); position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; border-radius: 9px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; font-weight: 700; font-size: 14px; }
      .modules li::after { content: attr(data-rule); float: right; margin-left: .6rem; font-size: .66rem; font-weight: 800; letter-spacing: .07em; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: .18rem .55rem; white-space: nowrap; transform: translateY(2px); }
      .modules li.is-welcome { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, var(--surface)), var(--surface)); }
      .modules li.is-welcome::before { background: var(--accent); color: white; }
      .modules li.is-welcome::after { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); background: color-mix(in srgb, var(--accent) 10%, transparent); }
      .rule-legend { display: flex; flex-wrap: wrap; gap: .5rem; margin: .7rem 0 1.1rem; }
      .rule-legend span { font-size: .72rem; font-weight: 800; letter-spacing: .06em; padding: .32rem .62rem; border: 1px solid var(--border); border-radius: 999px; color: var(--muted); background: color-mix(in srgb, var(--bg) 45%, transparent); }
      .rule-legend b { color: var(--text); }
      @media (max-width: 640px) { .modules li { padding-right: 10px; } .modules li::after { float: none; display: inline-block; margin: .35rem 0 0; transform: none; } }
      .welcome-module { margin: 1.4rem 0 1.8rem; padding: clamp(1.1rem, 3vw, 1.5rem); border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--border)); border-radius: 18px; background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, var(--surface)), var(--surface)); }
      .welcome-kicker { font-size: .72rem; font-weight: 800; letter-spacing: .12em; color: #a5b4fc; }
      .welcome-module h2 { margin: .3rem 0 .9rem; border: 0; padding: 0; }
      .welcome-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; }
      .welcome-grid > div { padding: .95rem 1rem; border: 1px solid var(--border); border-radius: 12px; background: color-mix(in srgb, var(--bg) 42%, var(--surface)); }
      .welcome-grid b { display: block; color: var(--accent); font-size: .95rem; margin-bottom: .3rem; }
      .welcome-grid p { margin: 0; color: var(--muted); line-height: 1.55; font-size: .92rem; }
      @media (max-width: 760px) { .welcome-grid { grid-template-columns: 1fr; } }
      pre { background: #0a0a0f; padding: 1rem; border-radius: 10px; overflow-x: auto; border: 1px solid var(--border); }
      .music-btn { position: fixed; bottom: 1rem; right: 1rem; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; border: none; padding: 0.6rem 1rem; border-radius: 10px; cursor: pointer; font-weight: 700; z-index: 100; }
      footer { text-align: center; padding: 2rem; color: var(--muted); border-top: 1px solid var(--border); margin-top: 3rem; }
      @media (max-width: 860px) {
        .sidebar { transform: translateX(-100%); }
        .sidebar.open { transform: translateX(0); }
        .content { margin-left: 0; }
        .menu-toggle { display: block; }
        .mobile-brand { display: block; }
        .top-nav { display: none; }
        .hero h1 { font-size: 2rem; }
        .features, .course-list { grid-template-columns: 1fr; }
        .music-btn { bottom: 0.5rem; right: 0.5rem; font-size: 0.8rem; }
      }

      /* === HERO TRUST BADGES (ilhom: osonstudio.uz) === */
      .hero-badges { display: inline-flex; flex-wrap: wrap; gap: 9px; justify-content: center; margin: 0 auto 22px; }
      .hero-badge {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 6px 14px 6px 7px; background: var(--surface);
        border: 1px solid var(--border); border-radius: 999px;
        font: 650 13px var(--font-display); color: var(--text);
        box-shadow: 0 2px 8px -4px rgba(0,0,0,.4);
        transition: transform .2s cubic-bezier(.2,.8,.2,1), box-shadow .2s, border-color .2s;
      }
      .hero-badge:hover { transform: translateY(-2px); box-shadow: 0 8px 18px -6px color-mix(in srgb, var(--bc) 50%, transparent); border-color: color-mix(in srgb, var(--bc) 40%, var(--border)); }
      .hero-badge .bic { width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--bc); color: #fff; box-shadow: 0 2px 6px -2px color-mix(in srgb, var(--bc) 70%, transparent); }
      .hero-badge .bic svg { width: 13px; height: 13px; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
      @media (max-width: 540px) { .hero-badges { gap: 7px; } .hero-badge { font-size: 12px; padding: 5px 12px 5px 6px; } .hero-badge .bic { width: 22px; height: 22px; } }

      /* === HERO DUAL CTA === */
      .hero-actions { display: flex; gap: 10px; justify-content: center; margin-top: 26px; flex-wrap: wrap; }
      .hero-cta { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 11px; font: 700 14px var(--font-display); cursor: pointer; text-decoration: none; transition: .15s; }
      .hero-cta:hover, .hero-cta:focus { text-decoration: none; }
      .hero-cta.primary { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; box-shadow: 0 6px 18px -4px rgba(125,125,245,.45); }
      .hero-cta.primary:hover { transform: translateY(-1px); box-shadow: 0 10px 22px -4px rgba(125,125,245,.6); color: #fff; }
      .hero-cta.secondary { background: var(--surface); color: var(--text); border: 1px solid var(--border); }
      .hero-cta.secondary:hover { border-color: var(--accent); color: var(--accent); }
      .hero-cta svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2.4; }

      /* === TYPED HEADLINE === */
      .hero h1.hero-typed { background: none; -webkit-text-fill-color: currentColor; color: var(--text); min-height: 1.3em; display: flex; flex-direction: column; align-items: center; gap: 2px; }
      .typed-static { display: block; }
      .typed-line { display: block; }
      .typed-text { color: var(--accent); }
      .typed-caret { display: inline-block; width: 3px; height: .9em; background: var(--accent); margin-left: 5px; border-radius: 2px; vertical-align: -.06em; animation: caretBlink 1.05s steps(1) infinite; }
      @keyframes caretBlink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .typed-caret { animation: none; opacity: 1; } }

      /* === SECTION HEADER (osonstudio uslubida) === */
      .sec-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 3.5rem 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
      .sec-title { display: flex; align-items: center; gap: 12px; font: 800 22px var(--font-display); color: var(--text); margin: 0; letter-spacing: -.01em; }
      .sec-ic { width: 40px; height: 40px; border-radius: 11px; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px -3px rgba(0,0,0,.4); flex-shrink: 0; }
      .sec-ic svg { width: 22px; height: 22px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .sec-all { display: inline-flex; align-items: center; gap: 6px; font: 700 13px var(--font-display); color: var(--accent); text-decoration: none; padding: 6px 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border)); background: color-mix(in srgb, var(--accent) 7%, transparent); transition: gap .2s, background .2s, border-color .2s; white-space: nowrap; }
      .sec-all:hover { gap: 9px; text-decoration: none; background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); color: var(--accent); }
      .sec-all b { font-weight: 800; }

      /* === COURSE CARD POLISH === */
      .features { margin-top: 0; }
      .card { overflow: hidden; }
      .card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--c, var(--accent)); opacity: 0; transition: opacity .25s ease, height .25s cubic-bezier(.2,.8,.2,1); border-top-left-radius: 16px; border-top-right-radius: 16px; }
      .card:hover::before { opacity: 1; height: 4px; }
      .card .c-ic { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; margin-bottom: 14px; color: var(--c, var(--accent)); background: color-mix(in srgb, var(--c, var(--accent)) 16%, transparent); transition: transform .3s cubic-bezier(.2,.8,.2,1); }
      .card:hover .c-ic { transform: scale(1.08) rotate(-4deg); }
      .card .c-ic svg { width: 26px; height: 26px; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .card h2 { font-size: 1.2rem; }
      /* Badge → kartochka ichida, overflow:hidden bilan mos */
      .badge { position: absolute; top: 12px; right: 12px; padding: 3px 9px; border-radius: 999px; font: 800 9.5px var(--font-display); letter-spacing: .04em; text-transform: uppercase; background: #ffd700; color: #1a1500; box-shadow: 0 3px 8px -2px rgba(0,0,0,.4); }
      .badge-new { background: #34d399; color: #062b1a; }
      .badge-free { background: #7d7df5; color: #fff; }

      /* === POLISHED BLOCKS === */
      .why-us, .payment { margin-top: 3.5rem; }
      .payment .pay-methods span { transition: transform .15s, border-color .15s, color .15s; }
      .payment .pay-methods span:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent); }

      /* === LANGUAGE SWITCHER (i18n) === */
      .lang-switch { display: inline-flex; gap: 2px; margin-left: 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 3px; }
      .lang-switch a { font: 700 11px var(--font-display); color: var(--muted); text-decoration: none; padding: 4px 8px; border-radius: 999px; transition: background .15s, color .15s; }
      .lang-switch a:hover { color: var(--text); }
      .lang-switch a.active { background: var(--accent); color: #fff; }
      .lang-switch.side { display: flex; margin: 10px 0 4px; }

      /* === UZS PRICE HELPER === */
      .price .uzs, .uzs { display: block; font-size: .85rem; font-weight: 600; color: var(--muted); margin-top: 2px; }
      .card .price .uzs { margin-top: 2px; }

      /* === COURSE CATEGORY PILL === */
      .cat { display: inline-block; font: 800 10.5px var(--font-display); letter-spacing: .04em; text-transform: uppercase; color: var(--c, var(--accent)); background: color-mix(in srgb, var(--c, var(--accent)) 14%, transparent); padding: 3px 9px; border-radius: 999px; margin: 2px 0 8px; }
      .card h2 + .cat { margin-top: -2px; }

      /* === "ENG MASHHUR" SPOTLIGHT === */
      .spotlight { margin-top: 2.5rem; border-radius: 20px; padding: 28px; background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 16%, var(--surface)), var(--surface)); border: 1px solid var(--border); display: grid; grid-template-columns: 1.4fr .8fr; gap: 22px; align-items: center; overflow: hidden; }
      .spotlight .badge-hot { background: linear-gradient(135deg, #ef4444, #f59e0b); color: #fff; }
      .spotlight h2 { font-size: 1.7rem; margin: 10px 0 6px; }
      .spotlight p { color: var(--muted); }
      .spotlight .spot-price { font-size: 1.7rem; font-weight: 800; color: var(--accent); margin: 1rem 0; }
      .spot-ic { width: 110px; height: 110px; border-radius: 24px; display: grid; place-items: center; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; box-shadow: 0 12px 30px -10px var(--accent); justify-self: center; }
      .spot-ic svg { width: 54px; height: 54px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      @media (max-width: 720px) { .spotlight { grid-template-columns: 1fr; text-align: center; } .spot-ic { order: -1; } }

      /* === CERTIFICATE BADGE === */
      .cert-line {
        display: inline-flex; align-items: center; gap: 5px;
        font: 800 10px var(--font-display); letter-spacing: .03em; text-transform: uppercase;
        color: #fff; background: linear-gradient(135deg, #0ea5e9, #22c55e);
        padding: 3px 9px; border-radius: 999px; margin: 0 0 8px;
      }
      .cert-line svg { width: 12px; height: 12px; fill: none; stroke: #fff; stroke-width: 2; }
      /* === TELEGRAM NAV LINK === */
      .side-nav a.tg-nav, .top-nav a.tg-nav { color: #229ED9; display: inline-flex; align-items: center; gap: 7px; }
      .side-nav a.tg-nav:hover, .top-nav a.tg-nav:hover { background: rgba(34,158,217,.12); color: #229ED9; }
      .side-nav a.tg-nav svg, .top-nav a.tg-nav svg { width: 16px; height: 16px; }
      /* === HERO TELEGRAM CTA === */
      .hero-cta.telegram { background: #229ED9; color: #fff; box-shadow: 0 6px 18px -4px rgba(34,158,217,.45); }
      .hero-cta.telegram:hover { background: #1c9bd1; color: #fff; transform: translateY(-1px); }

      /* === PRICING TABLE (Q5.1) === */
      .pricing { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.2rem; margin-top: 2rem; }
      .plan { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 26px 22px; display: flex; flex-direction: column; box-shadow: var(--shadow); position: relative; transition: transform .15s, border-color .15s; }
      .plan:hover { transform: translateY(-4px); border-color: var(--accent); }
      .plan.featured { border-color: var(--accent); box-shadow: 0 14px 36px -12px rgba(125,125,245,.45); }
      .plan .plan-name { font: 800 18px var(--font-display); color: var(--text); }
      .plan .plan-price { font-size: 2.1rem; font-weight: 800; color: var(--accent); margin: 1rem 0 .2rem; }
      .plan .plan-price .uzs { display: block; font-size: .9rem; }
      .plan .plan-desc { color: var(--muted); font-size: .92rem; margin-bottom: 1rem; }
      .plan ul { list-style: none; padding: 0; margin: 0 0 1.4rem; display: flex; flex-direction: column; gap: 8px; }
      .plan ul li { font-size: .92rem; padding-left: 24px; position: relative; color: var(--text); }
      .plan ul li::before { content: "✓"; position: absolute; left: 0; color: var(--accent); font-weight: 800; }
      .plan .start-btn { margin-top: auto; text-align: center; }

      /* === QUIZ (Q5.6) === */
      .quiz { margin-top: 3rem; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; }
      .quiz .q { margin-bottom: 1.1rem; }
      .quiz .q-t { font-weight: 700; margin-bottom: .5rem; }
      .quiz .q-o { display: flex; align-items: center; gap: 8px; padding: 7px 12px; border: 1px solid var(--border); border-radius: 10px; margin-bottom: 6px; cursor: pointer; transition: border-color .15s, background .15s; }
      .quiz .q-o:hover { border-color: var(--accent); }
      .quiz .q-o.ok { border-color: #22c55e; background: color-mix(in srgb, #22c55e 12%, transparent); }
      .quiz .q-o.no { border-color: #ef4444; background: color-mix(in srgb, #ef4444 12%, transparent); }
      .quiz-res { margin-top: 1rem; font-weight: 700; font-size: 1.05rem; color: var(--accent); }
      .quiz-hint { color: var(--muted); font-size: .88rem; margin-top: 6px; }

      /* === RECOMMENDER (Q5.2) === */
      .reco-q { margin-bottom: 1.6rem; }
      .reco-q .q-t { font-weight: 700; margin-bottom: .6rem; }
      .reco-opts { display: grid; gap: 8px; }
      .reco-opt { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; cursor: pointer; transition: border-color .15s, background .15s; }
      .reco-opt:hover { border-color: var(--accent); }
      .reco-opt.sel { border-color: var(--accent); background: var(--accent-soft); }
      .reco-result { margin-top: 1.5rem; padding: 20px; border-radius: 14px; background: var(--accent-soft); border: 1px solid var(--accent); display: none; }
      .reco-result.show { display: block; }
      .reco-result h3 { margin: 0 0 .4rem; color: var(--accent); }
      .reco-result .start-btn { margin-top: 1rem; }

      /* === FOOTER (QADAM 4) === */
      .site-footer { text-align: left; padding: 2.5rem 20px 1.5rem; border-top: 1px solid var(--border); margin-top: 3rem; background: var(--surface); }
      .site-footer .footer-grid { max-width: var(--maxw); margin: 0 auto; display: grid; grid-template-columns: 1.6fr 1fr; gap: 2rem; }
      .site-footer .brand { display: inline-flex; align-items: center; color: var(--text); text-decoration: none; }
      .site-footer .footer-brand p { color: var(--muted); font-size: 0.92rem; max-width: 360px; margin: 0.8rem 0 1.1rem; }
      .site-footer .footer-social { display: flex; gap: 10px; }
      .site-footer .footer-social a { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 10px; border: 1px solid var(--border); color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: border-color .15s, color .15s; }
      .site-footer .footer-social a:hover { border-color: var(--accent); color: var(--accent); }
      .site-footer .footer-col h4 { margin: 0 0 0.9rem; color: var(--accent); font-size: 0.82rem; text-transform: uppercase; letter-spacing: .05em; }
      .site-footer .footer-col a { display: block; color: var(--muted); text-decoration: none; padding: 5px 0; font-weight: 500; }
      .site-footer .footer-col a:hover { color: var(--accent); }
      .site-footer .footer-copy { text-align: center; color: var(--muted); font-size: 0.82rem; margin: 2rem 0 0; padding-top: 1.3rem; border-top: 1px solid var(--border); }
      @media (max-width: 640px) { .site-footer .footer-grid { grid-template-columns: 1fr; gap: 1.5rem; } }

      /* Telegram is a secondary footer contact, not a competing conversion CTA. */
      .tg-footer-cta { max-width: var(--maxw); margin: 0 auto 1rem; padding: 0 20px; }
      .tg-footer-inner { display:flex; align-items:center; gap:9px; padding:10px 0; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
      .tg-footer-ic { width:28px; height:28px; border-radius:7px; flex-shrink:0; display:grid; place-items:center; background:var(--accent); color:#fff; }
      .tg-footer-ic svg { width:15px; height:15px; }
      .tg-footer-text { display:flex; gap:6px; align-items:baseline; flex:1; min-width:0; }
      .tg-footer-text strong { color:var(--text); font-size:.88rem; }
      .tg-footer-text span { color:var(--muted); font-size:.82rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
      .tg-footer-btn { color:var(--accent); font-weight:700; text-decoration:none; font-size:.86rem; white-space:nowrap; }
      .tg-footer-btn:hover { color:var(--accent-2); text-decoration:underline; }
      .course-nav-link { display:inline; margin-left:1rem; color:var(--muted); text-decoration:underline; text-underline-offset:3px; font-size:.92rem; }
      .course-nav-link:hover { color:var(--accent); }
      @media (max-width: 560px) { .tg-footer-inner { align-items:flex-start; } .tg-footer-text { display:block; } .tg-footer-text span { display:block; white-space:normal; } }

      /* === COMMUNITY SECTION (QADAM 3) === */
      .community { margin-top: 3.5rem; }
      .community-card {
        display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
        padding: 26px 28px; border-radius: 18px; border: 1px solid var(--border);
        background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 14%, var(--surface)), var(--surface));
        box-shadow: var(--shadow);
      }
      .community-card .comm-ic { width: 56px; height: 56px; border-radius: 16px; flex-shrink: 0; display: grid; place-items: center; background: var(--accent); color: #fff; }
      .community-card .comm-body { flex: 1; min-width: 220px; }
      .community-card .comm-body h3 { margin: 0 0 .4rem; color: var(--text); font-size: 1.25rem; }
      .community-card .comm-body p { margin: 0; color: var(--muted); }
      .community-card .comm-body .comm-count { color: var(--accent); font-weight: 800; }
      .community-card .comm-join {
        display: inline-flex; align-items: center; gap: 6px; padding: 12px 22px; border-radius: 11px;
        background: var(--accent); color: #fff; font-weight: 700; text-decoration: none; white-space: nowrap;
        transition: background .15s, transform .15s;
      }
      .community-card .comm-join:hover { background: var(--accent-2); color: #fff; text-decoration: none; transform: translateY(-1px); }
      @media (max-width: 560px) {
        .community-card { flex-direction: column; text-align: center; }
        .community-card .comm-join { width: 100%; justify-content: center; }
      }

      /* === PRICE NOTE (QADAM 5) === */
      .price-note { display: block; font-size: 0.72rem; color: var(--muted); margin-top: 3px; font-style: italic; }

      /* === SUBTLE ANIMATIONS (QADAM) — yengil, professional, CSS-only === */
      /* Tugma bosilganda yengil siqilish (press feedback) */
      .start-btn, .hero-cta, .cta, .tg-footer-btn, .comm-join, .sec-all, .lang-switch a, .pay-methods span, .menu-toggle {
        transition: transform .15s ease, background .15s ease, box-shadow .15s ease, border-color .15s ease, color .15s ease;
      }
      .hero-cta:active, .start-btn:active, .cta:active, .tg-footer-btn:active, .comm-join:active, .sec-all:active { transform: scale(.97); }
      .pay-methods span:active { transform: scale(.97); }
      .lang-switch a:active { transform: scale(.92); }

      /* Kurs kartalari: hover'da yengil ko'tarilish + soya */
      .card { transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
      .card:hover { transform: translateY(-5px); box-shadow: 0 18px 36px -12px rgba(0,0,0,.6); border-color: var(--accent); }
      .course { transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
      .course:hover { transform: translateY(-5px); box-shadow: 0 18px 36px -12px rgba(0,0,0,.6); border-color: var(--accent); }

      /* Sahifa yuklanganda elementlar birin-ketin paydo bo'lishi (fade-in, stagger) */
      html.js-reveal .reveal { opacity: 0; transform: translateY(14px); transition: opacity .28s ease, transform .28s cubic-bezier(.2,.8,.2,1); }
      html.js-reveal .reveal.in-view { opacity: 1; transform: none; }

      /* Til almashtirganda yumshoq o'tish (qattiq sakrash bo'lmasin) */
      .content { transition: opacity .2s ease; }
      body.lang-switching .content { opacity: .45; }

      /* Harakatga sezgirlik kamaytirilgan holat — animatsiyalarni o'chir */
      @media (prefers-reduced-motion: reduce) {
        html.js-reveal .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
        .card:hover, .course:hover { transform: none; }
        .hero-cta:active, .start-btn:active, .cta:active, .tg-footer-btn:active, .comm-join:active, .sec-all:active, .pay-methods span:active, .lang-switch a:active { transform: none; }
        .content { transition: none; }
        body.lang-switching .content { opacity: 1; }
      }
    </style>

  <script define:vars={{ base }}>
    // GitHub Pages project URL ostida eski root-relative havolalarni ham to'g'rilaydi.
    document.querySelectorAll('a[href^="/"]').forEach((link) => {
      const href = link.getAttribute('href');
      if (href && base !== '/' && !href.startsWith(base)) link.setAttribute('href', base + href.slice(1));
    });
  </script>

  <ChatWidget />
  <SearchPanel />

  <script is:inline src={base + 'tayanch-ai.js'}></script>
  <script is:inline src={base + 'assets/interactive.js'}></script>
  </body>
</html>

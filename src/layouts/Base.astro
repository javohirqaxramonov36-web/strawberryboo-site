---
import Analytics from "../components/Analytics.astro";
import ChatWidget from "../components/ChatWidget.astro";
import SearchPanel from "../components/SearchPanel.astro";
import { footerNavigation, primaryNavigation } from "../config/navigation";
import { localizedPath } from "../i18n/routes";
const title = Astro.props.title || "Tayanch";
const description = Astro.props.description || '';
const lang = Astro.props.lang || "uz";
const canonical = Astro.props.canonical || Astro.url.href;
const localeAlternates = (Astro.props.localeAlternates || []).map((alternate) => ({
  ...alternate,
  href: new URL(alternate.href, Astro.url.origin).href
}));
const canonicalUz = (localeAlternates.find((a) => a.lang === 'uz') || {}).href || canonical;
const base = import.meta.env.BASE_URL;
const TG = "https://t.me/progression_go"; // Telegram kanal/guruh havolasi
const languageAlternates = Object.fromEntries(localeAlternates.map((alternate) => [alternate.lang, alternate.href]));
const navigationHref = (path: string) => base + localizedPath(lang, path);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'light' ? '#ffffff' : '#0e0f15');
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Analytics />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {localeAlternates.length > 0
      ? localeAlternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)
      : <link rel="alternate" hreflang="uz" href={canonicalUz} />}
    <link rel="alternate" hreflang="x-default" href={canonicalUz} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0e0f15" />
    <!-- Favicon (files already live in /public) — use BASE_URL so the project-page base path is included -->
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <link rel="alternate icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <!-- PWA -->
    <link rel="manifest" href={import.meta.env.BASE_URL + 'manifest.json'} />
    <link rel="apple-touch-icon" sizes="180x180" href={import.meta.env.BASE_URL + 'pwa-180.png'} />
    <link rel="apple-touch-icon" href={import.meta.env.BASE_URL + 'pwa-192.png'} />
    <!-- iOS PWA -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Tayanch" />
    <link rel="apple-touch-startup-image" media="(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" href={import.meta.env.BASE_URL + 'ios-splash/splash-320x568.png'} />
    <link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" href={import.meta.env.BASE_URL + 'ios-splash/splash-375x667.png'} />
    <link rel="apple-touch-startup-image" media="(device-width: 414px) and (device-height: 736px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href={import.meta.env.BASE_URL + 'ios-splash/splash-414x736.png'} />
    <link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href={import.meta.env.BASE_URL + 'ios-splash/splash-375x812.png'} />
    <link rel="apple-touch-startup-image" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)" href={import.meta.env.BASE_URL + 'ios-splash/splash-414x896.png'} />
    <link rel="apple-touch-startup-image" media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href={import.meta.env.BASE_URL + 'ios-splash/splash-390x844.png'} />
    <link rel="apple-touch-startup-image" media="(device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href={import.meta.env.BASE_URL + 'ios-splash/splash-428x926.png'} />
    <link rel="apple-touch-startup-image" media="(device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href={import.meta.env.BASE_URL + 'ios-splash/splash-393x852.png'} />
    <link rel="apple-touch-startup-image" media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)" href={import.meta.env.BASE_URL + 'ios-splash/splash-430x932.png'} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tayanch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('og-image.png', Astro.site ?? Astro.url).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('og-image.png', Astro.site ?? Astro.url).href} />
    <!-- Inter font (was referenced in --font-display but never loaded) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          var base = document.querySelector('link[rel="manifest"]').getAttribute('href').replace(/manifest\.json$/, '');
          navigator.serviceWorker.register(base + 'sw.js', { scope: base }).catch(function () {});
        });
      }
    </script>
    <link rel="stylesheet" href={base + 'assets/interactive.css'} />
    <!-- Sayt miqyosidagi structured data (Organization + WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': (Astro.site?.href ?? Astro.url.href) + '#organization',
          name: 'Tayanch',
          url: (Astro.site?.href ?? Astro.url.href),
          logo: new URL('favicon.svg', Astro.site ?? Astro.url).href,
          sameAs: ['https://t.me/progression_go']
        },
        {
          '@type': 'WebSite',
          '@id': (Astro.site?.href ?? Astro.url.href) + '#website',
          url: (Astro.site?.href ?? Astro.url.href),
          name: 'Tayanch',
          inLanguage: lang,
          publisher: { '@id': (Astro.site?.href ?? Astro.url.href) + '#organization' }
        }
      ]
    })} />
  </head>
  <body>
    <a href="#main" class="skip-link" data-i18n="skip">Asosiyga o'tish</a>

    <aside class="sidebar" id="site-navigation">
      <a href={base} class="brand">
        <span class="brand-wordmark"><span class="brand-tay">Tay</span><span class="brand-anch">anch</span></span>
      </a>
      <nav class="side-nav">
        {primaryNavigation.map((item) => <a href={navigationHref(item.href)}>{item.i18nKey ? <span data-i18n={item.i18nKey}>{item.label}</span> : item.label}</a>)}
        <a href={TG} class="tg-nav" aria-label="Telegram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4 3 11l5 2 2 5 3-3 4 3 4-13z"/><path d="m8 13 4-4"/></svg>
          Telegram
        </a>
        <span class="lang-switch side" aria-label="Til tanlash">
          <a href={languageAlternates.uz || canonicalUz} class={lang === 'uz' ? 'active' : ''} hreflang="uz">UZ</a>
          {languageAlternates.ru ? <a href={languageAlternates.ru} class={lang === 'ru' ? 'active' : ''} hreflang="ru">RU</a> : <button type="button" data-lang-coming>RU</button>}
          {languageAlternates.en ? <a href={languageAlternates.en} class={lang === 'en' ? 'active' : ''} hreflang="en">EN</a> : <button type="button" data-lang-coming>EN</button>}
        </span>
      </nav>
    </aside>

    <div class="content">
      <header class="site-header">
        <button class="menu-toggle" id="menuToggle" type="button" aria-label="Navigatsiyani ochish" aria-controls="site-navigation" aria-expanded="false">☰</button>
        <span class="mobile-brand"><span class="brand-wordmark"><span class="brand-tay">Tay</span><span class="brand-anch">anch</span></span></span>
        <nav class="top-nav">
          {primaryNavigation.filter((item) => item.href !== '').map((item) => <a href={navigationHref(item.href)}>{item.i18nKey ? <span data-i18n={item.i18nKey}>{item.label}</span> : item.label}</a>)}
          <a href={TG} class="tg-nav" aria-label="Telegram" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4 3 11l5 2 2 5 3-3 4 3 4-13z"/><path d="m8 13 4-4"/></svg>
            Telegram
          </a>
          <span class="lang-switch" aria-label="Til tanlash">
            <a href={languageAlternates.uz || canonicalUz} class={lang === 'uz' ? 'active' : ''} hreflang="uz">UZ</a>
            {languageAlternates.ru ? <a href={languageAlternates.ru} class={lang === 'ru' ? 'active' : ''} hreflang="ru">RU</a> : <button type="button" data-lang-coming>RU</button>}
            {languageAlternates.en ? <a href={languageAlternates.en} class={lang === 'en' ? 'active' : ''} hreflang="en">EN</a> : <button type="button" data-lang-coming>EN</button>}
          </span>
        </nav>
        <button id="themeToggle" class="theme-toggle" type="button" aria-label="Tema o'zgartirish" title="Tema o'zgartirish">
          <svg class="ic-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
          <svg class="ic-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
        </button>
        <div id="tayanchAuth" data-tayanch-auth aria-live="polite"></div>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="tg-footer-cta">
          <div class="tg-footer-inner">
            <div class="tg-footer-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4 3 11l5 2 2 5 3-3 4 3 4-13z"/><path d="m8 13 4-4"/></svg>
            </div>
            <div class="tg-footer-text">
              <strong data-i18n="tg.footer.title">Telegram kanalimizga qo'shiling</strong>
              <span data-i18n="tg.footer.text">Yangi kurslar, bepul materiallar va hamjamiyat — bitta joyda.</span>
            </div>
            <a href={TG} class="tg-footer-btn" data-i18n="tg.footer.btn" target="_blank" rel="noopener noreferrer">Kanalga qo'shilish →</a>
          </div>
        </div>
        <div class="footer-grid">
          <div class="footer-brand">
            <a href={base} class="brand">
              <span class="brand-wordmark"><span class="brand-tay">Tay</span><span class="brand-anch">anch</span></span>
            </a>
            <p data-i18n="footer.about">Amaliy onlayn kurslar: AI, IELTS, Admission va shaxsiy bilim bazasi. O'zbek tilida, bepul kurslar ham bor.</p>
            <div class="footer-social">
              <a href="https://t.me/progression_go" aria-label="Telegram" data-i18n="footer.social.tg" target="_blank" rel="noopener noreferrer">Telegram</a>
              <a href="https://instagram.com/javohir_kakhramonov" aria-label="Instagram" data-i18n="footer.social.ig" target="_blank" rel="noopener noreferrer">Instagram</a>
              <a href={navigationHref('fikr-bildirish/')} class="footer-feedback-link" data-i18n="footer.feedback">Fikr bildirish →</a>
            </div>
          </div>
          <div class="footer-col">
            <h4 data-i18n="footer.pages">Sahifalar</h4>
            {footerNavigation.map((item) => <a href={navigationHref(item.href)}>{item.i18nKey ? <span data-i18n={item.i18nKey}>{item.label}</span> : item.label}</a>)}
          </div>
        </div>
        <p class="footer-copy"><span data-i18n="footer.copy">© 2026 Tayanch. Barcha huquqlar himoyalangan.</span> · <a href={navigationHref('foydalanish-shartlari/')} data-i18n="footer.terms">Foydalanish shartlari</a></p>
      </footer>
    </div>

    <script>
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.querySelector('.sidebar');
      menuToggle.addEventListener('click', () => {
        const isOpen = sidebar.classList.toggle('open');
        menuToggle.setAttribute('aria-expanded', String(isOpen));
      });

      // === Dark / Light tema almashtirgich ===
      const themeToggle = document.getElementById('themeToggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', function () {
          const cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
          const next = cur === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          const mc = document.querySelector('meta[name="theme-color"]');
          if (mc) mc.setAttribute('content', next === 'light' ? '#ffffff' : '#0e0f15');
        });
      }

      // QADAM 5 — narx eslatmasi
      document.querySelectorAll('.uzs').forEach(function (u) {
        if (/so'm/i.test(u.textContent) && !u.querySelector('.price-note')) {
          var n = document.createElement('span');
          n.className = 'price-note';
          n.textContent = "*taxminiy kurs, to'lov vaqtida aniqlashtiriladi";
          u.appendChild(n);
        }
      });


      const routeLang = document.documentElement.lang || 'uz';
      function applyLang(lang) {
        if (!I18N[lang]) lang = 'uz';
        document.documentElement.lang = lang;
        document.querySelectorAll('[data-i18n]').forEach(function (el) {
          var key = el.getAttribute('data-i18n');
          var t = (I18N[lang] && I18N[lang][key] != null) ? I18N[lang][key]
                : (I18N.uz[key] != null ? I18N.uz[key] : el.textContent);
          el.textContent = t;
        });
      }
      // Content language follows the actual route. Unsupported RU/EN pages keep
      // visible controls but explain that translations are still being prepared.
      applyLang(routeLang);
      document.querySelectorAll('[data-lang-coming]').forEach(function (button) {
        button.addEventListener('click', function () {
          var toast = document.getElementById('languageNotice');
          if (!toast) {
            toast = document.createElement('div');
            toast.id = 'languageNotice';
            toast.className = 'language-notice';
            toast.setAttribute('role', 'status');
            document.body.appendChild(toast);
          }
          toast.textContent = 'RU/EN tarjimalari hozircha faqat ayrim IELTS kurslarida mavjud. Tez orada kengaytiriladi.';
          toast.classList.add('is-visible');
          setTimeout(function () { toast.classList.remove('is-visible'); }, 3200);
        });
      });

      // === Sahifa yuklanganda yumshoq paydo bo'lish (fade-in, stagger) — kutubxonasiz ===
      (function () {
        var targets = document.querySelectorAll('.card, .course, .plan, .why-us li, .spotlight, .community-card, .tg-footer-cta, .sec-head, .hero-badges, .hero-actions, .quiz, .reco-q, .reco-result');
        targets.forEach(function (el) {
          el.classList.add('reveal');
          var parent = el.parentElement;
          if (parent) {
            var sibs = Array.prototype.filter.call(parent.children, function (c) { return c.classList.contains('reveal'); });
            var idx = sibs.indexOf(el);
            if (idx > 0) el.style.transitionDelay = Math.min(idx * 70, 450) + 'ms';
          }
        });
        if (!('IntersectionObserver' in window)) {
          targets.forEach(function (el) { el.classList.add('in-view'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('in-view'); io.unobserve(en.target); }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(function (el) { io.observe(el); });
      })();

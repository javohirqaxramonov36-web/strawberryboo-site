---
import ChatWidget from "../components/ChatWidget.astro";
import SearchPanel from "../components/SearchPanel.astro";
const title = Astro.props.title || "Tayanch";
const description = Astro.props.description || '';
const lang = Astro.props.lang || "uz";
const canonical = Astro.props.canonical || Astro.url.href;
const base = import.meta.env.BASE_URL;
const TG = "https://t.me/progression_go"; // Telegram kanal/guruh havolasi
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'light' ? '#ffffff' : '#0e0f15');
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0e0f15" />
    <!-- Favicon (files already live in /public) — use BASE_URL so the project-page base path is included -->
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <link rel="alternate icon" href={import.meta.env.BASE_URL + 'favicon.ico'} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tayanch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.svg', Astro.site ?? Astro.url).href} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.svg', Astro.site ?? Astro.url).href} />
    <!-- Inter font (was referenced in --font-display but never loaded) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <script is:inline>document.documentElement.classList.add('js-reveal');</script>
  </head>
  <body>
    <a href="#main" class="skip-link" data-i18n="skip">Asosiyga o'tish</a>

    <aside class="sidebar">
      <a href={base} class="brand">
        <span class="brand-wordmark"><span class="brand-tay">Tay</span><span class="brand-anch">anch</span></span>
      </a>
      <nav class="side-nav">
        <a href={base}><span data-i18n="nav.home">Bosh sahifa</span></a>
        <a href={base + 'kurslar/'}><span data-i18n="nav.courses">Kurslar</span></a>
        <a href={base + 'narxlar/'}><span data-i18n="nav.prices">Narxlar</span></a>
        <a href={base + 'kurs-tanlash/'}><span data-i18n="nav.reco">Kurs tanlash</span></a>
        <a href={base + 'mening-yolim/'}><span data-i18n="nav.journey">Mening yo'lim</span></a>
        <a href={base + 'bog-lanish/'}><span data-i18n="nav.contact">Bog'lanish</span></a>
        <a href={base + 'md2pdf/'}><span>Markdown → PDF</span></a>
        <a href={TG} class="tg-nav" aria-label="Telegram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4 3 11l5 2 2 5 3-3 4 3 4-13z"/><path d="m8 13 4-4"/></svg>
          Telegram
        </a>
        <span class="lang-switch side">
          <a href="#" data-lang="uz" class={lang==='uz'?'active':''}>UZ</a>
          <a href="#" data-lang="ru" class={lang==='ru'?'active':''}>RU</a>
          <a href="#" data-lang="en" class={lang==='en'?'active':''}>EN</a>
        </span>
      </nav>
    </aside>

    <div class="content">
      <header class="site-header">
        <button class="menu-toggle" id="menuToggle">☰</button>
        <span class="mobile-brand"><span class="brand-wordmark"><span class="brand-tay">Tay</span><span class="brand-anch">anch</span></span></span>
        <nav class="top-nav">
          <a href={base + 'kurslar/'}><span data-i18n="nav.courses">Kurslar</span></a>
          <a href={base + 'narxlar/'}><span data-i18n="nav.prices">Narxlar</span></a>

            <a href={base + 'foydalanish-shartlari/'}>Foydalanish shartlari</a>
          </div>
        </div>
        <p class="footer-copy"><span data-i18n="footer.copy">© 2026 Tayanch. Barcha huquqlar himoyalangan.</span> · <a href={base + 'foydalanish-shartlari/'} data-i18n="footer.terms">Foydalanish shartlari</a></p>
      </footer>
    </div>

    <script>
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.querySelector('.sidebar');
      menuToggle.addEventListener('click', () => { sidebar.classList.toggle('open'); });

      // === Dark / Light tema almashtirgich ===
      const themeToggle = document.getElementById('themeToggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', function () {
          const cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
          const next = cur === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          const mc = document.querySelector('meta[name="theme-color"]');
          if (mc) mc.setAttribute('content', next === 'light' ? '#ffffff' : '#0e0f15');
        });
      }

      // QADAM 5 — narx eslatmasi
      document.querySelectorAll('.uzs').forEach(function (u) {
        if (/so'm/i.test(u.textContent) && !u.querySelector('.price-note')) {
          var n = document.createElement('span');
          n.className = 'price-note';
          n.textContent = "*taxminiy kurs, to'lov vaqtida aniqlashtiriladi";
          u.appendChild(n);
        }
      });


      const LS_KEY = 'org-lam-lang';
      function applyLang(lang) {
        if (!I18N[lang]) lang = 'uz';
        document.documentElement.lang = lang;
        document.querySelectorAll('[data-i18n]').forEach(function (el) {
          var key = el.getAttribute('data-i18n');
          var t = (I18N[lang] && I18N[lang][key] != null) ? I18N[lang][key]
                : (I18N.uz[key] != null ? I18N.uz[key] : el.textContent);
          el.textContent = t;
        });
        document.querySelectorAll('[data-lang]').forEach(function (b) {
          b.classList.toggle('active', b.getAttribute('data-lang') === lang);
        });
      }
      var savedLang = localStorage.getItem(LS_KEY) || 'uz';
      applyLang(savedLang);
      document.querySelectorAll('[data-lang]').forEach(function (b) {
        b.addEventListener('click', function (e) {
          e.preventDefault();
          var l = b.getAttribute('data-lang');
          if (l === savedLang) return;
          localStorage.setItem(LS_KEY, l);
          savedLang = l;
          document.body.classList.add('lang-switching');
          applyLang(l);
          setTimeout(function () { document.body.classList.remove('lang-switching'); }, 200);
        });
      });

      // === Sahifa yuklanganda yumshoq paydo bo'lish (fade-in, stagger) — kutubxonasiz ===
      (function () {
        var targets = document.querySelectorAll('.card, .course, .plan, .why-us li, .spotlight, .community-card, .tg-footer-cta, .sec-head, .hero-badges, .hero-actions, .quiz, .reco-q, .reco-result');
        targets.forEach(function (el) {
          el.classList.add('reveal');
          var parent = el.parentElement;
          if (parent) {
            var sibs = Array.prototype.filter.call(parent.children, function (c) { return c.classList.contains('reveal'); });
            var idx = sibs.indexOf(el);
            if (idx > 0) el.style.transitionDelay = Math.min(idx * 70, 450) + 'ms';
          }
        });
        if (!('IntersectionObserver' in window)) {
          targets.forEach(function (el) { el.classList.add('in-view'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('in-view'); io.unobserve(en.target); }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(function (el) { io.observe(el); });
      })();

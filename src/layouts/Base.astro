            Telegram
          </a>
          <span class="lang-switch">
            <a href="#" data-lang="uz" class={lang==='uz'?'active':''}>UZ</a>
            <a href="#" data-lang="ru" class={lang==='ru'?'active':''}>RU</a>
            <a href="#" data-lang="en" class={lang==='en'?'active':''}>EN</a>
          </span>
        </nav>
        <button id="themeToggle" class="theme-toggle" type="button" aria-label="Tema o'zgartirish" title="Tema o'zgartirish">

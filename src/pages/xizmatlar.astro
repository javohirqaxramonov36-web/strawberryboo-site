---
import Base from "../layouts/Base.astro";

const title = "Xizmatlar — Ikkinchi miyangizni qurib beramiz | Tayanch";
const description = "Obsidian asosida shaxsiy bilim tizimini siz uchun sozlab beramiz. Biznesmen, talaba va ijodkorlar uchun, o'zbek tilida.";
const telegramUrl = "https://t.me/tayanch_go";
---

<Base title={title} description={description}>
  <section class="hero">
    <span class="eyebrow">Xizmatlar</span>
    <h1>Ikkinchi miyangizni qurib beramiz</h1>
    <p class="lead">Obsidian asosida shaxsiy bilim tizimingizni siz uchun sozlab beramiz — hujjatlar, fikrlar va loyihalar bir joyda, tartibli.</p>
    <a class="cta" href={telegramUrl} target="_blank" rel="noopener noreferrer">Telegram orqali yozish</a>
  </section>

  <section class="why-us">
    <h2>Ma'lumot ko'p, tizim yo'q</h2>
    <p class="lead">Har kuni ko'plab fikr, hujjat, uchrashuv eslatmasi va g'oya paydo bo'ladi — lekin ular tarqoq holda qoladi: telefon eslatmalarida, Word fayllarida, xotirada. Natijada muhim narsalar unutiladi, qidirish vaqt yeydi, qaror qabul qilish qiyinlashadi. Obsidian — bu shaxsiy bilim bazasi tizimi, unda barcha fikr va hujjatlaringiz o'zaro bog'langan holda saqlanadi va kerak paytda darrov topiladi.</p>
  </section>

  <section class="why-us">
    <h2>Bepul shablon emas — sizga moslashtirilgan tizim</h2>
    <p class="lead">Internetda Obsidian uchun tayyor bepul shablonlar ko'p — lekin ular umumiy, hamma uchun bir xil. Ular sizning ishingiz, fikrlash tartibingiz yoki tilingizni bilmaydi. Men esa avval siz bilan shaxsan gaplashaman, keyin aynan sizning ehtiyojingizga mos tizim quraman — o'zbek tilida, sizga tushunarli tarzda.</p>
  </section>

  <section>
    <div class="sec-head">
      <h2 class="sec-title">Nima olasiz</h2>
    </div>
    <div class="features">
      <article class="card" style="--c:#7d7df5">
        <div class="c-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <h2>Boshlang'ich suhbat</h2>
        <p>30–45 daqiqalik suhbat — ishingiz va ehtiyojingizni tushunish uchun.</p>
      </article>
      <article class="card" style="--c:#a78bfa">
        <div class="c-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/></svg></div>
        <h2>Shaxsiy sozlangan vault</h2>
        <p>Kasbingizga mos papka tuzilishi, teglar va shablonlar.</p>
      </article>
      <article class="card" style="--c:#60a5fa">
        <div class="c-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="m6 10.5v4.8c0 1.5 2.7 3.7 6 3.7s6-2.2 6-3.7v-4.8"/></svg></div>
        <h2>Amaliy o'rgatish</h2>
        <p>Tizimdan foydalanishni bosqichma-bosqich ko'rsatamiz.</p>
      </article>
      <article class="card" style="--c:#34d399">
        <div class="c-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 15a4 4 0 0 1-4 4H8l-4 3v-7a4 4 0 0 1-2-3.5V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/><path d="M8 10h.01M12 10h.01M16 10h.01"/></svg></div>
        <h2>30 kunlik qo'llab-quvvatlash</h2>
        <p>Telegram orqali savol-javob va tizimni joyiga qo'yishda yordam.</p>
      </article>
    </div>
  </section>

  <section>
    <div class="sec-head">
      <h2 class="sec-title">Kimlar uchun</h2>
    </div>
    <div class="course-list">
      <article class="course"><h2>Biznesmenlar</h2><p>Uchrashuv, qaror va loyihalarni tartibga solish uchun.</p></article>
      <article class="course"><h2>Talabalar</h2><p>Dars materiallari va tadqiqotni tizimlashtirish uchun.</p></article>
      <article class="course"><h2>Ijodkorlar va yozuvchilar</h2><p>G'oya va kontentni rejalashtirish uchun.</p></article>
    </div>
  </section>

  <section>
    <div class="sec-head">
      <h2 class="sec-title">Jarayon</h2>
    </div>
    <ol class="modules">
      <li><strong>So'rovnoma</strong><br />Qisqa forma orqali ehtiyoj aniqlanadi.</li>
      <li><strong>Suhbat</strong><br />Video yoki ovozli qo'ng'iroq orqali batafsil muhokama qilamiz.</li>
      <li><strong>Sozlash</strong><br />Tizim 3–5 ish kunida tayyorlanadi.</li>
      <li><strong>Yetkazish</strong><br />Tayyor vault topshiriladi va undan foydalanish o'rgatiladi.</li>
    </ol>
  </section>

  <section class="payment">
    <div class="plan featured">
      <span class="plan-name">Shaxsiy Obsidian tizimi</span>
      <div class="plan-price">360 000 so'mdan <span class="usd">(≈ $29)</span></div>
      <p class="plan-desc">Shaxsiy suhbat + sozlangan vault + 30 kunlik qo'llab-quvvatlash</p>
      <p class="plan-desc">Narx ehtiyojga qarab farqlanishi mumkin — aniq narxni suhbat davomida kelishamiz.</p>
    </div>
  </section>

  <section class="hero">
    <h2>Tizimingizni bugun boshlang</h2>
    <a class="cta" href={telegramUrl} target="_blank" rel="noopener noreferrer">Telegram orqali yozing</a>
  </section>
</Base>

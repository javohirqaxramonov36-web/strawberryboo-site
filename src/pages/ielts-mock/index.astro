---
import Base from '../../layouts/Base.astro';
const title = 'IELTS Mock Test — Tayanch';
const description = 'IELTS Listening, Reading, Writing va Speaking uchun Tayanch Qadam asosidagi mock testlar.';
const base = import.meta.env.BASE_URL;
const mocks = Array.from({ length: 21 }, (_, index) => {
  const number = String(index + 1).padStart(3, '0');
  const launch = index < 3;
  const wave = index < 11 ? 'Keyingi to‘lqin' : 'Tez orada';
  return {
    code: `MOCK ${number}`,
    title: launch ? (index === 0 ? 'Academic Full Mock' : index === 1 ? 'Academic Skills Mock' : 'Academic Practice Mock') : 'IELTS Academic Mock',
    difficulty: index === 0 ? 'Standard' : index === 1 ? 'Foundation' : index === 2 ? 'Challenge' : 'Standard',
    status: launch ? 'MVP beta' : wave,
    launch,
  };
});
---

<Base title={title} description={description}>
  <section class="mock-hero">
    <div class="hero-copy">
      <p class="eyebrow">TAYANCH · IELTS MOCK TEST</p>
      <h1>Imtihondan oldin <span>o‘zingizni sinang.</span></h1>
      <p class="lead">Listening, Reading, Writing va Speaking bo‘limlarini alohida yoki bitta to‘liq mock sifatida topshiring. Natijangiz — AI practice estimate va aniq keyingi qadamlar bilan.</p>
      <div class="hero-actions">
        <a href="#katalog" class="primary-btn">Mock tanlash <span>→</span></a>
        <a href="#qadam" class="secondary-btn">Tayanch Qadam qanday ishlaydi?</a>
      </div>
      <p class="notice">Bu rasmiy IELTS imtihoni emas. Natijalar faqat practice va tayyorgarlik uchun.</p>
    </div>
    <aside class="wallet-card" aria-label="Demo Tayanch Qadam balansi">
      <div class="wallet-top"><span class="wallet-icon">✦</span><span>DEMO BALANS</span></div>
      <strong><span id="walletBalance">2</span> <em>Qadam</em></strong>
      <p>1 Qadam = 1 modul urinish</p>
      <a href="#qadam">Paketlarni ko‘rish →</a>
    </aside>
  </section>

  <section class="value-row" aria-label="Mock test afzalliklari">
    <article><span>01</span><strong>4 skill</strong><p>Har modul alohida yoki full mock.</p></article>
    <article><span>02</span><strong>Computer-delivered</strong><p>Taymer va progress bilan mashq.</p></article>
    <article><span>03</span><strong>AI feedback</strong><p>Writing va Speaking uchun tahlil.</p></article>
    <article><span>04</span><strong>Natija yo‘li</strong><p>Xatodan keyingi amaliy qadamlar.</p></article>
  </section>

  <section id="katalog" class="catalog-section">
    <div class="section-heading">
      <div><p class="eyebrow">MOCK KATALOGI</p><h2>O‘zingizga mos mockni tanlang</h2></div>
      <p class="section-note"><b>21 ta</b> original mock rejalashtirilgan<br/>MVP beta: MOCK 001–003</p>
    </div>
    <div class="filter-row" role="group" aria-label="Mock filtrlari">
      <button class="filter active" data-filter="all">Barchasi</button>
      <button class="filter" data-filter="beta">MVP beta</button>
      <button class="filter" data-filter="standard">Standard</button>
    </div>
    <div class="mock-grid">
      {mocks.map((mock) => (
        <article class:list={['mock-card', { 'is-locked': !mock.launch }]} data-state={mock.launch ? 'beta standard' : 'coming standard'}>
          <div class="card-top"><span class="mock-code">{mock.code}</span><span class:list={['status', { beta: mock.launch }]}>{mock.status}</span></div>
          <h3>{mock.title}</h3>
          <div class="skill-tags"><span>Listening</span><span>Reading</span><span>Writing</span><span>Speaking</span></div>
          <div class="mock-meta"><span>{mock.difficulty}</span><span>·</span><span>~2 soat 45 daqiqa</span></div>
          {mock.launch ? <button class="choose-mock" data-mock={mock.code}>Modullarni tanlash <span>→</span></button> : <button class="waitlist" disabled>Tez orada</button>}
        </article>
      ))}
    </div>
  </section>

  <section id="qadam" class="qadam-section">
    <div class="section-heading inverse">
      <div><p class="eyebrow">TAYANCH QADAM</p><h2>Faqat kerakli urinish uchun to‘lang</h2></div>
      <p>Qadamlar 6 oy faol hisobingizda turadi. IELTS Prep xaridorlariga bir marta 2 Qadam bonus beriladi.</p>
    </div>
    <div class="pricing-grid">
      <article class="price-card"><span>Sinov</span><strong>1 <em>Qadam</em></strong><p>1 modul uchun</p><b>32 000 so‘m</b><small>≈ $2.69</small><button class="buy-demo" data-pack="1">Demo tanlash</button></article>
      <article class="price-card"><span>Start</span><strong>5 <em>Qadam</em></strong><p>Full mock + 1 modul</p><b>145 000 so‘m</b><small>≈ $12.18</small><button class="buy-demo" data-pack="5">Demo tanlash</button></article>
      <article class="price-card featured"><i>Eng maqbul</i><span>Progress</span><strong>10 <em>Qadam</em></strong><p>2 full mock + 2 modul</p><b>269 000 so‘m</b><small>≈ $22.61</small><button class="buy-demo" data-pack="10">Demo tanlash</button></article>
      <article class="price-card"><span>Intensive</span><strong>20 <em>Qadam</em></strong><p>5 full mock</p><b>499 000 so‘m</b><small>≈ $41.93</small><button class="buy-demo" data-pack="20">Demo tanlash</button></article>
    </div>
    <p class="payment-note">Production versiyada: Click · Payme · Uzum · Karta. Hozirgi sahifa — frontend demo.</p>
  </section>

  <section class="flow-section">
    <p class="eyebrow">QANDAY ISHLAYDI</p>
    <div class="flow-grid"><div><b>1</b><h3>Mockni tanlang</h3><p>Skill yoki full mockni belgilang.</p></div><div><b>2</b><h3>Qadamdan foydalaning</h3><p>Jami oldindan aniq ko‘rinadi.</p></div><div><b>3</b><h3>Topshiring</h3><p>Taymer va autosave bilan ishlang.</p></div><div><b>4</b><h3>Natijani ko‘ring</h3><p>AI practice estimate va keyingi qadamlar.</p></div></div>
  </section>

  <dialog id="selectorDialog" class="selector-dialog" aria-labelledby="selectorTitle">
    <div class="dialog-head"><div><p class="eyebrow" id="selectedCode">MOCK 001</p><h2 id="selectorTitle">Modullarni tanlang</h2></div><button class="close-dialog" aria-label="Yopish">×</button></div>
    <p class="dialog-intro">Har modul 1 Qadam. Siz xohlagan ko‘nikmalarni belgilang.</p>
    <div class="module-list">
      <label><input type="checkbox" value="Listening" checked/><span><b>Listening</b><small>~30 daqiqa · avtomatik score</small></span><strong>1 Qadam</strong></label>
      <label><input type="checkbox" value="Reading" checked/><span><b>Reading</b><small>~60 daqiqa · avtomatik score</small></span><strong>1 Qadam</strong></label>
      <label><input type="checkbox" value="Writing" checked/><span><b>Writing</b><small>~60 daqiqa · AI feedback</small></span><strong>1 Qadam</strong></label>
      <label><input type="checkbox" value="Speaking" checked/><span><b>Speaking</b><small>~15 daqiqa · audio + AI feedback</small></span><strong>1 Qadam</strong></label>
    </div>
    <div class="summary"><div><span>Tanlangan modullar</span><b id="selectedCount">4 ta</b></div><div><span>Jami</span><strong><span id="totalQadam">4</span> Qadam <small>· <span id="totalUzs">128 000</span> so‘m</small></strong></div><p id="balanceMessage">Demo balansingiz yetarli emas. Paket tanlang yoki demo natijani ko‘ring.</p></div>
    <div class="dialog-actions"><button class="secondary-action close-dialog">Orqaga</button><a class="primary-action" href={base + 'ielts-mock/results/'} id="demoResult">Demo natijani ko‘rish →</a></div>
  </dialog>

  <div id="demoToast" class="toast" role="status" aria-live="polite"></div>

  <style>
    .mock-hero{display:grid;grid-template-columns:1.45fr .7fr;gap:2rem;align-items:stretch;padding:4.2rem min(7vw,90px) 3.5rem;max-width:1320px;margin:auto}.eyebrow{font-size:.76rem;font-weight:800;letter-spacing:.12em;color:var(--accent);margin:0 0 .7rem}.hero-copy h1{font:800 clamp(2.5rem,5vw,4.9rem)/1.03 var(--font-display);letter-spacing:-.065em;margin:0;max-width:720px}.hero-copy h1 span{color:var(--accent)}.lead{max-width:680px;color:var(--muted);font-size:1.1rem;line-height:1.7;margin:1.3rem 0 1.8rem}.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap}.primary-btn,.secondary-btn,.choose-mock,.waitlist,.buy-demo,.primary-action,.secondary-action{border:0;font:700 .95rem var(--font-display);border-radius:12px;text-decoration:none;cursor:pointer;transition:transform .16s,box-shadow .16s,background .16s}.primary-btn,.primary-action{background:linear-gradient(135deg,var(--accent),#6f62e8);color:#fff;padding:13px 18px;box-shadow:0 10px 26px -12px var(--accent)}.primary-btn:hover,.primary-action:hover{transform:translateY(-2px);color:#fff}.secondary-btn,.secondary-action{border:1px solid var(--border);color:var(--text);padding:12px 16px;background:transparent}.notice{font-size:.81rem;color:var(--muted);margin:1.25rem 0 0}.wallet-card{border:1px solid color-mix(in srgb,var(--accent) 45%,var(--border));border-radius:22px;padding:1.65rem;background:linear-gradient(155deg,color-mix(in srgb,var(--accent) 22%,var(--surface)),var(--surface));align-self:center;box-shadow:var(--shadow)}.wallet-top{display:flex;gap:.5rem;align-items:center;color:var(--muted);font-size:.76rem;font-weight:800;letter-spacing:.08em}.wallet-icon{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;color:#fff;background:var(--accent)}.wallet-card strong{display:block;font:800 2.55rem var(--font-display);margin:1rem 0 .2rem}.wallet-card em,.price-card em{font-style:normal;font-size:.95rem;color:var(--muted)}.wallet-card p{color:var(--muted);margin:.2rem 0 1.5rem}.wallet-card a{color:var(--accent);font-weight:700;text-decoration:none}.value-row{max-width:1140px;margin:0 auto 4.5rem;padding:0 min(7vw,90px);display:grid;grid-template-columns:repeat(4,1fr);gap:0}.value-row article{padding:1.25rem;border-left:1px solid var(--border)}.value-row article:first-child{border-left:0}.value-row span{display:block;color:var(--accent);font-size:.76rem;font-weight:800;margin-bottom:.6rem}.value-row strong{font-size:1rem}.value-row p{color:var(--muted);font-size:.86rem;line-height:1.5;margin:.4rem 0 0}.catalog-section,.flow-section{max-width:1180px;margin:0 auto;padding:0 min(7vw,90px) 4.5rem}.section-heading{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:1.6rem}.section-heading h2{font:800 clamp(1.8rem,3.2vw,3rem)/1.05 var(--font-display);letter-spacing:-.045em;margin:0}.section-note{font-size:.86rem;line-height:1.55;color:var(--muted);margin:0}.section-note b{color:var(--accent)}.filter-row{display:flex;gap:.45rem;margin-bottom:1.15rem}.filter{background:transparent;border:1px solid var(--border);border-radius:999px;padding:.5rem .85rem;color:var(--muted);font-weight:700;cursor:pointer}.filter.active{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}.mock-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.mock-card{display:flex;flex-direction:column;padding:1.35rem;border:1px solid var(--border);border-radius:17px;background:var(--surface);min-height:245px;transition:transform .16s,border-color .16s,opacity .16s}.mock-card:hover:not(.is-locked){transform:translateY(-3px);border-color:var(--accent)}.mock-card.is-locked{opacity:.67}.card-top{display:flex;justify-content:space-between;gap:.5rem;align-items:center}.mock-code{font-weight:800;letter-spacing:.08em;font-size:.76rem;color:var(--accent)}.status{font-size:.71rem;padding:.3rem .52rem;border-radius:999px;background:var(--border);color:var(--muted);font-weight:700}.status.beta{color:#58d47a;background:color-mix(in srgb,#58d47a 14%,transparent)}.mock-card h3{font:800 1.24rem var(--font-display);margin:1.15rem 0 .8rem}.skill-tags{display:flex;gap:.3rem;flex-wrap:wrap}.skill-tags span{font-size:.68rem;color:var(--muted);padding:.25rem .42rem;border-radius:6px;border:1px solid var(--border)}.mock-meta{display:flex;gap:.4rem;margin:.9rem 0;color:var(--muted);font-size:.78rem}.choose-mock,.waitlist{margin-top:auto;text-align:left;padding:0;background:none;color:var(--accent)}.waitlist{color:var(--muted);cursor:not-allowed}.qadam-section{padding:4.5rem max(7vw,24px);background:linear-gradient(135deg,#1b1b35,#0e0f15)}.qadam-section .section-heading{max-width:1180px;margin:0 auto 1.8rem}.inverse h2{color:#fff}.inverse>p{max-width:390px;color:#b6b5c8;line-height:1.6;margin:0}.pricing-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.price-card{position:relative;background:color-mix(in srgb,var(--surface) 91%,#fff);border:1px solid var(--border);border-radius:18px;padding:1.45rem;display:flex;flex-direction:column}.price-card.featured{border-color:var(--accent);box-shadow:0 14px 34px -20px var(--accent)}.price-card i{position:absolute;top:-12px;left:16px;padding:.3rem .6rem;border-radius:999px;background:var(--accent);color:#fff;font-size:.68rem;font-style:normal;font-weight:800}.price-card>span{color:var(--muted);font-size:.83rem;font-weight:700}.price-card strong{font:800 2rem var(--font-display);margin:.75rem 0 .2rem}.price-card p{min-height:38px;margin:0;color:var(--muted);font-size:.84rem;line-height:1.45}.price-card b{font-size:1rem;margin-top:1rem}.price-card small{color:var(--muted);margin-top:.2rem}.buy-demo{margin-top:1.2rem;padding:.75rem;background:var(--accent-soft);color:var(--accent)}.buy-demo:hover{background:var(--accent);color:#fff}.payment-note{max-width:1180px;margin:1.2rem auto 0;text-align:center;color:var(--muted);font-size:.8rem}.flow-section{padding-top:4.5rem}.flow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:1.4rem}.flow-grid div{padding:1.25rem;border-top:2px solid var(--accent);background:var(--surface);border-radius:0 0 14px 14px}.flow-grid b{color:var(--accent);font-size:.8rem}.flow-grid h3{font:800 1rem var(--font-display);margin:.8rem 0 .45rem}.flow-grid p{margin:0;color:var(--muted);font-size:.86rem;line-height:1.5}.selector-dialog{width:min(650px,calc(100% - 28px));background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:20px;padding:1.45rem;box-shadow:0 30px 80px rgba(0,0,0,.55)}.selector-dialog::backdrop{background:rgba(0,0,0,.65);backdrop-filter:blur(4px)}.dialog-head{display:flex;justify-content:space-between;gap:1rem}.dialog-head h2{font:800 1.8rem var(--font-display);margin:0}.close-dialog{width:34px;height:34px;border:1px solid var(--border);background:transparent;border-radius:10px;color:var(--text);font-size:1.4rem;cursor:pointer}.dialog-intro{color:var(--muted);margin:1rem 0}.module-list{display:grid;gap:.55rem}.module-list label{display:grid;grid-template-columns:auto 1fr auto;gap:.75rem;align-items:center;border:1px solid var(--border);border-radius:12px;padding:.75rem;cursor:pointer}.module-list input{accent-color:var(--accent);width:18px;height:18px}.module-list b{display:block}.module-list small{display:block;color:var(--muted);font-size:.76rem;margin-top:.15rem}.module-list strong{font-size:.85rem;color:var(--accent)}.summary{margin:1rem 0;padding:1rem;border-radius:13px;background:var(--accent-soft)}.summary>div{display:flex;justify-content:space-between;gap:1rem;margin:.25rem 0}.summary span{color:var(--muted);font-size:.85rem}.summary strong{color:var(--accent)}.summary strong small{font-weight:600;color:var(--muted)}.summary p{font-size:.8rem;color:var(--muted);margin:.8rem 0 0}.dialog-actions{display:flex;justify-content:flex-end;align-items:center;gap:.6rem}.dialog-actions .primary-action,.dialog-actions .secondary-action{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}.primary-action{padding:.75rem 1rem}.secondary-action{padding:.75rem 1rem}.toast{position:fixed;z-index:20;right:20px;bottom:24px;max-width:360px;padding:.85rem 1rem;background:#24243d;border:1px solid var(--accent);border-radius:12px;color:#fff;transform:translateY(130%);transition:transform .25s;box-shadow:var(--shadow)}.toast.show{transform:translateY(0)}
    @media(max-width:850px){.mock-hero{grid-template-columns:1fr;padding-top:3rem}.wallet-card{max-width:410px}.value-row,.pricing-grid,.flow-grid{grid-template-columns:repeat(2,1fr)}.mock-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:560px){.mock-hero,.catalog-section,.flow-section{padding-left:20px;padding-right:20px}.hero-copy h1{font-size:2.55rem}.section-heading{display:block}.section-note,.inverse>p{margin-top:1rem}.value-row{padding:0 20px;margin-bottom:3rem}.value-row article:nth-child(3){border-left:0}.pricing-grid,.flow-grid,.mock-grid{grid-template-columns:1fr}.qadam-section{padding:3.5rem 20px}.dialog-actions{flex-direction:column-reverse}.dialog-actions a,.dialog-actions button{text-align:center}.module-list label{grid-template-columns:auto 1fr}.module-list strong{grid-column:2}.toast{left:16px;right:16px}}
  </style>

  <script>
    const dialog = document.getElementById('selectorDialog');
    const selectedCode = document.getElementById('selectedCode');
    const checkboxes = [...document.querySelectorAll('.module-list input')];
    const totalQadam = document.getElementById('totalQadam');
    const totalUzs = document.getElementById('totalUzs');
    const selectedCount = document.getElementById('selectedCount');
    const balanceMessage = document.getElementById('balanceMessage');
    const toast = document.getElementById('demoToast');
    const wallet = document.getElementById('walletBalance');
    const format = new Intl.NumberFormat('uz-UZ');
    let demoBalance = 2;

    function updateSummary() {
      const count = checkboxes.filter((box) => box.checked).length;
      totalQadam.textContent = count;
      totalUzs.textContent = format.format(count * 32000);
      selectedCount.textContent = `${count} ta`;
      balanceMessage.textContent = count === 0 ? 'Davom etish uchun kamida bitta modulni tanlang.' : demoBalance >= count ? 'Demo balansingiz yetarli. Demo natijani ochishingiz mumkin.' : `Demo balans: ${demoBalance} Qadam. Sizga yana ${count - demoBalance} Qadam kerak.`;
    }
    document.querySelectorAll('.choose-mock').forEach((button) => button.addEventListener('click', () => {
      selectedCode.textContent = button.dataset.mock;
      dialog.showModal();
      updateSummary();
    }));
    document.querySelectorAll('.close-dialog').forEach((button) => button.addEventListener('click', () => dialog.close()));
    checkboxes.forEach((box) => box.addEventListener('change', updateSummary));
    document.querySelectorAll('.buy-demo').forEach((button) => button.addEventListener('click', () => {
      const count = Number(button.dataset.pack);
      demoBalance += count;
      wallet.textContent = demoBalance;
      toast.textContent = `Demo rejimida ${count} Qadam qo‘shildi. Production versiyada bu yerda checkout ochiladi.`;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 4200);
      updateSummary();
    }));
    document.querySelectorAll('.filter').forEach((button) => button.addEventListener('click', () => {
      document.querySelectorAll('.filter').forEach((item) => item.classList.remove('active'));
      button.classList.add('active');
      const filter = button.dataset.filter;
      document.querySelectorAll('.mock-card').forEach((card) => {
        card.hidden = filter !== 'all' && !card.dataset.state.includes(filter);
      });
    }));
  </script>
</Base>

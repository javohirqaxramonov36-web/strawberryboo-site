  </style>

  <script>
    const dialog = document.getElementById('selectorDialog');
    const selectedCode = document.getElementById('selectedCode');
    const checkboxes = [...document.querySelectorAll('.module-list input')];
    const totalQadam = document.getElementById('totalQadam');
    const totalUzs = document.getElementById('totalUzs');
    const selectedCount = document.getElementById('selectedCount');
    const balanceMessage = document.getElementById('balanceMessage');
    const toast = document.getElementById('demoToast');
    const format = new Intl.NumberFormat('uz-UZ');
    let currentBalance = 0;

    function updateSummary() {
      const count = checkboxes.filter((box) => box.checked).length;
      totalQadam.textContent = count;
      const total = count === 4 ? 149000 : count * 40000;
      totalUzs.textContent = format.format(total);
      selectedCount.textContent = `${count} ta`;
      balanceMessage.textContent = count === 0 ? 'Davom etish uchun kamida bitta modulni tanlang.' : currentBalance >= count ? 'Balansingiz yetarli. Real ochish oqimi yaqin orada faollashadi.' : `Balansingizni ko‘rish uchun kiring. Tanlov: ${count} Qadam.`;
    }
    document.querySelectorAll('.choose-mock').forEach((button) => button.addEventListener('click', () => {
      selectedCode.textContent = button.dataset.mock;
      dialog.showModal();
      updateSummary();
    }));
    document.querySelectorAll('.close-dialog').forEach((button) => button.addEventListener('click', () => dialog.close()));
    checkboxes.forEach((box) => box.addEventListener('change', updateSummary));
    document.querySelectorAll('.buy-demo').forEach((button) => button.addEventListener('click', () => {
      const count = Number(button.dataset.pack);
      toast.textContent = `${count} Qadam paketi tanlandi. To‘lov integratsiyasi ishga tushgach shu yerda checkout ochiladi.`;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 4200);
      updateSummary();
    }));
    window.addEventListener('tayanch:wallet', (event) => { currentBalance = Number(event.detail?.balance || 0); updateSummary(); });
        document.querySelectorAll('.filter').forEach((button) => button.addEventListener('click', () => {
      document.querySelectorAll('.filter').forEach((item) => item.classList.remove('active'));
      button.classList.add('active');
      const filter = button.dataset.filter;
      document.querySelectorAll('.mock-card').forEach((card) => {
        card.hidden = filter !== 'all' && !card.dataset.state.includes(filter);
      });
    }));
  </script>

---
import Base from '../../layouts/Base.astro';
import MockWallet from '../../components/MockWallet.astro';
const title = 'IELTS Mock Test — Tayanch';
const description = 'IELTS Listening, Reading, Writing va Speaking uchun Tayanch Qadam asosidagi mock testlar.';
const base = import.meta.env.BASE_URL;
const mocks = [
  { code: 'MOCK 001', title: 'Writing — Answer Checking', type: 'Writing', difficulty: 'Foundation', status: 'Mavjud', file: 'mock-001.html', audio: false },
  { code: 'MOCK 002', title: 'Writing — Answer Checking', type: 'Writing', difficulty: 'Foundation', status: 'Mavjud', file: 'mock-002.html', audio: false },
  { code: 'MOCK 003', title: 'Writing — Answer Checking', type: 'Writing', difficulty: 'Foundation', status: 'Mavjud', file: 'mock-003.html', audio: false },
  { code: 'MOCK 004', title: 'Writing — Answer Checking', type: 'Writing', difficulty: 'Foundation', status: 'Mavjud', file: 'mock-004.html', audio: false },
  { code: 'MOCK 014', title: 'Full Reading Practice', type: 'Reading', difficulty: 'Standard', status: 'Mavjud', file: 'mock-014.html', audio: false },
  { code: 'MOCK 015', title: 'Full Reading Practice', type: 'Reading', difficulty: 'Challenge', status: 'Mavjud', file: 'mock-015.html', audio: false },
  { code: 'MOCK 016', title: 'Full Reading Practice', type: 'Reading', difficulty: 'Standard', status: 'Mavjud', file: 'mock-016.html', audio: false },
  { code: 'MOCK 017', title: 'Writing Task 1 & 2', type: 'Writing', difficulty: 'Standard', status: 'Mavjud', file: 'mock-017.html', audio: false },
  { code: 'MOCK 018', title: 'Writing Practice', type: 'Writing', difficulty: 'Standard', status: 'Mavjud', file: 'mock-018.html', audio: false },
  { code: 'MOCK 019', title: 'To‘liq CDI Mock 1', type: 'Full Mock', difficulty: 'Standard', status: 'Mavjud', file: 'mock-019.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 020', title: 'To‘liq CDI Mock 2', type: 'Full Mock', difficulty: 'Standard', status: 'Mavjud', file: 'mock-020.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 021', title: 'To‘liq CDI Mock 3', type: 'Full Mock', difficulty: 'Standard', status: 'Mavjud', file: 'mock-021.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 022', title: 'To‘liq CDI Mock 4', type: 'Full Mock', difficulty: 'Challenge', status: 'Mavjud', file: 'mock-022.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 023', title: 'To‘liq CDI Mock 5', type: 'Full Mock', difficulty: 'Challenge', status: 'Mavjud', file: 'mock-023.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 024', title: 'To‘liq CDI Mock 6', type: 'Full Mock', difficulty: 'Standard', status: 'Mavjud', file: 'mock-024.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 025', title: 'To‘liq CDI Mock 7', type: 'Full Mock', difficulty: 'Standard', status: 'Mavjud', file: 'mock-025.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 026', title: 'To‘liq CDI Mock 8', type: 'Full Mock', difficulty: 'Standard', status: 'Mavjud', file: 'mock-026.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 027', title: 'To‘liq CDI Mock 9', type: 'Full Mock', difficulty: 'Standard', status: 'Mavjud', file: 'mock-027.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 028', title: 'To‘liq CDI Mock 10', type: 'Full Mock', difficulty: 'Standard', status: 'Mavjud', file: 'mock-028.html', audio: true, tag: 'To‘liq CDI Mock' },
  { code: 'MOCK 029', title: 'To‘liq CDI Mock 11', type: 'Full Mock', difficulty: 'Standard', status: 'Mavjud', file: 'mock-029.html', audio: true, tag: 'To‘liq CDI Mock' },
];
---

<Base title={title} description={description}>
  <section class="mock-hero">
    <div class="hero-copy">
      <p class="eyebrow" data-i18n="imk.eyebrow">TAYANCH · IELTS MOCK TEST</p>
      <h1 data-i18n="imk.h1">Imtihondan oldin <span>o‘zingizni sinang.</span></h1>
      <p class="lead" data-i18n="imk.lead">Listening, Reading, Writing va Speaking bo‘limlarini alohida yoki bitta to‘liq mock sifatida topshiring. Natijangiz — AI practice estimate va aniq keyingi qadamlar bilan.</p>
      <div class="hero-actions">
        <a href="#katalog" class="primary-btn">Hozir ishlaydigan practice’ni tanlash <span>→</span></a>
        <a href={base + 'ielts-mock/results/'} class="secondary-btn">Namuna natijani ko‘rish</a>
      </div>
      <p class="notice">Bu rasmiy IELTS imtihoni emas. Natijalar faqat practice va tayyorgarlik uchun.</p>
    </div>
    <MockWallet />
  </section>

  <section class="value-row" aria-label="Mock test afzalliklari">
    <article><span>01</span><strong>4 skill</strong><p>Har modul alohida yoki full mock.</p></article>
    <article><span>02</span><strong>Computer-delivered</strong><p>Taymer va progress bilan mashq.</p></article>
    <article><span>03</span><strong>AI feedback</strong><p>Writing va Speaking uchun tahlil.</p></article>
    <article><span>04</span><strong>Natija yo‘li</strong><p>Xatodan keyingi amaliy qadamlar.</p></article>
  </section>

  <section class="ai-grader-cta">
    <div class="ag-inner">
      <div>
        <p class="eyebrow">YANGI · AI BAHOLASH</p>
        <h2>Writing inshongizni Gemini baholasin</h2>
        <p>Task 1 yoki Task 2 inshongizni joylang — IELTS rasmiy mezonlari bo‘yicha 0–9 ball va qisqa maslahat. Bir daqiqadan kam vaqt oladi.</p>
      </div>
      <a class="ag-btn" href={base + 'ielts-mock/writing/'}>AI baholashni sinab ko‘rish <span>→</span></a>
    </div>
  </section>

  <section id="katalog" class="catalog-section">
    <div class="section-heading">
      <div><p class="eyebrow">MOCK KATALOGI</p><h2>O‘zingizga mos mockni tanlang</h2></div>
      <p class="section-note"><b>20 ta</b> mavjud HTML practice<br/><strong>11 ta To‘liq CDI Mock</strong> audio bilan tayyor</p>
    </div>
    <div class="filter-row" role="group" aria-label="Mock filtrlari">
      <button class="filter active" data-filter="all">Barchasi</button>
      <button class="filter" data-filter="available">Mavjud</button>
    </div>
    <div class="mock-grid">
      {mocks.map((mock) => (
        <article class:list={['mock-card', { 'is-locked': mock.status !== 'Mavjud' }]} data-state={mock.status === 'Mavjud' ? 'available' : 'audio'}>
          <div class="card-top"><span class="mock-code">{mock.code}</span><span class:list={['status', { beta: mock.status === 'Mavjud' }]}>{mock.status}</span></div>
          <h3>{mock.title}</h3>
          <div class="skill-tags"><span>{mock.type}</span>{mock.tag && <span>{mock.tag}</span>}{mock.status !== 'Mavjud' && <span>Audio kerak</span>}</div>
          <div class="mock-meta"><span>{mock.difficulty}</span><span>·</span><span>{mock.status === 'Mavjud' ? 'Hozir topshirish mumkin' : 'Audio yuklangach ochiladi'}</span></div>
          {mock.status === 'Mavjud'
            ? <a class="choose-mock" href={base + 'ielts-mocks/catalog/' + mock.file} target="_blank" rel="noopener">Practice’ni ochish <span>→</span></a>
            : <span class="waitlist">Hozircha sotuvda emas</span>}
        </article>
      ))}
    </div>
  </section>

  <section id="qadam" class="qadam-section">
    <div class="section-heading inverse">
      <div><p class="eyebrow">TAYANCH QADAM</p><h2>Faqat kerakli urinish uchun to‘lang</h2></div>
      <p>Qadamlar 6 oy faol hisobingizda turadi. IELTS Listening yoki IELTS Reading kursi xaridorlariga bir marta 2 Qadam bonus beriladi.</p>
    </div>
    <p class="offer-note">Birinchi oy uchun maxsus narx: paketlardagi chizib ko‘rsatilgan summa Qadamlarni alohida, bazaviy narxda olish qiymati. Sun’iy oshirilgan narx ishlatilmaydi.</p>
    <div class="pricing-grid">
      <article class="price-card"><span>Sinov</span><strong>1 <em>Qadam</em></strong><p>Bitta skill practice uchun</p><b>40 000 so‘m</b><small>Bazaviy narx</small><button class="buy-demo" data-pack="1">Sinov paketini tanlash</button></article>
      <article class="price-card"><span>Full Mock</span><strong>4 <em>Qadam</em></strong><p>Listening · Reading · Writing · Speaking</p><del>160 000 so‘m</del><b>149 000 so‘m</b><small>11 000 so‘m tejam</small><button class="buy-demo" data-pack="4">Full mockni tanlash</button></article>
      <article class="price-card"><span>Start</span><strong>5 <em>Qadam</em></strong><p>Full mock + 1 skill</p><del>200 000 so‘m</del><b>179 000 so‘m</b><small>21 000 so‘m tejam</small><button class="buy-demo" data-pack="5">Start paketini tanlash</button></article>
      <article class="price-card featured"><i>Eng maqbul</i><span>Progress</span><strong>10 <em>Qadam</em></strong><p>2 full mock + 2 skill</p><del>400 000 so‘m</del><b>329 000 so‘m</b><small>71 000 so‘m tejam</small><button class="buy-demo" data-pack="10">Progress paketini tanlash</button></article>
      <article class="price-card"><span>Intensive</span><strong>20 <em>Qadam</em></strong><p>5 ta full mock uchun</p><del>800 000 so‘m</del><b>599 000 so‘m</b><small>201 000 so‘m tejam</small><button class="buy-demo" data-pack="20">Intensive paketini tanlash</button></article>
    </div>
    <div class="conversion-footer">
      <div><strong>Hozir sinab ko‘rish xavfsiz.</strong><span>Bu frontend demo: tugmani bosish to‘lov yechmaydi. Real checkout ishga tushganda Click, Payme, Uzum yoki karta orqali to‘lash mumkin bo‘ladi.</span></div>
      <a href="#katalog" class="primary-btn">Hozir ishlaydigan practice’ni tanlash <span>→</span></a>
    </div>
  </section>

  <section class="trust-section" aria-label="Ishonch elementlari">
    <p class="eyebrow">TAYANCH HAQIDA</p>
    <div><strong>Asoschi natijalari: IELTS 7.0 · SAT 1420</strong><p>Mock natijasi rasmiy IELTS sertifikati emas; u practice va keyingi tayyorgarlik qadamlarini aniqlash uchun beriladi.</p></div>
  </section>

  <section class="model-section" aria-label="Tayanch practice modeli">
    <p class="eyebrow">QANDAY FOYDALANISH KERAK</p>
    <div><strong>Uyda tez-tez mashq qiling. Muhim imtihon oldidan esa real test muhitida o‘zingizni sinang.</strong><p>Tayanch — istalgan payt alohida skillni mashq qilish, xatoni ko‘rish va qayta urinish uchun. Fizik mock imtihon esa yakuniy atmosfera sinovi bo‘lishi mumkin.</p></div>
  </section>

  <section class="flow-section">
    <p class="eyebrow">QANDAY ISHLAYDI</p>
    <div class="flow-grid"><div><b>1</b><h3>Mockni tanlang</h3><p>Skill yoki full mockni belgilang.</p></div><div><b>2</b><h3>Qadamdan foydalaning</h3><p>Jami oldindan aniq ko‘rinadi.</p></div><div><b>3</b><h3>Topshiring</h3><p>Taymer va autosave bilan ishlang.</p></div><div><b>4</b><h3>Natijani ko‘ring</h3><p>AI practice estimate va keyingi qadamlar.</p></div></div>
  </section>

  <dialog id="selectorDialog" class="selector-dialog" aria-labelledby="selectorTitle">
    <div class="dialog-head"><div><p class="eyebrow" id="selectedCode">MOCK 001</p><h2 id="selectorTitle">Modullarni tanlang</h2></div><button class="close-dialog" aria-label="Yopish">×</button></div>
    <p class="dialog-intro">Har modul 1 Qadam. Siz xohlagan ko‘nikmalarni belgilang.</p>
    <div class="module-list">
      <label><input type="checkbox" value="Listening" checked/><span><b>Listening</b><small>~30 daqiqa · avtomatik score</small></span><strong>1 Qadam</strong></label>
      <label><input type="checkbox" value="Reading" checked/><span><b>Reading</b><small>~60 daqiqa · avtomatik score</small></span><strong>1 Qadam</strong></label>
      <label><input type="checkbox" value="Writing" checked/><span><b>Writing</b><small>~60 daqiqa · AI feedback</small></span><strong>1 Qadam</strong></label>
      <label><input type="checkbox" value="Speaking" checked/><span><b>Speaking</b><small>~15 daqiqa · audio + AI feedback</small></span><strong>1 Qadam</strong></label>
    </div>
    <div class="summary"><div><span>Tanlangan modullar</span><b id="selectedCount">4 ta</b></div><div><span>Jami</span><strong><span id="totalQadam">4</span> Qadam <small>· <span id="totalUzs">128 000</span> so‘m</small></strong></div><p id="balanceMessage">Demo balansingiz yetarli emas. Paket tanlang yoki demo natijani ko‘ring.</p></div>
    <div class="dialog-actions"><button class="secondary-action close-dialog">Orqaga</button><a class="primary-action" href={base + 'ielts-mock/results/'} id="demoResult">Demo natijani ko‘rish →</a></div>
  </dialog>

  <div id="demoToast" class="toast" role="status" aria-live="polite"></div>

  <style>
    .mock-hero{display:grid;grid-template-columns:1.45fr .7fr;gap:2rem;align-items:stretch;padding:4.2rem min(7vw,90px) 3.5rem;max-width:1320px;margin:auto}.eyebrow{font-size:.76rem;font-weight:800;letter-spacing:.12em;color:var(--accent);margin:0 0 .7rem}.hero-copy h1{font:800 clamp(2.5rem,5vw,4.9rem)/1.03 var(--font-display);letter-spacing:-.065em;margin:0;max-width:720px}.hero-copy h1 span{color:var(--accent)}.lead{max-width:680px;color:var(--muted);font-size:1.1rem;line-height:1.7;margin:1.3rem 0 1.8rem}.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap}.primary-btn,.secondary-btn,.choose-mock,.waitlist,.buy-demo,.primary-action,.secondary-action{border:0;font:700 .95rem var(--font-display);border-radius:12px;text-decoration:none;cursor:pointer;transition:transform .16s,box-shadow .16s,background .16s}.primary-btn,.primary-action{background:linear-gradient(135deg, var(--btn-bg),#6f62e8);color:#fff;padding:13px 18px;box-shadow:0 10px 26px -12px var(--accent)}.primary-btn:hover,.primary-action:hover{transform:translateY(-2px);color:#fff}.secondary-btn,.secondary-action{border:1px solid var(--border);color:var(--text);padding:12px 16px;background:transparent}.notice{font-size:.81rem;color:var(--muted);margin:1.25rem 0 0}.wallet-card{border:1px solid color-mix(in srgb,var(--accent) 45%,var(--border));border-radius:22px;padding:1.65rem;background:linear-gradient(155deg,color-mix(in srgb,var(--accent) 22%,var(--surface)),var(--surface));align-self:center;box-shadow:var(--shadow)}.wallet-top{display:flex;gap:.5rem;align-items:center;color:var(--muted);font-size:.76rem;font-weight:800;letter-spacing:.08em}.wallet-icon{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;color:#fff;background: var(--btn-bg)}.wallet-card strong{display:block;font:800 2.55rem var(--font-display);margin:1rem 0 .2rem}.wallet-card em,.price-card em{font-style:normal;font-size:.95rem;color:var(--muted)}.wallet-card p{color:var(--muted);margin:.2rem 0 1.5rem}.wallet-card a{color:var(--accent);font-weight:700;text-decoration:none}.value-row{max-width:1140px;margin:0 auto 4.5rem;padding:0 min(7vw,90px);display:grid;grid-template-columns:repeat(4,1fr);gap:0}.value-row article{padding:1.25rem;border-left:1px solid var(--border)}.value-row article:first-child{border-left:0}.value-row span{display:block;color:var(--accent);font-size:.76rem;font-weight:800;margin-bottom:.6rem}.value-row strong{font-size:1rem}.value-row p{color:var(--muted);font-size:.86rem;line-height:1.5;margin:.4rem 0 0}.catalog-section,.flow-section{max-width:1180px;margin:0 auto;padding:0 min(7vw,90px) 4.5rem}.section-heading{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:1.6rem}.section-heading h2{font:800 clamp(1.8rem,3.2vw,3rem)/1.05 var(--font-display);letter-spacing:-.045em;margin:0}.section-note{font-size:.86rem;line-height:1.55;color:var(--muted);margin:0}.section-note b{color:var(--accent)}.filter-row{display:flex;gap:.45rem;margin-bottom:1.15rem}.filter{background:transparent;border:1px solid var(--border);border-radius:999px;padding:.5rem .85rem;color:var(--muted);font-weight:700;cursor:pointer}.filter.active{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}.mock-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.mock-card{display:flex;flex-direction:column;padding:1.35rem;border:1px solid var(--border);border-radius:17px;background:var(--surface);min-height:245px;transition:transform .16s,border-color .16s,opacity .16s}.mock-card:hover:not(.is-locked){transform:translateY(-3px);border-color:var(--accent)}.mock-card.is-locked{opacity:.67}.card-top{display:flex;justify-content:space-between;gap:.5rem;align-items:center}.mock-code{font-weight:800;letter-spacing:.08em;font-size:.76rem;color:var(--accent)}.status{font-size:.71rem;padding:.3rem .52rem;border-radius:999px;background:var(--border);color:var(--muted);font-weight:700}.status.beta{color:#58d47a;background:color-mix(in 
---
import Base from "../layouts/Base.astro";
const title = "Markdown → PDF konverter | Tayanch";
const description = "Markdown matnni brauzerda darhol PDF faylga aylantiring. Bepul, serverga yuklanmaydi.";
const base = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <section class="md2pdf">
    <div class="md2pdf-head">
      <span class="badge badge-new">Vosita</span>
      <h1 data-i18n="mdp.h1">Markdown → PDF konverter</h1>
      <p class="lead" data-i18n="mdp.lead">
        Markdown yozing — o'ng tomonda jonli ko'rinish paydo bo'ladi.
        <b>«PDF yuklab olish»</b> tugmasi bilan darhol fayl saqlang.
        Hammasi brauzeringizda bo'ladi, hech qanday matn serverga yuborilmaydi.
      </p>
    </div>

    <div class="md2pdf-toolbar">
      <button id="dlPdf" class="start-btn" type="button">⬇ PDF yuklab olish</button>
      <button id="loadSample" class="ghost-btn" type="button">Namuna yuklash</button>
      <button id="clearAll" class="ghost-btn" type="button">Tozalash</button>
      <span id="status" class="md2pdf-status" aria-live="polite"></span>
    </div>

    <div class="md2pdf-grid">
      <div class="md2pdf-pane">
        <label for="mdInput">Markdown</label>
        <textarea id="mdInput" spellcheck="false"
          placeholder={"# Sarlavha\n\nMatn... **qalin**, *qiyiq*, `kod`, [havola](https://example.com).\n\n- ro'yxat\n- element\n\n| A | B |\n|---|---|\n| 1 | 2 |"}></textarea>
      </div>
      <div class="md2pdf-pane">
        <label>Ko'rinish (PDF ga aylanadi)</label>
        <div id="preview" class="md-preview"></div>
      </div>
    </div>

    <p class="md2pdf-note">
      Eslatma: bu <code>md2pdf.py</code> skriptining brauzer-versiyasi. Fayl nomi birinchi
      <code># sarlavha</code> dan olinadi. Katta hujjatlarda PDF bir necha soniya tayyorlanishi mumkin.
    </p>
  </section>
</Base>

<script is:inline src={base + 'vendor/marked.umd.js'}></script>
<script is:inline src={base + 'vendor/html2pdf.bundle.min.js'}></script>
<script is:inline>
  (function () {
    var input = document.getElementById('mdInput');
    var preview = document.getElementById('preview');
    var status = document.getElementById('status');
    var dlBtn = document.getElementById('dlPdf');
    var sampleBtn = document.getElementById('loadSample');
    var clearBtn = document.getElementById('clearAll');

    var SAMPLE = [
      '# O\'rganamiz — kunlik reja',
      '',
      '**Bugun:** IELTS Reading mashqi va 30 daqiqa listening.',
      '',
      '## Vazifalar',
      '',
      '- [x] 20 ta savol (TRUE/FALSE/NOT GIVEN)',
      '- [ ] Reading passage 2',
      '- [ ] Writing Task 2 outline',
      '',
      '> "Kichik, lekin doimiy qadam — eng muhimi."',
      '',
      '### Nutfular jadvali',
      '',
      '| Bo\'lim | Vaqt | Maqsad |',
      '|--------|------|--------|',
      '| Listening | 30 d | 7.0 band |',
      '| Reading | 30 d | 7.0 band |',
      '',
      'Kod misoli:',
      '',
      '```js',
      'console.log("Salom, O\'rganamiz!");',
      '```',
      '',
      'Batafsil: [rasmiy sayt](https://javohirqaxramonov36-web.github.io/strawberryboo-site/)'
    ].join('\n');

    function render() {
      var src = input.value || '';
      try {
        preview.innerHTML = marked.parse(src);
      } catch (e) {
        preview.innerHTML = '<p style="color:#b00020">Xatolik: ' + e.message + '</p>';
      }
    }

    function filenameFrom(src) {
      var m = src.match(/^#\s+(.+)$/m);
      var raw = m ? m[1].trim() : 'hujjat';
      var cleaned = raw.replace(/[^\p{L}\p{N} _-]/gu, '').replace(/\s+/g, '_').slice(0, 60);
      return (cleaned || 'hujjat') + '.pdf';
    }

    input.addEventListener('input', render);

    dlBtn.addEventListener('click', function () {
      if (!input.value.trim()) { status.textContent = 'Avval markdown yozing.'; return; }
      var name = filenameFrom(input.value);
      status.textContent = 'PDF tayyorlanmoqda...';
      html2pdf().set({
        margin: 12,
        filename: name,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
        pagebreak: { mode: ['css', 'legacy'] }
      }).from(preview).save().then(function () {
        status.textContent = '✅ Yuklab olindi: ' + name;
      }).catch(function (e) {
        status.textContent = 'Xatolik: ' + (e && e.message ? e.message : e);
      });
    });

    sampleBtn.addEventListener('click', function () {
      input.value = SAMPLE;
      render();
      status.textContent = 'Namuna yuklandi.';
    });

    clearBtn.addEventListener('click', function () {
      input.value = '';
      render();
      status.textContent = '';
    });

    render();
  })();
</script>

<style>
  .md2pdf { max-width: 1100px; margin: 0 auto; padding: 2.5rem 20px 3rem; }
  .md2pdf-head { margin-bottom: 1.4rem; }
  .md2pdf-head h1 { font-family: var(--font-display); font-size: 2rem; margin: .4rem 0 .5rem; letter-spacing: -.02em; }
  .md2pdf-head .lead { color: var(--muted); max-width: 760px; line-height: 1.65; }

  .md2pdf-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 1.2rem; }
  .ghost-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: .65rem 1.2rem; border-radius: 10px; cursor: pointer;
    background: var(--surface); color: var(--text);
    border: 1px solid var(--border); font-weight: 700; font-size: .95rem;
    transition: border-color .15s, color .15s, background .15s;
  }
  .ghost-btn:hover { border-color: var(--accent); color: var(--accent); }
  .md2pdf-status { color: var(--muted); font-size: .88rem; }

  .md2pdf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .md2pdf-pane { display: flex; flex-direction: column; }
  .md2pdf-pane label {
    font: 700 12px var(--font-display); text-transform: uppercase; letter-spacing: .05em;
    color: var(--muted); margin-bottom: .5rem;
  }
  #mdInput {
    flex: 1; min-height: 440px; resize: vertical;
    padding: 16px 18px; border-radius: 12px;
    background: var(--surface); color: var(--text);
    border: 1px solid var(--border);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 14px; line-height: 1.6;
  }
  #mdInput:focus { outline: none; border-color: var(--accent); }

  /* Preview content: use :global() so runtime-injected HTML gets styled */
  .md-preview {
    flex: 1; min-height: 440px; overflow: auto;
    padding: 24px 28px; border-radius: 12px;
    background: #ffffff; color: #111111;
    border: 1px solid var(--border);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.65; font-size: 15px;
  }
  .md-preview :global(h1) { font-size: 1.7rem; margin: 0 0 .6rem; color: #111; }
  .md-preview :global(h2) { font-size: 1.35rem; margin: 1.4rem 0 .5rem; color: #111; border-bottom: 1px solid #e5e5e5; padding-bottom: .3rem; }
  .md-preview :global(h3) { font-size: 1.12rem; margin: 1.1rem 0 .4rem; color: #111; }
  .md-preview :global(h4) { font-size: 1rem; margin: 1rem 0 .4rem; color: #111; }
  .md-preview :global(p) { margin: 0 0 .7rem; }
  .md-preview :global(ul),
  .md-preview :global(ol) { margin: 0 0 .8rem; padding-left: 1.4rem; }
  .md-preview :global(li) { margin: .2rem 0; }
  .md-preview :global(li input[type="checkbox"]) { margin-right: .4rem; }
  .md-preview :global(a) { color: #3b5bdb; text-decoration: underline; }
  .md-preview :global(strong) { color: #000; }
  .md-preview :global(code) {
    background: #f2f2f4; color: #c0392b; padding: .1rem .35rem;
    border-radius: 5px; font-size: .9em;
    font-family: ui-monospace, Menlo, Consolas, monospace;
  }
  .md-preview :global(pre) {
    background: #0f1117; color: #e6e6e6; padding: 1rem; border-radius: 10px;
    overflow-x: auto; margin: 0 0 .8rem;
  }
  .md-preview :global(pre code) { background: none; color: inherit; padding: 0; }
  .md-preview :global(blockquote) {
    margin: 0 0 .8rem; padding: .5rem 1rem; border-left: 4px solid #7d7df5;
    background: #f5f5fb; color: #333; border-radius: 0 8px 8px 0;
  }
  .md-preview :global(table) { border-collapse: collapse; width: 100%; margin: 0 0 .8rem; font-size: .92rem; }
  .md-preview :global(th),
  .md-preview :global(td) { border: 1px solid #d8d8e0; padding: .45rem .7rem; text-align: left; }
  .md-preview :global(th) { background: #f0f0f6; color: #111; font-weight: 700; }
  .md-preview :global(hr) { border: none; border-top: 1px solid #e0e0e6; margin: 1rem 0; }
  .md-preview :global(img) { max-width: 100%; height: auto; }

  .md2pdf-note { color: var(--muted); font-size: .85rem; margin-top: 1.2rem; max-width: 820px; }
  .md2pdf-note code { background: var(--accent-soft); color: var(--accent); padding: .1rem .35rem; border-radius: 5px; }

  @media (max-width: 760px) {
    .md2pdf-grid { grid-template-columns: 1fr; }
    #mdInput, .md-preview { min-height: 280px; }
  }
</style>

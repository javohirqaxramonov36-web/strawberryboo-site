  <script is:inline>
    const allGames = [
      { id:1, title:"Typing Speed Test", description:"Matn beriladi, yozasiz. WPM va aniqlik hisoblanadi.", emoji:"⌨️", category:"mashq", type:"typing" },
      { id:2, title:"Reaction Time Test", description:"Yashil bo'lganda bosing. Vaqt ms da.", emoji:"⚡", category:"mashq", type:"reaction" },
      { id:3, title:"Word Guess (Wordle)", description:"5 harfli so'zni 6 urinishda toping.", emoji:"🔤", category:"mashq", type:"wordle" },
      { id:4, title:"Memory Match", description:"Kartalarni juftlang.", emoji:"🃏", category:"mashq", type:"memory" },
      { id:5, title:"Anagram Solver", description:"Aralash harflardan so'z toping.", emoji:"🔡", category:"mashq", type:"anagram" },
      { id:6, title:"Xato Topish", description:"Gapdagi grammatik xatoni toping.", emoji:"🔍", category:"bilim", type:"xato" },
      { id:7, title:"Tez fikrla (60s)", description:"60 soniyada qancha so'z yozasiz?", emoji:"💡", category:"mashq", type:"tez" },
      { id:8, title:"Emoji Puzzle", description:"Emojidan ibora toping.", emoji:"😀", category:"bilim", type:"emoji" },
      { id:9, title:"Optical Illusion", description:"Vizual jumboqlar galereyasi.", emoji:"👁️", category:"bilim", type:"optical" },
      { id:10, title:"Trivia (15 savol)", description:"15 ta bilim savoli.", emoji:"🧠", category:"bilim", type:"trivia" },
      { id:11, title:"AI yoki Inson?", description:"Matn AI tomonidanmi yozilgan?", emoji:"🤖", category:"bilim", type:"aihuman" },
      { id:12, title:"Band 9 yozuvchimisiz?", description:"5 ta juftlikni to'g'ri joylashtiring.", emoji:"📝", category:"bilim", type:"band9" },
      { id:13, title:"Flashcard Speed", description:"60 soniyada 8 karta.", emoji:"🗂️", category:"bilim", type:"flashcard" },
      { id:14, title:"AI Detective", description:"Qaysi xabar soxta?", emoji:"🕵️", category:"bilim", type:"detective" },
      { id:15, title:"20 ta savol", description:"Qaror daraxti bo'yicha 20 savol.", emoji:"🌳", category:"simulyatsiya", type:"twenty" },
      { id:16, title:"Startup Idea Generator", description:"Tasodifiy startup g'oyasi.", emoji:"🚀", category:"ijod", type:"startup" },
      { id:17, title:"Byudjet simulyatori", description:"$1000 ni taqsimlang.", emoji:"💰", category:"simulyatsiya", type:"budget" },
      { id:18, title:"Bugungi kayfiyat", description:"Kayfiyatingizni tanlang.", emoji:"😊", category:"ijod", type:"mood" },
      { id:19, title:"Mini avatar", description:"SVG avatar generatsiyasi.", emoji:"🎨", category:"ijod", type:"avatar" },
      { id:20, title:"Prompt Engineering", description:"Prompt tuzing, ball oling.", emoji:"💬", category:"ijod", type:"prompt" }
    ];

    const SCORE_KEY = "strawberry_scores";
    function getScores(){ try { return JSON.parse(localStorage.getItem(SCORE_KEY)) || {}; } catch(e){ return {}; } }
    function getBest(id){ const s = getScores(); return s[id] ? s[id].best : null; }
    function setBest(id, value, label){
      const s = getScores();
      if(!s[id] || value > s[id].best){ s[id] = { best: value, label, ts: Date.now() }; localStorage.setItem(SCORE_KEY, JSON.stringify(s)); return true; }
      return false;
    }

    function renderGames(filter){
      const container = document.getElementById("games-container");
      const list = filter === "all" ? allGames : allGames.filter(g => g.category === filter);
      document.querySelectorAll(".filter-btn").forEach(b => b.classList.toggle("active", b.dataset.filter === filter));
      if(!list.length){ container.innerHTML = `<p class="no-games">O'yin topilmadi.</p>`; return; }
      container.innerHTML = list.map(g => {
        const best = getBest(g.id);
        const bestHtml = best !== null ? `<span class="best-score">🏆 ${best.label}: ${best.best}</span>` : `<span class="best-score muted">🏆 hali yo'q</span>`;
        return `<div class="game-card" data-id="${g.id}">
          <div class="game-emoji">${g.emoji}</div>
          <div class="game-title">${g.title}</div>
          <div class="game-desc">${g.description}</div>
          ${bestHtml}
          <button class="play-btn" data-id="${g.id}">O'ynash →</button>
        </div>`;
      }).join("");
      document.querySelectorAll(".play-btn").forEach(btn => {
        btn.addEventListener("click", () => openGame(parseInt(btn.dataset.id)));
      });
    }

    let activeGame = null;
    let lastResultText = "";
    function openGame(id){
      const game = allGames.find(g => g.id === id);
      if(!game) return;
      activeGame = game;
      document.getElementById("game-modal-title").textContent = game.emoji + " " + game.title;
      document.getElementById("game-modal-body").innerHTML = "";
      document.getElementById("game-result").classList.add("hidden");
      document.getElementById("game-result").innerHTML = "";
      document.getElementById("game-share").classList.add("hidden");
      document.getElementById("game-modal").classList.remove("hidden");
      window["init_" + game.type](document.getElementById("game-modal-body"));
    }
    function closeGame(){
      document.getElementById("game-modal").classList.add("hidden");
      activeGame = null;
    }
    function showResult(html, scoreValue, scoreLabel){
      const r = document.getElementById("game-result");
      r.innerHTML = html;
      r.classList.remove("hidden");
      if(scoreValue !== undefined && scoreLabel){
        const improved = setBest(activeGame.id, scoreValue, scoreLabel);
        if(improved) r.innerHTML += `<p class="new-record">🎉 Yangi rekord!</p>`;
        lastResultText = `${activeGame.emoji} ${activeGame.title} — ${scoreLabel}: ${scoreValue} (Tayanch Ko'ngilochar)`;
        document.getElementById("game-share").classList.remove("hidden");
      }
      renderGames(document.querySelector(".filter-btn.active").dataset.filter);
    }
    document.getElementById("game-modal-close").addEventListener("click", closeGame);
    document.getElementById("game-modal").addEventListener("click", e => { if(e.target.id === "game-modal") closeGame(); });
    document.getElementById("share-copy").addEventListener("click", () => {
      navigator.clipboard.writeText(lastResultText).then(() => alert("Nusxa olindi!")).catch(() => alert("Nusxa olish qo'llab-quvvatlanmaydi."));
    });
    document.getElementById("share-telegram").addEventListener("click", e => {
      e.preventDefault();

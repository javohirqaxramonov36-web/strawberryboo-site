      function wait(){ box.textContent = "Kuting..."; box.className = "reaction-box wait"; active = false; setTimeout(() => { box.textContent = "ENDI BOSING!"; box.className = "reaction-box go"; start = performance.now(); active = true; }, 1000 + Math.random()*3000); }

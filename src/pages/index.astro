      <p class="price">$19 <span class="uzs">≈ 240 000 so'm</span></p>

      <a href={base + 'kurslar/obsidian'} class="start-btn" data-gumroad-product="obsidian-bilim-bazasi" target="_blank" rel="noopener noreferrer">Bilim bazosi qurish →</a>
    </div>

    <div class="card" style="--c:#ef4444">
      <span class="badge badge-hot"><span data-i18n="spot.badge">Eng mashhur</span></span>

        else showResult(`<p>Jami $${sum}. 1000 bo'lishi kerak. Qayta urinib ko'ring.</p>`, sum, "$");
      });
    }

    const MOODS = [["😄","Ajoyib"],["🙂","Yaxshi"],["😐","Normal"],["😟","Xafa"],["😡","G'azablangan"]];
    function init_mood(root){
      root.innerHTML = `<p class="g-inst">Bugun o'zingizni qanday his qilyapsiz?</p><div id="mood-area">${MOODS.map((m,i)=>`<button class="mood-btn" data-i="${i}">${m[0]}</button>`).join("")}</div><p id="mood-msg"></p>`;
      document.querySelectorAll(".mood-btn").forEach(b => b.addEventListener("click", () => {
        const m = MOODS[parseInt(b.dataset.i)];
        document.getElementById("mood-msg").textContent = `Siz: ${m[0]} ${m[1]}`;
        localStorage.setItem("strawberry_mood", m[1]);
        showResult(`<p>Bugungi kayfiyat: <b>${m[0]} ${m[1]}</b></p>`, parseInt(b.dataset.i)+1, "ball");
      }));
    }

    function init_avatar(root){
      const colors = ["#fee2e2","#dbeafe","#dcfce7","#fef9c3","#f3e8ff"];
      function gen(){ const c = colors[Math.floor(Math.random()*colors.length)]; const eye = 6+Math.floor(Math.random()*6); const smile = Math.random()>0.5;
        root.innerHTML = `<div class="avatar-wrap"><svg width="160" height="160" viewBox="0 0 100 100"><circle cx="50" cy="50" r="45" fill="${c}"/><circle cx="35" cy="45" r="6" fill="#333"/><circle cx="65" cy="45" r="6" fill="#333"/>${smile?`<path d="M35 65 Q50 78 65 65" stroke="#333" stroke-width="3" fill="none"/>`:`<path d="M35 70 Q50 58 65 70" stroke="#333" stroke-width="3" fill="none"/>`}</svg></div><div class="g-actions"><button id="avatar-again" class="mini-btn">Yana</button></div>`;
        document.getElementById("avatar-again").addEventListener("click", gen);
      }
      gen();
    }

    const PROMPTS = [
      { task:"AI dan 5 ta IELTS Writing Task 2 mavzusi chiqarishini so'rang.", hint:"Aniq, kontest berish yaxshiroq." },
      { task:"AI ga tarjima qildirib, notchalik tabiiy ekanini baholang.", hint:"Instruction'da maqsad audienceni ayting." },
      { task:"AI dan rezyume uchun 3 ta xulosani yozishni so'rang.", hint:"Rol (role) bering: 'Sen HR mutaxassisisan'." }
    ];
    function init_prompt(root){
      const item = PROMPTS[Math.floor(Math.random()*PROMPTS.length)];
      root.innerHTML = `<p class="g-inst">Vazifa: ${item.task}</p><p class="g-hint">Maslahat: ${item.hint}</p><textarea id="prompt-input" rows="3" placeholder="O'z promptingizni yozing..."></textarea><div class="g-actions"><button id="prompt-score" class="mini-btn">Baholash</button></div>`;
      document.getElementById("prompt-score").addEventListener("click", () => {
        const v = document.getElementById("prompt-input").value.trim();
        const len = v.length; const score = Math.min(100, Math.round(len/2));
        showResult(`<p>Prompt bahosi: <b>${score}/100</b> (uzunlik asosida, oddiy baho).</p>`, score, "ball");
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      initStatic();
      renderGames("all");
      document.querySelectorAll(".filter-btn").forEach(btn => {
        btn.addEventListener("click", () => renderGames(btn.dataset.filter));
      });
    });
  </script>

<script>
  (function () {
    const el = document.querySelector(".typed-text");
    if (!el) return;
    const HERO_I18N = {"uz": ["AI'dan 5 daqiqada sifatli javob", "O'qiganingiz esda qoladigan bilim bazasi", "O'z AI yordamchingizni yaratish", "IELTS 6.5+ band: 30 kunlik reja", "Chet elga qabul: hujjatdan intervyugacha", "Pullik obuna bermasdan AI'dan foydalanish", "Bepul Figma: UI/UX asoslarini 1 kunda", "Mac'da chizma: bepul talaba litsenziyasi", "Mac'da ishni 2 baravar tezroq bajarish", "Nima uchun chet elda o'qish kerak (va bepul qanday)", "Data Analytics", "Backend Python"], "ru": ["Качественный ответ от ИИ за 5 минут", "База знаний, которая запоминается", "Создать своего ИИ-помощника", "IELTS 6.5+ баллов: план на 30 дней", "Поступление за рубеж: от документов до интервью", "Пользоваться ИИ без платной подписки", "Бесплатный Figma: основы UI/UX за 1 день", "Рисование на Mac: бесплатная студенческая лицензия", "Работа на Mac в 2 раза быстрее", "Зачем учиться за рубежом (и как бесплатно)", "Data Analytics", "Backend Python"], "en": ["Quality answer from AI in 5 minutes", "A knowledge base that actually sticks", "Build your own AI assistant", "IELTS 6.5+ band: 30-day plan", "Study abroad: from documents to interview", "Use AI without a paid subscription", "Free Figma: UI/UX basics in 1 day", "Drawing on Mac: free student license", "Get work done 2x faster on Mac", "Why study abroad (and how for free)", "Data Analytics", "Backend Python"]};
    const _L = localStorage.getItem('org-lam-lang') || 'uz';
    const words = (HERO_I18N[_L] || HERO_I18N.uz);
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) { el.textContent = words[0]; return; }
    let wi = 0, ci = 0, deleting = false;
    function tick() {
      const word = words[wi];
      if (!deleting) {
        ci++;
        el.textContent = word.slice(0, ci);
        if (ci === word.length) { deleting = true; return setTimeout(tick, 1600); }
        return setTimeout(tick, 70 + Math.random() * 45);
      } else {
        ci--;
        el.textContent = word.slice(0, ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; return setTimeout(tick, 420); }
        return setTimeout(tick, 35);
      }
    }
    el.textContent = "";
    setTimeout(tick, 600);
  })();
</script>


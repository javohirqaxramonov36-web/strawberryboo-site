import Base from "../layouts/Base.astro";
import { totalCourseCount } from "../config/course-catalog";
import CourseCard from "../components/CourseCard.astro";
import TelegramLeadSection from "../components/TelegramLeadSection.astro";
import SocialImpactBanner from "../components/SocialImpactBanner.astro";
import coursesData from "../data/courses.json";
const courseById = (slug: string) => (coursesData.courses as any[]).find((c) => c.slug === slug);
const title = "AI, IELTS va Admission kurslari | Tayanch";
const description = "AI, IELTS, Admission va shaxsiy bilim bazasi bo'yicha amaliy kurslar. O'zbek tilida, bepul kurs ham bor.";
const base = import.meta.env.BASE_URL;
const allCourses = coursesData.courses as any[];
const generalEnglishCourses = allCourses.filter((course) => course.cats?.includes('general-english'));
const satCourses = allCourses.filter((course) => course.cats?.includes('sat'));
const TG = "https://t.me/tayanch_go"; // Telegram kanal/guruh havolasi
---

<Base title={title} description={description} showDiscountBanner={true}>
<section class="hero">
  <span class="eyebrow" data-i18n="hero.eyebrow">AI · IELTS · Admission kurslari</span>

  <div class="hero-badges">
    <span class="hero-badge" style="--bc:#7d7df5">
      <span class="bic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
      {totalCourseCount} ta kurs
    </span>
    <span class="hero-badge" style="--bc:#22c55e">
      <span class="bic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8M12 8v13M12 8S10 3 7.5 4.5 9 8 12 8zM12 8s2-5 4.5-3.5S15 8 12 8z"/></svg></span>
      Bepul ham bor
    </span>
    <span class="hero-badge" style="--bc:#3b82f6">
      <span class="bic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
      O'zbek tilida
    </span>
    <span class="hero-badge" style="--bc:#f59e0b">
      <span class="bic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></span>
      Forever access
    </span>
  </div>

  <p class="hero-founder-note"><span class="hf-ic" aria-hidden="true">✓</span> Asoschi: IELTS 7.0 va SAT 1420 natijalariga erishgan</p>

  <h1 class="hero-typed" data-i18n="hero.learn">AI, IELTS va Admission’ni bir joyda o‘rganing</h1>

  <p class="lead">
    Bugundan yangi ko'nikma egallang. Sun'iy intellekt nima uchun kerak,
    qanday foyda olish, qayerda qo'llash — barchasi amaliy kurslar bilan.
  </p>

  <div class="hero-actions">
    <a class="hero-cta primary" href={base + 'kurs-tanlash/'}>
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      <span>Qaysi kurs menga mos?</span>
    </a>
  </div>
</section>

<SocialImpactBanner />

<section class="founder-excerpt" aria-labelledby="founder-excerpt-title">
  <div><p class="eyebrow">NEGA TAYANCH?</p><h2 id="founder-excerpt-title">AI, IELTS va Admission’ni amaliy yo‘l bilan o‘rganing</h2></div>
  <div><p>Men moliyaviy qiyinchiliklar sabab mustaqil o‘rganish yo‘lidan o‘tdim. Endi Tayanch’da AI, IELTS va Admission bo‘yicha bilimni aniq yo‘l va amaliy qadamlar bilan ulashaman.</p><a class="course-nav-link" href={base + 'mening-yolim/'}>Batafsil o‘qish →</a><div class="founder-social"><a href={TG} target="_blank" rel="noopener noreferrer">Telegram</a><a href="https://instagram.com/javohir_kakhramonov" target="_blank" rel="noopener noreferrer">Instagram</a></div></div>
</section>

<!-- ENG MASHHUR SPOTLIGHT -->
<section class="spotlight">
  <div>
    <span class="badge badge-hot"><span data-i18n="spot.badge">Eng mashhur</span></span>
    <h2>O'z AI yordamchingizni yaratish</h2>
    <p>Oddiy AI bitta savolga javob beradi. Agent esa vazifani o'zi rejalashtirib, qidiruv qilib, natijani yozib chiqadi. CrewAI va LangGraph bilan o'z agent'ingizni yaratasiz. Kimga mo'ljallangan: AI bilan tanishgan va uni haqiqiy ishga qo'llamoqchi bo'lganlarga.</p>
    <div class="spot-price"><span class="uzs">490 000 so'm</span><span class="usd">≈ $39</span></div>
    <a href={base + 'kurslar/ai-agentlar'} class="course-nav-link"><span data-i18n="spot.more">Batafsil →</span></a>
  </div>
  <div class="spot-ic">
    <svg viewBox="0 0 24 24"><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><circle cx="12" cy="12" r="4"/><path d="M12 8a4 4 0 0 0-4 4M16 12a4 4 0 0 1-4 4"/></svg>
  </div>
</section>

<section>
  <div class="sec-head">
    <h2 class="sec-title">
      <span class="sec-ic" style="background:linear-gradient(135deg,#7d7df5,#5b5bd6)"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/><path d="M19 14l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg></span>
      <span data-i18n="sec.courses">Kurslarimiz</span>
    </h2>
    <a class="sec-all" href={base + 'kurslar'}><span data-i18n="sec.all">Barchasini ko'rish</span> <b>{totalCourseCount}</b> →</a>
  </div>

  <div class="features">
    {['prompt-engineering','obsidian','ai-agentlar'].map((s) => <CourseCard course={courseById(s)!} />)}

    <div class="card" style="--c:#22c55e">
      <span class="badge badge-new">Yangi</span>
      <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.5 3 6 3s6-2 6-3v-5"/></svg></div>
      <h2>IELTS 6.5+ band: 30 kunlik reja</h2>
      <span class="cat">Til · Admission</span>
      <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
      <p>Har bir skill alohida, 30 kunlik speaking rejasi bilan — kerakli band'gacha yetib olasiz. Kimga mo'ljallangan: IELTS 6.5–7.0 kerak bo'lganlarga.</p>
      <p class="price"><span class="price-local">93 750 so'mdan</span> <span class="usd">(≈ $7.50 / skill)</span></p>

      <a href={base + 'kurslar/#ielts-courses'} class="start-btn">Modullarni ko'rish →</a>
      <a href={base + 'ielts-mock/'} class="mock-practice-link">Mock imtihonni sinab ko'ring →</a>
    </div>

    {['admission-process','tekin-ai','mac-tezlik-sirlari','figma','vibe-coding','autocad-on-mac','chet-elda-oqish','data-analytics','backend-python','financial-literacy'].map((s) => <CourseCard course={courseById(s)!} />)}


  </div>
</section>

<section class="direction-preview" aria-labelledby="direction-preview-title">
  <div class="sec-head">
    <h2 class="sec-title" id="direction-preview-title">Yangi yo‘nalishlar</h2>
    <a class="sec-all" href={base + 'kurslar/'}>Barcha kurslar →</a>
  </div>
  <div class="direction-grid">
    <article class="direction-card">
      <p class="eyebrow">GENERAL ENGLISH · A1–C1</p>
      <h3>Darajama-daraja ingliz tili</h3>
      <p>6 ta bosqich: Beginner’dan Advanced’gacha. Har bir daraja uchun narx: $15.</p>
      <div class="path-list">
        {generalEnglishCourses.map((course, index) => <a class="path-item" href={base + course.href + '/'}><span>{index + 1}/6 · {course.title.uz}</span><small>{course.status === 'upcoming' ? 'Tez orada' : 'Mavjud'}</small></a>)}
      </div>
    </article>
    <article class="direction-card">
      <p class="eyebrow">SAT · ADMISSION</p>
      <h3>SAT uchun 3 qismli yo‘l</h3>
      <p>Math va English — $30 dan, Desmos Applications — $19. Har bir modul alohida tayyorlanadi.</p>
      <div class="path-list">
        {satCourses.map((course, index) => <a class="path-item" href={base + course.href + '/'}><span>{index + 1}/3 · {course.title.uz}</span><small>$30 / $19</small></a>)}
      </div>
    </article>
  </div>
</section>

<section class="upcoming-courses" aria-labelledby="upcoming-courses-title">
  <div class="upcoming-heading">
    <p class="eyebrow">KELAYOTGAN KURSLAR</p>
    <h2 id="upcoming-courses-title">Material tayyorlanmoqda</h2>
    <p>Bu kurslar ustida ish davom etmoqda. To‘liq material va sotuv ochilganda e’lon qilinadi.</p>
  </div>
  <div class="upcoming-grid">
    <div class="card" style="--c:#ec4899">
      <span class="badge badge-new">Tez orada</span>
      <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M12 4V2M9 2h6"/></svg></div>
      <h2>El-Yurt Umidi'ni yutaylik</h2>
      <span class="cat">Admission</span>
      <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
      <p>Davlat granti bo'yicha suhbatga tayyorgarlik — to'liq material tez orada qo'shiladi.</p>
      <p class="upcoming-status">Dastur ustida ish davom etmoqda</p>
      <span class="start-btn is-disabled" aria-disabled="true">Tayyorlanmoqda</span>
    </div>

    <div class="card" style="--c:#0ea5e9">
      <span class="badge badge-soon">Kelayotgan</span>
      <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="11" rx="2"/><path d="M2 20h20"/></svg></div>
      <h2>Computer Literacy — Raqamli savodxonlik</h2>
      <span class="cat">HAYOTIY KO'NIKMA</span>
      <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
      <p>Microsoft Office (Word, Excel, PowerPoint) va Google Workspace (Docs, Sheets, Slides) — zamonaviy muhandislik va ta'lim uchun asosiy raqamli ko'nikmalar.</p>
      <p class="upcoming-status">Narx va dastur tez orada e'lon qilinadi</p>
      <span class="start-btn is-disabled" aria-disabled="true">Tayyorlanmoqda</span>
    </div>
  </div>
</section>

<section class="why-us">
  <div class="sec-head" style="margin-top:0">
    <h2 class="sec-title">
      <span class="sec-ic" style="background:linear-gradient(135deg,#22c55e,#16a34a)"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
      <span data-i18n="why.title">Nega biz?</span>
    </h2>
  </div>
  <ul>
    <li data-i18n="why.1">Amaliy — nazariya emas, qilish o'rganasiz</li>
    <li data-i18n="why.2">O'zbek tilida — tushunarli tushuntirish</li>
    <li data-i18n="why.3">Arzon — 240 000 so‘mdan (≈ $19)</li>
    <li data-i18n="why.4">Forever access — bir marta sotib, doim foydalan</li>
    <li data-i18n="why.5">Har kursda sertifikat</li>
  </ul>
  <p class="quiz-hint" style="margin:1rem 0 0">Sertifikatlar bo‘yicha nimani tekshirish mumkinligini ochiq ko‘ring: <a href={base + 'sertifikat/'} style="color:var(--accent)">sertifikatlar haqida →</a></p>
</section>

<section class="payment">
  <div class="sec-head" style="margin-top:0">
    <h2 class="sec-title">
      <span class="sec-ic" style="background:linear-gradient(135deg,#f59e0b,#d97706)"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
      <span data-i18n="pay.title">To'lov</span>
    </h2>
  </div>
  <p class="quiz-hint" style="margin-top:0">To'lov tafsilotlari uchun Telegram orqali yozing: <a href="https://t.me/tayanch_go" style="color:var(--accent)" target="_blank" rel="noopener noreferrer">@tayanch_go</a></p>
  <p class="quiz-hint" style="margin-top:1.2rem">Narxlar <a href={base + 'narxlar'} style="color:var(--accent)">paketlar</a> bilan arzonroq. Barcha narxlar <b>forever access</b>.</p>
</section>


<section class="focus-break" aria-labelledby="focus-break-title">
  <div><p class="eyebrow">DAM OLISH UCHUN</p><h2 id="focus-break-title">O‘yinlar va simulyatsiyalar alohida bo‘limda</h2><p>Kurslar sahifasi asosiy o‘quv maqsadida qoladi. Barcha o‘yin natijalari faqat shu brauzerda saqlanadi.</p></div><a class="start-btn" href={base + 'entertainment/'}>Entertainment’ni ochish →</a>
</section>



<style>
  .founder-excerpt{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:2rem;align-items:start;margin:var(--section-gap) 0;padding:clamp(1.2rem,4vw,2rem);border:1px solid color-mix(in srgb,var(--accent) 38%,var(--border));border-radius:18px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 10%,var(--surface)),var(--surface))}.founder-excerpt .eyebrow{margin:0 0 .5rem}.founder-excerpt h2{margin:0;font-size:clamp(1.4rem,3vw,2rem)}.founder-excerpt p{margin:0 0 1rem;color:var(--muted);line-height:1.65}.founder-excerpt .course-nav-link{font-weight:800}.founder-social{display:flex;gap:1rem;margin-top:1rem}.founder-social a{color:var(--accent);font-weight:800;text-decoration:none}@media(max-width:700px){.founder-excerpt{grid-template-columns:1fr;gap:1rem}}
.direction-preview{margin:var(--section-gap) 0}.direction-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.direction-card{padding:1.25rem;border:1px solid var(--border);border-radius:18px;background:var(--surface)}.direction-card h3{margin:.2rem 0 .45rem}.direction-card>p:not(.eyebrow){color:var(--muted);line-height:1.55;margin:.35rem 0 1rem}.path-list{display:grid;gap:.45rem}.path-item{display:flex;justify-content:space-between;gap:.75rem;align-items:center;padding:.65rem .75rem;border:1px solid var(--border);border-radius:12px;color:var(--text);text-decoration:none;background:color-mix(in srgb,var(--bg) 55%,var(--surface))}.path-item:hover{border-color:var(--accent);color:var(--accent)}.path-item span{font-weight:700}.path-item small{color:var(--muted);white-space:nowrap}@media(max-width:700px){.direction-grid{grid-template-columns:1fr}.path-item{align-items:flex-start;flex-direction:column;gap:.2rem}}
</style>

<TelegramLeadSection />

<style>
  .focus-break{display:flex;justify-content:space-between;align-items:center;gap:1.25rem;margin:var(--section-gap) 0;padding:1.25rem 1.4rem;border:1px solid var(--border);border-radius:18px;background:var(--surface)}
  .focus-break h2{margin:.2rem 0 .45rem;font-size:1.2rem}.focus-break p:not(.eyebrow){margin:0;color:var(--muted);line-height:1.55}.focus-break .eyebrow{margin:0;color:var(--accent);font-size:.74rem;font-weight:800;letter-spacing:.12em}
  @media(max-width:650px){.focus-break{align-items:flex-start;flex-direction:column}.focus-break .start-btn{width:100%;text-align:center}}
</style>

</Base>

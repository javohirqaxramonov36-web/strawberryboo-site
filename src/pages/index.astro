<script>
  (function () {
    const el = document.querySelector(".typed-text");
    if (!el) return;
    const words = ["Prompt Engineering", "Obsidian PKM", "AI Agentlar", "IELTS Prep", "Admission Process", "Tekin AI", "Figma", "AutoCAD", "Financial Literacy", "Mac'da Tezlik Sirlari", "Chet elda o'qish", "El-Yurt Umidi", "Computer Literacy"];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) { el.textContent = words[0]; return; }
    let wi = 0, ci = 0, deleting = false;
    function tick() {
      const word = words[wi];
      if (!deleting) {
        ci++;
        el.textContent = word.slice(0, ci);
        if (ci === word.length) { deleting = true; return setTimeout(tick, 1600); }
        return setTimeout(tick, 70 + Math.random() * 45);
      } else {
        ci--;
        el.textContent = word.slice(0, ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; return setTimeout(tick, 420); }
        return setTimeout(tick, 35);
      }
    }
    el.textContent = "";
    setTimeout(tick, 600);
  })();
</script>

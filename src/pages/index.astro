<script>
  (function () {
    const el = document.querySelector(".typed-text");
    if (!el) return;
    const words = ["AI'dan 5 daqiqada sifatli javob", "O'qiganingiz esda qoladigan bilim bazasi", "O'z AI yordamchingizni yaratish", "IELTS 6.5+ band: 30 kunlik reja", "Chet elga qabul: hujjatdan intervyugacha", "Pullik obuna bermasdan AI'dan foydalanish", "Bepul Figma: UI/UX asoslarini 1 kunda", "Mac'da chizma: bepul talaba litsenziyasi", "Mac'da ishni 2 baravar tezroq bajarish", "Nima uchun chet elda o'qish kerak (va bepul qanday)", "Data Analytics", "Backend Python"];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) { el.textContent = words[0]; return; }
    let wi = 0, ci = 0, deleting = false;
    function tick() {
      const word = words[wi];
      if (!deleting) {
        ci++;
        el.textContent = word.slice(0, ci);
        if (ci === word.length) { deleting = true; return setTimeout(tick, 1600); }
        return setTimeout(tick, 70 + Math.random() * 45);
      } else {
        ci--;
        el.textContent = word.slice(0, ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; return setTimeout(tick, 420); }
        return setTimeout(tick, 35);
      }
    }
    el.textContent = "";
    setTimeout(tick, 600);
  })();
</script>

    const WORDLE_WORDS = ["APPLE","BRAIN","CLOUD","DREAM","HEART","LIGHT","MOUSE","PLANT","RIVER","STONE","TRAIN","VOICE","WATCH","YOUTH","BREAD"];
    function init_wordle(root){
      const answer = WORDLE_WORDS[Math.floor(Math.random()*WORDLE_WORDS.length)];
      let row = 0; const grid = [];
      root.innerHTML = `<p class="g-inst">6 urinish. Har qatorda 5 harf.</p><div id="wordle-grid"></div><input id="wordle-input" maxlength="5" placeholder="so'z"><div class="g-actions"><button id="wordle-guess" class="mini-btn">Tahmin</button></div><p class="g-hint">Namuna: ${WORDLE_WORDS[0]}</p>`;
      const gridEl = document.getElementById("wordle-grid");
      for(let i=0;i<6;i++){ const r=document.createElement("div"); r.className="wordle-row"; for(let j=0;j<5;j++){ const c=document.createElement("span"); c.className="wordle-cell"; r.appendChild(c); } gridEl.appendChild(r); grid.push(r); }
      document.getElementById("wordle-guess").addEventListener("click", () => {
        const val = document.getElementById("wordle-input").value.toUpperCase();
        if(val.length!==5) return;
        const cells = grid[row].children; const used = {};
        for(let i=0;i<5;i++){ if(val[i]===answer[i]){ cells[i].className="wordle-cell green"; used[answer[i]]=(used[answer[i]]||0)+1; } }
        for(let i=0;i<5;i++){ if(cells[i].className==="wordle-cell"){ if(answer.includes(val[i]) && (used[val[i]]||0) < answer.split("").filter(x=>x===val[i]).length){ cells[i].className="wordle-cell yellow"; used[val[i]]=(used[val[i]]||0)+1; } else cells[i].className="wordle-cell gray"; } cells[i].textContent=val[i]; }
        if(val===answer){ showResult(`<p>Topdingiz! 🎉 Javob: <b>${answer}</b></p>`, 6-row, "qadam"); return; }
        row++;
        if(row>=6){ showResult(`<p>Afsuski. Javob: <b>${answer}</b></p>`, 0, "qadam"); return; }
        document.getElementById("wordle-input").value="";
      });
    }


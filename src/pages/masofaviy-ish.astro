---
import Base from '../layouts/Base.astro';
import CareerOutcomePanel from '../components/CareerOutcomePanel.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Uydan turib xorijiy kompaniyalar uchun ishlash | Tayanch" description="Upwork, Fiverr va Toptal kabi platformalarda profil, portfolio va birinchi buyurtmaga tayyorlanish bo‘yicha amaliy qo‘llanma.">
<article class="impact-page">
  <header class="impact-hero"><p class="eyebrow">MASOFAVIY ISH</p><h1>Chet elga ketmasdan, shu yerda AI bilan pul topish yo‘lini boshlang.</h1><p class="lead">Freelance — tez boyish va daromad kafolati emas. Bu aniq xizmat, yaxshi portfolio, inglizcha muloqot, sabr va platforma qoidalariga rioya qilishni talab qiladigan ish yo‘li.</p></header>
  <section><h2>1. Bitta xizmatdan boshlang</h2><div class="steps"><article><b>01</b><h3>Muammo</h3><p>Kimga qanday muammoni hal qilishingizni yozing: masalan, “kichik biznes uchun savdo dashboardi”.</p></article><article><b>02</b><h3>Portfolio</h3><p>2–4 ta haqiqiy yoki o‘zingiz yaratgan namunani, vazifa–qaror–natija formatida joylang.</p></article><article><b>03</b><h3>Taklif</h3><p>Faqat mos loyihalarga shaxsiylashtirilgan cover letter va aniq deliverable yuboring.</p></article></div></section>
  <section><h2>2. Platformalar bo‘yicha yo‘l</h2><div class="platforms"><article><h3>Upwork</h3><p>To‘liq profil, ish namunasi, taklif va screening savollariga javob kerak. Connects va shaxsni tasdiqlash qoidalarini oldindan tekshiring.</p><a href="https://support.upwork.com/hc/en-us/articles/211067778-Who-s-eligible-to-join-and-use-Upwork" target="_blank" rel="noopener noreferrer">Eligibility →</a> <a href="https://support.upwork.com/hc/en-us/articles/211062998-How-to-submit-a-proposal-on-Upwork" target="_blank" rel="noopener noreferrer">Proposal →</a></article><article><h3>Fiverr</h3><p>Bitta aniq Gig yarating: xizmat doirasi, paket, muddat, mijozdan kerakli ma’lumot va o‘zingizga tegishli namuna.</p><a href="https://help.fiverr.com/hc/en-us/articles/360010451397-Creating-a-Gig" target="_blank" rel="noopener noreferrer">Gig guide →</a></article><article><h3>Toptal</h3><p>Bu boshlovchilar uchun tezkor yo‘l emas: til, tajriba, jonli screening va test loyiha bosqichlari bor.</p><a href="https://www.toptal.com/top-3-percent" target="_blank" rel="noopener noreferrer">Screening →</a></article></div></section>
  <section class="income-note"><h2>3. Pul haqida realistik hisob</h2><p>Upwork’ning rasmiy misolida 10% komissiyadan keyin $20/soat qolishi uchun taxminan $22.22/soat narx qo‘yish kerak. Fiverr payment terms bo‘yicha freelancer buyurtma summasining 80%ini oladi: $100 buyurtma — soliqlar, payout va valyuta xarajatlaridan oldin taxminan $80.</p><p><strong>Bu daromad va mijoz kafolati emas.</strong> Platforma qoidasi, to‘lov usuli, soliq, valyuta va O‘zbekistondan pul yechish imkoniyatini har safar tekshiring.</p><p class="sources">Manbalar: <a href="https://support.upwork.com/hc/en-us/articles/211062538-Learn-about-the-Freelancer-Service-Fee" target="_blank" rel="noopener noreferrer">Upwork fee</a>, <a href="https://www.fiverr.com/legal-portal/legal-terms/payment-terms-of-service" target="_blank" rel="noopener noreferrer">Fiverr payment terms</a>, <a href="https://support.upwork.com/hc/en-us/articles/211060918-How-to-get-paid-on-Upwork" target="_blank" rel="noopener noreferrer">Upwork payouts</a>, <a href="https://help.fiverr.com/hc/en-us/articles/14257019400465-Setting-up-Payoneer-as-a-payout-method" target="_blank" rel="noopener noreferrer">Fiverr payouts</a>.</p></section>
  <CareerOutcomePanel slug="ai-agentlar" />
  <section><h2>4. Instagram / Telegram post seriyasi</h2><ol class="post-series"><li><b>Post 1:</b> “Chet elga ketmasdan AI bilan pul topish mumkinmi?” — imkoniyat va cheklovlar.</li><li><b>Post 2:</b> “Portfolio bo‘lmasa, profil ishlamaydi” — 2–4 ta namuna tayyorlash.</li><li><b>Post 3:</b> “$100 buyurtmadan qancha qoladi?” — komissiya va xarajatlarni tushuntirish.</li><li><b>Post 4:</b> “Birinchi taklifni qanday yozish?” — muammo, natija va muddat.</li><li><b>Post 5:</b> “Firibgarlikdan saqlaning” — oldindan pul so‘rash, platformadan tashqariga majburlash va shubhali fayllar.</li></ol></section>
  <div class="page-links"><a class="start-btn" href={base + 'kurslar/'}>Kasbiy kurslarni ko‘rish →</a><a class="course-nav-link" href={base + 'viloyatlar/'}>Viloyatlar uchun dastur</a></div>
</article>
<style>.impact-page{max-width:960px;margin:auto}.impact-hero{padding:2rem 0}.impact-hero h1{font-size:clamp(2rem,5vw,4rem);max-width:820px}.lead{max-width:780px;color:var(--muted);line-height:1.7}.steps,.platforms{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:.8rem}.steps article,.platforms article,.income-note{padding:1.1rem;border:1px solid var(--border);border-radius:15px;background:var(--surface)}.steps b{color:var(--accent)}.steps p,.platforms p,.income-note p{color:var(--muted);line-height:1.55}.platforms a,.sources a{color:var(--accent);font-weight:700}.income-note{margin-top:1rem;border-color:color-mix(in srgb,#fbbf24 45%,var(--border));background:color-mix(in srgb,#fbbf24 8%,var(--surface))}.sources{font-size:.86rem}.post-series{display:grid;gap:.6rem;padding-left:1.4rem;color:var(--muted);line-height:1.55}.post-series b{color:var(--text)}.page-links{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin:1.5rem 0 3rem}</style>
</Base>

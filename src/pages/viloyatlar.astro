---
import Base from '../layouts/Base.astro';
import RegionalSupportForm from '../components/RegionalSupportForm.astro';
import { regionalInstitutions } from '../data/regional-outreach';
const base = import.meta.env.BASE_URL;
const statusLabel = (value: string) => value === 'official-page-read' ? 'Rasmiy sahifa o‘qildi' : value === 'official-domain-recheck' ? 'Rasmiy domen — qayta tekshirish kerak' : 'Dastlabki lead — qo‘lda tasdiqlash kerak';
---
<Base title="Viloyatlar uchun ta’lim imkoniyatlari | Tayanch" description="Tayanch onlayn kurslari, viloyat yoshlari uchun taklif etilayotgan stipendiya piloti va hamkorlik outreach ro‘yxati.">
<article class="regional-page"><header class="regional-hero"><p class="eyebrow">POYTAXTDAN UZOQDAGILAR UCHUN</p><h1>Bilim va portfolio joyga bog‘liq bo‘lmasin.</h1><p class="lead">Tayanch kurslari internet bor joyda o‘qiladi: AI, IELTS, admission, freelance va moliyaviy savodxonlik yo‘nalishlari bitta onlayn platformada.</p></header>
<section class="pilot"><div><p class="eyebrow">TAKLIF ETILAYOTGAN PILOT</p><h2>“Tayanch-10” — har oy 10 ta bepul o‘rin</h2><p>Viloyatdagi maktab, kollej yoki universitet o‘quvchilari/talabalari uchun taklif etilayotgan mexanizm: qisqa ariza, ehtiyoj va maqsadni ko‘rib chiqish, oy oxirida 10 ta o‘rin haqida ochiq e’lon. Bu hozircha faol grant va’dasi emas; moliyalashtirish va qabul sanasi alohida tasdiqlanadi.</p><ol><li>Viloyat va ta’lim holatini ko‘rsating.</li><li>Qaysi kurs va qanday natija kerakligini yozing.</li><li>O‘rinlar ochilganda email/Telegram orqali xabar oling.</li></ol></div><RegionalSupportForm /></section>
<section><h2>Hamkorlik uchun dastlabki outreach ro‘yxati</h2><p class="muted">Quyidagi 26 ta muassasa rasmiy sahifalar va domenlar asosida tuzilgan boshlang‘ich ro‘yxat. Hamkorlik borligi yoki qiziqish bildirilgani da’vo qilinmaydi. Kontaktni yuborishdan oldin rasmiy sahifada qayta tekshiring.</p><div class="table-wrap"><table><thead><tr><th>Muassasa</th><th>Shahar / hudud</th><th>Tur</th><th>Rasmiy sahifa</th><th>Holat</th></tr></thead><tbody>{regionalInstitutions.map((item) => <tr><td>{item.name}</td><td>{item.city}, {item.region}</td><td>{item.type}</td><td><a href={item.url} target="_blank" rel="noopener noreferrer">Ochish →</a></td><td><small>{statusLabel(item.verification)}</small></td></tr>)}</tbody></table></div></section>
<section class="regional-cta"><h2>Hamkorlik yoki bepul o‘rin haqida gaplashamiz</h2><p>O‘qituvchi, universitet vakili yoki viloyatdagi yoshlar tashabbusi bo‘lsangiz, qiziqish formasi orqali yozing. Aniq chegirma kodi hozircha aktiv emas.</p><a class="start-btn" href={base + 'bog-lanish/'}>Bog‘lanish →</a></section>
</article><style>.regional-page{max-width:1120px;margin:auto}.regional-hero{padding:2rem 0}.regional-hero h1{font-size:clamp(2.1rem,5vw,4.2rem);max-width:820px}.lead,.muted{color:var(--muted);line-height:1.7;max-width:800px}.pilot{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,410px);gap:1.2rem;padding:1.3rem;border:1px solid color-mix(in srgb,#34d399 48%,var(--border));border-radius:18px;background:linear-gradient(135deg,rgba(52,211,153,.1),var(--surface));margin:1rem 0 2rem}.pilot p,.pilot li{color:var(--muted);line-height:1.55}.table-wrap{overflow:auto;border:1px solid var(--border);border-radius:14px}.table-wrap table{width:100%;min-width:850px;border-collapse:collapse;background:var(--surface)}th,td{padding:.7rem .75rem;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}th{font-size:.78rem;color:var(--accent);text-transform:uppercase;letter-spacing:.05em}td{color:var(--muted);font-size:.9rem}td a{color:var(--accent);font-weight:700}td small{font-size:.78rem}.regional-cta{margin:1.5rem 0 3rem;padding:1.3rem;border:1px solid var(--border);border-radius:16px;background:var(--surface)}.regional-cta p{color:var(--muted);line-height:1.55}@media(max-width:760px){.pilot{grid-template-columns:1fr}}</style>
</Base>

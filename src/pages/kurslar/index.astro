---
import Base from "../../layouts/Base.astro";
const title = "Kurslar — Tayanch";
const description = "Pullik va bepul kurslar hamda IELTS Mock Test practice mahsuloti: Prompt Engineering, Obsidian, AI Agentlar, IELTS Prep, Admission Process va boshqalar.";
const base = import.meta.env.BASE_URL;
---

<Base title={title} description={description}>

<h1>Kurslar</h1>

<div class="course-filter" id="courseFilter">
  <button class="cf-btn active" data-filter="all">Barchasi</button>
  <button class="cf-btn" data-filter="ai">AI</button>
  <button class="cf-btn" data-filter="ielts">IELTS</button>
  <button class="cf-btn" data-filter="admission">Admission</button>
  <button class="cf-btn" data-filter="dizayn">Dizayn</button>
  <button class="cf-btn" data-filter="hayotiy">Hayotiy ko'nikma</button>
  <button class="cf-btn" data-filter="bepul">Bepul</button>
</div>

<div class="course-list">
  <div class="card" style="--c:#7d7df5" data-cat="ai">
    <span class="badge">Mashhur</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/><path d="M19 14l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg></div>
    <h2>Prompt Engineering</h2>
    <span class="cat">AI · PKM</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>Nima uchun kerak? Qanday foyda? Qayerda qo'llash? — amaliy misollar.</p>
    <p class="price">$29 <span class="uzs">≈ 360 000 so'm</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'kurslar/prompt-engineering'} class="start-btn">Kursni boshlash →</a>
  </div>

  <div class="card" style="--c:#34d399" data-cat="ai">
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
    <h2>Obsidian PKM</h2>
    <span class="cat">AI · PKM</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>Shaxsiy bilim bazasi qurish. Tayanch bilan avtomatik capture.</p>
    <p class="price">$19 <span class="uzs">≈ 240 000 so'm</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'kurslar/obsidian'} class="start-btn">Kursni boshlash →</a>
  </div>

  <div class="card" style="--c:#ef4444" data-cat="ai">
    <span class="badge badge-hot">Eng mashhur</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 8V4M9 2h6M9 12h.01M15 12h.01M9 16h6"/></svg></div>
    <h2>AI Agentlar nega kerak?</h2>
    <span class="cat">AI · PKM</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>CrewAI, LangGraph — agent'lar nima uchun kerak, qanday foyda.</p>
    <p class="price">$39 <span class="uzs">≈ 490 000 so'm</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'kurslar/ai-agentlar'} class="start-btn">Kursni boshlash →</a>
  </div>

  <section class="ielts-collection" id="ielts-courses" data-cat="ielts">
    <div class="ielts-collection-head"><div><span class="badge badge-new">Yangi</span><h2>IELTS kurslari</h2><p>Har skill alohida: sizga aynan kerakli yo‘nalishni tanlang.</p></div><span class="collection-price">Har biri $7.50 · ≈ 93 750 so'm</span></div>
    <div class="ielts-course-grid">
      <a class="ielts-mini-card listening" href={base + 'kurslar/ielts-listening'}><b>01</b><h3>Listening</h3><p>Signal, raqam, birlik-ko‘plik va distractor mashqlari.</p><span>$7.50 →</span></a>
      <a class="ielts-mini-card reading" href={base + 'kurslar/ielts-reading'}><b>02</b><h3>Reading</h3><p>Vaqt, savol turi va xato patternlari ustida ishlang.</p><span>$7.50 →</span></a>
      <a class="ielts-mini-card writing" href={base + 'kurslar/ielts-writing'}><b>03</b><h3>Writing</h3><p>Task 1/2, outline va original practice.</p><span>$7.50 →</span></a>
      <a class="ielts-mini-card speaking" href={base + 'kurslar/ielts-speaking'}><b>04</b><h3>Speaking</h3><p>AI bilan 30 kunlik talaffuz va gapirish mashqi.</p><span>$7.50 →</span></a>
    </div>
    <div class="ielts-bundle"><div><span>IELTS FULL BUNDLE</span><h3>4 tasini birga oling — 20% tejang</h3><p><s>375 000 so'm</s> o‘rniga <b>300 000 so'm</b>. To‘lov Telegram orqali qo‘lda tasdiqlanadi.</p></div><a class="start-btn" href={base + 'bog-lanish?course=ielts-full-bundle&price=300000'}>Bundle’ni olish →</a></div>
  </section>

  <div class="card" style="--c:#7d7df5" data-cat="ielts">
    <span class="badge badge-new">Yangi</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z"/><path d="M8 3v4M16 3v4M7 11h10M7 15h6"/></svg></div>
    <h2>IELTS Mock Test</h2>
    <span class="cat">IELTS · Practice</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18"/></svg>Tayanch Qadam bilan</span>
    <p>Listening, Reading, Writing va Speaking bo‘limlarini alohida yoki full mock sifatida mashq qiling.</p>
    <p class="price">1 Qadamdan <span class="uzs">≈ 32 000 so‘m / modul</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'ielts-mock/'} class="start-btn">Mockni tanlash →</a>
  </div>

  <div class="card" style="--c:#8b5cf6" data-cat="admission">
    <span class="badge badge-new">Yangi</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg></div>
    <h2>Admission Process</h2>
    <span class="cat">Til · Admission</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>Chet el universitetlariga kirish: hujjatlar, essay, interview.</p>
    <p class="price">49 000 so'mdan <span class="uzs">3 qism alohida tanlanadi</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'kurslar/admission-process'} class="start-btn">Kursni boshlash →</a>
  </div>

  <div class="card" style="--c:#7d7df5" data-cat="ai">
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8M12 8v13M12 8S10 3 7.5 4.5 9 8 12 8zM12 8s2-5 4.5-3.5S15 8 12 8z"/></svg></div>
    <h2>Tekin AI modellar va agentlar</h2>
    <span class="cat">AI</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>AI vositalari ro'yxati va amaliy qo'llanma.</p>
    <p class="price">$19 <span class="uzs">≈ 240 000 so'm</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'kurslar/tekin-ai'} class="start-btn">Kursni boshlash →</a>
  </div>

  <div class="card" style="--c:#3b82f6" data-cat="hayotiy">
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-14h-7l1-8z"/></svg></div>
    <h2>Mac'da Tezlik Sirlari</h2>
    <span class="cat">HAYOTIY KO'NIKMA</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>Raycast, shortcut'lar va Mac vositalari bilan kundalik ishlarni 2 baravar tezroq bajarish — amaliy kurs.</p>
    <p class="price">$15 <span class="uzs">≈ 190 000 so'm</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'kurslar/mac-tezlik-sirlari'} class="start-btn">Kursni boshlash →</a>
  </div>

  <div class="card" style="--c:#f59e0b" data-cat="bepul dizayn">
    <span class="badge badge-new">Yangi</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg></div>
    <h2>Figma / Dizayn</h2>
    <span class="cat">Dizayn</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>UI/UX asoslari, komponentlar va prototip — bepul dizaynga kirish.</p>
    <p class="price">$0 <span class="uzs">Bepul</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'kurslar/figma'} class="start-btn">Kursni boshlash →</a>
  </div>

  <div class="card" style="--c:#f97316" data-cat="dizayn">
    <span class="badge badge-new">Yangi</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3zM3 9h18M9 3v18M15 9v12"/></svg></div>
    <h2>AutoCAD on Mac</h2>
    <span class="cat">Dizayn · Muhandislik</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>Mac'da AutoCAD: o'rnatish, interfeys, chizish buyruqlari va bepul litsenziya.</p>
    <p class="price">$29 <span class="uzs">≈ 360 000 so'm</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'kurslar/autocad-on-mac'} class="start-btn">Kursni boshlash →</a>
  </div>


  <div class="card" style="--c:#14b8a6" data-cat="bepul admission">
    <span class="badge badge-free">Bepul</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.5 3 6 3s6-2 6-3v-5"/></svg></div>
    <h2>Nega chet elda o'qish kerak</h2>
    <span class="cat">Bepul · Admission</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>Ta'lim sifati, karyera, shaxsiy rivojlanish va bepul grantlar (El-Yurt Umidi, Chevening, DAAD).</p>
    <p class="price">$0 <span class="uzs">Bepul</span></p>
    <p class="social-proof"><span class="sp-starters">- kishi boshladi</span></p>
    <a href={base + 'kurslar/chet-elda-oqish'} class="start-btn">Kursni boshlash →</a>
  </div>


</div>


<section class="upcoming-courses" aria-labelledby="upcoming-courses-title">
  <div class="upcoming-heading">
    <p class="eyebrow">KELAYOTGAN KURSLAR</p>
    <h2 id="upcoming-courses-title">Material tayyorlanmoqda</h2>
    <p>Bu kurslar ustida ish davom etmoqda. To‘liq material va sotuv ochilganda e’lon qilinadi.</p>
  </div>
  <div class="upcoming-grid">
  <div class="card" style="--c:#10b981" data-cat="hayotiy">
    <span class="badge badge-soon">Kelayotgan</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z"/><path d="M3 7l2-3h11l2 3"/><circle cx="17" cy="13" r="1.6"/></svg></div>
    <h2>Financial Literacy — Moliyaviy savodxonlik</h2>
    <span class="cat">HAYOTIY KO'NIKMA</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>Pulni boshqarish, byudjet tuzish va moliyaviy qarorlar — talaba hayoti uchun asosiy ko'nikmalar.</p>
      <p class="upcoming-status">Narx va dastur tez orada e'lon qilinadi</p>
      <span class="start-btn is-disabled" aria-disabled="true">Tayyorlanmoqda</span>
  </div>

  <div class="card" style="--c:#ec4899" data-cat="admission">
    <span class="badge badge-new">Tez orada</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M12 4V2M9 2h6"/></svg></div>
    <h2>El-Yurt Umidi'ni yutaylik</h2>
    <span class="cat">Admission</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>Davlat granti bo'yicha suhbatga tayyorgarlik — to'liq material tez orada qo'shiladi.</p>
      <p class="upcoming-status">Dastur ustida ish davom etmoqda</p>
      <span class="start-btn is-disabled" aria-disabled="true">Tayyorlanmoqda</span>
  </div>

  <div class="card" style="--c:#0ea5e9" data-cat="hayotiy">
    <span class="badge badge-soon">Kelayotgan</span>
    <div class="c-ic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="11" rx="2"/><path d="M2 20h20"/></svg></div>
    <h2>Computer Literacy — Raqamli savodxonlik</h2>
    <span class="cat">HAYOTIY KO'NIKMA</span>
    <span class="cert-line"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M9 13.5 7.5 21 12 18l4.5 3L15 13.5"/></svg>Sertifikat bilan</span>
    <p>Microsoft Office (Word, Excel, PowerPoint) va Google Workspace (Docs, Sheets, Slides) — zamonaviy muhandislik va ta'lim uchun asosiy raqamli ko'nikmalar.</p>
      <p class="upcoming-status">Narx va dastur tez orada e'lon qilinadi</p>
      <span class="start-btn is-disabled" aria-disabled="true">Tayyorlanmoqda</span>
  </div>
  </div>
</section>

<p class="quiz-hint" style="margin-top:1.5rem">Qaysi kurs sizga kerakligini bilmayapsizmi? <a href={base + 'kurs-tanlash'} style="color:var(--accent)">Kurs tanlash testi →</a> · <a href={base + 'narxlar'} style="color:var(--accent)">Narxlar va paketlar →</a></p>

<style is:global>
  .course-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 1.2rem 0 .5rem; }
  .cf-btn { font: 700 13px var(--font-display); color: var(--muted); background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 7px 14px; cursor: pointer; transition: .15s; }
  .cf-btn:hover { color: var(--text); border-color: var(--accent); }
  .cf-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.ielts-collection{grid-column:1/-1;border:1px solid var(--border);border-radius:18px;padding:clamp(1rem,3vw,1.5rem);background:linear-gradient(135deg,rgba(34,197,94,.08),var(--surface))}.ielts-collection-head,.ielts-bundle{display:flex;justify-content:space-between;gap:1rem;align-items:center}.ielts-collection-head h2,.ielts-collection-head p,.ielts-bundle h3,.ielts-bundle p{margin:.25rem 0}.ielts-collection-head p,.ielts-bundle p{color:var(--muted)}.collection-price{color:var(--accent);font-weight:800}.ielts-course-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin:1rem 0}.ielts-mini-card{display:block;padding:1rem;border:1px solid var(--border);border-radius:13px;text-decoration:none;color:var(--text);background:var(--surface);transition:transform .2s,border-color .2s}.ielts-mini-card:hover{transform:translateY(-2px);border-color:var(--accent)}.ielts-mini-card b,.ielts-mini-card span{color:var(--accent);font-size:.8rem}.ielts-mini-card h3{margin:.35rem 0}.ielts-mini-card p{color:var(--muted);font-size:.88rem;line-height:1.45;min-height:3.8em}.ielts-bundle{padding:1rem;border-radius:13px;background:rgba(125,125,245,.1)}@media(max-width:780px){.ielts-collection-head,.ielts-bundle{align-items:stretch;flex-direction:column}.ielts-course-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:460px){.ielts-course-grid{grid-template-columns:1fr}}
</style>

<script>
  const filter = document.getElementById('courseFilter');
  if (filter) {
    const cards = document.querySelectorAll('.course-list .card');
    filter.addEventListener('click', (e) => {
      const btn = e.target.closest('.cf-btn');
      if (!btn) return;
      filter.querySelectorAll('.cf-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter;
      cards.forEach(card => {
        const cats = (card.dataset.cat || '').split(' ');
        const show = f === 'all' || cats.includes(f);
        card.style.display = show ? '' : 'none';
      });
    });
  }
</script>
</Base>

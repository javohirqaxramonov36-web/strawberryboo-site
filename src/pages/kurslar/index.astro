---
import Base from "../../layouts/Base.astro";
import CourseCard from "../../components/CourseCard.astro";
import coursesData from "../../data/courses.json";
const courses = coursesData.courses as any[];
const title = "Kurslar — Tayanch";
const description = "Pullik va bepul kurslar hamda IELTS Mock Test practice mahsuloti: Prompt Engineering, Obsidian, AI Agentlar, IELTS Prep, Admission Process va boshqalar.";
const base = import.meta.env.BASE_URL;

const top = ["prompt-engineering", "obsidian", "ai-agentlar"];
const topStandard = courses.filter((c) => top.includes(c.slug));
const restStandard = courses.filter((c) => (c.type === "standard" || c.type === "mock") && !top.includes(c.slug));
const miniCourses = courses.filter((c) => c.type === "ielts-mini");
const bundle = courses.find((c) => c.type === "bundle") as any;
const comingSoon = courses.filter((c) => c.type === "coming-soon");
---

<Base title={title} description={description}>

<h1 data-i18n="kk.h1">Kurslar</h1>

<div class="course-filter" id="courseFilter">
  <button class="cf-btn active" data-filter="all" data-i18n="kk.fAll">Barchasi</button>
  <button class="cf-btn" data-filter="ai" data-i18n="kk.fAi">AI</button>
  <button class="cf-btn" data-filter="ielts" data-i18n="kk.fIelts">IELTS</button>
  <button class="cf-btn" data-filter="general-english" data-i18n="kk.fGeneralEnglish">General English</button>
  <button class="cf-btn" data-filter="admission" data-i18n="kk.fAdm">Admission</button>
  <button class="cf-btn" data-filter="sat" data-i18n="kk.fSat">SAT</button>
  <button class="cf-btn" data-filter="dizayn" data-i18n="kk.fDes">Dizayn</button>
  <button class="cf-btn" data-filter="hayotiy" data-i18n="kk.fLife">Hayotiy ko'nikma</button>
  <button class="cf-btn" data-filter="bepul" data-i18n="kk.fFree">Bepul</button>
  <button class="cf-btn" data-filter="data" data-i18n="kk.fData">Data</button>
  <button class="cf-btn" data-filter="dasturlash" data-i18n="kk.fDev">Dasturlash</button>
</div>

<div class="course-list">
  {topStandard.map((c) => <CourseCard course={c} />)}

  <section class="ielts-collection" id="ielts-courses" data-cat="ielts">
    <div class="ielts-collection-head"><div><span class="badge badge-new">Yangi</span><h2 data-i18n="kk.ieltsTitle">IELTS 6.5+ band: 30 kunlik reja</h2><p data-i18n="kk.ieltsDesc">Har bir skill alohida, 30 kunlik speaking rejasi bilan — kerakli band'gacha yetib olasiz. Kimga mo'ljallangan: IELTS 6.5–7.0 kerak bo'lganlarga.</p></div><span class="collection-price" data-i18n="kk.ieltsPrice">Skill-kurslar: $7.50–$14.99 · ≈ 93 750–187 500 so'm</span></div>
    <div class="ielts-course-grid">
      {miniCourses.map((c) => <CourseCard course={c} />)}
    </div>
    <div class="ielts-bundle"><div><span>IELTS FULL BUNDLE</span><h3 data-i18n="kk.bundleTitle">4 tasini birga oling — 20% tejang</h3><p><s>468 750 so'm</s> o‘rniga <b>375 000 so'm</b>. Listening + Reading + Writing + Speaking birga. To‘lov Telegram orqali qo‘lda tasdiqlanadi.</p></div><a class="start-btn" href={base + bundle.href} data-gumroad-product={bundle.gumroadSlug} target="_blank" rel="noopener noreferrer">Bundle’ni olish →</a></div>
  </section>

  {restStandard.map((c) => <CourseCard course={c} />)}
</div>


<section class="upcoming-courses" aria-labelledby="upcoming-courses-title">
  <div class="upcoming-heading">
    <p class="eyebrow">KELAYOTGAN KURSLAR</p>
    <h2 id="upcoming-courses-title" data-i18n="kk.upTitle">Material tayyorlanmoqda</h2>
    <p data-i18n="kk.upDesc">Bu kurslar ustida ish davom etmoqda. To‘liq material va sotuv ochilganda e’lon qilinadi.</p>
  </div>
  <div class="upcoming-grid">
    {comingSoon.map((c) => <CourseCard course={c} />)}
  </div>
</section>

<p class="quiz-hint" style="margin-top:1.5rem">Qaysi kurs sizga kerakligini bilmayapsizmi? <a href={base + 'kurs-tanlash'} style="color:var(--accent)">Kurs tanlash testi →</a> · <a href={base + 'narxlar'} style="color:var(--accent)">Narxlar va paketlar →</a></p>

<style is:global>
  .course-card-progress{display:block;margin:.55rem 0;color:var(--muted);font-size:.78rem;font-weight:700;line-height:1.25}.course-card-progress.has-progress{color:var(--accent)}.ielts-mini-card .course-card-progress{margin:.45rem 0 0;font-size:.73rem}.ielts-mini-card .course-card-progress::before{content:'◔ ';color:var(--accent)}
  .course-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 1.2rem 0 .5rem; }
  .cf-btn { font: 700 13px var(--font-display); color: var(--muted); background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 7px 14px; cursor: pointer; transition: .15s; }
  .cf-btn:hover { color: var(--text); border-color: var(--accent); }
  .cf-btn.active { background: var(--btn-bg); color: #fff; border-color: var(--accent); }
  @media (max-width: 460px) { .course-filter { flex-wrap: nowrap; overflow-x: auto; padding-bottom: .35rem; -webkit-overflow-scrolling: touch; } .cf-btn { flex: 0 0 auto; } }
.ielts-collection{grid-column:1/-1;border:1px solid var(--border);border-radius:18px;padding:clamp(1rem,3vw,1.5rem);background:linear-gradient(135deg,rgba(34,197,94,.08),var(--surface))}.ielts-collection-head,.ielts-bundle{display:flex;justify-content:space-between;gap:1rem;align-items:center}.ielts-collection-head h2,.ielts-collection-head p,.ielts-bundle h3,.ielts-bundle p{margin:.25rem 0}.ielts-collection-head p,.ielts-bundle p{color:var(--muted)}.collection-price{color:var(--accent);font-weight:800}.ielts-course-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:.7rem;margin:1rem 0}.ielts-mini-card{display:block;padding:1rem;border:1px solid var(--border);border-radius:13px;text-decoration:none;color:var(--text);background:var(--surface);transition:transform .2s,border-color .2s}.ielts-mini-card:hover{transform:translateY(-2px);border-color:var(--accent)}.ielts-mini-card b,.ielts-mini-card span{color:var(--accent);font-size:.8rem}.ielts-mini-card h3{margin:.35rem 0}.ielts-mini-card p{color:var(--muted);font-size:.88rem;line-height:1.45;min-height:3.8em}.ielts-bundle{padding:1rem;border-radius:13px;background:rgba(125,125,245,.1)}@media(max-width:780px){.ielts-collection-head,.ielts-bundle{align-items:stretch;flex-direction:column}.ielts-course-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:460px){.ielts-course-grid{grid-template-columns:1fr}}
</style>

<script>
  const filter = document.getElementById('courseFilter');
  if (filter) {
    const cards = document.querySelectorAll('.course-list > [data-cat]');
    filter.addEventListener('click', (e) => {
      const btn = e.target.closest('.cf-btn');
      if (!btn) return;
      filter.querySelectorAll('.cf-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter;
      cards.forEach((card) => {
        const cats = (card.dataset.cat || '').split(' ');
        const show = f === 'all' || cats.includes(f);
        card.style.display = show ? '' : 'none';
      });
    });
  }
</script>

<script>
  (() => {
    const read = (key) => { try { return JSON.parse(localStorage.getItem(key) || '{}'); } catch { return {}; } };
    const speakingDone = () => Object.values(read('tayanch-speaking-progress-v2')).filter((day) => day && day.pronunciation_done && day.shadowing_done && day.speaking_done).length;
    const writingDone = () => Object.values(read('tayanch-writing-progress-v2')).filter((day) => day && day.task1_done && day.task2_done).length;
    const render = () => document.querySelectorAll('[data-course-progress-meter]').forEach((meter) => {
      const id = meter.dataset.courseId;
      let done, total;
      if (id === 'ielts-speaking') { done = Math.min(30, speakingDone()); total = 30; }
      else if (id === 'ielts-writing') { done = Math.min(30, writingDone()); total = 30; }
      else { const state = read('progress:' + id); const values = Object.values(state); done = values.filter(Boolean).length; total = Number(meter.dataset.total) || values.length; }
      meter.textContent = total ? `Progress: ${done}/${total} · ${Math.round(done / total * 100)}%` : 'Progressni boshlang';
      meter.classList.toggle('has-progress', done > 0);
    });
    render();
    window.addEventListener('storage', render);
  })();
</script>

</Base>

---
import Base from '../../layouts/Base.astro';
import GeneralEnglishCourse from '../../components/GeneralEnglishCourse.astro';
import { getGeneralEnglishCourse } from '../../data/general-english-courses';

const lang = 'uz' as const;
const course = getGeneralEnglishCourse('general-english-elementary', lang);
if (!course) throw new Error('Course was not found.');
const previousCourse = course.previousSlug ? getGeneralEnglishCourse(course.previousSlug, lang) : undefined;
const nextCourse = course.nextSlug ? getGeneralEnglishCourse(course.nextSlug, lang) : undefined;
const base = import.meta.env.BASE_URL;
const alternates = [
  { lang: 'uz', href: base + 'kurslar/general-english-elementary/' },
  { lang: 'ru', href: base + 'ru/kurslar/general-english-elementary/' },
  { lang: 'en', href: base + 'en/kurslar/general-english-elementary/' },
];
---

<Base title={course.title + ' | Tayanch'} description={course.description} lang={lang} localeAlternates={alternates}>
  <GeneralEnglishCourse {course} {previousCourse} {nextCourse} {lang} />
</Base>

  <script>
    const documentChecks = [...document.querySelectorAll('[data-admission-doc]')];
    const documentCount = document.querySelector('#docCheckCount');
    const updateDocumentCount = () => { if (documentCount) documentCount.textContent = String(documentChecks.filter((item) => item.checked).length); };
    documentChecks.forEach((item) => item.addEventListener('change', updateDocumentCount));
    updateDocumentCount();

    const checks = [...document.querySelectorAll('.subcourse-check')];
    const fmt = new Intl.NumberFormat('uz-UZ');
    const label = document.querySelector('#selectionLabel');
    const price = document.querySelector('#totalPrice');
    const note = document.querySelector('#totalNote');
    const hint = document.querySelector('#bundleHint');
    const link = document.querySelector('#purchaseLink');
    const updateSelection = () => {
      const chosen = checks.filter((item) => item.checked);
      document.querySelectorAll('.subcourse-card').forEach((card) => card.classList.toggle('chosen', card.querySelector('input').checked));
      const isBundle = chosen.length === 3;
      const total = isBundle ? 219000 : chosen.reduce((sum, item) => sum + Number(item.dataset.price), 0);
      label.textContent = chosen.length ? chosen.map((item) => item.dataset.title).join(', ') : 'Hali tanlanmadi';
      price.textContent = `${fmt.format(total)} so'm`;
      note.textContent = isBundle ? 'Bundle chegirma qo\'llandi' : chosen.length ? 'Tanlangan sub-kurslar narxi' : 'Sub-kurs tanlang';
      hint.classList.toggle('active', isBundle);
      link.classList.toggle('select-disabled', !chosen.length);
      link.setAttribute('aria-disabled', String(!chosen.length));
      link.href = chosen.length ? `${import.meta.env.BASE_URL}bog-lanish?admission=${chosen.map((item) => item.value).join(',')}&total=${total}` : `${import.meta.env.BASE_URL}bog-lanish`;
    };
    checks.forEach((check) => check.addEventListener('change', updateSelection));
    link.addEventListener('click', (event) => { if (!checks.some((item) => item.checked)) event.preventDefault(); });
    updateSelection();
  </script>


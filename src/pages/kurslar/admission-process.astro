---
import Base from "../../layouts/Base.astro";
import CourseProgress from "../../components/CourseProgress.astro";
import PaymentInstructions from "../../components/PaymentInstructions.astro";
import CourseSchema from "../../components/CourseSchema.astro";
import Quiz from "../../components/Quiz.astro";
const title = "Admission Process — Tayanch";
const description = "Chet el universitetlariga hujjat topshirish: essaylar, hujjatlar va ariza platformalari.";
const base = import.meta.env.BASE_URL;
const questions = [
  { q: "Personal statementning asosiy vazifasi nima?", opts: ["Faqat baholarni qayta yozish", "Arizachining hikoyasi, maqsadi va mosligini tushuntirish", "Pasport o'rniga ishlatish", "IELTS natijasini almashtirish"], answer: 1 },
  { q: "Common App va Coalition App qanday joylashtirilgan?", opts: ["Bitta tizim", "Alohida ariza platformalari", "Faqat to'lov ilovalari", "Faqat universitet reytinglari"], answer: 1 },
  { q: "Transcript bilan ishlashda nimani avval tekshirish kerak?", opts: ["Rasm rangini", "Universitetning hujjat formati va deadline talabini", "Essay sarlavhasini", "Telegram kanalini"], answer: 1 }
];
const subcourses = [
  { id: 'essays', num: '01', title: 'Esseylar', price: 129000, priceLabel: "129 000 so'm", summary: "Personal Statement, tavsiyanoma va qo'shimcha essaylarni tizimli tayyorlash." },
  { id: 'documents', num: '02', title: 'Hujjat tayyorlash', price: 49000, priceLabel: "49 000 so'm", summary: "Transcript, IELTS, SAT va attestatni talabga mos tartibga solish." },
  { id: 'apply', num: '03', title: "Hujjat topshirish va qabul xati", price: 99000, priceLabel: "99 000 so'm", summary: "Kaplan, Common App, Coalition App va Scoir orqali ariza jarayoni." }
];
---

<Base title={title} description={description}>
  <CourseProgress courseId="admission-process" title="Admission Process progressi" itemSelector=".content-section .lesson-card" labelSelector="h3" />
  <CourseSchema name={title} description={description} />
  <article class="lesson admission-page">
    <div class="course-hero">
      <h1>Chet elga qabul: hujjatdan intervyugacha</h1>
      <div class="price admission-price"><span class="now">49 000 so'mdan</span><span class="uzs">sub-kurslar alohida tanlanadi</span></div>
    </div>

    <p class="lead">Chet el universitetlariga hujjat topshirish jarayonini uchta mustaqil yo'nalishga ajratib o'rganing: essaylar, hujjatlar va ariza topshirish.</p>

    <section class="welcome-module" aria-labelledby="welcome-title">
      <span class="welcome-kicker">WELCOME MODULI · C3</span>
      <h2 id="welcome-title">Bu kursdan nima olasiz?</h2>
      <div class="welcome-grid">
        <div><b>Maqsad</b><p>Chet el universitetlariga ariza topshirish jarayonini hujjatli, rejali va muddatlari bilan boshqarishni o'rganish.</p></div>
        <div><b>Tuzilma</b><p>3 sub-kurs: Esseylar → Hujjat tayyorlash → Topshirish va qabul xati. Har dars: hook → nazariya → amaliy mashq → xulosa.</p></div>
        <div><b>Kutilayotgan natija</b><p>Kurs oxirida master profile, hujjat check-listi va ariza tracker'ingiz tayyor bo'ladi.</p></div>
      </div>
    </section>

    <section class="admission-toolkit" aria-labelledby="admission-toolkit-title">
      <div class="admission-toolkit-head"><div><span>ARIZA XARITASI</span><h2 id="admission-toolkit-title">Hujjatlar va jarayon</h2><p>Hujjatlarning tayyor holatini belgilang, keyin ariza oqimini bosqichma-bosqich kuzating.</p></div><p class="check-progress" aria-live="polite"><b id="docCheckCount">0</b>/4 belgilandi</p></div>
      <div class="admission-toolkit-grid">
        <div class="document-checklist"><h3>Kerakli hujjatlar</h3><label><input type="checkbox" data-admission-doc /><span class="doc-box" aria-hidden="true">✓</span><span><b>Transcript</b><small>Maktab baholari va akademik ma'lumot</small></span></label><label><input type="checkbox" data-admission-doc /><span class="doc-box" aria-hidden="true">✓</span><span><b>IELTS</b><small>Test natijasi va yuborish holati</small></span></label><label><input type="checkbox" data-admission-doc /><span class="doc-box" aria-hidden="true">✓</span><span><b>SAT</b><small>Talab qilinsa, score report</small></span></label><label><input type="checkbox" data-admission-doc /><span class="doc-box" aria-hidden="true">✓</span><span><b>Attestat</b><small>Format va tarjima talabini tekshirish</small></span></label></div>
        <div class="admission-timeline" aria-label="Ariza jarayoni timeline'i"><h3>Ariza jarayoni</h3><ol><li><span>01</span><div><b>Hujjat</b><small>Talab, format va deadline’ni tekshirish</small></div></li><li><span>02</span><div><b>Essay</b><small>Hikoya, dalil va savolga mos reja</small></div></li><li><span>03</span><div><b>Interview</b><small>Keyingi suhbatga tayyorgarlik</small></div></li></ol></div>
      </div>
    </section>

    <section class="subcourse-section" aria-labelledby="subcourses-title">
      <div class="section-heading"><div><p class="eyebrow">TANLAB SOTIB OLISH</p><h2 id="subcourses-title">Sizga kerakli sub-kurslarni tanlang</h2></div><p>Bir yoki bir nechta qismni tanlashingiz mumkin. Uchalasini tanlasangiz bundle narxi avtomatik qo'llanadi.</p></div>
      <p class="rule-legend" aria-label="Modul tuzilma qoidalari"><span><b>C1</b> ≤30 daqiqa</span><span><b>C2</b> hook → nazariya → amaliy → xulosa → mini-test</span><span><b>C4</b> amaliy transformatsiya</span></p>
      <div class="subcourse-grid">
        {subcourses.map((course) => (
          <label class="subcourse-card" data-card={course.id}>
            <input class="subcourse-check" type="checkbox" value={course.id} data-price={course.price} data-title={course.title} />
            <span class="checkmark" aria-hidden="true">✓</span>
            <span class="card-number">{course.num}</span>
            <strong>{course.title}</strong>
            <span class="card-summary">{course.summary}</span>
            <span class="card-price">{course.priceLabel}</span>
          </label>
        ))}
      </div>
      <div class="purchase-panel" aria-live="polite">
        <div><p class="selection-label">Tanlanganlar: <strong id="selectionLabel">Hali tanlanmadi</strong></p><p id="bundleHint" class="bundle-hint">3 tasini birga oling — <strong>58 000 so'm tejang</strong>.</p></div>
        <div class="total-box"><span>Jami</span><strong id="totalPrice">0 so'm</strong><small id="totalNote">Sub-kurs tanlang</small></div>
        <a id="purchaseLink" class="start-btn select-disabled" href={base + 'bog-lanish'}>Tanlangan sub-kurslar bo'yicha bog'lanish →</a>
      </div>
    </section>

    <section class="bundle-callout"><div><p class="eyebrow">BUNDLE CHEGIRMA</p><h2>3 tasini birga oling</h2><p>Esseylar + Hujjat tayyorlash + Hujjat topshirish va qabul xati alohida olinganda 277 000 so'm. Bundle narxi: <strong>219 000 so'm</strong>.</p></div><div class="bundle-price"><span>58 000 so'm tejang</span><strong>219 000 so'm</strong></div></section>

    <section id="essays" class="content-section"><p class="eyebrow">01 — SUB-KURS</p><h2>Esseylar</h2><div class="content-list"><div><h3>Recommendation letters</h3><p>Tavsiyanoma uchun kimni tanlash, kontekst yig'ish va mazmunni tartibga solish bo'yicha ish oqimi.</p></div><div><h3>Personal Statement</h3><p>Shaxsiy tajribani maqsad va yo'nalish bilan bog'laydigan aniq hikoya strukturasini tuzish.</p></div><div><h3>Qo'shimcha essaylar</h3><p>Additional va Supplemental essaylarni har universitet savoliga mos, takrorlanmaydigan tarzda rejalash.</p></div></div>
      <article class="lesson-card">
        <p class="eyebrow">DARS 1 — PERSONAL STATEMENT</p>
        <h3>Qiziqishni hikoyaga aylantirish: origin story va growth narrative</h3>
        <p class="lesson-intro">Kuchli Common App inshosi faqat “men bu sohani yoqtiraman” degan da’vo emas. U o'quvchiga sizning qiziqishingiz qayerdan boshlanganini, qaysi qadamlar bilan rivojlanganini va nima uchun u bugungi maqsadingizga olib kelganini ko'rsatadi.</p>
        <div class="lesson-grid">
          <div><span>1</span><h4>Origin story bilan boshlang</h4><p>Hikoyani sizga xos boshlang'ich nuqtadan oching: ilk robot, birinchi kod, bolalikdagi noodatiy odat, kichik loyiha yoki “bu muammoni yechaman” degan vaziyat. Boshlanish umumiy emas, tasavvur qilsa bo'ladigan detalga tayanishi kerak.</p></div>
          <div><span>2</span><h4>O'sish zanjirini ko'rsating</h4><p>Bir qiziqishning keyingi bosqichga qanday olib kelganini tartib bilan bering: ilk tajriba → o'rgangan ko'nikma → sinab ko'rgan loyiha → hozirgi akademik maqsad. Bu “growth narrative” sizning yo'lingiz tasodifiy emasligini ko'rsatadi.</p></div>
          <div><span>3</span><h4>Mayda, vizual dalillar ishlating</h4><p>“Men codingga qiziqaman” deyish o'rniga, masalan, bir xatoni uch oy tahlil qilib yechganingizni yoki birinchi ilovangizning nega ishlamaganini ayting. Konkret epizodlar essayni esda qoladigan qiladi.</p></div>
          <div><span>4</span><h4>Bitta asosiy xususiyatni tanlang</h4><p>Hikoyaning markazida sizni tavsiflaydigan sifat bo'lsin: builder, problem-solver, researcher, challenger, storyteller yoki community-builder. Har paragraf shu xususiyatni turli dalil bilan kuchaytirishi kerak.</p></div>
          <div><span>5</span><h4>Future vision bilan yoping</h4><p>Oxirida hikoya hozirgi niyatga ulanadi: “Shu sabab men ___ yo'nalishini universitetda chuqurlashtirmoqchiman.” Bu major tanlovingizni oldingi tajribalar bilan mantiqan bog'laydi.</p></div>
          <div><span>6</span><h4>Voice: sodda, samimiy, aniq</h4><p>Murakkab so'zlar bilan taassurot qoldirishga urinmang. O'quvchi sizning tabiiy ovozingizni, fikrlash usulingizni va o'zingiz haqingizdagi mulohazangizni his qilishi kerak.</p></div>
        </div>
        <div class="practice-box"><h4>Mini-mashq: hikoya xaritasi</h4><ol><li>Qiziqishingiz boshlangan bitta aniq voqeani yozing.</li><li>U sizni o'rgangan yoki qurgan keyingi narsaga qanday olib kelganini yozing.</li><li>Bugun tanlamoqchi bo'lgan yo'nalishingiz bilan bog'lang.</li><li>Hikoyada ko'rinadigan bitta asosiy sifatni belgilang.</li></ol><p><strong>Formula:</strong> bitta tajriba → bitta o'sish → yangi bosqich → hozirgi maqsad.</p></div>
      </article>
      <article class="lesson-card">
        <p class="eyebrow">DARS 2 — SUPPLEMENTAL ESSAY</p>
        <h3>“Why this university?” javobini tadqiqotdan shaxsiy argumentgacha olib boring</h3>
        <p class="lesson-intro">Qo'shimcha esse universitetning reklama matnini qaytarish uchun emas. U sizning maqsadingiz, aniq imkoniyat va universitet hamjamiyatiga qo'shadigan hissangiz orasidagi bog'lanishni ko'rsatadi.</p>
        <div class="lesson-grid">
          <div><span>1</span><h4>Avval savol turini aniqlang</h4><p>“Why us?”, “Why major?”, community yoki short answer savollari bir xil reja bilan yozilmaydi. Javob berayotgan savolni bir jumlada o'zingizga qayta ayting.</p></div>
          <div><span>2</span><h4>Uchta tekshirilgan detail tanlang</h4><p>Dastur, fan, laboratoriya, klub yoki yondashuvdan faqat sizning maqsadingizga tegishli dalillarni oling. Nomlarni sanashdan ko'ra, nega aynan ular kerakligini izohlang.</p></div>
          <div><span>3</span><h4>Detailni tajribangizga ulang</h4><p>Har bir imkoniyat yoniga: “Bu menga nima uchun kerak?” degan savolga javob yozing. Oldingi loyiha, qiziqish yoki muammo bilan mantiqiy ko'prik quring.</p></div>
          <div><span>4</span><h4>Universitet uchun hissani ko'rsating</h4><p>Faqat nima olishingizni emas, qanday savol, tajriba yoki hamkorlik ruhini olib borishingizni ham bering. Da'vo o'rniga bitta real misol ishlating.</p></div>
        </div>
        <div class="practice-box"><h4>Mini-mashq: 3×3 research xaritasi</h4><p>3 ta universitet detailini yozing. Har biri uchun: rasmiy manba, sizning avvalgi tajribangiz va campusdagi keyingi qadamingizni belgilang. Keyin 150–200 so'zli original reja tuzing.</p></div>
      </article>
      <article class="lesson-card"><p class="eyebrow">DARS 3 — HIKOYA TANLASH</p><h3>Personal Statement uchun aytishga arziydigan voqeani toping</h3><p class="lesson-intro">Kuchli essay rezyumedagi barcha yutuqlarni takrorlamaydi. U bitta aniq tajriba orqali sizning qaroringiz, o'sishingiz va bugungi qarashingizni ko'rsatadi.</p><div class="lesson-grid"><div><span>1</span><h4>Vaziyatni emas, burilish nuqtasini qidiring</h4><p>Sizni o'zgartirgan qaror, xato, muammo yoki kutilmagan savolni tanlang. Voqea kichik bo'lishi mumkin, lekin fikr yuritishingizni ochishi kerak.</p></div><div><span>2</span><h4>Da'vo o'rniga sahna bering</h4><p>“Men qat'iyman” deyish o'rniga, tanlov qilgan bir lahzani, ko'rgan detalingizni va natijani tasvirlang.</p></div><div><span>3</span><h4>Mulohaza bilan yoping</h4><p>Hikoyaning o'zi yetarli emas: u siz nimani tushunganingiz va keyingi qadamlaringizga qanday ta'sir qilganini ko'rsatishi kerak.</p></div></div><div class="practice-box"><h4>Mini-mashq: 6 katakli story map</h4><p>Vaziyat → taranglik → harakat → burilish → insight → bugungi ahamiyat zanjirida bitta tajribangizni xaritalang.</p></div></article>
      <article class="lesson-card"><p class="eyebrow">DARS 4 — WHY MAJOR?</p><h3>Qiziqishni akademik yo'nalishga aylantiring</h3><p class="lesson-intro">“Men bu sohaga qiziqaman” umumiy gap. Ishonchli javob qiziqish qayerdan boshlanganini, siz nima qilganingizni va endi qaysi savolni chuqurlashtirmoqchi ekaningizni ko'rsatadi.</p><div class="lesson-grid"><div><span>1</span><h4>Origin-ni dalil bilan bering</h4><p>Bitta haqiqiy tajriba yoki kuzatuvdan boshlang; u faqat qiziqish emas, nega aynan siz uchun muhimligini ko'rsatsin.</p></div><div><span>2</span><h4>Davomiy harakatni ko'rsating</h4><p>Loyiha, kurs, mustaqil izlanish, ish yoki hamjamiyat tajribasi orqali qiziqishni tekshirganingizni ko'rsating.</p></div><div><span>3</span><h4>Keyingi savolni aniqlang</h4><p>Majorni kasb nomi sifatida emas, universitetda o'rganmoqchi bo'lgan aniq muammo yoki savol sifatida yozing.</p></div></div><div class="practice-box"><h4>Mini-mashq: interest → action → question</h4><p>120 so'zda shu uchlik asosida paragraf yozing. So'ng barcha mavhum so'zlarni aniq misol yoki detail bilan almashtiring.</p></div></article>
      <article class="lesson-card"><p class="eyebrow">DARS 5 — PROMPT-EVIDENCE MATCH</p><h3>Har supplemental savol uchun mos dalil tanlang</h3><p class="lesson-intro">Bir essayni barcha savolga moslashtirish oson ko'rinadi, lekin u promptdan chetga chiqishi mumkin. Har savol o'zining eng mos dalilini so'raydi.</p><div class="lesson-grid"><div><span>1</span><h4>Prompt maqsadini o'qing</h4><p>Academic interest, community, contribution, value yoki “why us” savoli nimani bilmoqchi ekanini bir gapda aniqlang.</p></div><div><span>2</span><h4>Bitta asosiy tezis yozing</h4><p>Javob boshidan qanday fikrni isbotlashini aniqlang; keyin faqat shu fikrga xizmat qiladigan dalilni qoldiring.</p></div><div><span>3</span><h4>Takrorlashdan saqlaning</h4><p>Bir tajribani qayta ishlatsangiz ham, boshqa rakurs bering. Har supplemental arizaning umumiy portretiga yangi qatlam qo'shsin.</p></div></div><div class="practice-box"><h4>Amaliy ish: 3 prompt, 3 dalil</h4><p>Academic interest, community va “why us” turidagi uch savol uchun bittadan mos tajriba va bittadan tezis yozing.</p></div></article>
      <article class="lesson-card"><p class="eyebrow">DARS 6 — REVISION LAB</p><h3>Birinchi draftni aniq va esda qoladigan essayga aylantiring</h3><p class="lesson-intro">Tahrirlash faqat grammatika emas. Avval ma'no va struktura, keyin dalil, so'ng til hamda mexanikani tekshiring.</p><div class="lesson-grid"><div><span>1</span><h4>Har paragrafning vazifasi bormi?</h4><p>Har paragraf markaziy fikrni oldinga siljitishini tekshiring. Takror yoki chetga chiqish bo'lsa, qisqartiring.</p></div><div><span>2</span><h4>Mavhum yorliqni detail bilan almashtiring</h4><p>“Lider”, “mehnatkash” yoki “ijodkor” kabi so'zlar o'rniga, buni ko'rsatadigan aniq harakat va vaziyat bering.</p></div><div><span>3</span><h4>Qabul xodimi kabi o'qing</h4><p>Matn aniqmi, tabiiy ovoz eshitiladimi, savolga javob beryaptimi va bir o'qishda tushuniladimi — shuni tekshiring.</p></div></div><div class="practice-box"><h4>Mini-mashq: uch rangli edit</h4><p>Draftdagi takrorlarni o'chirishga, dalilsiz da'volarni belgilashga va qo'shiladigan ikki konkret detailga uch xil rang ajrating. Keyin 3 bandli revision reja yozing.</p></div></article>
      <p class="source-note">Obsidian manbasi: <code>04.Admissions/2.Personal esseys/3.Personal statement.md</code> va <code>04.Admissions/2.Personal esseys/All in one "Personal esseys".md</code>. Qo'shimcha kurs materiali: user bergan Grand Slam Group matni va videolari asosida qayta tuzib yozildi (foydalanish huquqi tasdiqlangan). Universitetga xos prompt va so'z limitlarini amaldagi rasmiy qabul sahifasida tekshiring.</p></section>

    <section id="documents" class="content-section"><p class="eyebrow">02 — SUB-KURS</p><h2>Hujjat tayyorlash</h2><div class="content-list"><div><h3>Hujjatlar check-listi</h3><p>Maktab baholari (transcript), IELTS, SAT va attestatni alohida talablar bilan solishtirib, tayyor holatini kuzatish.</p></div><div><h3>Format va muddat</h3><p>Har universitet yoki platformaning yuklash formati, tarjima talabi va deadline'ini bitta reja ichida boshqarish.</p></div></div><article class="lesson-card"><p class="eyebrow">DARS 1 — MASTER PROFILE</p><h3>Arizadagi barcha faktlar uchun bitta ishonchli manba yarating</h3><p class="lesson-intro">Ko'p xato ariza formasida emas, ma'lumotlar turli fayllarda bir-biriga mos kelmaganda boshlanadi. Master profile — barcha platformalar uchun tekshirilgan faktlar bazasi.</p><div class="lesson-grid"><div><span>1</span><h4>Shaxsiy ma'lumotlar</h4><p>Pasportdagi ism, tug'ilgan sana, fuqarolik, manzil va aloqa ma'lumotlarini aynan rasmiy shaklda bitta jadvalga kiriting.</p></div><div><span>2</span><h4>Akademik kontekst</h4><p>Maktab nomi, o'qish yillari, baholash tizimi, GPA izohi, fanlar va o'qish tilini bir joyda saqlang.</p></div><div><span>3</span><h4>Test va sertifikatlar</h4><p>IELTS, SAT/ACT yoki boshqa natijalarda test sanasi, score report va yuborish holatini alohida belgilang.</p></div><div><span>4</span><h4>Versiya nazorati</h4><p>Har yangi fakt yoniga sana va manbani yozing. Taxminiy yoki esdan aytilgan ma'lumotni arizada ishlatmang.</p></div></div><div class="practice-box"><h4>Amaliy ish: master profile</h4><p>Google Sheet yoki Obsidian’da 5 bo'limli jadval tuzing: Shaxsiy ma'lumotlar, Ta'lim, Testlar, Faoliyatlar, Hujjatlar. Har faktga “tekshirildi” belgisi qo'ying.</p></div></article>
      <article class="lesson-card"><p class="eyebrow">DARS 2 — ACTIVITIES, HONORS VA CV</p><h3>Faoliyatlaringizni ro'yxatdan dalilga aylantiring</h3><p class="lesson-intro">Faoliyat nomi o'zi yetarli emas. Kuchli ta'rif sizning rolingiz, qilgan ishingiz, davomiyligingiz va natijangizni qisqa, aniq ko'rsatadi.</p><div class="lesson-grid"><div><span>1</span><h4>Ustuvorlik bering</h4><p>Eng muhim 8–10 faoliyatni tanlang: uzoq davom etgan, tashabbus ko'rsatgan yoki odamlar hayotiga ta'sir qilgan ishlardan boshlang.</p></div><div><span>2</span><h4>Harakat → ta'sir → natija</h4><p>Har ta'rifda nima qilganingiz, kimga yoki nimaga ta'sir qilgani va imkon bo'lsa o'lchanadigan natijani yozing.</p></div><div><span>3</span><h4>Raqamga kontekst bering</h4><p>“200 o'quvchi” degan raqam yonida faoliyatingiz doirasi va mas'uliyatingizni ham ko'rsating.</p></div><div><span>4</span><h4>CV va platformani moslang</h4><p>CV uzunroq dalillar uchun, ariza maydoni esa cheklangan so'z uchun. Bir xil faktni ikki xil hajmda, lekin zid bo'lmagan tarzda tayyorlang.</p></div></div><div class="practice-box"><h4>Mini-mashq: activity audit</h4><p>3 ta faoliyatingiz uchun to'rt ustun yozing: rol, haftalik vaqt, qilgan harakat, natija. Keyin har biridan qisqa ariza ta'rifi hosil qiling.</p></div></article>
      <article class="lesson-card"><p class="eyebrow">DARS 3 — TAVSIYANOMA PAKETI</p><h3>O'qituvchi va counselor bilan ishni vaqtida, etik va tartibli boshqaring</h3><p class="lesson-intro">Tavsiyanomani o'quvchi yozmaydi. Uning vazifasi tavsiya beruvchiga mustaqil baho yozishi uchun kerakli kontekst, vaqt va tartibni berishdir.</p><div class="lesson-grid"><div><span>1</span><h4>To'g'ri odamni tanlang</h4><p>Fanlardagi qiziqishingiz, rivojlanishingiz yoki jamoaviy ishingizni real misol bilan biladigan o'qituvchini tanlang.</p></div><div><span>2</span><h4>Briefing tayyorlang</h4><p>1 betlik resume/brag sheet, yo'nalishlaringiz, deadline jadvali va eslatadigan 2–3 tajribani bering. Bu xat mazmunini diktovka qilish emas.</p></div><div><span>3</span><h4>Rollarni ajrating</h4><p>Teacher tavsiyanomasi sinfdagi kuzatuvni, counselor esa maktab va umumiy akademik kontekstni yoritishi mumkin.</p></div><div><span>4</span><h4>Statusni xushmuomalalik bilan kuzating</h4><p>Taklif yuborilgani, fayl yuklangani va deadline holatini tekshiring, biroq baholash va maxfiy javoblarga aralashmang.</p></div></div><div class="practice-box"><h4>Amaliy ish: o'qituvchi paketi</h4><p>Resume/brag sheet, universitetlar va deadline jadvali, hamda muloyim so'rov xati loyihasini bir papkaga jamlang.</p></div></article>
      <p class="source-note">Obsidian manbasi: <code>04.Admissions/4.Other-Admission/6.Transcripts.md</code> va <code>04.Admissions/4.Other-Admission/5.Sertificates and CV.md</code>. Qo'shimcha material: user taqdim etgan Grand Slam Group videolari, original darsga aylantirildi.</p></section>

    <section id="apply" class="content-section"><p class="eyebrow">03 — SUB-KURS</p><h2>Hujjat topshirish va qabul xati</h2><div class="content-list platforms"><div><h3>Kaplan International Pathways</h3><p>Kaplan yo'nalishidagi universitetlar uchun ariza va talablar oqimi alohida ko'rib chiqiladi.</p></div><div><h3>Common App</h3><p>Profil, education, activities, essay va university bo'limlarini yagona arizada boshqarish.</p></div><div><h3>Coalition App</h3><p>Coalition App — Common App bilan birlashtirilmaydigan, mustaqil ariza tizimi sifatida ko'rib chiqiladi.</p></div><div><h3>Scoir</h3><p>Scoir ham alohida platforma: ma'lumotlar, universitetlar va topshirish ketma-ketligi mustaqil yuritiladi.</p></div><div><h3>Qabul xati va keyingi qadam</h3><p>Natija kelgach offer letter hujjatlarini tekshirish, keyingi deadline va qarorni qayd etish.</p></div></div><article class="lesson-card"><p class="eyebrow">DARS 1 — PLATFORM VA RO'YXAT</p><h3>Platformani emas, ariza strategiyasini tanlang</h3><p class="lesson-intro">Common App, Scoir/Coalition, UCAS yoki universitetning bevosita portali turli interfeys bo'lishi mumkin. Asosiy vazifa — har universitetning rasmiy talabini tekshirib, yagona deadline rejasini yuritish.</p><div class="lesson-grid"><div><span>1</span><h4>Rasmiy manbadan boshlang</h4><p>Universitetning admission sahifasida qabul turi, kerakli platforma, hujjatlar va so'nggi muddatni yozib oling.</p></div><div><span>2</span><h4>Fit ro'yxatini tuzing</h4><p>Yo'nalish, xarajat, qabul selektivligi, joylashuv va imkoniyatlarni solishtiring. Birgina reyting asosida qaror qilmang.</p></div><div><span>3</span><h4>Deadline turini biling</h4><p>Early, Regular va Rolling kabi rejalar majburiyat va vaqt bo'yicha farq qiladi. Har birini universitetning o'z sahifasida tekshiring.</p></div><div><span>4</span><h4>Bitta kalendar, bitta status</h4><p>Universitet, platforma, deadline, fee, tavsiyanoma va hujjat holatini bitta trackerda boshqaring.</p></div></div><div class="practice-box"><h4>Amaliy ish: 5 universitet tracker</h4><p>5 ta universitet uchun platforma, dastur, deadline, talab qilinadigan hujjat, esse va status ustunlari bor jadval yarating.</p></div></article>
      <article class="lesson-card"><p class="eyebrow">DARS 2 — REVIEW BEFORE SUBMIT</p><h3>Yuborishdan oldingi tekshiruv: 15 daqiqa xatolardan qutqaradi</h3><p class="lesson-intro">Arizani yuborish — tayyorgarlikning yakuni, taxminning emas. Portal tasdiqlari o'zgarishi mumkin, lekin yakuniy audit tamoyillari barcha platformalarda bir xil qoladi.</p><div class="lesson-grid"><div><span>1</span><h4>Faktlar mosligini tekshiring</h4><p>Ism, sana, maktab, baho, test va pasport ma'lumotlarini master profile hamda yuklangan fayllar bilan solishtiring.</p></div><div><span>2</span><h4>Preview yoki PDFni o'qing</h4><p>Format buzilishi, bo'sh qolgan maydon, noto'g'ri fayl yoki kesilib qolgan esse bo'lsa, yuborishdan oldin tuzating.</p></div><div><span>3</span><h4>Tavsiyanoma va hujjat holati</h4><p>Kim taklif qilinganini, qaysi universitet uchun qanday hujjat kerakligini hamda statusini tekshiring.</p></div><div><span>4</span><h4>Keyingi qadamni yozib qo'ying</h4><p>Submission confirmation, applicant portal, qo'shimcha so'rovlar va keyingi deadline’lar uchun alohida eslatma qo'ying.</p></div></div><div class="practice-box"><h4>Mini-mashq: final audit</h4><p>Bir mock ariza uchun 10 bandli tekshiruv ro'yxati tuzing: ma'lumot, esse, hujjat, tavsiyanoma, to'lov/fee waiver, deklaratsiya va status.</p></div></article>
      <article class="lesson-card"><p class="eyebrow">DARS 3 — QABUL XATIDAN KEYIN</p><h3>Offer letter kelgach: qarorni hujjatli va xotirjam qabul qiling</h3><p class="lesson-intro">Qabul xati yakuniy nuqta emas. Shartlar, moliyaviy yordam, deposit, viza va uy-joy kabi keyingi majburiyatlarni muddatlari bilan alohida ko'rish kerak.</p><div class="lesson-grid"><div><span>1</span><h4>Taklif turini aniqlang</h4><p>Offer shartli yoki shartsizligini, bajarilishi kerak bo'lgan akademik/test talablari bor-yo'qligini rasmiy xatdan tekshiring.</p></div><div><span>2</span><h4>Moliyaviy qismini o'qing</h4><p>Scholarship, grant, xarajat va to'lov muddatlarini yozib chiqing. Tushunarsiz bo'lsa universitetning rasmiy bo'limiga savol yuboring.</p></div><div><span>3</span><h4>Deadline’ni kalendarga qo'ying</h4><p>Qaror, deposit, hujjat, turar joy va viza qadamlari uchun alohida eslatma o'rnating.</p></div><div><span>4</span><h4>Har bir xatni saqlang</h4><p>Offer letter va rasmiy yozishmalarni xavfsiz papkaga joylang; norasmiy skrinshotga tayanmang.</p></div></div></article>
      <p class="source-note">Obsidian manbasi: <code>04.Admissions/1.UniList/1.UniList-Kaplan internationbal Pathways.md</code>, <code>2.Unilist-Common App.md</code>, <code>3.UniList-Scoir Coalation.md</code>. Qo'shimcha material: user taqdim etgan Grand Slam Group videolari, original darsga aylantirildi. Platforma interfeysi va deadline’larni har mavsum rasmiy manbadan qayta tekshiring.</p></section>


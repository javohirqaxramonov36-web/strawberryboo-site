---
import Base from "../../layouts/Base.astro";
import TelegramCTA from "../../components/TelegramCTA.astro";
import Quiz from "../../components/Quiz.astro";
const title = "Admission Process — O'rganamiz";
const description = "Chet el universitetlariga kirish: hujjatlar, essay, interview.";
const questions = [
  { q: "Motivation Letter nima?", opts: ["Pochta", "Universitetga nima uchun kirishni tushuntiruvchi xat", "Rasm", "Viza"], answer: 1 },
  { q: "Quyidagilardan qaysi biri stipendiya?", opts: ["El-Yurt Umidi", "Click", "Uzum", "Telegram"], answer: 0 },
  { q: "Interview oldidan nima kerak?", opts: ["Hech narsa", "Tayyorgarlik savollari va o'z loyihangizni bilish", "Pul", "Dam olish"], answer: 1 }
];
---

<Base title={title} description={description}>

<article class="lesson">
  <div class="course-hero">
    <h1>Admission Process</h1>
    <div class="price">
      <span class="now">$34</span>
      <span class="old">$49</span>
      <span class="badge badge-new">-31%</span>
      <span class="badge badge-cert">Sertifikat</span>
      <span class="uzs">≈ 425 000 so'm</span>
    </div>
  </div>

  <p class="lead" data-i18n="ap.lead">
    Chet el universitetlariga hujjat topshirish — murakkab jarayon.
    Noto'g'ri qadam stipendiyani o'tkazib yuborishi mumkin.
  </p>

  <section>
    <h2 data-i18n="ap.modules">Kurs modullari</h2>
    <ol class="modules">
      <li data-i18n="ap.mod1">Universitet tanlash: reyting, mutaxassislik, xarajat</li>
      <li data-i18n="ap.mod2">Hujjatlar: diplom, transcript, pasport</li>
      <li data-i18n="ap.mod3">Motivation Letter / Essay qanday yozish</li>
      <li data-i18n="ap.mod4">Interview: tayyorgarlik savollari</li>
      <li data-i18n="ap.mod5">Stipendiya: El-Yurt Umidi, Stipendium Hungaricum, KAU</li>
      <li data-i18n="ap.mod6">Obsidian'da kuzatuv: muddatlar, eslatmalar</li>
    </ol>
  </section>

  <a href="/bog-lanish" class="start-btn" style="margin-top:2rem;" data-i18n="ap.buy">Kursni sotib olish →</a>
  <a href="/kurslar" class="enroll" style="margin-left:1rem;" data-i18n="ap.all">← Barcha kurslar</a>

  <Quiz title="O'z bilimingizni tekshiring" titleI18n="ap.quizTitle" questions={questions} />

  <section class="tracker-cta">
    <div class="tracker-inner">
      <span class="badge badge-free">Bepul shablon</span>
      <h2 data-i18n="ap.trackerTitle">Universitet va Stipendiya Tracker Shabloni</h2>
      <p class="tracker-desc" data-i18n="ap.trackerDesc">
        UK, AQSH, Koreya, Ispaniya, Kanada universitetlarini kuzatish uchun tayyor shablon.
        Ariza muddatlari, hujjatlar holati va stipendiya bosqichlarini bitta jadvalda ushlab turing —
        nima topshirilgani, nima kutayotganingiz va qachon eslatma kerakligini unutmay gensiz.
      </p>
      <a href="#" class="dl-btn" onclick="return false;" aria-disabled="true" data-i18n="ap.trackerBtn">⬇ Yuklab olish</a>
      <p class="dl-note" data-i18n="ap.trackerNote">Fayl tez orada yuklanadi — havola hozircha placeholder.</p>
    </div>
  </section>
</article>

<style>
  .tracker-cta { margin-top: 3rem; }
  .tracker-inner {
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 14%, var(--surface)), var(--surface));
    border: 1px solid var(--border); border-radius: 18px; padding: 28px 26px;
    text-align: center; box-shadow: var(--shadow);
  }
  .tracker-inner .badge-free { position: static; display: inline-block; margin-bottom: 12px; }
  .tracker-inner h2 { margin: 0 0 .6rem; font-size: 1.5rem; color: var(--text); }
  .tracker-desc { color: var(--muted); max-width: 640px; margin: 0 auto 1.4rem; font-size: 1rem; }
  .dl-btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 13px 28px; border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; font-weight: 700;
    text-decoration: none; font-size: 1.02rem; cursor: pointer; box-shadow: 0 8px 22px -8px var(--accent);
    transition: transform .15s, box-shadow .15s;
  }
  .dl-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 26px -8px var(--accent); color: #fff; text-decoration: none; }
  .dl-note { margin: 1rem 0 0; color: var(--muted); font-size: .85rem; font-style: italic; }
  @media (max-width: 540px) { .tracker-inner { padding: 22px 18px; } .tracker-inner h2 { font-size: 1.3rem; } }
</style>
<TelegramCTA />
</Base>

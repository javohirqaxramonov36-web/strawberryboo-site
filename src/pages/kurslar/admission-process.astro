---
import Base from "../../layouts/Base.astro";
import TelegramCTA from "../../components/TelegramCTA.astro";
import Quiz from "../../components/Quiz.astro";
const title = "Admission Process — O'rganamiz";
const description = "Chet el universitetlariga hujjat topshirish: essaylar, hujjatlar va ariza platformalari.";
const base = import.meta.env.BASE_URL;
const questions = [
  { q: "Personal statementning asosiy vazifasi nima?", opts: ["Faqat baholarni qayta yozish", "Arizachining hikoyasi, maqsadi va mosligini tushuntirish", "Pasport o'rniga ishlatish", "IELTS natijasini almashtirish"], answer: 1 },
  { q: "Common App va Coalition App qanday joylashtirilgan?", opts: ["Bitta tizim", "Alohida ariza platformalari", "Faqat to'lov ilovalari", "Faqat universitet reytinglari"], answer: 1 },
  { q: "Transcript bilan ishlashda nimani avval tekshirish kerak?", opts: ["Rasm rangini", "Universitetning hujjat formati va deadline talabini", "Essay sarlavhasini", "Telegram kanalini"], answer: 1 }
];
const subcourses = [
  { id: 'essays', num: '01', title: 'Esseylar', price: 129000, priceLabel: "129 000 so'm", summary: "Personal Statement, tavsiyanoma va qo'shimcha essaylarni tizimli tayyorlash." },
  { id: 'documents', num: '02', title: 'Hujjat tayyorlash', price: 49000, priceLabel: "49 000 so'm", summary: "Transcript, IELTS, SAT va attestatni talabga mos tartibga solish." },
  { id: 'apply', num: '03', title: "Hujjat topshirish va qabul xati", price: 99000, priceLabel: "99 000 so'm", summary: "Kaplan, Common App, Coalition App va Scoir orqali ariza jarayoni." }
];
---

<Base title={title} description={description}>
  <article class="lesson admission-page">
    <div class="course-hero">
      <h1>Admission Process</h1>
      <div class="price admission-price"><span class="now">49 000 so'mdan</span><span class="uzs">sub-kurslar alohida tanlanadi</span></div>
    </div>

    <p class="lead">Chet el universitetlariga hujjat topshirish jarayonini uchta mustaqil yo'nalishga ajratib o'rganing: essaylar, hujjatlar va ariza topshirish.</p>

    <section class="subcourse-section" aria-labelledby="subcourses-title">
      <div class="section-heading"><div><p class="eyebrow">TANLAB SOTIB OLISH</p><h2 id="subcourses-title">Sizga kerakli sub-kurslarni tanlang</h2></div><p>Bir yoki bir nechta qismni tanlashingiz mumkin. Uchalasini tanlasangiz bundle narxi avtomatik qo'llanadi.</p></div>
      <div class="subcourse-grid">
        {subcourses.map((course) => (
          <label class="subcourse-card" data-card={course.id}>
            <input class="subcourse-check" type="checkbox" value={course.id} data-price={course.price} data-title={course.title} />
            <span class="checkmark" aria-hidden="true">✓</span>
            <span class="card-number">{course.num}</span>
            <strong>{course.title}</strong>
            <span class="card-summary">{course.summary}</span>
            <span class="card-price">{course.priceLabel}</span>
          </label>
        ))}
      </div>
      <div class="purchase-panel" aria-live="polite">
        <div><p class="selection-label">Tanlanganlar: <strong id="selectionLabel">Hali tanlanmadi</strong></p><p id="bundleHint" class="bundle-hint">3 tasini birga oling — <strong>58 000 so'm tejang</strong>.</p></div>
        <div class="total-box"><span>Jami</span><strong id="totalPrice">0 so'm</strong><small id="totalNote">Sub-kurs tanlang</small></div>
        <a id="purchaseLink" class="start-btn select-disabled" href={base + 'bog-lanish'}>Tanlangan sub-kurslar bo'yicha bog'lanish →</a>
      </div>
    </section>

    <section class="bundle-callout"><div><p class="eyebrow">BUNDLE CHEGIRMA</p><h2>3 tasini birga oling</h2><p>Esseylar + Hujjat tayyorlash + Hujjat topshirish va qabul xati alohida olinganda 277 000 so'm. Bundle narxi: <strong>219 000 so'm</strong>.</p></div><div class="bundle-price"><span>58 000 so'm tejang</span><strong>219 000 so'm</strong></div></section>

    <section class="content-section"><p class="eyebrow">01 — SUB-KURS</p><h2>Esseylar</h2><div class="content-list"><div><h3>Recommendation letters</h3><p>Tavsiyanoma uchun kimni tanlash, kontekst yig'ish va mazmunni tartibga solish bo'yicha ish oqimi.</p></div><div><h3>Personal Statement</h3><p>Shaxsiy tajribani maqsad va yo'nalish bilan bog'laydigan aniq hikoya strukturasini tuzish.</p></div><div><h3>Qo'shimcha essaylar</h3><p>Additional va Supplemental essaylarni har universitet savoliga mos, takrorlanmaydigan tarzda rejalash.</p></div></div><p class="source-note">Obsidian manbasi: <code>04.Admissions/2.Personal esseys/3.Personal statement.md</code> va <code>04.Admissions/2.Personal esseys/All in one "Personal esseys".md</code>.</p></section>

    <section class="content-section"><p class="eyebrow">02 — SUB-KURS</p><h2>Hujjat tayyorlash</h2><div class="content-list"><div><h3>Hujjatlar check-listi</h3><p>Maktab baholari (transcript), IELTS, SAT va attestatni alohida talablar bilan solishtirib, tayyor holatini kuzatish.</p></div><div><h3>Format va muddat</h3><p>Har universitet yoki platformaning yuklash formati, tarjima talabi va deadline'ini bitta reja ichida boshqarish.</p></div></div><p class="source-note">Obsidian manbasi: <code>04.Admissions/4.Other-Admission/6.Transcripts.md</code> va <code>04.Admissions/4.Other-Admission/5.Sertificates and CV.md</code>.</p></section>

    <section class="content-section"><p class="eyebrow">03 — SUB-KURS</p><h2>Hujjat topshirish va qabul xati</h2><div class="content-list platforms"><div><h3>Kaplan International Pathways</h3><p>Kaplan yo'nalishidagi universitetlar uchun ariza va talablar oqimi alohida ko'rib chiqiladi.</p></div><div><h3>Common App</h3><p>Profil, education, activities, essay va university bo'limlarini yagona arizada boshqarish.</p></div><div><h3>Coalition App</h3><p>Coalition App — Common App bilan birlashtirilmaydigan, mustaqil ariza tizimi sifatida ko'rib chiqiladi.</p></div><div><h3>Scoir</h3><p>Scoir ham alohida platforma: ma'lumotlar, universitetlar va topshirish ketma-ketligi mustaqil yuritiladi.</p></div><div><h3>Qabul xati va keyingi qadam</h3><p>Natija kelgach offer letter hujjatlarini tekshirish, keyingi deadline va qarorni qayd etish.</p></div></div><p class="source-note">Obsidian manbasi: <code>04.Admissions/1.UniList/1.UniList-Kaplan internationbal Pathways.md</code>, <code>2.Unilist-Common App.md</code>, <code>3.UniList-Scoir Coalation.md</code>.</p></section>

    <Quiz title="O'z bilimingizni tekshiring" questions={questions} />
    <a href={base + 'kurslar'} class="enroll">← Barcha kurslar</a>
  </article>

  <script>
    const checks = [...document.querySelectorAll('.subcourse-check')];
    const fmt = new Intl.NumberFormat('uz-UZ');
    const label = document.querySelector('#selectionLabel');
    const price = document.querySelector('#totalPrice');
    const note = document.querySelector('#totalNote');
    const hint = document.querySelector('#bundleHint');
    const link = document.querySelector('#purchaseLink');
    const updateSelection = () => {
      const chosen = checks.filter((item) => item.checked);
      document.querySelectorAll('.subcourse-card').forEach((card) => card.classList.toggle('chosen', card.querySelector('input').checked));
      const isBundle = chosen.length === 3;
      const total = isBundle ? 219000 : chosen.reduce((sum, item) => sum + Number(item.dataset.price), 0);
      label.textContent = chosen.length ? chosen.map((item) => item.dataset.title).join(', ') : 'Hali tanlanmadi';
      price.textContent = `${fmt.format(total)} so'm`;
      note.textContent = isBundle ? 'Bundle chegirma qo\'llandi' : chosen.length ? 'Tanlangan sub-kurslar narxi' : 'Sub-kurs tanlang';
      hint.classList.toggle('active', isBundle);
      link.classList.toggle('select-disabled', !chosen.length);
      link.setAttribute('aria-disabled', String(!chosen.length));
      link.href = chosen.length ? `${import.meta.env.BASE_URL}bog-lanish?admission=${chosen.map((item) => item.value).join(',')}&total=${total}` : `${import.meta.env.BASE_URL}bog-lanish`;
    };
    checks.forEach((check) => check.addEventListener('change', updateSelection));
    link.addEventListener('click', (event) => { if (!checks.some((item) => item.checked)) event.preventDefault(); });
    updateSelection();
  </script>

  <style>
    .admission-page { max-width: 980px; }
    .admission-price .now { font-size: 1.55rem; }
    .subcourse-section, .content-section { margin-top: 3.2rem; }
    .section-heading { display:flex; justify-content:space-between; gap:28px; align-items:flex-end; border-bottom:1px solid var(--border); padding-bottom:16px; margin-bottom:20px; }
    .section-heading h2, .content-section h2 { margin:0; }
    .section-heading > p { max-width:430px; color:var(--muted); margin:0; }
    .eyebrow { color:var(--accent); font-size:.78rem; font-weight:800; letter-spacing:.1em; margin:0 0 .5rem; }
    .subcourse-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; }
    .subcourse-card { display:flex; min-height:215px; flex-direction:column; gap:10px; position:relative; padding:22px; border:1px solid var(--border); background:var(--surface); border-radius:16px; cursor:pointer; transition:.18s ease; }
    .subcourse-card:hover, .subcourse-card.chosen { border-color:var(--accent); transform:translateY(-2px); box-shadow:0 12px 28px -20px var(--accent); }
    .subcourse-card input { position:absolute; opacity:0; }
    .checkmark { position:absolute; right:15px; top:15px; width:24px; height:24px; display:grid; place-items:center; color:transparent; border:1px solid var(--border); border-radius:7px; font-size:.85rem; }
    .chosen .checkmark { color:#fff; background:var(--accent); border-color:var(--accent); }
    .card-number { color:var(--accent); font-size:.8rem; font-weight:800; letter-spacing:.1em; }
    .subcourse-card strong { font-size:1.14rem; }
    .card-summary { color:var(--muted); line-height:1.5; font-size:.92rem; }
    .card-price { color:var(--text); font-weight:800; margin-top:auto; font-size:1.03rem; }
    .purchase-panel { display:grid; grid-template-columns:1fr auto auto; gap:18px; align-items:center; margin-top:18px; padding:20px; border:1px solid var(--border); border-radius:16px; background:color-mix(in srgb, var(--accent) 8%, var(--surface)); }
    .selection-label, .bundle-hint { margin:0; font-size:.9rem; color:var(--muted); }.bundle-hint { display:none; color:var(--accent); margin-top:5px; }.bundle-hint.active { display:block; }
    .total-box { min-width:150px; text-align:right; }.total-box span,.total-box small { display:block; color:var(--muted); font-size:.8rem; }.total-box strong { display:block; color:var(--accent); font-size:1.3rem; margin:3px 0; }
    .select-disabled { opacity:.58; pointer-events:none; }
    .bundle-callout { margin-top:24px; display:flex; align-items:center; justify-content:space-between; gap:24px; padding:25px 28px; border:1px solid color-mix(in srgb, var(--accent) 45%, var(--border)); border-radius:17px; background:linear-gradient(125deg, color-mix(in srgb, var(--accent) 18%, var(--surface)), var(--surface)); }.bundle-callout h2{margin:0 0 6px}.bundle-callout p:last-child{margin:0;color:var(--muted)}.bundle-price{text-align:right}.bundle-price span,.bundle-price strong{display:block}.bundle-price span{color:var(--accent);font-weight:700}.bundle-price strong{font-size:1.6rem;margin-top:5px}
    .content-section { padding-top:28px; border-top:1px solid var(--border); }.content-list { display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; }.content-list > div { padding:18px; border-radius:14px; background:var(--surface); border:1px solid var(--border); }.content-list h3 { margin:0 0 8px; font-size:1rem; }.content-list p { margin:0; color:var(--muted); line-height:1.55; font-size:.92rem; }.platforms { grid-template-columns:repeat(2,1fr); }.source-note { color:var(--muted); font-size:.82rem; margin:15px 0 0; }.source-note code { color:var(--accent); overflow-wrap:anywhere; }
    @media(max-width:760px){.section-heading,.bundle-callout{align-items:flex-start;flex-direction:column}.subcourse-grid,.content-list,.platforms{grid-template-columns:1fr}.purchase-panel{grid-template-columns:1fr}.total-box{text-align:left}.purchase-panel .start-btn{width:100%;text-align:center}.subcourse-card{min-height:170px}}
  </style>
  <TelegramCTA />
</Base>

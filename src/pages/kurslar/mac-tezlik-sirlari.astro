---
import Base from "../../layouts/Base.astro";
import PaymentInstructions from "../../components/PaymentInstructions.astro";
import CourseProgress from "../../components/CourseProgress.astro";
import CourseSchema from "../../components/CourseSchema.astro";
import LeadMagnetCTA from "../../components/LeadMagnetCTA.astro";
import Quiz from "../../components/Quiz.astro";
const title = "Mac'da Tezlik Sirlari — MacBook'dan samarali foydalanish";
const description = "Raycast, klaviatura shortcut'lari va Mac vositalari bilan kundalik ishlarni 2 baravar tezroq bajarish. Amaliy kurs.";
const questions = [
  { q: "Raycast asosan nima uchun ishlatiladi?", opts: ["Ilovalarni tez ochish, fayl qidirish va vazifalarni bajarish", "Faqat o'yin o'ynash", "Rasm chizish", "Musiqa tinglash"], answer: 0 },
  { q: "Clipboard History nima qiladi?", opts: ["Oldingi nusxalangan matnlarni ko'rsatadi va qayta joylashtiradi", "Faylni o'chiradi", "Internetni tezlashtiradi", "Batareyani tejaydi"], answer: 0 },
  { q: "Spotlight va Raycast farqi nima?", opts: ["Raycast kengaytiriladigan (extension'li), Spotlight asosan qidiruv", "Farqi umuman yo'q", "Raycast faqat Windows uchun", "Spotlight pullik"], answer: 0 }
];
---

<Base title={title} description={description}>
  <CourseProgress courseId="mac-tezlik-sirlari" title="Mac'da Tezlik Sirlari progressi" itemSelector=".modules > li" labelSelector="ol.modules" />
  <CourseSchema name={title} description={description} />

<article class="lesson">
  <div class="course-hero">
    <h1>Mac'da Tezlik Sirlari</h1>
    <div class="price">
      <span class="now">$15</span>
      <span class="uzs">≈ 190 000 so'm</span>
      <span class="badge badge-cert">Sertifikat</span>
    </div>
  </div>

  <p class="lead">
    <span data-i18n="mt.lead1">MacBook'dan faqat "foydalanish" yetarli emas — uni</span> <b data-i18n="mt.leadBold">tez va samarali</b> <span data-i18n="mt.lead2">ishlatish ko'nikmasi kunlik vaqtingizning soatlarini tejashi mumkin. Bu amaliy kursta Raycast, klaviatura shortcut'lari va boshqa Mac vositalari orqali kundalik ishlarni qanday tezlashtirishni o'rganasiz.</span>
  </p>

  <section class="shortcut-lab" aria-labelledby="shortcut-lab-title">
    <div><span>TEZKOR AMALIYOT</span><h2 id="shortcut-lab-title">Shortcut'ni tanlang</h2><p>Kartochkani bosing — qaysi tezkor ish uchun ishlatilishini ko'ring.</p></div>
    <div class="shortcut-grid" role="list">
      <button type="button" class="shortcut-card is-active" role="listitem" data-shortcut="search"><kbd>⌘</kbd><b>+</b><kbd>Space</kbd><strong>Qidirish</strong></button>
      <button type="button" class="shortcut-card" role="listitem" data-shortcut="switch"><kbd>⌘</kbd><b>+</b><kbd>Tab</kbd><strong>Almashtirish</strong></button>
      <button type="button" class="shortcut-card" role="listitem" data-shortcut="close"><kbd>⌘</kbd><b>+</b><kbd>W</kbd><strong>Yopish</strong></button>
      <button type="button" class="shortcut-card" role="listitem" data-shortcut="windows"><kbd>⌘</kbd><b>+</b><kbd>`</kbd><strong>Oynalar</strong></button>
    </div>
    <div class="shortcut-output" aria-live="polite"><span aria-hidden="true">⌘</span><p data-shortcut-output><b>Cmd + Space</b> — Raycast yoki Spotlight oynasini ochib, ilova va fayllarni tez topish uchun.</p></div>
  </section>

  <div style="background:var(--accent-soft);border:1px solid var(--accent);border-left:4px solid var(--accent);border-radius:12px;padding:14px 16px;margin:1.5rem 0;font-size:0.95rem;">
    Bu kurs <b>macOS (MacBook)</b> foydalanuvchilari uchun. Ko'p misollar Raycast'dan
    foydalanadi — u bepul ham, Pro versiyasi ham mavjud. Asosiy tezlik sirlari bepul
    qismida ham to'liq ishlaydi.
  </div>

  <section>
    <h2 data-i18n="mt.modules">Kurs modullari</h2>
    <ol class="modules">
      <li data-i18n="mt.mod1">Raycast asoslari — nima, Spotlight'dan farqi, o'rnatish va sozlash</li>
      <li data-i18n="mt.mod2">Foydali Raycast extension'lari — vaqtdan tejaydiganlar ro'yxati</li>
      <li data-i18n="mt.mod3">Shaxsiy workflow misollari — ilovalni ochish, fayl qidirish, shablonlar</li>
      <li data-i18n="mt.mod4">Boshqa Mac tezlik vositalari — shortcut'lar, Spotlight, Automator/Shortcuts</li>
      <li data-i18n="mt.mod5">Natija: nima uchun bu muhim — real vaqt tejash misoli</li>
      <li>Tavsiya etilgan Raycast extension'lari (audit asosida)</li>
      <li>8GB RAM / M2 Pro uchun eslatma</li>
      <li>Telegram Bot — Macbook Assistant ko'prigi</li>
    </ol>
  </section>

  <section>
    <h2>1. Raycast asoslari</h2>
    <p>
      <b>Raycast</b> — macOS uchun "launcher" (ishga tushiruvchi). Bitta tugma bilan
      ilovalni ochish, fayllarni topish, hisoblash, matn konvertatsiya qilish va
      boshqa ko'plab narsalarni bajarish mumkin.
    </p>
    <p>
      <b>Spotlight'dan farqi:</b> Spotlight asosan qidiruv vositasi. Raycast esa
      <b>kengaytiriladigan</b> — ya'ni "extension"lar orqali har qanday vazifani
      (clipboard tarixi, snippet'lar, oyna boshqaruvi) bitta joydan bajarish mumkin.
      Tezroq va kuchliroq.
    </p>

    <h3>O'rnatish va sozlash — qadam-baqadam</h3>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">1. Brauzerda <code>raycast.com</code> oching.</div>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">2. "Download" tugmasini bosing va faylni yuklab oling.</div>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">3. Yuklangan <code>.dmg</code> faylni oching, Raycast'ni <b>Applications</b> papkasiga sudrab qo'ying.</div>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">4. Raycast'ni ishga tushiring. <b>Cmd + Space</b> bosib, qidiruv oynasi ochilishini tekshiring.</div>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">5. Raycast ichida <b>Settings → Extensions</b> bo'limidan kerakli extension'larni qo'shing.</div>

    <div style="border:2px dashed var(--border);border-radius:10px;padding:28px;text-align:center;color:var(--muted);font-size:0.9rem;margin:1rem 0;">GIF / skrinshot joyi — Raycast o'rnatish jarayoni (keyinroq qo'shiladi)</div>
  </section>

  <section>
    <h2>2. Foydali Raycast extension'lari</h2>
    <p>Eng ko'p vaqt tejaydigan extension'lar (barchasi bepul asosida mavjud):</p>
    <ul>
      <li><b>Clipboard History</b> — oldingi nusxalangan matnlaringizni saqlaydi; kerakli paytda qayta joylashtirasiz (Ctrl/Cmd bilan aylanish).</li>
      <li><b>Window Management</b> — oynani yarim ekranga, chorak ekranga joylashtirish (mishka bilan sudrab emas, bitta tugma bilan).</li>
      <li><b>Snippets</b> — tez-tez yozadigan matn shablonlari (manzil, standart email javobi). Kalit so'z yozib darhol joylashtirasiz.</li>
      <li><b>Calculator</b> — qidiruv oynasiga son yozing, natija paydo bo'ladi (aloqador ilova ochish shart emas).</li>
      <li><b>1Password / Clipboard / Finder</b> integratsiyalari — parol, fayl va boshqalarni tez topish.</li>
    </ul>

    <h3>Clipboard History — qadam-baqadam</h3>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">1. <b>Cmd + Space</b> bosing (Raycast oynasi ochiladi).</div>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">2. "Clipboard" yozing va Enter bosing.</div>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">3. Ro'yxatdan kerakli nusxalangan matnni tanlang — u avtomatik joylashadi.</div>

    <div style="border:2px dashed var(--border);border-radius:10px;padding:28px;text-align:center;color:var(--muted);font-size:0.9rem;margin:1rem 0;">GIF / skrinshot joyi — Clipboard History ishlatish (keyinroq qo'shiladi)</div>
  </section>

  <section>
    <h2>3. Shaxsiy workflow misollari</h2>
    <p>Raycast orqali kundalik ishlarni qanday tezlashtirish mumkin — amaliy misollar:</p>
    <ul>
      <li><b>Ilovalarni tez ochish:</b> <b>Cmd + Space</b> → "Chrome" yozing → Enter. Dock yoki Launchpad'dan qidirish o'rniga 2 soniya.</li>
      <li><b>Faylni topish:</b> <b>Cmd + Space</b> → fayl nomini yozing → to'g'ridan-to'g'ri oching (Finder'da katalog bo'ylab yurish shart emas).</li>
      <li><b>Matn shablonlari:</b> Snippets'da "addr" kalit so'zini "To'liq manzil matni" ga bog'lang; "addr" yozib Enter bosing — butun manzil joylashadi.</li>
    </ul>

    <h3>Snippet yaratish — qadam-baqadam</h3>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">1. <b>Cmd + Space</b> → "Snippets" yozing → Enter.</div>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">2. "Create Snippet" tanlang, kalit so'z (masalan <code>addr</code>) va matnni kiriting.</div>
    <div style="border-left:3px solid var(--accent);padding:10px 14px;margin:8px 0;background:var(--surface);border-radius:8px;">3. Saqlang. Endi istalgan joyda <code>addr</code> yozing va Raycast taklifini tanlang.</div>

    <div style="border:2px dashed var(--border);border-radius:10px;padding:28px;text-align:center;color:var(--muted);font-size:0.9rem;margin:1rem 0;">GIF / skrinshot joyi — snippet joylashtirish (keyinroq qo'shiladi)</div>
  </section>

  <section>
    <h2>4. Boshqa Mac tezlik vositalari</h2>
    <p>Raycast'dan tashqari, Mac'da tayyor mavjud vositalar:</p>
    <ul>
      <li><b>Klaviatura shortcut'lari:</b> <code>Cmd + C / V</code> (nusxa/joylash), <code>Cmd + Tab</code> (ilovelar orasida o'tish), <code>Cmd + W</code> (oynani yopish), <code>Cmd + \`</code> (bitta ilovaning oynalari orasida).</li>
      <li><b>Spotlight:</b> <code>Cmd + Space</code> (agar Raycast o'rnatilmagan bo'lsa) — fayl va ilovalni tez topish.</li>
      <li><b>Automator / Shortcuts:</b> qayta-qayta qiladigan vazifalarni avtomatlashtirish (masalan, faylni boshqa formatga o'tkazish, papkaga saralash).</li>
    </ul>
    <p class="quiz-hint">
      Maslahat: bir shortcut'ni har kuni 10 marta ishlatsangiz, bir oyda ancha vaqt tejashadi.
      Avval eng ko'p ishlatadigan 3 ta shortcut'ni o'rganing.
    </p>
  </section>

  <section>
    <h2>5. Natija: nima uchun bu muhim</h2>
    <p>
      Kichik odatlar katta farq qiladi. Real misol:
    </p>
    <div style="background:color-mix(in srgb,#34d399 12%,transparent);border:1px solid #34d399;border-radius:12px;padding:16px 18px;margin:1rem 0;">
      Kuniga <b>10 marta</b> ilovani Dock yoki Launchpad'dan qidirib topish o'rniga,
      Raycast bilan <b>2 soniyada</b> ochasiz. Har bir qidiruv taxminan 8–10 soniya oladi.
      <br><br>
      <b>Hisob:</b> 10 × 8 soniya = 80 soniya/kun ≈ 1,3 daqiqa/kun → ~40 daqiqa/oy →
      <b>yilda taxminan 8 soat</b> tejash. Faqat bitta odat bilan.
    </div>
    <p>
      Bu — faqat ilova ochish. Clipboard tarixi, snippet'lar va oyna boshqaruvi qo'shilsa,
      tejalgan vaqt bir necha barobar ortadi. <b>Tezlik — vaqt, vaqt esa eng qimmat resurs.</b>
    </p>
  </section>

  <section style="margin-top:3rem;">
    <h2>6. Tavsiya etilgan Raycast extension'lari (audit asosida)</h2>
    <p>
      71 ta o'rnatilgan extension tekshirilib, vault mavzulariga (IELTS, Obsidian,
      AutoCAD, universitet) eng mos keladiganlari ajratildi. Eng foydalilari:
    </p>
    <div style="overflow:auto;border:1px solid var(--border);border-radius:12px;margin:1rem 0;">
      <table style="width:100%;border-collapse:collapse;font-size:0.92rem;">
        <thead>
          <tr style="background:var(--surface);">
            <th style="text-align:left;padding:10px 12px;border-bottom:1px solid var(--border);">Extension</th>
            <th style="text-align:left;padding:10px 12px;border-bottom:1px solid var(--border);">Nima uchun foydali</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>Obsidian</b></td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">Vault bilan ishlash — nota qidirish, yangi note, daily note, vault ochish (ENG MUHIM)</td></tr>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>GitHub</b></td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">Issue / PR / repo qidirish, notification'lar</td></tr>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>Google Translate</b></td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">So'z / jumlalarni bir zumda tarjima qilish (IELTS uchun asosiy)</td></tr>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>Visual Studio Code</b></td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">CAD skriptlari va LaTeX/hesob fayllarini ochish</td></tr>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>ChatGPT</b> ⚠️</td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">Savol berish, matnni qayta ishlash — OpenAI API kaliti talab qiladi</td></tr>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>Notion</b></td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">Zahira sahifalarni tez qidirish / yaratish</td></tr>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>Linear</b></td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">Vazifa / issue kuzatuvi (admissions bosqichlari)</td></tr>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>Spotify Player</b></td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">O'qish vaqtida musiqa boshqaruvi</td></tr>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>Color Picker</b></td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">Ekrandagi ranglarni olish (AutoCAD/BIM uchun)</td></tr>
          <tr><td style="padding:10px 12px;border-bottom:1px solid var(--border);"><b>Kill Process</b></td><td style="padding:10px 12px;border-bottom:1px solid var(--border);">AutoCAD "osilib" qolganda jarayonni tez to'xtatish</td></tr>
        </tbody>
      </table>
    </div>
    <div style="background:color-mix(in srgb,#ef4444 10%,transparent);border:1px solid #ef4444;border-radius:12px;padding:14px 16px;margin:1rem 0;">
      <strong style="color:#ef4444;">Parol uchun:</strong> 1Password kabi 3-partiya parol
      menejeri tavsiya etilmaydi — parollar uchun faqat <b>Apple Passwords</b> ishlatiladi.
    </div>

    <h3>Raycast'ning o'zidagi bepul core feature'lar (eng katta yengillik)</h3>
    <p>
      Bular qo'shimcha extension xotirasini olmaydi, ilovalar bilan dublikat emas:
    </p>
    <ul>
      <li><b>Snippets</b> — IELTS shablon jumlalari / prompt template'larini saqlash.</li>
      <li><b>Clipboard History</b> — tarjima qilingan vocab'ni pin qilish.</li>
      <li><b>Quicklinks</b> — vault MOC'lariga va universitet portaliga bir zumda havola.</li>
      <li><b>Window Management</b> — "AutoCAD + Obsidian" yonma-yon hotkey.</li>
      <li><b>Calculator</b> — calculus / GPA hisoblash (kalkulyator ilovasiz).</li>
      <li><b>Calendar</b> — ariza muddatlari (deadline) eslatmasi.</li>
    </ul>
  </section>

  <section style="margin-top:3rem;">
    <h2>7. 8GB RAM / M2 Pro uchun eslatma</h2>
    <div style="background:var(--accent-soft);border:1px solid var(--accent);border-left:4px solid var(--accent);border-radius:12px;padding:14px 16px;margin:1rem 0;">
      <b>Cheklov:</b> MacBook M2 Pro, 8GB RAM / 256GB SSD — faqat yengil, fonda
      og'ir ishlamaydigan extension'lar. Resurs cheklangan, shuning uchun ortiqcha
      yuklamaslik kerak.
    </div>
    <ul>
      <li>Allaqachon bor (takrorlanmaydi): Macs Fan Control, Stats, Cursor, Google Antigravity, Claude, Gemini, Apple Passwords, Obsidian.</li>
      <li>AI/kod uchun 6+ ilova bor → yangi AI extension tavsiya qilinmaydi.</li>
      <li>Monitoring uchun Stats bor → yangi monitoring extension tavsiya qilinmaydi.</li>
      <li>Eng muhim yangi, yengil extension'lar: <b>Obsidian</b> (fonda daemon yo'q, faqat chaqirilganda ishlaydi) va <b>Can I Use</b> (statik veb-texnologiya ma'lumotnomasi).</li>
      <li>Parol uchun faqat <b>Apple Passwords</b> → hech qanday 3-partiya parol menejeri (1Password ham) tavsiya qilinmaydi.</li>
    </ul>
  </section>

  <section style="margin-top:3rem;">
    <h2>8. Telegram Bot — Macbook Assistant ko'prigi</h2>
    <p>
      Telefondan yoki Telegram web'dan shaxsiy <b>assistant'ingizga</b> to'g'ridan-to'g'ri
      buyruq berish, xabar / rasm / PDF / ovoz yuborish va hammasini avtomatik ravishda
      <b>Obsidian'ga saqlash</b> imkonini beruvchi "remote control" ko'prik. Bu — kursning
      eng amaliy tezlik vositasi: kompyuteringiz yonida bo'lmasangiz ham, buyruq berib,
      natijani qaytarib olasiz.
    </p>
    <h3>Arxitektura</h3>
    <ul>
      <li><b>Siz</b> → Telegram → <b>bot</b> → <b>ngrok tunnel</b> → webhook server (localhost:8080) → <b>Groq</b> (Llama 3.3 70B) → javob qaytadi.</li>
      <li>Webhook server — aiohttp asosida, so'nggi 8 xabar tarixini eslab qoladi.</li>
      <li>Saqlash joyi — Obsidian vault'ingizdagi <code>00.Inbox/</code> papkasi (rasmlar va fayllar <code>.attachments/</code> ga, qabul qilingan ma'lumotlar <code>*.md</code> ga).</li>
    </ul>
    <p class="quiz-hint">
      Bot — bu faqat "trubka" (pipe); haqiqiy "miya" alohida ishlaydi. Shuning uchun
      real-time javob uchun assistant ochiq bo'lishi kerak. Telegram Bot API'ning o'zida
      LLM yo'q.
    </p>
    <h3>Foydali CLI buyruqlari</h3>
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px;overflow:auto;"><code># Holat ko'rish
python3 .telegram/telegram_bot.py status

# Yangi xabarlarni ko'rish (offset saqlamasdan)
python3 .telegram/telegram_bot.py peek

# Fonda tinglash (real-time polling)
python3 .telegram/telegram_bot.py daemon

# Bitta xabar yuborish (o'z chat_id'ingizga)
python3 .telegram/telegram_bot.py send &lt;chat_id&gt; "&lt;matn&gt;"

# Bitta media yuklash
python3 .telegram/telegram_bot.py attach &lt;update_id&gt;</code></pre>
    <div style="background:color-mix(in srgb,#34d399 12%,transparent);border:1px solid #34d399;border-radius:12px;padding:14px 16px;margin:1rem 0;">
      <strong style="color:#34d399;">Natija:</strong> telefondan yozganingiz — darhol
      Macbook'dagi assistant'ga boradi va Obsidian'ga saqlanadi. Sayt linkini ham
      shu bot orqali o'zingizga yuborish mumkin.
    </div>
  </section>

  <section class="performance-bonus" aria-labelledby="performance-bonus-title">
    <div class="performance-bonus__head">
      <div><p class="performance-bonus__eyebrow">🎁 BONUS</p><h2 id="performance-bonus-title">AI orqali kompyuter tezligini xavfsiz diagnostika qilish</h2></div>
      <button class="performance-copy" id="performanceCopy" type="button">Nusxalash</button>
    </div>
    <p>MacBook sekinlashib qoldimi? Joy to'lib qolyaptimi? Quyidagi promptni ChatGPT, Claude yoki boshqa AI yordamchiga (terminal/kod ishga tushirish imkoniyati bo'lgan) bering — u avval faqat diagnostika qiladi, hech narsani sizning tasdig'ingizsiz o'chirmaydi.</p>
    <pre class="performance-prompt"><code id="performancePrompt">Vazifa: MacBook'ning ishlash tezligini (performance) xavfsiz tarzda diagnostika qil va optimallashtir.

Qadam 1: Diagnostika (hech narsani o'zgartirmasdan)
Avval quyidagilarni tekshir va menga hisobot ber:
- CPU va xotira (RAM) yuklamasini (Activity Monitor orqali yoki top/ps buyrug'i bilan) — eng ko'p resurs yeyayotgan 5-10 ta jarayonni ko'rsat
- Disk bo'sh joyi qancha qolgan (df -h)
- Login items — Mac yoqilganda avtomatik ishga tushadigan dasturlar ro'yxati
- Background/xizmat jarayonlari (launch agents/daemons) — qanchasi keraksiz bo'lishi mumkin
- Xotira siqilishi (memory pressure) holati
- macOS versiyasi va oxirgi yangilanish sanasi

Qadam 2: Tavsiyalar (hali hech narsa o'chirmasdan)
Diagnostika natijasiga asoslanib:
- Qaysi dasturlar/jarayonlar ko'p resurs yeyayotganini va nima uchun ekanini tushuntir
- Qaysi login items'ni o'chirish xavfsiz ekanini ko'rsat
- Disk tozalash kerak bo'lsa, qaysi papkalar/keshlar xavfsiz o'chirilishi mumkinligini ayt (masalan Xcode derived data, brew cache, npm cache va h.k.)
- Har bir tavsiya uchun taxminiy qanday foyda berishini yoz (masalan "bu 2GB RAM bo'shatadi")

Qadam 3: Amalga oshirish (FAQAT tasdiqdan keyin)
- Hech qanday faylni o'chirish, dasturni o'rnatish/o'chirish, yoki tizim sozlamasini o'zgartirishdan OLDIN ro'yxat ko'rsat va tasdiq so'ra
- Har bir amaldan keyin nima qilinganini aniq yoz
- Muhim tizim fayllariga yoki foydalanuvchi hujjatlariga (Documents, Desktop, Downloads ichidagi shaxsiy fayllarga) TEGMA — faqat kesh, vaqtinchalik fayllar va tasdiqlangan keraksiz dasturlar bilan ishla

Muhim: hech qachon sudo rm -rf kabi keng qamrovli o'chirish buyruqlarini ishlatma. Har doim aniq, tor maqsadli buyruqlardan foydalan.</code></pre>

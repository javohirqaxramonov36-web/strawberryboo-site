---
import Base from "../../layouts/Base.astro";
const title = "Computer Literacy — Raqamli savodxonlik | Tayanch";
const description = "Microsoft Office (Word, Excel, PowerPoint) va Google Workspace (Docs, Sheets, Slides) asoslari — zamonaviy muhandislik va ta'lim uchun amaliy raqamli ko'nikmalar.";
---

<Base title={title} description={description}>

<article class="lesson">
  <div class="course-hero">
    <h1>Computer Literacy — Raqamli savodxonlik</h1>
    <div class="price">
      <span class="now">$24</span>
      <span class="badge badge-new">Yangi</span>
      <span class="badge badge-cert">Sertifikat</span>
      <span class="uzs">≈ 300 000 so'm · material to'ldirilmoqda</span>
    </div>
  </div>

  <p class="lead">
    Microsoft Office va Google Workspace — har qanday talaba va muhandis uchun
    asosiy ish qurollari. Bu kursda ularni amalda qanday ishlatishni o'rganasiz:
    hujjat, jadval va taqdimotlarni tez va sifatli tayyorlash.
  </p>

  <section>
    <h2>Nega Computer Literacy kerak?</h2>
    <p>
      Zamonaviy dunyoda kompyuter savodxonligi — bu shunchaki kompyuterni yoqish
      emas, balki ma'lumotni samarali ishlab chiqarish, tartibga solish va taqdim
      etish ko'nikmasidir. Muhandislikda ham, ta'limda ham asosiy ish jarayoni
      raqamli vositalarsiz tasavvur qilib bo'lmaydi: hisobotlar, loyiha
      hujjatlari, jadvallar va prezentatsiyalar aynan Word, Excel va PowerPoint
      kabi dasturlarda yaratiladi. Google Workspace esa jamoa bilan masofaviy
      ishlash, hujjatlarni real vaqtda birgalikda tahrirlash va bulutda saqlash
      imkonini beradi.
    </p>
    <p>
      Talaba bo'lsangiz, kurs ishlari, referatlar va prezentatsiyalarni tez va
      sifatli tayyorlash baholaringizga bevosita ta'sir qiladi. Muhandis
      bo'lsangiz, Excel'dagi oddiy formuladan tortib, PowerPoint'dagi loyiha
      himoyasigacha bo'lgan har bir qadam karyerangizda farq qiladi. Raqamli
      savodxonlik — bu "qo'shimcha" emas, zamonaviy kasbning ajralmas qismi.
      Uni egallab, vaqtingizni texnikaga emas, fikrlashga sarflaysiz.
    </p>
  </section>

  <section>
    <h2>Kurs modullari</h2>
    <ol class="modules">
      <li><strong>1-modul: Microsoft Office</strong> — Word, Excel, PowerPoint asoslari</li>
      <li><strong>2-modul: Google Workspace</strong> — Docs, Sheets, Slides asoslari</li>
    </ol>
  </section>

  <section>
    <h2>1-modul: Microsoft Office</h2>
    <p class="quiz-hint">Struktura tayyor — kontent keyinroq to'ldiriladi.</p>
    <ol class="modules">
      <li>Word — hujjat yaratish, saqlash va formatlash asoslari</li>
      <li>Word — sarlavhalar, ro'yxatlar, jadval va rasm joylashtirish</li>
      <li>Excel — kataklar, formulalar va eng kerakli funksiyalar</li>
      <li>Excel — diagrammalar va ma'lumotlarni vizualizatsiya</li>
      <li>PowerPoint — taqdimot yaratish va dizayn qoidalari</li>
    </ol>
  </section>

  <section>
    <h2>2-modul: Google Workspace</h2>
    <p class="quiz-hint">Struktura tayyor — kontent keyinroq to'ldiriladi.</p>
    <ol class="modules">
      <li>Google Docs — hujjatlarni bulutda yaratish va birgalikda tahrirlash</li>
      <li>Google Sheets — jadvallar va formulalar (Excel onlayn alternativi)</li>
      <li>Google Slides — onlayn taqdimotlar tayyorlash</li>
      <li>Google Drive — fayllarni saqlash, tartibga solish va ulashish</li>
    </ol>
  </section>

  <a href={import.meta.env.BASE_URL + 'kurslar'} class="course-nav-link" style="margin-top:2rem;">← Barcha kurslar</a>
</article>
</Base>

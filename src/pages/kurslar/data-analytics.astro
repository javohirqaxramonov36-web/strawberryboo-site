---
import Base from "../../layouts/Base.astro";
import CourseProgress from "../../components/CourseProgress.astro";
import PaymentInstructions from "../../components/PaymentInstructions.astro";
import CourseSchema from "../../components/CourseSchema.astro";
import Quiz from "../../components/Quiz.astro";
const title = "Data Analytics — Ma'lumotlar tahlili kursi | Tayanch";
const description = "Ma'lumotlar tahlili kursi: Excel'dan SQL va Python (pandas) gacha. Ma'lumotlarni tahlil qilish, vizualizatsiya qilish va qaror qabul qilishni o'zbekcha o'rganing.";
const questions = [
  { q: "Data Analytics asosan nima bilan shug'ullanadi?", opts: ["Ma'lumotlarni tahlil qilish va xulosa chiqarish", "Rasm chizish", "Musiqa yozish", "Pochta jo'natish"], answer: 0 },
  { q: "Qaysi vosita ma'lumotlar bazasidan so'rov olish uchun ishlatiladi?", opts: ["Excel", "SQL", "Word", "PowerPoint"], answer: 1 },
  { q: "Python'da ma'lumototlar bilan ishlash uchun qaysi kutubxona ko'p ishlatiladi?", opts: ["pandas", "Photoshop", "Excel", "Figma"], answer: 0 }
];
---

<Base title={title} description={description}>
  <CourseProgress courseId="data-analytics" title="Data Analytics progressi" itemSelector=".course-modules > li" />
  <CourseSchema name={title} description={description} />

  <article class="lesson">
    <div class="course-hero">
      <p class="hero-meta"><span class="cat-pill">AI · Data</span> · <span>Sertifikat bilan</span> · <span class="new-tag">Yangi</span></p>
      <h1>Data Analytics — Ma'lumotlar tahlili</h1>
      <div class="price">
        <span class="now">Tez orada</span>
        <span class="uzs">Narx belgilanmoqda</span>
      </div>
    </div>

    <p class="lead">
      Excel'dan SQL va Python'gacha — ma'lumotlarni tahlil qilish, vizualizatsiya qilish va ular asosida
      qaror qabul qilishni o'rganasiz. Real case-study orqali sotuv ma'lumotlarini tahlil qilasiz.
      Kimga mo'ljallangan: raqamlar bilan ishlaydigan, lekin dasturlashdan boshlamoqchi bo'lmaganlarga —
      marketolog, menejer, talaba va freelancer'larga.
    </p>

    <section class="modules-section">
      <div class="modules-head"><div><span>KURSLAR BO'LIMLARI</span><h2>Dastur</h2><p>Amaliy, bosqichma-bosil — boshlang'ich saviyadan real tahlilgacha.</p></div><span class="modules-count">6 bo'lim</span></div>
      <ol class="course-modules">
        <li><b>Kirish:</b> nima uchun data analytics kerak va qayerda qo'llaniladi — biznes, ilm-fan, marketinq.</li>
        <li><b>Excel / Google Sheets:</b> formulalar, filtrlar, pivot jadvallar bilan tez tahlil.</li>
        <li><b>SQL asoslari:</b> ma'lumotlar bazasidan so'rov yozish va kerakli ma'lumotni ajratib olish.</li>
        <li><b>Python va pandas:</b> ma'lumotlarni yuklash, tozalash va tayyorlash.</li>
        <li><b>Vizualizatsiya:</b> diagrammalar va sodda dashboard orqali natijani ko'rsatish.</li>
        <li><b>Real case-study:</b> sotuv ma'lumotlarini tahlil qilish va boshqaruvga tavsiya tayyorlash.</li>
      </ol>
    </section>

    <p style="margin-top:2rem;">
      <a href={import.meta.env.BASE_URL + 'kurslar'} class="course-nav-link">← Barcha kurslar</a>
    </p>

    <Quiz title="O'z bilimingizni tekshiring" questions={questions} />
    <PaymentInstructions course="Data Analytics — Ma'lumotlar tahlili" price="TBD · tez orada belgilanadi" />
  </article>

  <style>
    .hero-meta{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin:0 0 .6rem;color:var(--muted);font-size:.85rem}
    .cat-pill{padding:.25rem .6rem;border:1px solid var(--accent);border-radius:999px;color:var(--accent);font-weight:700;font-size:.76rem}
    .new-tag{color:#34d399;font-weight:700}
    .modules-section{padding:clamp(1.1rem,3vw,1.65rem);border:1px solid color-mix(in srgb,#0ea5e9 43%,var(--border));border-radius:18px;background:linear-gradient(135deg,color-mix(in srgb,#0ea5e9 10%,var(--surface)),var(--surface))}
    .modules-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}
    .modules-head>div>span{font-size:.72rem;letter-spacing:.12em;font-weight:800;color:#38bdf8}
    .modules-head h2{margin:.25rem 0 .4rem}
    .modules-head p{margin:0;color:var(--muted)}
    .modules-count{white-space:nowrap;padding:.45rem .65rem;border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:.78rem}
    .course-modules{list-style:none;counter-reset:m;margin:1.2rem 0 0;padding:0;display:grid;gap:.6rem}
    .course-modules li{counter-increment:m;display:flex;gap:.8rem;align-items:flex-start;padding:.85rem 1rem;border:1px solid var(--border);border-radius:12px;background:color-mix(in srgb,var(--accent) 6%,var(--surface));line-height:1.5}
    .course-modules li::before{content:counter(m);flex:0 0 1.6rem;height:1.6rem;display:grid;place-items:center;border-radius:50%;background:var(--accent);color:#fff;font-weight:800;font-size:.85rem}
    .course-modules li b{color:var(--text)}
  </style>
</Base>

---
import Base from "../../layouts/Base.astro";
import TelegramCTA from "../../components/TelegramCTA.astro";
import Quiz from "../../components/Quiz.astro";
const title = "Tekin AI modellar va agentlar — O'rganamiz";
const description = "MacBook'da o'rnatiladigan bepul AI vositalari ro'yxati va qo'llanma.";
const questions = [
  { q: "Ollama nima qiladi?", opts: ["Bulutli AI", "MacBook'da local AI model ishlatadi", "Pochta", "Rasm chizadi"], answer: 1 },
  { q: "Local (offline) AI ning afzalligi?", opts: ["Tezroq", "Ma'lumotlar kompyuteringizda qoladi", "Bepul emas", "Hech nima"], answer: 1 },
  { q: "CrewAI nima?", opts: ["O'yin", "Jamoa agent'lari framework'i", "Virus", "Pochta"], answer: 1 }
];
---

<Base title={title} description={description}>

<article class="lesson">
  <div class="course-hero">
    <h1>Tekin AI modellar va agentlar</h1>
    <div class="price">
      <span class="now">$0</span>
      <span class="badge badge-free">Bepul</span>
    </div>
  </div>

  <p class="lead" data-i18n="ta.lead">
    Pul sarflamasdan, o'z MacBook'ingizda ishlaydigan AI vositalari.
    Hamma narsa offline (internet shimsiz) ishlaydi.
  </p>

  <section>
    <h2 data-i18n="ta.modules">Vositalar ro'yxati</h2>
    <ol class="modules">
      <li data-i18n="ta.mod1">Ollama — local AI model (llama3.2)</li>
      <li data-i18n="ta.mod2">CrewAI — jamoa agent'lari</li>
      <li data-i18n="ta.mod3">LangGraph — orchestration</li>
      <li data-i18n="ta.mod4">Letta / MemGPT — xotira</li>
      <li data-i18n="ta.mod5">Obsidian + Strawberryboo — capture</li>
      <li data-i18n="ta.mod6">Obsidian'dagi 17 ta AI agent haqida notalar</li>
    </ol>
  </section>

  <p style="margin-top:2rem;">
    <a href="/kurslar" class="enroll" data-i18n="ta.all">← Barcha kurslar</a>
  </p>

  <Quiz titleI18n="ta.quizTitle" questions={questions} />
</article>
<TelegramCTA />
</Base>

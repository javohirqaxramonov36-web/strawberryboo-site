  .src {
    font-size: .85rem;
    color: #7c6bb0;
    border-left: 3px solid #8b5cf6;
    padding: .4rem .75rem;
    margin: .5rem 0 1.25rem;
    background: rgba(139, 92, 246, .06);
  }
  .src a { color: #8b5cf6; text-decoration: underline; }
</style>
</Base>

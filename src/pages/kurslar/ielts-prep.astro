---
import Base from "../../layouts/Base.astro";
import TelegramCTA from "../../components/TelegramCTA.astro";
import Quiz from "../../components/Quiz.astro";

const title = "IELTS Prep — O'rganamiz";
const description = "IELTS Listening, Reading va Writing uchun shaxsiy strategiya tizimlari hamda amaliy mashqlar bo'limi.";
const questions = [
  { q: "Listening gap-filling savolida grammatik signal nima uchun kerak?", opts: ["Javob shaklini oldindan taxmin qilish uchun", "Audio tezligini oshirish uchun", "Savolni o'tkazib yuborish uchun", "Faqat imlo uchun"], answer: 0 },
  { q: "Reading savolida javob topilmasa nima qilish kerak?", opts: ["Bo'sh qoldirish", "Faqat Ctrl+F ishlatish", "Javobni darhol kiritib, yakuniy tekshiruvda ko'rish", "Testni to'xtatish"], answer: 2 },
  { q: "Hozir Writing nazariyasining shaxsiy asosiy qoidasi qaysi?", opts: ["Kirish qisqa, body 2 paragraf", "Har essay 5 body paragraf", "Faqat lug'at yozish", "Writing bo'limi yo'q"], answer: 0 }
];
---

<Base title={title} description={description}>
  <article class="lesson">
    <div class="course-hero">
      <h1>IELTS Prep</h1>
      <div class="price">
        <span class="now">$24</span>
        <span class="old">$39</span>
        <span class="badge badge-new">-38%</span>
        <span class="badge badge-cert">Sertifikat</span>
        <span class="uzs">≈ 300 000 so'm</span>
      </div>
    </div>

    <p class="lead">Bu kurs hozir uchta alohida sub-kursdan iborat: Listening, Reading va Writing. Har birida avval shaxsiy strategiya tizimi, keyin esa alohida Practice bo'limi bor.</p>

    <section>
      <h2>Sub-kurslar</h2>
      <div class="subcourse-nav" aria-label="IELTS sub-kurslari">
        <a href="#listening"><span>01</span><strong>IELTS Listening</strong><small>Strategiya + Practice</small></a>
        <a href="#reading"><span>02</span><strong>IELTS Reading</strong><small>Strategiya + Practice</small></a>
        <a href="#writing"><span>03</span><strong>IELTS Writing</strong><small>Strategiya + Practice</small></a>
      </div>
      <p class="course-note">Speaking hozircha ushbu kursga kiritilmagan. U alohida sub-kurs sifatida faqat keyin tasdiqlansa qo'shiladi.</p>
    </section>

    <section id="listening" class="subcourse">
      <p class="eyebrow">01 — SUB-KURS</p>
      <h2>IELTS Listening</h2>

      <h3>A. Nazariya / Strategiya</h3>
      <ul>
        <li><b>Bo'shliqdan oldingi grammatik signal:</b> form-completion javobida birlik/ko'plik va so'z turini oldindan tekshirish.</li>
        <li><b>Section 2 va Section 4 diqqat boshqaruvi:</b> bitta savolda qotib qolmasdan, keyingi savolga darhol o'tish va hech bir javobni bo'sh qoldirmaslik.</li>
        <li><b>Distractor hamda contrast signal so'zlari:</b> “although”, “but”, “however” kabi burilishlarni ajratish va tanish eshitilgan, ammo noto'g'ri variantga avtomatik ketmaslik.</li>
        <li><b>Map-question strategiyasi:</b> ushbu shaxsiy strategiya uchun kursda alohida joy ajratiladi; batafsil note topilmagani sabab aniq qadamlar keyin sizning manbangiz bilan to'ldiriladi.</li>
      </ul>
      <p class="src">Obsidian manbasi: <code>01.IELTS prep/Listening/2026-08-12-listening-test-5.md</code> · <code>01.IELTS prep/3.ielts/1.Reflection "Listening and Reading"/14-august.md</code></p>

      <h3>B. Practice (Mashq)</h3>
      <div class="practice-placeholder">Mashqlar tez orada qo'shiladi. Cambridge 16–21 kitoblaridan hech qanday test matni yoki savol ushbu sahifaga ko'chirilmagan.</div>
    </section>

    <section id="reading" class="subcourse">
      <p class="eyebrow">02 — SUB-KURS</p>
      <h2>IELTS Reading</h2>

      <h3>A. Nazariya / Strategiya</h3>
      <ul>
        <li><b>Skimming va scanning uchun ish oqimi:</b> savolning kalit so'zini ajratib, matndan ko'z bilan kerakli joyni topish; CD-IELTS sharoitida Ctrl+F'ga tayanmaslik.</li>
        <li><b>Vaqt va javobni boshqarish:</b> javobni test davomida bevosita kiritish, bo'sh qoldirmaslik va yakunda word-limit'ni tekshirish.</li>
        <li><b>Error-log asosidagi tekshiruv:</b> e'tiborsizlik, so'z chegarasi, T/F/NG va solishtirishdagi xatolarni alohida toifalab borish.</li>
        <li><b>Yakuniy nazorat:</b> “more/less” kabi qarama-qarshi ma'nolarni hamda ortiqcha article yoki hyphen kabi mayda xatolarni tekshirish.</li>
      </ul>
      <p class="src">Obsidian manbasi: <code>01.IELTS prep/5.Weekly Progress Tracker.md</code> · <code>01.IELTS prep/3.ielts/1.Reflection "Listening and Reading"/1.All in one Reflection "Listening and Reading".md</code></p>

      <h3>B. Practice (Mashq)</h3>
      <div class="practice-placeholder">Mashqlar tez orada qo'shiladi. Cambridge 16–21 kitoblaridan hech qanday test matni yoki savol ushbu sahifaga ko'chirilmagan.</div>
    </section>

    <section id="writing" class="subcourse">
      <p class="eyebrow">03 — SUB-KURS</p>
      <h2>IELTS Writing</h2>

      <h3>A. Nazariya / Strategiya</h3>
      <ul>
        <li><b>Task 2 asosiy framework:</b> introduction qisqa bo'lishi va asosiy fikrlar ikki body paragraph ichida izchil rivojlanishi.</li>
        <li><b>Daily writing ritmi:</b> Writing'ni Listening yoki Reading bilan parallel, muntazam blok sifatida rejalashtirish.</li>
        <li><b>Frameworkni kengaytirish:</b> hozirgi shaxsiy note faqat introduction va ikki body paragraph qoidasini qamrab oladi; keyingi qoidalar sizning Task 2 note'ingiz kengaytirilgach qo'shiladi.</li>
      </ul>
      <p class="src">Obsidian manbasi: <code>01.IELTS prep/2026-08-15-writing-intro-qoidasi.md</code> · <code>01.IELTS prep/5.Weekly Progress Tracker.md</code></p>

      <h3>B. Practice (Mashq)</h3>
      <div class="practice-placeholder">Mashqlar tez orada qo'shiladi. Cambridge 16–21 kitoblaridan hech qanday test matni yoki savol ushbu sahifaga ko'chirilmagan.</div>
    </section>

    <section>
      <h2>Haftalik review</h2>
      <p>Har bir sub-kursdagi xatolar va progress haftalik tracker orqali ko'rib chiqiladi. Maqsad ko'proq test yig'ish emas, takrorlanayotgan patternni topib, keyingi mashqni aynan o'sha patternga moslashdir.</p>
      <p class="src">Obsidian manbasi: <code>01.IELTS prep/5.Weekly Progress Tracker.md</code></p>
    </section>

    <a href="/bog-lanish" class="start-btn" style="margin-top:2rem;">Kursni sotib olish →</a>
    <a href="/kurslar" class="enroll" style="margin-left:1rem;">← Barcha kurslar</a>

    <Quiz title="O'z bilimingizni tekshiring" questions={questions} />
  </article>
  <TelegramCTA />

  <style>
    .subcourse-nav { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:.75rem; margin:1rem 0; }
    .subcourse-nav a { display:flex; flex-direction:column; gap:.35rem; padding:1rem; color:var(--text); text-decoration:none; border:1px solid var(--border); border-radius:12px; background:var(--surface); transition:transform .2s, border-color .2s; }
    .subcourse-nav a:hover { transform:translateY(-2px); border-color:var(--accent); }
    .subcourse-nav span, .eyebrow { color:var(--accent); font-size:.78rem; font-weight:700; letter-spacing:.08em; }
    .subcourse-nav small { color:var(--muted); }
    .course-note { color:var(--muted); font-size:.92rem; }
    .subcourse { scroll-margin-top:1.5rem; border-top:1px solid var(--border); padding-top:1.5rem; }
    .practice-placeholder { border:1px dashed var(--border); border-radius:10px; padding:1rem; color:var(--muted); background:rgba(125,125,245,.05); }
    .src { font-size:.85rem; color:#7c6bb0; border-left:3px solid #8b5cf6; padding:.4rem .75rem; margin:.75rem 0 1.25rem; background:rgba(139, 92, 246, .06); overflow-wrap:anywhere; }
    @media (max-width: 700px) { .subcourse-nav { grid-template-columns:1fr; } }
  </style>
</Base>

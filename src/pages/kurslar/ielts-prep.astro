---
import Base from "../../layouts/Base.astro";
import Quiz from "../../components/Quiz.astro";

const title = "IELTS Prep — Tayanch";
const description = "IELTS Listening, Reading va Writing uchun shaxsiy strategiya tizimlari hamda amaliy mashqlar bo'limi.";
const questions = [
  { q: "Listening gap-filling savolida grammatik signal nima uchun kerak?", opts: ["Javob shaklini oldindan taxmin qilish uchun", "Audio tezligini oshirish uchun", "Savolni o'tkazib yuborish uchun", "Faqat imlo uchun"], answer: 0 },
  { q: "Reading savolida javob topilmasa nima qilish kerak?", opts: ["Bo'sh qoldirish", "Faqat Ctrl+F ishlatish", "Javobni darhol kiritib, yakuniy tekshiruvda ko'rish", "Testni to'xtatish"], answer: 2 },
  { q: "Hozir Writing nazariyasining shaxsiy asosiy qoidasi qaysi?", opts: ["Kirish qisqa, body 2 paragraf", "Har essay 5 body paragraf", "Faqat lug'at yozish", "Writing bo'limi yo'q"], answer: 0 }
];
const base = import.meta.env.BASE_URL;
---

<Base title={title} description={description}>
  <article class="lesson">
    <div class="course-hero">
      <h1>IELTS Prep</h1>
      <div class="price">
        <span class="now">$24</span>
        <span class="old">$39</span>
        <span class="badge badge-new">-38%</span>
        <span class="badge badge-cert">Sertifikat</span>
        <span class="uzs">≈ 300 000 so'm</span>
      </div>
    </div>

    <p class="lead">Bu kurs to'rtta alohida sub-kursdan iborat: Listening, Reading, Writing va Speaking. Har birida Obsidian’dagi strategiya notalari asosida original darslar hamda amaliy mashqlar bor.</p>

    <section>
      <h2>Sub-kurslar</h2>
      <div class="subcourse-nav" aria-label="IELTS sub-kurslari">
        <a href="#listening"><span>01</span><strong>IELTS Listening</strong><small>Strategiya + Practice</small></a>
        <a href="#reading"><span>02</span><strong>IELTS Reading</strong><small>Strategiya + Practice</small></a>
        <a href="#writing"><span>03</span><strong>IELTS Writing</strong><small>Strategiya + Practice</small></a>
        <a href="#speaking"><span>04</span><strong>IELTS Speaking</strong><small>Strategiya + kunlik mashq</small></a>
      </div>
      <p class="course-note">Har sub-kursdagi darslar Obsidian’dagi shaxsiy o‘rganish notalaridan qayta tuzilgan; test matnlari yoki tashqi audio nusxalanmagan.</p>
    </section>

    <section id="listening" class="subcourse">
      <p class="eyebrow">01 — SUB-KURS</p>
      <h2>IELTS Listening</h2>

      <h3>A. Nazariya / Strategiya</h3>
      <ul>
        <li><b>Bo'shliqdan oldingi grammatik signal:</b> form-completion javobida birlik/ko'plik va so'z turini oldindan tekshirish.</li>
        <li><b>Section 2 va Section 4 diqqat boshqaruvi:</b> bitta savolda qotib qolmasdan, keyingi savolga darhol o'tish va hech bir javobni bo'sh qoldirmaslik.</li>
        <li><b>Distractor hamda contrast signal so'zlari:</b> “although”, “but”, “however” kabi burilishlarni ajratish va tanish eshitilgan, ammo noto'g'ri variantga avtomatik ketmaslik.</li>
        <li><b>Map-question strategiyasi:</b> ushbu shaxsiy strategiya uchun kursda alohida joy ajratiladi; batafsil note topilmagani sabab aniq qadamlar keyin sizning manbangiz bilan to'ldiriladi.</li>
      </ul>
      <p class="src">Obsidian manbasi: <code>01.IELTS prep/Listening/2026-08-12-listening-test-5.md</code> · <code>01.IELTS prep/3.ielts/1.Reflection "Listening and Reading"/14-august.md</code></p>

      <h3>B. Practice (Mashq)</h3>
      <div class="practice-card" id="listening-practice">
        <div class="practice-head"><div><span class="practice-tag">ORIGINAL MASHQ</span><h4>Section 2 — Riverside Community Day</h4></div><span class="skill-pill">Listening · 10 savol</span></div>
        <p>Bu mashq Tayanch uchun noldan yozilgan. U birlik/ko'plik, raqam, joy nomi va distractor'larni tekshiradi; Cambridge materialidan nusxa olinmagan.</p>
        <p class="practice-tip"><b>Ishlash tartibi:</b> “Audio”ni bir marta eshiting, bo'shliqlarni to'ldiring, keyin tekshiring. Audio brauzeringizning ovozli o'qish funksiyasidan foydalanadi.</p>
        <div class="practice-actions"><a class="practice-btn practice-launch" href={base + 'ielts-practice/listening/'}>⛶ To'liq ekran practice formatida ochish</a><button class="practice-btn" id="playListening" type="button">▶ Tez preview audio</button><button class="text-btn" id="showTranscript" type="button">Transcriptni keyin ko'rish</button></div>
        <div class="listen-form" aria-label="Listening form completion">
          <p><b>Riverside Community Day</b></p>
          <label>1. First meeting point: <input data-listen-answer="visitor centre" placeholder="1–2 so'z" /></label>
          <label>2. Guided walk starts at: <input data-listen-answer="10:15" placeholder="vaqt" /></label>
          <label>3. Bags can be left in the: <input data-listen-answer="lockers" placeholder="ko'plikka e'tibor" /></label>
          <label>4. The art activity is beside the old: <input data-listen-answer="sculptures" placeholder="ko'plikka e'tibor" /></label>
          <label>5. Children should cross the wooden: <input data-listen-answer="bridge" placeholder="1 so'z" /></label>
          <label>6. Free printed <input data-listen-answer="maps" placeholder="ko'plikka e'tibor" /> are available at the entrance.</label>
          <label>7. The photography talk lasts <input data-listen-answer="12" placeholder="raqam" /> minutes.</label>
          <label>8. The quiet area is near the herb: <input data-listen-answer="gardens" placeholder="ko'plikka e'tibor" /></label>
          <label>9. Lunch can be bought at the: <input data-listen-answer="cafe|café" placeholder="1 so'z" /></label>
          <label>10. The exit for buses is on the <input data-listen-answer="south" placeholder="yo'nalish" /> side.</label>
        </div>
        <button class="practice-btn secondary" id="checkListening" type="button">Javoblarni tekshirish</button><p class="practice-result" id="listeningResult" aria-live="polite"></p>
        <details id="transcriptBox"><summary>Transcript — faqat javobdan keyin oching</summary><p>Good morning, and welcome to Riverside Community Day. Please meet our volunteers at the visitor centre, not at the museum entrance as shown on an old poster. The guided walk begins at 10:15, after the safety briefing. You can leave large bags in the lockers beside reception. For the art activity, walk past the old sculptures, then turn left. Families going to the river area should cross the wooden bridge, not the metal gate. Free printed maps are available at the entrance. The photography talk lasts 12 minutes. If you need a quiet place, the herb gardens are behind the library. Lunch is sold at the cafe, and buses leave from the south side.</p></details>
      </div>
    </section>

    <section id="reading" class="subcourse">
      <p class="eyebrow">02 — SUB-KURS</p>
      <h2>IELTS Reading</h2>

      <h3>A. Nazariya / Strategiya</h3>
      <ul>
        <li><b>Skimming va scanning uchun ish oqimi:</b> savolning kalit so'zini ajratib, matndan ko'z bilan kerakli joyni topish; CD-IELTS sharoitida Ctrl+F'ga tayanmaslik.</li>
        <li><b>Vaqt va javobni boshqarish:</b> javobni test davomida bevosita kiritish, bo'sh qoldirmaslik va yakunda word-limit'ni tekshirish.</li>
        <li><b>Error-log asosidagi tekshiruv:</b> e'tiborsizlik, so'z chegarasi, T/F/NG va solishtirishdagi xatolarni alohida toifalab borish.</li>
        <li><b>Yakuniy nazorat:</b> “more/less” kabi qarama-qarshi ma'nolarni hamda ortiqcha article yoki hyphen kabi mayda xatolarni tekshirish.</li>
      </ul>
      <p class="src">Obsidian manbasi: <code>01.IELTS prep/5.Weekly Progress Tracker.md</code> · <code>01.IELTS prep/3.ielts/1.Reflection "Listening and Reading"/1.All in one Reflection "Listening and Reading".md</code></p>

      <h3>B. Practice (Mashq)</h3>
      <div class="practice-card" id="reading-practice">
        <div class="practice-head"><div><span class="practice-tag">ORIGINAL MASHQ</span><h4>Reading — Diqqat va word-limit drill</h4></div><span class="skill-pill">Reading · 6 savol</span></div>
        <p><b>Matn:</b> Eastfield Library changed its study-floor rules after a student survey. The library did not add more computers; instead, it moved several existing computers closer to natural light. Printed books remain on the ground floor, while group tables are now on the second floor. Students may reserve a silent desk one day in advance, but not for an entire week. The café has extended its opening hours until 7 p.m. on weekdays. The library will review the changes after three months.</p>
        <div class="reading-questions">
          <label>1. The library bought new computers. <select data-read-answer="false"><option value="">Tanlang</option><option value="true">TRUE</option><option value="false">FALSE</option><option value="not given">NOT GIVEN</option></select></label>
          <label>2. Group tables are on the ground floor. <select data-read-answer="false"><option value="">Tanlang</option><option value="true">TRUE</option><option value="false">FALSE</option><option value="not given">NOT GIVEN</option></select></label>
          <label>3. A silent desk can be reserved for seven days. <select data-read-answer="false"><option value="">Tanlang</option><option value="true">TRUE</option><option value="false">FALSE</option><option value="not given">NOT GIVEN</option></select></label>
          <label>4. The café is open later on weekdays. <select data-read-answer="true"><option value="">Tanlang</option><option value="true">TRUE</option><option value="false">FALSE</option><option value="not given">NOT GIVEN</option></select></label>
          <label>5. How many months later will the changes be reviewed? <input data-read-answer="three|3" placeholder="NO MORE THAN ONE WORD AND/OR A NUMBER" /></label>
          <label>6. Where are printed books kept? <input data-read-answer="ground floor|the ground floor" placeholder="NO MORE THAN TWO WORDS" /></label>
        </div>
        <a class="practice-btn practice-launch" href={base + 'ielts-practice/reading/'}>⛶ To'liq ekran Reading practice</a><button class="practice-btn secondary" id="checkReading" type="button">Javoblarni tekshirish</button><p class="practice-result" id="readingResult" aria-live="polite"></p>
      </div>
    </section>

    <section id="writing" class="subcourse">
      <p class="eyebrow">03 — SUB-KURS</p>
      <h2>IELTS Writing</h2>

      <h3>A. Nazariya / Strategiya</h3>
      <ul>
        <li><b>Task 2 asosiy framework:</b> introduction qisqa bo'lishi va asosiy fikrlar ikki body paragraph ichida izchil rivojlanishi.</li>
        <li><b>Daily writing ritmi:</b> Writing'ni Listening yoki Reading bilan parallel, muntazam blok sifatida rejalashtirish.</li>
        <li><b>Frameworkni kengaytirish:</b> hozirgi shaxsiy note faqat introduction va ikki body paragraph qoidasini qamrab oladi; keyingi qoidalar sizning Task 2 note'ingiz kengaytirilgach qo'shiladi.</li>
      </ul>
      <p class="src">Obsidian manbasi: <code>01.IELTS prep/2026-08-15-writing-intro-qoidasi.md</code> · <code>01.IELTS prep/5.Weekly Progress Tracker.md</code></p>

      <div class="strategy-grid">
        <article class="strategy-card"><span class="practice-tag">TASK 1 — INTRODUCTION</span><h3>Grafikning asosiy faktlarini aniq oching</h3><p>Kirishda grafik turi, nimani taqqoslayotgani, o'lchov yoki kategoriya, joy va vaqtni ajrating. Sabab, fikr yoki xulosani bu paragrafga qo'shmang.</p><ol><li>Avval promptdagi 5 faktni belgilang: visual turi, subyekt, o'lchov, joy, vaqt.</li><li>So'zlarni o'zgartiring, lekin qamrovni o'zgartirmang.</li><li>Yil, birlik yoki guruhni tashlab ketmaganingizni tekshiring.</li></ol><p class="strategy-task"><b>Mini-mashq:</b> o'zingiz yaratgan jadval yoki grafik uchun 1–2 gaplik introduction yozing; trendni hali sharhlamang.</p></article>
        <article class="strategy-card"><span class="practice-tag">TASK 2 — INTRODUCTION</span><h3>Context → muammo → pozitsiya zanjiri</h3><p>Fact-based mavzuda avval muammoni neytral kontekstga joylashtiring, so'ng savolga aniq javob beradigan tezis yozing. Introduction body paragraph'dagi barcha dalillarni oldindan sanab o'tmasin.</p><ol><li>Mavzuni bir jumlada umumiyroq kontekstga ulang.</li><li>Savol sizdan sabab, fikr yoki yechim so'rayotganini ajrating.</li><li>Pozitsiyangizni bitta boshqariladigan da'vo bilan yoping.</li></ol><p class="strategy-task"><b>Mini-mashq:</b> "Shaharlarga ko'chish" kabi mavzu uchun 2 jumlalik introduction yozing; keyin tezisingizni bitta aniq fikrga qisqartiring.</p></article>
      </div>
      <p class="src">Qo'shimcha Obsidian manbalari: <code>01.IELTS prep/2.2 writing task 1/1.Universal introduction/1.structure.md</code> · <code>01.IELTS prep/2.1 writing task 2/1.1 fact-based Introductions/1.intro structure/1.structure.md</code>. Original darsga aylantirildi; tashqi sample yoki test prompti ko'chirilmagan.</p>

      <h3>B. Practice (Mashq)</h3>
      <div class="practice-card" id="writing-practice">
        <div class="practice-head"><div><span class="practice-tag">AMALIY SHABLON</span><h4>Task 2 outline builder</h4></div><span class="skill-pill">Writing · self-review</span></div>
        <p>Shaxsiy framework asosida avval pozitsiyani aniqlang, keyin ikkita body paragraph uchun bitta-bittadan asosiy fikr yozing.</p>
        <a class="practice-btn practice-launch" href={base + 'ielts-practice/writing/'}>⛶ To'liq ekran Writing practice shabloni</a>
        <p class="practice-tip">Yangi Writing testlarda faqat original savol, kerak bo'lsa grafik va sample-answer bo'limlari almashtiriladi; interfeys bir xil qoladi.</p>
        <div class="outline-grid"><label>Mavzu / savol<textarea id="wTopic" rows="3" placeholder="Essay savolini o'zingiz yozing..."></textarea></label><label>Introduction — pozitsiyangiz<textarea id="wIntro" rows="3" placeholder="Qisqa: mavzuni qayta ayting va fikringizni bildiring."></textarea></label><label>Body 1 — asosiy fikr + misol<textarea id="wBody1" rows="4"></textarea></label><label>Body 2 — asosiy fikr + misol<textarea id="wBody2" rows="4"></textarea></label></div>
        <div class="checklist"><label><input type="checkbox" data-write-check /> Introduction qisqa va aniqmi?</label><label><input type="checkbox" data-write-check /> Ikkita body paragraph rejalashtirildimi?</label><label><input type="checkbox" data-write-check /> Har body'da sabab yoki misol bormi?</label><label><input type="checkbox" data-write-check /> Academic uslubdagi so'zlarni keyin o'zingiz tekshirasizmi?</label></div>
        <button class="practice-btn secondary" id="saveOutline" type="button">Outline'ni qurilmada saqlash</button><p class="practice-result" id="writingResult" aria-live="polite"></p>
      </div>
    </section>

    <section id="speaking" class="subcourse">
      <p class="eyebrow">04 — SUB-KURS</p>
      <h2>IELTS Speaking</h2>
      <p class="lead-small">Maqsad mukammal gapni kutish emas, fikrni aniq, tabiiy va sabab-misol bilan davom ettira olishdir. Quyidagi tizim Speaking uchun Obsidian’dagi strategiya va mashq kundaligidan original tarzda tuzildi.</p>
      <div class="strategy-grid">
        <article class="strategy-card"><span class="practice-tag">PART 1</span><h3>Qisqa, lekin to'liq javob bering</h3><p>Bir so'zli “yes/no” bilan to'xtamang. Javob + sabab yoki kichik misol yordamida 1–2 bog'langan gap tuzing.</p><p class="strategy-task"><b>Formula:</b> javob → sabab → kichik detail.</p></article>
        <article class="strategy-card"><span class="practice-tag">PART 2</span><h3>1 daqiqada gapirish xaritasini tuzing</h3><p>Tayyorlanish vaqtida to'liq matn yozmang. Who/what, where/when, why va feeling kabi 5 signal so'zni yozib, ular asosida 2 daqiqa gapiring.</p><p class="strategy-task"><b>Mini-mashq:</b> “Sizga yangi narsa o'rgatgan inson” haqida 5 bullet yozing va ovoz chiqarib 2 daqiqa gapiring.</p></article>
        <article class="strategy-card"><span class="practice-tag">PART 3</span><h3>Fikrni dalil va solishtirish bilan rivojlantiring</h3><p>Fikr bildiring, sabab bering, bir misol qo'shing. Kerak bo'lsa past va hozirni yoki ikki turli kontekstni solishtiring.</p><p class="strategy-task"><b>Formula:</b> fikrim → chunki → misol → solishtirish.</p></article>
        <article class="strategy-card"><span class="practice-tag">KUNLIK RITM</span><h3>15–20 daqiqalik Speaking sikli</h3><p>Har kuni 1 ta Part 1 mavzu, 1 ta cue card va 1 ta Part 3 muhokamani yozib oling. Keyin ravonlik, lug'at, grammatika va talaffuz bo'yicha bitta yaxshilash nuqtasini belgilang.</p><p class="strategy-task"><b>Bugungi mavzular:</b> Hometown · Studies · Hobbies · Technology · Travel.</p></article>
      </div>
      <p class="src">Obsidian manbasi: <code>01.IELTS prep/6.speaking/IELTS Speaking - strategiya va mashq.md</code>. Speaking savollari Tayanch uchun mashq sifatida beriladi; real IELTS savol banki nusxalanmaydi.</p>
    </section>

    <section class="practice-tools">
      <h2>Practice vositalari</h2>
      <div class="tool-grid">
        <div class="practice-card"><span class="practice-tag">ERROR-LOG</span><h3>Xatoni qayd qilish</h3><p>Mashqdan keyin xatoni toifalang. Bu natijalar faqat shu brauzerda saqlanadi.</p><label>Ko'nikma <select id="errorSkill"><option>Listening</option><option>Reading</option><option>Writing</option></select></label><label>Xato turi <select id="errorType"><option>E'tiborsizlik</option><option>Grammatika / birlik-ko'plik</option><option>Tinglab tushunmaslik</option><option>Word limit</option><option>Vaqt boshqaruvi</option></select></label><label>Qisqa izoh <input id="errorNote" placeholder="Masalan: swans o'rniga swan" /></label><button class="practice-btn secondary" id="saveError" type="button">Error-logga saqlash</button><ul class="saved-list" id="errorList"></ul></div>
        <div class="practice-card"><span class="practice-tag">CAMBRIDGE TRACKER</span><h3>Shaxsiy kitob tracker'i</h3><p>O'zingiz qonuniy ega bo'lgan Cambridge 15–21 kitoblari bilan ishlagan testingiz natijasini belgilang. Savollar yoki audio bu saytda saqlanmaydi.</p><div class="tracker-row"><label>Kitob <select id="bookSelect"><option>Cambridge 15</option><option>Cambridge 16</option><option>Cambridge 17</option><option>Cambridge 18</option><option>Cambridge 19</option><option>Cambridge 20</option><option>Cambridge 21</option></select></label><label>Test <select id="testSelect"><option>Test 1</option><option>Test 2</option><option>Test 3</option><option>Test 4</option></select></label><label>Listening / 40 <input id="trackListening" inputmode="numeric" placeholder="masalan 31" /></label><label>Reading / 40 <input id="trackReading" inputmode="numeric" placeholder="masalan 30" /></label></div><button class="practice-btn secondary" id="saveTracker" type="button">Natijani saqlash</button><ul class="saved-list" id="trackerList"></ul></div>
      </div>
    </section>

    <section class="mock-library-cta">
      <h2>To'liq IELTS mock testlar kutubxonasi</h2>
      <p>Listening, Reading va Writing bo'limlarini o'z ichiga olgan to'liq (40 savol/bo'lim) CDI Full Mock testlari bilan mashq qiling. Har bir mock alohida sahifada ochiladi.</p>
      <a href={base + 'ielts-practice/'} class="course-nav-link">Mock kutubxonasini ochish →</a>
    </section>

    <section class="official-resources">
      <h2>Rasmiy practice manbalari</h2>
      <p>Quyidagi manbalar rasmiy saytlarga olib boradi. Bu sahifa ularning test matni yoki audiosini nusxalamaydi.</p>
      <ul><li><a href="https://ielts.org/take-a-test/preparation-resources/sample-test-questions" target="_blank" rel="noopener">IELTS.org — Academic sample test questions</a></li><li><a href="https://takeielts.britishcouncil.org/prepare/ielts-free-practice-mock-tests" target="_blank" rel="noopener">British Council — bepul IELTS practice testlar</a></li><li><a href="https://www.cambridgeenglish.org/exams-and-tests/ielts/preparation" target="_blank" rel="noopener">Cambridge English — IELTS preparation</a></li></ul>
      <p class="src">Tashqi rasmiy manbalar: IELTS.org · British Council · Cambridge English</p>
    </section>

    <section>
      <h2>Haftalik review</h2>
      <p>Har bir sub-kursdagi xatolar va progress haftalik tracker orqali ko'rib chiqiladi. Maqsad ko'proq test yig'ish emas, takrorlanayotgan patternni topib, keyingi mashqni aynan o'sha patternga moslashdir.</p>
      <p class="src">Obsidian manbasi: <code>01.IELTS prep/5.Weekly Progress Tracker.md</code></p>
    </section>

    <a href={base + 'bog-lanish'} class="start-btn" style="margin-top:2rem;">Kursni sotib olish →</a>
    <a href={base + 'kurslar'} class="course-nav-link" style="margin-left:1rem;">← Barcha kurslar</a>

    <Quiz title="O'z bilimingizni tekshiring" questions={questions} />
  </article>

  <script>
    const normalise = (value) => value.trim().toLowerCase().replace(/\s+/g, ' ');
    const checkAnswers = (selector, resultId) => {
      const fields = [...document.querySelectorAll(selector)]; let correct = 0;
      fields.forEach((field) => { const answers = field.dataset.listenAnswer || field.dataset.readAnswer; const ok = answers.split('|').some((answer) => normalise(field.value) === normalise(answer)); field.classList.toggle('answer-ok', ok); field.classList.toggle('answer-no', !ok && field.value.trim() !== ''); if (ok) correct++; });
      document.querySelector(resultId).textContent = `${correct}/${fields.length} to'g'ri. Xato bo'lsa, Error-logga sababini yozing.`;
    };
    document.querySelector('#playListening')?.addEventListener('click', () => { const text = document.querySelector('#transcriptBox p')?.textContent; if ('speechSynthesis' in window && text) { speechSynthesis.cancel(); const utterance = new SpeechSynthesisUtterance(text); utterance.lang = 'en-GB'; utterance.rate = 0.9; speechSynthesis.speak(utterance); } });
    document.querySelector('#showTranscript')?.addEventListener('click', () => document.querySelector('#transcriptBox')?.setAttribute('open',''));
    document.querySelector('#checkListening')?.addEventListener('click', () => checkAnswers('[data-listen-answer]', '#listeningResult'));
    document.querySelector('#checkReading')?.addEventListener('click', () => checkAnswers('[data-read-answer]', '#readingResult'));
    const key = (name) => `organamiz-ielts-${name}`;
    const readStore = (name) => JSON.parse(localStorage.getItem(key(name)) || '[]');
    const render = (name, id, format) => { const list = document.querySelector(id); if (list) list.innerHTML = readStore(name).map(format).join('') || "<li>Hali yozuv yo'q.</li>"; };
    const esc = (text) => text.replace(/[&<>]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
    const renderErrors = () => render('errors', '#errorList', (x) => `<li><b>${esc(x.skill)}</b> — ${esc(x.type)}${x.note ? ': '+esc(x.note) : ''}</li>`);
    const renderTracker = () => render('tracker', '#trackerList', (x) => `<li><b>${esc(x.book)} · ${esc(x.test)}</b> — Listening: ${esc(x.listening || '—')}/40, Reading: ${esc(x.reading || '—')}/40</li>`);
    document.querySelector('#saveError')?.addEventListener('click', () => { const errors=readStore('errors'); errors.unshift({skill:document.querySelector('#errorSkill').value,type:document.querySelector('#errorType').value,note:document.querySelector('#errorNote').value}); localStorage.setItem(key('errors'),JSON.stringify(errors.slice(0,20))); document.querySelector('#errorNote').value=''; renderErrors(); });
    document.querySelector('#saveTracker')?.addEventListener('click', () => { const rows=readStore('tracker'); const book=document.querySelector('#bookSelect').value, test=document.querySelector('#testSelect').value; const row={book,test,listening:document.querySelector('#trackListening').value,reading:document.querySelector('#trackReading').value}; const index=rows.findIndex((x)=>x.book===book&&x.test===test); if(index>=0) rows[index]=row; else rows.unshift(row); localStorage.setItem(key('tracker'),JSON.stringify(rows)); renderTracker(); });
    document.querySelector('#saveOutline')?.addEventListener('click', () => { const data={topic:document.querySelector('#wTopic').value,intro:document.querySelector('#wIntro').value,body1:document.querySelector('#wBody1').value,body2:document.querySelector('#wBody2').value}; localStorage.setItem(key('outline'),JSON.stringify(data)); document.querySelector('#writingResult').textContent='Outline shu qurilmada saqlandi.'; });
    const outline=JSON.parse(localStorage.getItem(key('outline')) || '{}'); [['#wTopic','topic'],['#wIntro','intro'],['#wBody1','body1'],['#wBody2','body2']].forEach(([id,name])=>{ const el=document.querySelector(id); if(el && outline[name]) el.value=outline[name]; }); renderErrors(); renderTracker();
  </script>


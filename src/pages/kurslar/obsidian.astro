---
import Base from "../../layouts/Base.astro";
import LeadMagnetCTA from "../../components/LeadMagnetCTA.astro";
import CoursePreviewSyllabus from "../../components/CoursePreviewSyllabus.astro";
import PaymentInstructions from "../../components/PaymentInstructions.astro";
import CourseProgress from "../../components/CourseProgress.astro";
import Quiz from "../../components/Quiz.astro";
import ObsidianScreenshotSlots from "../../components/ObsidianScreenshotSlots.astro";
import CourseTestimonialPlaceholder from "../../components/CourseTestimonialPlaceholder.astro";
import CourseFaq from "../../components/CourseFaq.astro";
import CourseSchema from "../../components/CourseSchema.astro";
import { bespokeCourseFaqFacts } from "../../data/course-faqs";
const title = "Obsidian: shaxsiy bilim bazasi qurish | Tayanch";
const description = "Obsidian PKM bilan shaxsiy bilim bazasi qurish: kundalik yuritish, eslatmalarni bog'lash va o'qiganingizni esda saqlash. Bepul kurs.";
const base = import.meta.env.BASE_URL;
const images = {
  graphOverview: base + "screenshots/obsidian-course/graph-view-overview.webp",
  graphFolder: base + "screenshots/obsidian-course/graph-view-folder-expanded.webp",
  vocab: base + "screenshots/obsidian-course/vocab-note-example.webp"
};
const questions = [
  { q: "PKM nima?", opts: ["O'yin", "Shaxsiy bilim bazasi (Personal Knowledge Management)", "Pochta", "Virus"], answer: 1 },
  { q: "MOC nima uchun kerak?", opts: ["Rang uchun", "Kontentni bog'lash va yo'naltirish uchun", "Saqlash uchun", "Hech nima uchun"], answer: 1 },
  { q: "Tayanch nima qiladi?", opts: ["Rasm chizadi", "Telegram'dan Obsidian'ga avtomatik capture", "Kod yozadi", "Video montaj"], answer: 1 }
];
const shortcuts = [
  ["navigation", "Cmd + O", "Ctrl + O", "tezkor ochuvchi (nota nomini yozib ochish)"],
  ["navigation", "Cmd + P", "Ctrl + P", "buyruq paletasi"],
  ["navigation", "Cmd + Alt + ← / →", "Ctrl + Alt + ← / →", "orqaga / oldinga"],
  ["navigation", "Cmd + Shift + F", "Ctrl + Shift + F", "barcha fayllarda qidirish"],
  ["navigation", "Cmd + N / T / W", "Ctrl + N / T / W", "yangi nota / yangi tab / yopish"],
  ["formatting", "Cmd + B / I", "Ctrl + B / I", "qalin / yotiq"],
  ["formatting", "Cmd + E", "Ctrl + E", "edit ↔ preview"],
  ["formatting", "Cmd + Shift + K", "Ctrl + Shift + K", "ichki havola ([[) qo'shish"],
  ["formatting", "Cmd + 1…6", "Ctrl + 1…6", "sarlavha darajasi (H1–H6), 0 — paragraf"],
  ["formatting", "Cmd + [ / ]", "Ctrl + [ / ]", "ro'yxat indent / outdent"],
  ["view", "Cmd + \\", "Ctrl + \\", "editor'ni ikkiga bo'lish"],
  ["view", "Cmd + .", "Ctrl + .", "fokus rejimi"]
];
const plugins = [
  ["◈", "MOC (Map of Content)", '"All in One" hub note\'lar. Har bir papka ichida markaziy note yaratib, qolgan notalarga wikilink ([[ ]]) ko\'prik qo\'yish; butun bo\'limni bitta sahifada umumlashtiradi.'],
  ["01", "Numeric Order", "papkalarga 01., 02., 03. prefiks berib, mavzularni xronologik va ahamiyat darajasi bo'yicha tartiblash."],
  ["⌁", "Templater", "kunlik notelarni avtomatlashtirish. Bir tugma bilan sana avtomatik yoziladigan tayyor shablon yaratadi (vaqt tejaydi, format bir xil qoladi)."],
  ["▤", "Dataview", "avtomatik ro'yxat va statistika. LIST / TABLE / TASK so'rovlari bilan \"nechta vocabulary note bor\" kabi savollarga qo'lda sanamasdan javob olasiz. Yangi note qo'shilsa, ro'yxat o'zi yangilanadi."],
  ["↻", "Spaced Repetition", "vocabulary uchun oraliqli takrorlash (Anki'dagi SM-2 kabi). Flashcard tegi #flashcards, qoida so'z::tarjima yoki ikki tomonlama so'z ::: tarjima."],
  ["▣", "Notebook Navigator", "kunlik notalarga tez kirish. Chap panelda \"Bugun / Kecha\" deb guruhlanadi; Cmd+P → Daily notes: Open today's daily note."],
  ["⇄", "Neighbouring Files", "bitta papka ichidagi notalar orasida ketma-ket o'tish: Cmd + > (keyingi), Option + < (oldingi)."],
  ["✦", "Excalidraw", "qo'lda chizma va diagramma (masalan, qurilish sxemasi, tushuncha diagrammasi)."],
  ["⌘", "Obsidian Git", "GitHub'dagi private repo'ga avtomatik backup. Commit xabarlari \"vault backup:\" formatida; katta ishdan keyin qo'lda tekshirish tavsiya etiladi."],
  ["AI", "Gemini / Note Pilot (Groq)", "Obsidian ichidan AI. Note Pilot bir nechta provayderni (Groq, OpenAI, Anthropic, OpenRouter, Gemini, Ollama) bitta oynadan ulaydi; AI taklif qilgan o'zgarishni avtomatik qo'llamaydi — tasdiqlangandan keyin."]
];
---
<Base title={title} description={description}>
  <CourseSchema name="Obsidian: shaxsiy bilim bazasi qurish" description={description} lang="uz" />
  <CourseProgress courseId="obsidian" title="Obsidian PKM progressi" itemSelector=".modules > li" labelSelector="ol.modules" />
<article class="lesson obsidian-course">
  <header class="course-hero course-hero--visual">
    <div class="hero-copy"><span class="eyebrow" data-i18n="op.eyebrow">PERSONAL KNOWLEDGE MANAGEMENT</span>    <h1 data-i18n="op.h1">O'qiganingiz esda qoladigan bilim bazasi</h1><div class="price"><span class="now">$19</span><span class="old">$29</span><span class="badge badge-new">-35%</span><span class="badge badge-cert">Sertifikat</span><span class="uzs">≈ 240 000 so'm</span></div></div>
    <button class="image-card hero-image" type="button" data-lightbox-src={images.graphOverview} data-lightbox-alt="Obsidian Graph view overview"><img src={images.graphOverview} alt="Obsidian Graph view overview" loading="eager" fetchpriority="high" decoding="async" /><span class="image-card-label">Graph view overview <span>↗ Kattalashtirish</span></span></button>
  </header>
  <p class="lead" data-i18n="op.lead">Shaxsiy bilim bazasi qurish. Kimga mo'ljallangan: kundalik yuritadigan, o'qigan/o'rgangan narsalarini tartibga solmoqchi bo'lgan talaba va tadqiqotchilarga. Tayanch bilan Telegram'dan forward qilsangiz — AI xulosalab, Obsidian'ga saqlaydi.</p>
  <CoursePreviewSyllabus slug="obsidian" lang="uz" />

  <section><h2 data-i18n="op.modules">Kurs modullari</h2><ol class="modules"><li data-i18n="op.mod1">Nima uchun Obsidian? (Tashqi xotira)</li><li data-i18n="op.mod2">Vault tuzilmasi: MOC, papkalar, link'lar</li><li data-i18n="op.mod3">AutoConnect plugin: yangi note'larni avtomatik ulash</li><li data-i18n="op.mod4">Tayanch: Telegram → Obsidian capture</li><li data-i18n="op.mod5">Graph view: bilimlar bog'lanishi</li><li data-i18n="op.mod6">Qayerda qo'llash: o'qish, ish, tadqiqot</li></ol></section>
  <section><h2>1. Nima uchun Obsidian? (Tashqi xotira)</h2><p>Miyamiz cheksiz emas — eslab qolish uchun cheklangan. Obsidian esa <b>tashqi xotira</b>: fikrlaringizni, darslarni, manbalarni bir joyga yozib, keyin tez topib oladigan shaxsiy bilim bazasi (PKM — Personal Knowledge Management). Oddiy fayl (Markdown) sifatida saqlanadi — hech qanday "qora quti" yo'q, istalgan muharrirda ochib o'qish mumkin.</p><div class="core-idea"><b>ASOSIY G'OYA:</b> bilimni <b>saqlash</b> va <b>bog'lash</b> — shunchaki yozib qo'yish emas, balki ular orasida aloqa (link) yaratish.</div></section>
  <section><h2>Amaliy rasm joylari: vault asoslari</h2><p class="quiz-hint">Quyidagi joylarga faqat siz olgan haqiqiy Obsidian skrinshotlari yuklanadi. Tavsiya: WebP, har biri 150 KB dan kichik.</p><ObsidianScreenshotSlots section="basics" /></section>
  <section><h2>2. Markdown belgilari</h2><p>Obsidian dagi har bir note — bu Markdown fayli. Sarlavhalar rishotka (<code>#</code>) soni bilan darajalanadi:</p><pre><code># Katta sarlavha (bitta rishotka bilan boshlanadi)
## O'rtacha sarlavha (ikkita rishotka)
### Kichik sarlavha (uchta rishotka)</code></pre><p class="quiz-hint">Boshqa foydali belgilar: <code>**qalin**</code>, <code>*yotiq*</code>, <code>- ro'yxat</code>, <code>1. raqamli ro'yxat</code>, <code>&gt; [!tip] eslatma</code> (callout — quyida).</p><button class="image-card vocab-image" type="button" data-lightbox-src={images.vocab} data-lightbox-alt="Vocabulary note example"><img src={images.vocab} alt="Vocabulary note example" loading="lazy" decoding="async" /><span class="image-card-label">Vocabulary note misoli <span>↗ Kattalashtirish</span></span></button><ObsidianScreenshotSlots section="markdown" /></section>
  <section><h2>3. YouTube embed kodi</h2><p><b>YouTube embed kodi</b> — videoni Obsidian ichida to'g'ridan-to'g'ri ko'rinadigan qilib qo'yish uchun ishlatiladigan maxsus kod (<code>&lt;iframe&gt;</code> qatori). "Embed" so'zi inglizcha "ichiga joylashtirish, singdirish" degan ma'noni beradi.</p><ul><li><b>Oddiy link</b> — bosilganda brauzerga (YouTube saytiga) olib chiqadi.</li><li><b>Embed kodi</b> — video Obsidian sahifasining o'zida, hech qayerga chiqmasdan ko'rinadi va o'sha yerda tomosha qilinadi.</li></ul><h3>Embed kodi qanday olinadi?</h3><div class="steps"><div>1. YouTube'da videoni oching.</div><div>2. Video ostidagi <b>"Share"</b> (Ulashish) tugmasini bosing.</div><div>3. <b>"Embed"</b> bo'limini tanlang.</div><div>4. Chiqqan kodni nusxalab oling.</div></div><ObsidianScreenshotSlots section="embed" /><p class="quiz-hint"><b>VIDEO_ID</b> — bu video manzilidagi <code>watch?v=</code> dan keyingi qism. Masalan: <code>youtube.com/watch?v=dQw4w9WgXcQ</code> bo'lsa, ID = <code>dQw4w9WgXcQ</code>. Reading mode'ga o'ting (yuqori o'ngdagi kitob belgisi) — video shu yerda ko'rinadi.</p></section>
  <section><h2>4. Tezkor tugmalar (shortcuts)</h2><p>Mac'da <code>Cmd</code>, Windows/Linux'da <code>Ctrl</code> ishlatiladi.</p><div class="shortcut-controls" aria-label="Shortcut filters"><div class="toggle-group" role="group" aria-label="Operating system"><button type="button" class="is-active" data-os="mac">Mac</button><button type="button" data-os="windows">Windows / Linux</button></div><div class="filter-group" role="group" aria-label="Shortcut category"><button type="button" class="is-active" data-filter="all">Barchasi</button><button type="button" data-filter="navigation">Navigatsiya</button><button type="button" data-filter="formatting">Formatlash</button><button type="button" data-filter="view">Ko'rinish</button></div></div><div class="shortcut-list">{shortcuts.map(([category, mac, windows, text]) => <div class="shortcut-row" data-category={category}><span class="shortcut-category">{category === "navigation" ? "Navigatsiya" : category === "formatting" ? "Formatlash" : "Ko'rinish"}</span><code data-mac={mac} data-windows={windows}>{mac}</code><span>{text}</span></div>)}</div><p class="quiz-hint">Eng foydalilari: <code>Cmd + O</code> (sichqonchasiz nota topish), <code>Cmd + Shift + K</code> (tez ichki havola), <code>Cmd + E</code> (yozish/ko'rish o'rtasida).</p></section>
  <section><h2>5. Callout — chiroyli eslatma qutilari</h2><p>Obsidian'da rangli "eslatma quti" yaratish uchun <b>Callout</b> sintaksisi ishlatiladi. Bu built-in funksiya, plagin kerak emas.</p><div class="callout-lab"><div class="callout-picker"><span>Turini tanlang</span><div role="group" aria-label="Callout type"><button class="is-active" data-callout="tip" type="button">tip</button><button data-callout="note" type="button">note</button><button data-callout="warning" type="button">warning</button><button data-callout="success" type="button">success</button><button data-callout="question" type="button">question</button></div></div><div class="callout-output"><pre><code id="callout-code">&gt; [!tip] Sarlavha
&gt; Matn shu yerda</code></pre><div id="callout-preview" class="callout-preview callout-tip"><strong>TIP · Sarlavha</strong><span>Matn shu yerda</span></div></div></div><h3>Misollar</h3><ul><li><code>&gt; [!tip]</code> — muhim qoida yoki maslahat uchun</li><li><code>&gt; [!note]</code> — oddiy eslatma</li><li><code>&gt; [!warning]</code> — ogohlantirish</li><li><code>&gt; [!success]</code> — tugagan / tasdiqlangan narsa</li><li><code>&gt; [!question]</code> — hali javobi topilmagan</li></ul><div class="important-rule"><strong>ENG MUHIM QOIDA:</strong> callout ichidagi <b>har bir qator</b> oldida <code>&gt;</code> bo'lishi shart — hatto bo'sh qator bo'lsa ham. <code>&gt;</code> tugagan zahoti, matn callout tashqarisiga chiqib ketadi.</div><ul><li>❌ <code>[! note]</code> — undov belgisi va so'z orasida bo'shliq bo'lmasligi kerak</li><li>✅ <code>[!note]</code> — bo'shliqsiz yozish shart</li><li>❌ <code>&gt; &gt;[[1.]]</code> — ikkita <code>&gt;</code> yozilsa, bu nested callout yasaydi</li><li>✅ <code>&gt; [[1.]]</code> — faqat bitta <code>&gt;</code></li></ul><ObsidianScreenshotSlots section="callouts" /></section>
  <section><h2>6. Men Obsidianda nima qildim — foydali plugin'lar</h2><p>Quyidagi plaginlar haqiqatan o'rnatilib, ishlatilgan (tajribaga asoslangan):</p><div class="plugin-grid">{plugins.map(([icon, name, detail]) => <article class="plugin-card"><span class="plugin-icon">{icon}</span><h3>{name}</h3><p>{detail}</p></article>)}</div><div class="plugin-pattern"><p class="eyebrow">NAMUNA: FLASHCARDS / SPACED REPETITION</p><h3>Nima uchun kerak?</h3><p>Vocabulary va muhim g‘oyalarni interval bilan takrorlashga yordam beradi. Shu naqshni boshqa community pluginlarga ham qo‘llang: maqsad → katalogdan qidirish → minimal sozlash → bitta kichik test → xavfsizlikni tekshirish.</p><h3>O‘rnatish qadamlari</h3><ol><li>Settings → Community plugins ga kiring va Restricted Mode ogohlantirishini o‘qing.</li><li>Browse tugmasini bosing, qidiruvga <b>Flashcards</b> yozing.</li><li>Plugin sahifasida <b>Install</b>, so‘ng <b>Enable</b> ni bosing.</li></ol><h3>Qanday ishlatiladi?</h3><ol><li>Vocabulary note yarating va masalan <code>resilient::bardoshli</code> yozing.</li><li>Flashcards review oynasini ochib, bitta kartochka bilan takrorlashni sinang.</li></ol><p class="quiz-hint"><b>Amaliy maslahat:</b> avval 5–10 ta aniq kartochka bilan boshlang; har kartada faqat bitta tushuncha bo‘lsin.</p></div><ObsidianScreenshotSlots section="flashcards" /><h3>Qolgan pluginlar uchun shu pattern</h3><p>Templater, Dataview, Notebook Navigator va Excalidraw uchun ham avval maqsadni aniqlang, rasmiy katalogdan qidiring, bitta kichik real note’da sinang va ruxsatlarni qayta ko‘ring.</p><ObsidianScreenshotSlots section="plugins" /></section>
  <section><h2>7. Xavfsizlik — nima qilish mumkin / mumkin emas</h2><div class="security-grid"><article class="security-card safe"><h3>✅ Mumkin (xavfsiz)</h3><ul><li><b>Restricted Mode</b>'ni yoqib saqlash — uchinchi tomon kodining bajarilishini oldini oladi (faqat ishonchli plagin uchun vaqtincha o'chirish).</li><li>Faqat <b>rasmiy Community Plugins katalogi</b> orqali plagin o'rnatish (har bir versiya xavfsizlik skaneridan o'tadi, "safety scorecard" ko'rsatiladi).</li><li>Plagin o'rnatishdan oldin uning <b>GitHub repozitoriyasini</b> tekshirish: oxirgi yangilanish, yulduzlar, ochiq issue'lar.</li><li><b>Core (rasmiy)</b> plaginlardan foydalanish — eng ishonchli.</li><li>Vault'ni mahalliy diskda saqlash + macOS'da <b>FileVault</b> shifrlash.</li><li>Muntazam <b>backup</b>: rasmiy Obsidian Sync (end-to-end shifrlangan) yoki shaxsiy (private) git repo.</li></ul></article><article class="security-card avoid"><h3>🚫 Mumkin emas (qat'iy taqiqlangan)</h3><ul><li>Parollar, API kalitlar, seed phrase, bank/karta ma'lumotlarini <b>shifrlanmagan oddiy note</b> sifatida yozish.</li><li><b>Google akkaunt parolini</b> Obsidian'ga yozish — Markdown fayllar default holda oddiy matn.</li><li>Rasmiy katalogdan <b>tashqarida</b> joylashgan manbadan plagin o'rnatish. Community plaginlar Obsidian'ning to'liq huquqlarini meros qilib oladi — kompyuterdagi istalgan faylga kirishi, internetga ulanishi mumkin.</li><li><b>Restricted Mode</b>'ni ishonchsiz plagin uchun o'chirish.</li><li>2026-yil mayida aynan "Installed community plugins" sinxronizatsiyasi orqali (Shell Commands plagini bilan) <b>PHANTOMPULSE</b> nomli zararli dastur tarqatilgan — bu real, tasdiqlangan xavf.</li></ul></article><article class="security-card caution"><h3>⚠️ Tavsiya etilmaydi (ehtiyot bo'lish)</h3><ul><li><b>"Plugin hoarding"</b> — har bir qiziqarli plaginni o'rnatib qo'yish; har bir o'rnatilgan pligin xavfsizlik yuzasini kengaytiradi.</li><li>Vault'ni <b>public GitHub repo</b> sifatida saqlash (shaxsiy yozuvlar bo'lsa).</li><li>Dropbox/Google Drive'da bir nechta qurilmada <b>bir vaqtda tahrirlash</b> — fayl konflikti.</li><li>Backup/sinxronizatsiyasiz uzoq muddat ishlash.</li><li>Parollar uchun Obsidian shifrlash plaginlaridan (masalan Meld Encrypt) foydalanish — ular uchun maxsus parol menejeri (Bitwarden, Keychain) yaxshiroq.</li></ul></article></div><ObsidianScreenshotSlots section="security" /><div class="security-advice"><strong>Maslahat:</strong> parollar uchun doimo maxsus parol menejeri (Bitwarden — bepul/ochiq manba, yoki macOS Keychain) ishlating. Obsidian — bilim bazasi, parol seyfi emas.</div></section>
  <section class="graph-section"><div><span class="eyebrow">MODUL 5</span><h2>Graph view: bilimlar bog'lanishi</h2><p>Graph view note'lar va ular orasidagi link'larni bitta xaritada ko'rsatadi. Papkalarni kengaytirib, bilimlar qanday bog'langanini ko'ring.</p></div><ObsidianScreenshotSlots section="graph" /><button class="image-card graph-image" type="button" data-lightbox-src={images.graphFolder} data-lightbox-alt="Obsidian Graph view with expanded folder"><img src={images.graphFolder} alt="Obsidian Graph view with expanded folder" loading="lazy" decoding="async"/><span class="image-card-label">Papka kengaytirilgan Graph view <span>↗ Kattalashtirish</span></span></button></section>
  <a href={base + 'bog-lanish'} class="start-btn" style="margin-top:2rem;" data-gumroad-product="obsidian-bilim-bazasi" target="_blank" rel="noopener noreferrer" data-i18n="op.buy">Kursni sotib olish →</a><a href={base + 'kurslar'} class="course-nav-link" style="margin-left:1rem;" data-i18n="op.all">← Barcha kurslar</a>
  <Quiz title="O'z bilimingizni tekshiring" titleI18n="op.quizTitle" questions={questions} />
  <PaymentInstructions course="Obsidian PKM" price="$19 · ≈ 240 000 so'm" />
  <CourseFaq facts={bespokeCourseFaqFacts["obsidian"]} />
  {/* REAL student reviews go in src/data/testimonials.ts — add only permissioned, verified reviews. This renders nothing until then. */}
  <CourseTestimonialPlaceholder />
  <LeadMagnetCTA />
</article>
<dialog class="lightbox" id="image-lightbox"><button class="lightbox-close" type="button" aria-label="Yopish">×</button><img src="" alt="" /><p></p></dialog>
</Base>
<script>
  const $ = (s) => document.querySelector(s);
  let activeOs = 'mac', activeFilter = 'all';
  function updateShortcuts() { document.querySelectorAll('.shortcut-row').forEach(row => { row.hidden = activeFilter !== 'all' && row.dataset.category !== activeFilter; const key = row.querySelector('code'); key.textContent = key.dataset[activeOs]; }); }
  document.querySelectorAll('[data-os]').forEach(button => button.addEventListener('click', () => { activeOs = button.dataset.os; document.querySelectorAll('[data-os]').forEach(b => b.classList.toggle('is-active', b === button)); updateShortcuts(); }));
  document.querySelectorAll('[data-filter]').forEach(button => button.addEventListener('click', () => { activeFilter = button.dataset.filter; document.querySelectorAll('[data-filter]').forEach(b => b.classList.toggle('is-active', b === button)); updateShortcuts(); }));
  const code = $('#callout-code'), preview = $('#callout-preview');
  document.querySelectorAll('[data-callout]').forEach(button => button.addEventListener('click', () => { const type = button.dataset.callout; document.querySelectorAll('[data-callout]').forEach(b => b.classList.toggle('is-active', b === button)); code.textContent = `> [!${type}] Sarlavha\n> Matn shu yerda`; preview.className = `callout-preview callout-${type}`; preview.innerHTML = `<strong>${type.toUpperCase()} · Sarlavha</strong><span>Matn shu yerda</span>`; }));
  const lightbox = $('#image-lightbox'), lightboxImage = lightbox.querySelector('img'), lightboxText = lightbox.querySelector('p');
  document.querySelectorAll('[data-lightbox-src]').forEach(button => button.addEventListener('click', () => { lightboxImage.src = button.dataset.lightboxSrc; lightboxImage.alt = button.dataset.lightboxAlt; lightboxText.textContent = button.dataset.lightboxAlt; lightbox.showModal(); }));
  lightbox.querySelector('.lightbox-close').addEventListener('click', () => lightbox.close());
  lightbox.addEventListener('click', event => { if (event.target === lightbox) lightbox.close(); });
</script>
<style>

---
import Base from '../../../layouts/Base.astro';
import SpeakingPractice from '../../../components/SpeakingPractice.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="IELTS Speaking — 30 kunlik AI kursi | Tayanch" description="IELTS Speaking uchun talaffuz, shadowing, Part 1/2/3 savollari va AI practice feedback.">
  <main class="speaking-page">
    <a class="back" href={base + 'kurslar/ielts-prep/'}>← IELTS Prep kursiga qaytish</a>
    <SpeakingPractice />
  </main>
</Base>
<style>.speaking-page{max-width:1180px;margin:0 auto;padding:1.2rem 20px}.back{display:inline-block;margin:.25rem 0 1rem;color:var(--muted);font-size:.92rem}.back:hover{color:var(--accent)}</style>

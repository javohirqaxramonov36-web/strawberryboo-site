---
import Base from "../../layouts/Base.astro";
import CourseTestimonialPlaceholder from "../../components/CourseTestimonialPlaceholder.astro";
import LeadMagnetCTA from "../../components/LeadMagnetCTA.astro";
import CourseSchema from "../../components/CourseSchema.astro";
const title = "Vibe Coding: G'oyadan 2 haftada saytgacha | Tayanch";
const description = "AI agentlar yordamida bepul yoki arzon vositalar bilan g'oyadan 2 haftada saytgacha. Vibe Coding bo'yicha amaliy kurs.";
const base = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <CourseSchema name="Vibe Coding: G‘oyadan 2 haftada saytgacha" description={description} lang="uz" />
  <article class="lesson">
    <div class="course-hero">
      <h1 data-i18n="vc.h1">Vibe Coding: G'oyadan Saytgacha</h1>
      <div class="price">
        <span class="now">Tez orada</span>
        <span class="uzs">Bepul / arzon AI vositalar bilan</span>
      </div>
    </div>

    <p class="lead" data-i18n="vc.lead">
      Vibe coding — bu dasturchi kodni qo'lda yozmaydi, balki AI agentga <b>nima kerakligini</b>
      aniq tushuntiradi; agent esa kodni yozadi, tahrirlaydi va testdan o'tkazadi. Siz esa natijani
      ko'rib chiqib, yo'naltirasiz. Kimga mo'ljallangan: g'oyasi bor, lekin kod yozishni bilmaydigan tadbirkor va yaradorlarga.
    </p>

    <!-- ISHONCH DALILI -->
    <div class="welcome-module">
      <div class="welcome-kicker" data-i18n="vc.proofKicker">ISHONCH DALILI</div>
      <h2 data-i18n="vc.proofTitle">Siz hozir aynan shu usulda qurilgan saytni ko'ryapsiz</h2>
      <div class="welcome-grid">
        <div>
          <b data-i18n="vc.p1">Haqiqiy misol</b>
          <p>Bu Tayanch sayti vibe coding yondashuvi bilan, bir necha hafta ichida qurilgan. Siz ko'rayotgan har bir bo'lim — AI agentga berilgan aniq topshiriqlar natijasi.</p>
        </div>
        <div>
          <b data-i18n="vc.p2">Tejamkorlik</b>
          <p>Pullik AI kodlash vositalari (Cursor Pro, Claude Code Max, GitHub Copilot) odatda oyiga $10–$60+ turadi. Kursda siz xuddi shu ishni bepul yoki juda arzon alternativalar bilan qilishni o'rganasiz.</p>
        </div>
        <div>
          <b data-i18n="vc.p3">Amaliyot</b>
          <p>Nazariya emas — kurs davomida haqiqiy sayt va loyiha qurasiz. Dasturchi bo'lish shart emas.</p>
        </div>
      </div>
    </div>

    <!-- MARKETING XABARLAR -->
    <section class="vibe-why">
      <h2 data-i18n="vc.whyTitle">Nima uchun aynan bu kurs?</h2>
      <ul class="modules">
        <li><b data-i18n="vc.w1">Amaliylik:</b> Nazariya emas — kurs davomida haqiqiy sayt/loyiha qurasiz.</li>
        <li><b data-i18n="vc.w2">Tejamkorlik:</b> Pullik vositalar oyiga $10–$60+; kursda bepul/arzon alternativalarni (OpenCode + bepul model provayderlar) ishlatishni o'rganasiz.</li>
        <li><b data-i18n="vc.w3">Kirish to'sigi past:</b> Dasturchi bo'lish shart emas — vibe coding aynan shuning uchun yaratilgan.</li>
        <li><b data-i18n="vc.w4">Ishonch dalili:</b> Bu saytning o'zi shu usulda, bir necha hafta ichida qurilgan.</li>
      </ul>
    </section>

    <!-- DASTUR -->
    <section class="vibe-program">
      <div class="sec-head">
        <h2 class="sec-title" data-i18n="vc.progTitle">Kurs dasturi — 10 modul</h2>
      </div>
      <ol class="modules">
        <li><b data-i18n="vc.m1">Vibe Coding nima o'zi?</b> Ta'rif, case study (shu sayt), kimlar uchun mo'ljallangan.</li>
        <li><b data-i18n="vc.m2">AI kodlash agentlariga kirish.</b> Pullik (Cursor, Copilot, Claude Code) vs bepul/ochiq (OpenCode, Cline, Continue).</li>
        <li><b data-i18n="vc.m3">OpenCode'ni o'rnatish.</b> Terminal orqali o'rnatish, bepul provayder ulash (OpenCode Zen, Gemini/Groq, Ollama).</li>
        <li><b data-i18n="vc.m4">Birinchi loyiha: oddiy landing page.</b> AI agentga bosqichma-bosqich topshiriq berib HTML/CSS sahifa yasash.</li>
        <li><b data-i18n="vc.m5">Prompt yozish san'ati.</b> Yaxshi/yomon prompt, AGENTS.md / loyiha qoidalari fayli yozish.</li>
        <li><b data-i18n="vc.m6">Xatolarni tuzatish va nazorat.</b> Diff'ni o'qish, testlar, "auto-approve" rejimidan ehtiyot bo'lish.</li>
        <li><b data-i18n="vc.m7">MCP va integratsiyalar.</b> Model Context Protocol, GitHub va boshqa vositalarni ulash; token sarfini boshqarish.</li>
        <li><b data-i18n="vc.m8">Real loyiha: shu sayt qanday qurilgan.</b> Qaysi bo'limlar qanday promptlar bilan yaratilgani, xatolardan qanday saboq olingani.</li>
        <li><b data-i18n="vc.m9">Vibe coding orqali pul topish.</b> Frilanserlik, portfolio saytlari, mijozlar uchun tezkor prototiplar, narx belgilash.</li>
        <li><b data-i18n="vc.m10">Xavfsizlik va yaxshi amaliyotlar.</b> API key'larni himoyalash, .gitignore, xarajat limiti, "auto-approve" xavfi.</li>
      </ol>
    </section>

    <!-- QOLGAN MODULLAR UCHUN HAQIQIY DARSLAR -->
    <section class="vibe-lessons">
      <div class="sec-head"><h2 class="sec-title" data-i18n="vc.lessTitle">Kurs darslari — qisqa yo'riqnoma</h2></div>

      <div class="vibe-lesson">
        <h3>Modul 1 — Vibe Coding nima o'zi?</h3>
        <p>Vibe coding — dasturchi qo'lda har qatorni yozmaydi, balki AI agentga <b>nima kerakligini</b> tushuntiradi; agent esa kodni yozadi, tahrirlaydi va testdan o'tkazadi. An'anaviy yondashuvda siz kodni o'zingiz yozasiz; vibe coding'da agent yozadi, siz esa natijani ko'rib chiqib yo'naltirasiz. Kimlar uchun: g'oyasi bor, lekin dasturlashni chuqur bilmaydigan tadbirkor, marketolog, o'qituvchi va g'oyalarni tez sinab ko'rishni istaganlar.</p>
      </div>

      <div class="vibe-lesson">
        <h3>Modul 2 — AI kodlash agentlariga kirish</h3>
        <p>Pullik vositalar: Cursor (editor ichida agent), GitHub Copilot (taklif), Claude Code (terminal agent) — qulay, lekin oyiga $10–$60+. Bepul/ochiq alternativalar: <b>OpenCode</b> (terminal, provayder tanlanadi), Cline va Continue (VS Code bilan), Aider. Boshlash uchun eng yaxshisi OpenCode: u Gemini, Groq, Ollama kabi bepul provayderlarni qo'llab-quvvatlaydi.</p>
      </div>

      <div class="vibe-lesson">
        <h3>Modul 3 — OpenCode'ni o'rnatish</h3>
        <ul class="lesson-list">
          <li>Terminalda <code>npm install -g opencode</code> (yoki rasmiy skript).</li>
          <li><code>opencode</code> buyug'i bilan ishga tushiring.</li>
          <li>Provayder ulash: OpenCode Zen yoki Google AI Studio'dan bepul Gemini kaliti; yoki Groq (tezkor, bepul limit); yoki Ollama (butunlay offlayn).</li>
          <li>Loyiha papkasida <code>opencode</code> ishga tushiring.</li>
        </ul>
        <p class="lesson-note">Muhim: kalitlarni <code>.env</code> faylida saqlang, hech qachon kodga to'g'ridan-to'g'ri yozmang.</p>
      </div>

    <!-- NAMUNA DARS: MODUL 5 (haqiqiy, yozilgan kontent) -->
    <section class="vibe-lesson">
      <div class="sec-head"><h2 class="sec-title">Namuna dars — Modul 5: Prompt yozish san'ati</h2></div>
      <p class="lesson-lead">
        Vibe coding muvaffaqiyatining 80 foizi — agentga to'g'ri topshiriq berishda. AI "telepatiya" qila olmaydi:
        u faqat siz yozgan narsaga qarab ishlaydi. Quyida bitta kichik, amaliy dars — nima uchun bir xil vazifa
        ikki xil prompt bilan butunlay farqli natija berishi mumkinligini ko'ramiz.
      </p>

      <h3>1. Yaxshi promptning tuzilmasi</h3>
      <p>Ko'p hollarda quyidagi elementlarni kiritish natijani sezilarli yaxshilaydi:</p>
      <ul class="lesson-list">
        <li><b>Rol (role):</b> "Sen — 10 yillik tajribaga ega frontend dasturchi" kabi kontekst berish.</li>
        <li><b>Kontekst:</b> loyiha haqida qisqa ma'lumot — qanday texnologiya, kim uchun, qanday muhit.</li>
        <li><b>Vazifa:</b> aniq, bir vazifa — "shu funksiyani yoz", "shu xatoni tuzat", "refactor qil".</li>
        <li><b>Cheklovlar:</b> nimalar qilinmasligi kerak (masalan, "yangi kutubxona qo'shma", "faqat CSS bilan").</li>
        <li><b>Misollar:</b> kichik kirish/chiqish namunasi (few-shot) — AI ga aynan nima kutyog'ingizni ko'rsatadi.</li>
        <li><b>Format:</b> javob qanday bo'lishi kerak (kod bloki, ro'yxat, JSON, qisqa izoh).</li>
      </ul>

      <h3>2. Yomon vs yaxshi — bitta misol</h3>
      <p><b>Yomon prompt:</b> <code>Login sahifasini yasab ber.</code></p>
      <p>Natija: agent "login"ni o'zi xohlagancha tushunadi — ehtimol keraksiz kutubxona ulaydi, mobilni unutadi, xavfsizlikni e'tiborsiz qoldiradi.</p>
      <p><b>Yaxshi prompt:</b></p>
      <pre class="lesson-code">Sen — Tailwind va Astro bilan ishlovchi frontend dasturchi.
Mening loyiham: statik sayt, faqat HTML/CSS, mobilga mos bo'lishi shart.
Vazifa: email va parol maydonli, markazlashgan login kartasi yarat.
Cheklovlar: yangi JS kutubxonasi qo'shilmasing, faqat Tailwind class'lari ishlat.
Format: faqat &lt;section&gt; blokini qaytar, 3-4 qator izoh bilan tushuntir.</pre>
      <p>Farq shundaki, ikkinchi promptda agent "chegaralar ichida" harakat qiladi va siz xohlagan natijaga yaqinroq chiqadi.</p>

      <h3>3. Tekshirish ro'yxati (checklist)</h3>
      <ul class="lesson-list">
        <li>Bitta promptda bitta aniq vazifami bor?</li>
        <li>Rol va kontekst aytilganmi?</li>
        <li>Cheklovlar (nima qilinmasligi) ko'rsatilganmi?</li>
        <li>Javob formati aniqmi?</li>
        <li>Agar murakkab bo'lsa, vazifa bosqichlarga bo'linganmi (chain-of-thought)?</li>
      </ul>
      <p class="lesson-note">
        Eslatma: bu — kursning bitta namuna darsi. To'liq 10 modul (o'rnatish, xato tuzatish, MCP, real loyiha)
        alohida material sifatida, tekshirib tasdiqlangandan keyin qo'shiladi.
      </p>
    </section>

      <div class="vibe-lesson">
        <h3>Modul 4 — Birinchi loyiha: oddiy landing page</h3>
        <p>Maqsad: sodda, mobilga mos landing. Agentga bosqichma-bosqich bering: (a) "index.html yarating, navbar + hero", (b) "hero'ga 2 ta tugma qo'shing", (c) "Tailwind CDN ulab, ranglarni brendga moslang", (d) "mobil uchun media query qo'shing". Har bosqichdan so'ng brauzerda ko'ring — kichik qadamlar aniqroq natija beradi. Yakuniy natijani GitHub Pages'ga joylang.</p>
      </div>

      <div class="vibe-lesson">
        <h3>Modul 5 — Prompt yozish san'ati</h3>
        <p>Quyida alohida, to'liq namuna dars berilgan (rol/kontekst/vazifa tuzilmasi, yomon vs yaxshi prompt, tekshirish ro'yxati). O'qib chiqing.</p>
      </div>

      <div class="vibe-lesson">
        <h3>Modul 6 — Xatolarni tuzatish va nazorat</h3>
        <p>Agent yozgan kodni ko'rib chiqish majburiy. <code>git diff</code> orqali nima o'zgarganini o'qing. "Auto-approve" rejimini ehtiyotkorlik bilan ishlating — agent xato qilsa, u avtomatik qabul qilinadi. Mavjud testlarni ishga tushiring; xato bo'lsa agentga aniq ayting: "X sahifada tugma ishlamayapti, sababi...". Diff'ni tushunmasangiz, agentdan qisqa izoh so'rang.</p>
      </div>

      <div class="vibe-lesson">
        <h3>Modul 7 — MCP va integratsiyalar</h3>
        <p>MCP (Model Context Protocol) — agentga tashqi vositalarni ulash standarti. Masalan, GitHub MCP orqali agent issue yaratadi va fayl yozadi; fayl-tizimi MCP orqali loyihangizni o'qiydi. Token sarfini boshqarish: katta fayllarni to'liq yubormasdan, faqat kerakli qismini bering (.gitignore, qisqa context). Juda uzun suhbat — xarajat va sifat pasayishiga olib keladi.</p>
      </div>

      <div class="vibe-lesson">
        <h3>Modul 8 — Real loyiha: shu sayt qanday qurilgan</h3>
        <p>Tayanch saytining ko'p bo'limlari aynan shu usulda qurilgan. Masalan kurs sahifalari: "IELTS skill-kurs uchun card yarat, accent rang parametri bilan"; testimonial bloki: "bo'sh placeholder, lekin hech qanday soxta fikr ko'rsatma". Muvaffaqiyat kaliti — aniq, chegaralangan topshiriq va har bosqichda tekshirish. Dastlab keng topshiriqlar chalkashlik keltirdi; keyin ularni kichik qismlarga bo'ldik.</p>
      </div>

      <div class="vibe-lesson">
        <h3>Modul 9 — Vibe coding orqali pul topish</h3>
        <p>Frilanserlik: mijozlarga tezkor prototiplar va landing sahifalar. Portfolio: o'zingizning loyihalaringizni joylang. Narx belgilash: vaqt tejashni hisobga oling — prototype 1 kunda, an'anaviy 1 hafta. Mijozlar: kichik biznes, shaxsiy brend, tadbirkorlar. Eslatma: sifatli natija uchun agentni nazorat qilish — sizning asosiy ishingiz.</p>
      </div>

      <div class="vibe-lesson">
        <h3>Modul 10 — Xavfsizlik va yaxshi amaliyotlar</h3>
        <p>API kalitlarini hech qachon kodga yozmang — <code>.env</code> + <code>.gitignore</code>. Xarajat limiti o'rnating (provayderda). "Auto-approve" xavfi: agent kutilmagan faylni o'zgartirishi mumkin — muhim fayllar uchun tasdiqlash talab qiling. Maxfiy ma'lumotlarni agentga yubormang. Har kunda <code>git commit</code> qiling — xato bo'lsa, oldingi holatga qaytish oson bo'ladi.</p>
      </div>
    </section>

    <p style="margin-top:2rem;">
      <a href={base + 'kurslar'} class="course-nav-link" data-i18n="vc.allCourses">← Barcha kurslar</a>
    </p>

    <div class="donate-cta" style="margin-top:2rem;text-align:center">
      <a href="https://t.me/tayanch_go" class="start-btn" target="_blank" rel="noopener noreferrer">Telegram'da kurs chiqishini kuzatib boring →</a>
    </div>
  <CourseTestimonialPlaceholder />
  <LeadMagnetCTA />
</article>
</Base>

<style>
  .vibe-why { margin-top: 2.5rem; }
  .vibe-why h2 { color: var(--accent); font-size: 1.4rem; margin: 0 0 1rem; }
  .vibe-program { margin-top: 2.5rem; }
  .vibe-program .sec-head { margin: 0 0 1rem; border: 0; padding: 0; }
  .vibe-program .sec-title { font-size: 1.4rem; }
  /* modullar ro'yxati uchun kurs sahifasidagi .modules uslubini qayta ishlatamiz */
  .lesson .modules li { font-size: 15px; }
  .vibe-lesson { margin-top: 2.5rem; padding: 1.4rem 1.5rem; border: 1px solid color-mix(in srgb,var(--accent) 40%,var(--border)); border-radius: 16px; background: linear-gradient(135deg,color-mix(in srgb,var(--accent) 7%,var(--surface)),var(--surface)); }
  .vibe-lesson .sec-title { color: var(--accent); font-size: 1.35rem; }
  .vibe-lesson h3 { margin: 1.4rem 0 .5rem; font-size: 1.1rem; }
  .lesson-lead { color: var(--muted); line-height: 1.7; }
  .lesson-list { margin: .4rem 0 1rem; padding-left: 1.1rem; }
  .lesson-list li { margin: .35rem 0; line-height: 1.6; }
  .lesson-code { background: #0b0c12; color: #e6e6e6; padding: 1rem; border-radius: 12px; overflow:auto; font-size: .85rem; line-height: 1.55; white-space: pre-wrap; }
  .vibe-lesson code { background: color-mix(in srgb,var(--accent) 16%,var(--surface)); padding: .1rem .4rem; border-radius: 6px; }
  .lesson-note { margin-top: 1rem; font-size: .9rem; color: var(--muted); border-left: 3px solid var(--accent); padding-left: .8rem; }
</style>

---
import Base from '../../layouts/Base.astro';
import SatCourse from '../../components/SatCourse.astro';
import { getSatCourse } from '../../data/sat-courses';

const course = getSatCourse('desmos-applications');
if (!course) throw new Error('SAT course was not found.');
const relatedCourse = course.relatedCourseSlug ? getSatCourse(course.relatedCourseSlug) : undefined;
---

<Base title={course.title + ' | Tayanch'} description={course.description}>
  <SatCourse {course} {relatedCourse} />
</Base>

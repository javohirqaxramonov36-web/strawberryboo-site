---
import Base from '../../layouts/Base.astro';
import CourseProgress from '../../components/CourseProgress.astro';
import VocabularyMethodCard from '../../components/VocabularyMethodCard.astro';
import CourseSchema from "../../components/CourseSchema.astro";
const base = import.meta.env.BASE_URL;
const methods = [
  {
    number: '01',
    title: 'Flashcards',
    visual: 'flashcard',
    tagline: 'Oddiy karton bilan tez boshlanadigan yodlash tizimi',
    description: 'Kichik kartaning bir tomoniga so‘z, ikkinchi tomoniga tarjima yoki qisqa ta’rif yozing. Kartalarni bir maromda qayta ko‘rish orqali qiyin so‘zlarni ko‘proq, yaxshi esda qolganlarini esa kamroq takrorlang.',
    benefits: ['Telefon yoki ilova kerak emas.', 'Boshlash juda oson va arzon.', 'Qo‘lda yozish so‘zni faolroq eslab qolishga yordam beradi.'],
    limitations: ['Kartalar ko‘payganda tartib saqlash qiyinlashadi.', 'Bog‘lanish va misollarni keng yozish uchun joy kam.'],
    placeholderFile: 'screenshots/vocabulary-course/flashcards-method.jpg'
  },
  {
    number: '02',
    title: 'Obsidian orqali yodlash',
    visual: 'knowledge-map',
    tagline: 'So‘zlarni bilim xaritasi sifatida bog‘lab boring',
    description: 'Har bir so‘z uchun alohida yozuv yarating: ma’no, misol va o‘xshash so‘zlarni saqlang. Linklar orqali mavzularni ulang, Spaced Repetition plagini bilan qaytarish vaqtini boshqaring.',
    benefits: ['So‘z, misol va mavzular bir joyda saqlanadi.', 'Linklar kontekst va bog‘lanishlarni ko‘rsatadi.', 'Katta so‘z bazasi uchun qidirish va takrorlash qulay.'],
    limitations: ['Dastlabki sozlash va odat hosil qilish kerak.', 'Telefon yoki kompyuterga bog‘liq.'],
    placeholderFile: 'screenshots/vocabulary-course/obsidian-method.jpg'
  }
];
---
<Base title="IELTS Vocabulary: so‘zlarni yodlash | Tayanch" description="IELTS Vocabulary: so‘zlarni flashcards va Obsidian yordamida muntazam yodlash. Lug‘at boyligini oshirish uchun amaliy mini-kurs.">
  <CourseSchema name="IELTS Vocabulary" description="IELTS Vocabulary: so‘zlarni flashcards va Obsidian yordamida muntazam yodlash. Lug‘at boyligini oshirish uchun amaliy mini-kurs." lang="uz" />
  <CourseProgress courseId="ielts-vocabulary" title="IELTS Vocabulary progressi" itemSelector="#flashcards .method-card, #obsidian .method-card" labelSelector="h2" />
  <article class="vocabulary-course">
    <header class="course-hero">
      <p class="eyebrow">05 — IELTS MINI-KURS</p>
      <h1 data-i18n="vo.h1">IELTS Vocabulary</h1>
      <p class="lead" data-i18n="vo.lead">So‘z yodlashda qiynalyapsizmi? Sizga mos, muntazam ishlaydigan usulni tanlang va uni har kuni kichik qadamlar bilan davom ettiring.</p>
      <nav class="jump-links" aria-label="Vocabulary kurs bo‘limlari"><a href="#flashcards">Flashcards</a><a href="#obsidian">Obsidian</a><a href="#compare">Qaysi usul mos?</a></nav>
    </header>

    <section class="intro" aria-labelledby="start-title">
      <p class="eyebrow">ASOSIY TAMOYIL</p>
      <h2 id="start-title" data-i18n="vo.introTitle">Yodlash emas, qayta uchrashish</h2>
      <p data-i18n="vo.introP">Yangi so‘zni bir marta ko‘rish yetmaydi. Uni qisqa oraliqlarda qayta eslash — <strong>spaced repetition</strong> — so‘zni uzoqroq muddat xotirada saqlashga yordam beradi. Quyidagi ikki usul shu odatni qurish uchun turli yo‘l beradi.</p>
    </section>

    <section id="flashcards" aria-label="Flashcards usuli"><VocabularyMethodCard {...methods[0]} /></section>
    <section id="obsidian" aria-label="Obsidian usuli"><VocabularyMethodCard {...methods[1]} /></section>

    <section class="compare" id="compare" aria-labelledby="compare-title">
      <p class="eyebrow">QAYSI USUL SENGA MOS?</p>
      <h2 id="compare-title" data-i18n="vo.cmpTitle">Tez tanlash jadvali</h2>
      <div class="comparison-wrap"><table><thead><tr><th>Holatingiz</th><th>Tavsiya</th><th>Nega?</th></tr></thead><tbody><tr><td>Bugunoq, sodda usul bilan boshlamoqchisiz</td><td><a href="#flashcards">Flashcards</a></td><td>Qog‘oz, ruchka va 10 daqiqa yetarli.</td></tr><tr><td>So‘z, misol va mavzularni uzoq muddat saqlamoqchisiz</td><td><a href="#obsidian">Obsidian</a></td><td>Har bir so‘zni kontekst hamda linklar bilan rivojlantirasiz.</td></tr><tr><td>Telefon/kompyuterdan tanaffus qilishni xohlaysiz</td><td><a href="#flashcards">Flashcards</a></td><td>To‘liq offline ishlaydi.</td></tr><tr><td>Allaqachon Obsidian’da nota yuritasiz</td><td><a href="#obsidian">Obsidian</a></td><td>Mavjud vaultingizni so‘z bazasiga aylantirasiz.</td></tr></tbody></table></div>
      <p class="note">Ikki usulni birga ishlatish ham mumkin: yangi so‘zlarni Obsidian’da saqlab, eng qiyinlarini alohida qog‘oz kartalarga ajrating.</p>
    </section>

    <section class="obsidian-callout"><div><p class="eyebrow">CHUQURROQ O‘RGANISH</p><h2 data-i18n="vo.ocTitle">Obsidian tizimini noldan qurmoqchimisiz?</h2><p data-i18n="vo.ocText">Obsidian PKM kursida nota, linklar va Spaced Repetition plagini bilan ishlash yo‘li batafsil ko‘rsatilgan.</p></div><a class="start-btn" href={base + 'kurslar/obsidian/'} data-i18n="vo.ocLink">Obsidian PKM kursi →</a></section>

    <div class="actions"><a class="course-nav-link" href={base + 'kurslar/#ielts-courses'} data-i18n="vo.allIELTS">← Barcha IELTS kurslari</a></div>
</article>
</Base>

<style>
.vocabulary-course{max-width:980px;margin:auto}.eyebrow{color:#c4b5fd;font-size:.78rem;font-weight:800;letter-spacing:.1em;margin:0 0 .5rem}.lead{max-width:740px;color:var(--muted);line-height:1.68;font-size:1.08rem}.jump-links{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.15rem}.jump-links a{color:var(--text);text-decoration:none;padding:.48rem .75rem;border:1px solid var(--border);border-radius:999px;background:var(--surface);font-size:.9rem}.jump-links a:hover{border-color:#a78bfa;color:#c4b5fd}.intro,.compare{margin:1.6rem 0;padding:clamp(1rem,3vw,1.5rem);border:1px solid var(--border);border-radius:16px;background:var(--surface)}.intro h2,.compare h2{margin:.2rem 0 .6rem}.intro p,.note{color:var(--muted);line-height:1.65}.comparison-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:12px;margin-top:1rem}table{width:100%;border-collapse:collapse;min-width:620px}th,td{text-align:left;padding:.9rem;border-bottom:1px solid var(--border);vertical-align:top}th{font-size:.82rem;letter-spacing:.05em;color:#c4b5fd;background:rgba(167,139,250,.08)}td{color:var(--muted);line-height:1.5}tr:last-child td{border-bottom:0}td a{color:var(--accent);font-weight:700}.note{margin:.9rem 0 0}.obsidian-callout{margin:1.5rem 0;padding:1.3rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;border:1px solid rgba(52,211,153,.45);border-radius:16px;background:linear-gradient(135deg,rgba(52,211,153,.11),var(--surface))}.obsidian-callout h2{margin:.2rem 0 .45rem}.obsidian-callout p{color:var(--muted);line-height:1.55;margin:.2rem 0}.actions{margin:1.5rem 0}.course-nav-link{color:var(--muted)}@media(max-width:700px){.obsidian-callout{align-items:stretch;flex-direction:column}.obsidian-callout .start-btn{text-align:center}}
</style>

---
import Base from "../../layouts/Base.astro";
import CourseProgress from "../../components/CourseProgress.astro";
import CourseSchema from "../../components/CourseSchema.astro";
import Quiz from "../../components/Quiz.astro";
import LeadMagnetCTA from "../../components/LeadMagnetCTA.astro";
import CourseTestimonialPlaceholder from "../../components/CourseTestimonialPlaceholder.astro";
const title = "Bepul Figma: UI/UX asoslarini 1 kunda | Tayanch";
const description = "Bepul Figma kursi: UI/UX asoslari, komponentlar va prototip yasash. Dizaynni noldan, o'zbek tilida o'rganing.";
const questions = [
  { q: "Figma — bu nima?", opts: ["Matn muharriri", "UI/UX dizayn vositasi", "Ma'lumotlar bazasi", "Video montaj"], answer: 1 },
  { q: "Komponent nima uchun kerak?", opts: ["Rang o'zgartirish uchun", "Takrorlanuvchi elementni bir joydan boshqarish uchun", "Fayl saqlash uchun", "Hech nima uchun"], answer: 1 },
  { q: "Prototype nima qiladi?", opts: ["Rasm chizadi", "Sahifalarni bog'lab, interfeysni jonli ko'rsatadi", "Kod yozadi", "PDF chiqaradi"], answer: 1 }
];
---

<Base title={title} description={description}>
  <CourseProgress courseId="figma" title="Figma progressi" itemSelector=".modules > li" />
  <CourseSchema name={title} description={description} />

<article class="lesson">
  <div class="course-hero">
    <h1 data-i18n="fig.h1">Bepul Figma: UI/UX asoslarini 1 kunda</h1>
    <div class="price">
      <span class="now">$0</span>
      <span class="badge badge-free">Bepul</span>
      <span class="badge badge-cert">Sertifikat</span>
    </div>
  </div>

  <p class="lead" data-i18n="fig.lead">
    Dizayn noldan — bepul. Figma'da interfeys chizish, komponentlar yaratish
    va prototip orqali g'oyangizni jonli ko'rsatish. Kimga mo'ljallangan: dizaynga yangi kirgan, UI/UX asoslarini noldan o'rganmoqchi bo'lganlarga.
  </p>

  <section class="figma-style-lab" aria-labelledby="figma-style-title">
    <div><span>VIZUAL ASOSLAR</span><h2 id="figma-style-title">Rang va tipografiya</h2><p>Interfeys elementlarini faqat matn bilan emas, rang kontrasti va yozuv ierarxiyasi bilan ajrating.</p></div>
    <div class="figma-preview-grid"><article class="color-board"><h3>Rang palitrasi</h3><div class="swatches"><span style="--swatch:#7d7df5"><b>Primary</b><small>#7D7DF5</small></span><span style="--swatch:#34d399"><b>Success</b><small>#34D399</small></span><span style="--swatch:#fbbf24"><b>Accent</b><small>#FBBF24</small></span><span style="--swatch:#fb7185"><b>Alert</b><small>#FB7185</small></span></div></article><article class="type-board"><h3>Tipografiya namunasi</h3><p class="type-title">Sarlavha</p><p class="type-body">Asosiy matn foydalanuvchi uchun ravshan va o'qilishi oson bo'lishi kerak.</p><p class="type-caption">CAPTION / KICHIK IZOH</p></article></div>
  </section>

  <section>
    <h2 data-i18n="fg.modules">Kurs modullari</h2>
    <ol class="modules">
      <li data-i18n="fg.mod1">Nima uchun Figma? (brauzerda, bepul)</li>
      <li data-i18n="fg.mod2">Frame, shape, text asoslari</li>
      <li data-i18n="fg.mod3">Auto-layout: moslashuvchan dizayn</li>
      <li data-i18n="fg.mod4">Komponent va variantlar (variants)</li>
      <li data-i18n="fg.mod5">Prototype: sahifalarni bog'lash</li>
      <li data-i18n="fg.mod6">UI kit va dizayn tizimi</li>
      <li data-i18n="fg.mod7">Portfolio uchun birinchi loyiha</li>
    </ol>
  </section>

  <section>
    <h2 data-i18n="fg.benefit">Qanday foyda olasiz?</h2>
    <ul>
      <li data-i18n="fg.ben1">UI/UX ko'nikmasi — eng talab qilinadigan yo'nalish</li>
      <li data-i18n="fg.ben2">Mahsulot g'oyangizni jonli prototip qilish</li>
      <li data-i18n="fg.ben3">Freelance yoki ish uchun portfolio</li>
    </ul>
  </section>

  <p class="quiz-hint" data-i18n="fg.hint">Kursni yakunlaganingizdan so'ng sertifikat olasiz.</p>

  <Quiz title="O'z bilimingizni tekshiring" titleI18n="fg.quizTitle" questions={questions} />

  <a href={import.meta.env.BASE_URL + 'kurslar'} class="course-nav-link" style="margin-left:1rem;" data-i18n="fg.all">← Barcha kurslar</a>
</article>

<style>.figma-style-lab{padding:clamp(1.1rem,3vw,1.65rem);border:1px solid color-mix(in srgb,#f472b6 42%,var(--border));border-radius:18px;background:radial-gradient(circle at 94% 8%,color-mix(in srgb,#f472b6 17%,transparent),transparent 25%),linear-gradient(135deg,color-mix(in srgb,#7d7df5 11%,var(--surface)),var(--surface))}.figma-style-lab>div:first-child>span{font-size:.72rem;letter-spacing:.12em;font-weight:800;color:#f9a8d4}.figma-style-lab h2{margin:.25rem 0 .4rem}.figma-style-lab>div:first-child>p{color:var(--muted);margin:0}.figma-preview-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:.8rem;margin-top:1.2rem}.color-board,.type-board{padding:1rem;border:1px solid var(--border);border-radius:14px;background:color-mix(in srgb,var(--bg) 35%,var(--surface))}.color-board h3,.type-board h3{margin:0 0 .8rem;font-size:.9rem}.swatches{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.45rem}.swatches span{display:flex;min-height:105px;flex-direction:column;justify-content:flex-end;padding:.55rem;border-radius:10px;background:linear-gradient(135deg,color-mix(in srgb,var(--swatch) 100%,white),var(--swatch));color:#111827}.swatches b{font-size:.72rem}.swatches small{margin-top:.18rem;font:600 .63rem ui-monospace,monospace;opacity:.72}.type-board p{margin:0}.type-title{font-size:1.65rem;font-weight:800;letter-spacing:-.04em}.type-body{margin-top:.55rem!important;color:var(--muted);line-height:1.55;font-size:.91rem}.type-caption{margin-top:.85rem!important;color:#f9a8d4;font-size:.66rem;letter-spacing:.12em;font-weight:800}@media(max-width:620px){.figma-preview-grid{grid-template-columns:1fr}.swatches span{min-height:82px}}</style>
</Base>

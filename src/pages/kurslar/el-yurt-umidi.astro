---
import Base from "../../layouts/Base.astro";
import CourseSchema from "../../components/CourseSchema.astro";
import CourseTestimonialPlaceholder from "../../components/CourseTestimonialPlaceholder.astro";
import LeadMagnetCTA from "../../components/LeadMagnetCTA.astro";
const title = "El-Yurt Umidi'ni yutaylik | Tayanch";
const description = "El-Yurt Umidi davlat granti bo'yicha suhbatga tayyorgarlik kursi — tez orada to'liq material qo'shiladi.";
---

<Base title={title} description={description}>
  <CourseSchema name={title} description={description} />

<article class="lesson">
  <div class="course-hero">
    <h1>El-Yurt Umidi'ni yutaylik</h1>
    <div class="price">
      <span class="badge badge-new">Tez orada</span>
      <span class="badge badge-cert">Sertifikat</span>
      <span class="uzs">Kurs holati: TO'LDIRILMAGAN — material keyinroq qo'shiladi</span>
    </div>
  </div>

  <p class="lead" data-i18n="ey.lead">
    El-Yurt Umidi davlat granti bo'yicha suhbatga tayyorgarlik kursi —
    tez orada to'liq material qo'shiladi. Hozircha kursning bo'limlar
    strukturasi tayyor. To'liq darslar keyingi yangilanishda yuklanadi.
  </p>
  <section class="coming-stage"><span>TEZ ORADA</span><h2>Material tayyorlanmoqda</h2><p>Bu sahifadagi mavjud kurs holati saqlanadi; to'liq material keyinroq qo'shiladi.</p><div><i></i><i></i><i></i></div></section>

  <section>
    <h2 data-i18n="ey.modules">Kurs bo'limlari (struktura tayyor)</h2>
    <ol class="modules">
      <li data-i18n="ey.mod1">Suhbatga tayyorgarlik</li>
      <li data-i18n="ey.mod2">Bridge texnikasi</li>
      <li data-i18n="ey.mod3">Tez-tez so'raladigan savollar</li>
      <li data-i18n="ey.mod4">Muvaffaqiyatli case'lar</li>
    </ol>
  </section>

  <section>
    <h2>Suhbatga tayyorgarlik</h2>
    <p class="quiz-hint">TO'LDIRILMAGAN — material keyinroq qo'shiladi.</p>
  </section>

  <section>
    <h2>Bridge texnikasi</h2>
    <p class="quiz-hint">TO'LDIRILMAGAN — material keyinroq qo'shiladi.</p>
  </section>

  <section>
    <h2>Tez-tez so'raladigan savollar</h2>
    <p class="quiz-hint">TO'LDIRILMAGAN — material keyinroq qo'shiladi.</p>
  </section>

  <section>
    <h2>Muvaffaqiyatli case'lar</h2>
    <p class="quiz-hint">TO'LDIRILMAGAN — material keyinroq qo'shiladi.</p>
  </section>

  <a href={import.meta.env.BASE_URL + 'kurslar'} class="course-nav-link" style="margin-top:2rem;" data-i18n="ey.all">← Barcha kurslar</a>
</article>
<style>.coming-stage{text-align:center;padding:3rem 1.2rem;border:1px solid color-mix(in srgb,#ec4899 50%,var(--border));border-radius:18px;background:radial-gradient(circle,rgba(236,72,153,.15),transparent 55%),var(--surface)}.coming-stage>span{color:#f9a8d4;font-weight:800;letter-spacing:.16em;font-size:.75rem}.coming-stage h2{font-size:clamp(1.6rem,5vw,2.4rem);margin:.5rem}.coming-stage p{color:var(--muted)}.coming-stage i{display:inline-block;width:8px;height:8px;margin:.3rem;border-radius:50%;background:#ec4899;animation:pulse 1.4s infinite alternate}.coming-stage i:nth-child(2){animation-delay:.2s}.coming-stage i:nth-child(3){animation-delay:.4s}@keyframes pulse{to{transform:translateY(-6px);opacity:.35}}</style>
  <CourseTestimonialPlaceholder />
  <LeadMagnetCTA />
</Base>

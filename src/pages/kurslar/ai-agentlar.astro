---
import Base from "../../layouts/Base.astro";
import LeadMagnetCTA from "../../components/LeadMagnetCTA.astro";
import PaymentInstructions from "../../components/PaymentInstructions.astro";
import CourseProgress from "../../components/CourseProgress.astro";
import CourseSchema from "../../components/CourseSchema.astro";
import Quiz from "../../components/Quiz.astro";
import CourseTestimonialPlaceholder from "../../components/CourseTestimonialPlaceholder.astro";
const title = "AI Agent yaratish: CrewAI va LangGraph | Tayanch";
const description = "AI agent nima va nima uchun kerak: CrewAI va LangGraph bilan o'z agent'ingizni yaratish. Vazifalarni avtomatlashtirish bo'yicha o'zbekcha kurs.";
const questions = [
  { q: "Agent oddiy ChatGPT dan nimasi bilan farq qiladi?", opts: ["Hech farqi yo'q", "Vazifani o'zi rejalashtirib bajarib chiqadi", "Faqat rasm chizadi", "Tezroq yozadi"], answer: 1 },
  { q: "CrewAI nima?", opts: ["O'yin", "Jamoa agent'lari (Planner, Researcher, Writer)", "Pochta", "Virus"], answer: 1 },
  { q: "LangGraph nima qiladi?", opts: ["Rang o'zgartiradi", "Agent'lar oqimini boshqaradi", "Fayl saqlaydi", "Hech narsa"], answer: 1 }
];
---

<Base title={title} description={description}>
  <CourseProgress courseId="ai-agentlar" title="AI Agentlar progressi" itemSelector=".modules > li" labelSelector="ol.modules" />
  <CourseSchema name={title} description={description} />

<article class="lesson">
  <div class="course-hero">
    <h1 data-i18n="aa.h1">O'z AI yordamchingizni yaratish</h1>
    <div class="price">
      <span class="now">$39</span>
      <span class="old">$59</span>
      <span class="badge badge-new">-34%</span>
      <span class="badge badge-cert">Sertifikat</span>
      <span class="uzs">≈ 490 000 so'm</span>
    </div>
  </div>

  <p class="lead" data-i18n="aa.lead">
    Oddiy AI (ChatGPT) — bitta savol. Agent esa vazifani o'zi bajarib chiqadi:
    reja tuzadi, qidiruv qiladi, natijani yozadi. Kimga mo'ljallangan: AI bilan tanishgan va uni haqiqiy ishga (hisobot, tadqiqot, avtomatlashtirish) qo'llamoqchi bo'lganlarga.
  </p>

  <section class="agent-visual" aria-labelledby="agent-flow-title">
    <div class="agent-visual-heading">
      <span>AGENT ISH JARAYONI</span>
      <h2 id="agent-flow-title">Vazifa → reja → qidiruv → natija</h2>
      <p>Oddiy AI savolga javob beradi. Agent esa vazifani bosqichlarga ajratib, ish oqimi bo'ylab olib boradi.</p>
    </div>
    <div class="agent-flow" aria-label="Agent ish bosqichlari">
      <article class="agent-step agent-step-task"><b>01</b><span class="agent-step-icon" aria-hidden="true">✦</span><h3>Vazifa</h3><p>Qanday natija kerakligini oladi.</p></article>
      <span class="agent-arrow" aria-hidden="true">→</span>
      <article class="agent-step agent-step-plan"><b>02</b><span class="agent-step-icon" aria-hidden="true">⌁</span><h3>Reja</h3><p>Vazifani bajariladigan qadamlarga bo'ladi.</p></article>
      <span class="agent-arrow" aria-hidden="true">→</span>
      <article class="agent-step agent-step-search"><b>03</b><span class="agent-step-icon" aria-hidden="true">⌕</span><h3>Qidiruv</h3><p>Kerakli ma'lumot va vositalarni topadi.</p></article>
      <span class="agent-arrow" aria-hidden="true">→</span>
      <article class="agent-step agent-step-result"><b>04</b><span class="agent-step-icon" aria-hidden="true">✓</span><h3>Natija</h3><p>Topilganlarini yig'ib, javobni qaytaradi.</p></article>
    </div>
  </section>

  <section class="framework-compare" aria-labelledby="framework-title">
    <div class="framework-heading"><span>QANDAY TASHKIL QILINADI?</span><h2 id="framework-title">CrewAI va LangGraph</h2><p>Ikki vosita ham agentlar bilan ishlashga yordam beradi, lekin urg'usi boshqacha.</p></div>
    <div class="framework-tabs" role="tablist" aria-label="Frameworkni tanlang">
      <button type="button" class="framework-tab is-active" role="tab" aria-selected="true" aria-controls="crew-panel" id="crew-tab" data-framework="crew">CrewAI <small>Jamoa</small></button>
      <button type="button" class="framework-tab" role="tab" aria-selected="false" aria-controls="graph-panel" id="graph-tab" data-framework="graph">LangGraph <small>Oqim</small></button>
    </div>
    <article class="framework-panel crew-panel" id="crew-panel" role="tabpanel" aria-labelledby="crew-tab" data-framework-panel="crew">
      <div class="framework-illustration crew-illustration" aria-hidden="true"><span>Planner</span><i>→</i><span>Researcher</span><i>→</i><span>Writer</span></div>
      <div><h3>Rol'li agentlar jamoasi</h3><p>CrewAI murakkab vazifani Planner, Researcher va Writer kabi alohida rollarga bo'lib bajarishga mos. Har bir agent o'z vazifasiga e'tibor beradi.</p><p class="framework-tag">Role + Goal + Task</p></div>
    </article>
    <article class="framework-panel graph-panel" id="graph-panel" role="tabpanel" aria-labelledby="graph-tab" data-framework-panel="graph" hidden>
      <div class="framework-illustration graph-illustration" aria-hidden="true"><span>Start</span><i>→</i><span>Node</span><i>↻</i><span>Natija</span></div>
      <div><h3>Boshqariladigan agent oqimi</h3><p>LangGraph ko'p bosqichli agent oqimini graf shaklida bog'laydi: har bir node bitta qadam, ular bir-biriga ulanadi va kerak bo'lsa qayta urinish mumkin.</p><p class="framework-tag">Node + oqim + nazorat</p></div>
    </article>
  </section>

  <section>
    <h2 data-i18n="aa.modules">Kurs modullari</h2>
    <p class="rule-legend" aria-label="Modul tuzilma qoidalari"><span><b>C1</b> ≤30 daqiqa</span><span><b>C2</b> hook → nazariya → amaliy → xulosa → mini-test</span><span><b>C3</b> welcome moduli</span><span><b>C4</b> amaliy transformatsiya</span></p>
    <ol class="modules">
      <li class="is-welcome" data-rule="C3 · C2 · C4" data-i18n="aa.mod1">Welcome moduli: Oddiy AI vs Agent — farqi nima?</li>
      <li data-rule="C1 · C2 · C4" data-i18n="aa.mod2">CrewAI: jamoa agent'lari (Planner, Researcher, Writer)</li>
      <li data-rule="C1 · C2 · C4" data-i18n="aa.mod3">LangGraph: agent'lar oqimini boshqarish</li>
      <li data-rule="C1 · C2 · C4" data-i18n="aa.mod4">Letta: agent'ga uzoq muddatli xotira</li>
      <li data-rule="C1 · C2 · C4" data-i18n="aa.mod5">O'z agent'ingizni yarating (MacBook'da)</li>
      <li data-rule="C1 · C2 · C4" data-i18n="aa.mod6">Qayerda qo'llash: tadqiqot, kontent, biznes</li>
      <li data-rule="C1 · C2 · C4" data-i18n="aa.mod7">AI va agentlar nimani tezlashtiradi? (yangi dars)</li>
    </ol>
  </section>

  <section style="margin-top:3rem;">
    <h2>7. AI va agentlar nimani tezlashtiradi?</h2>
    <p class="lead">
      Bu — kursning eng muhim darsi. Ko'p odam AI va agentlarni "o'rganish kerak"
      degan maqsad bilan o'rganadi. Lekin aslida ular — maqsad emas, faqat <b>vosita</b>.
    </p>

    <div style="background:var(--accent-soft);border:1px solid var(--accent);border-left:4px solid var(--accent);border-radius:12px;padding:16px 18px;margin:1.5rem 0;">
      <strong style="color:var(--accent);">ASOSIY G'OYA:</strong>
      AI va agentlar — <b>TEZLASHTIRUVCHI</b> vosita, <b>MAQSAD</b> emas.
    </div>

    <ul style="list-style:none;padding:0;margin:1.5rem 0;display:flex;flex-direction:column;gap:12px;">
      <li style="padding:14px 16px 14px 50px;position:relative;border:1px solid var(--border);border-radius:12px;background:var(--surface);font-weight:500;">
        <span style="position:absolute;left:14px;top:50%;transform:translateY(-50%);width:26px;height:26px;border-radius:8px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-weight:800;">📚</span>
        <b>O'qiyotgan</b> bo'lsangiz — AI o'qishingizni yengilroq, osonroq va tezroq qiladi:
        mavzuni tushuntiradi, reja tuzib beradi, mashqlarni tekshiradi.
      </li>
      <li style="padding:14px 16px 14px 50px;position:relative;border:1px solid var(--border);border-radius:12px;background:var(--surface);font-weight:500;">
        <span style="position:absolute;left:14px;top:50%;transform:translateY(-50%);width:26px;height:26px;border-radius:8px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-weight:800;">⚙️</span>
        <b>Loyiha</b> ustida ishlayotgan bo'lsangiz — AI loyihangizni aniqroq va tezroq
        bitirishga yordam beradi: kod, tadqiqot, kontent, hisob-kitob.
      </li>
      <li style="padding:14px 16px 14px 50px;position:relative;border:1px solid #ef4444;border-radius:12px;background:color-mix(in srgb,#ef4444 10%,transparent);font-weight:500;">
        <span style="position:absolute;left:14px;top:50%;transform:translateY(-50%);width:26px;height:26px;border-radius:8px;background:#ef4444;color:#fff;display:grid;place-items:center;font-weight:800;">!</span>
        <b>LEKIN:</b> agar siz hech qanday harakat qilmasdan, shunchaki "AI va agentlarni
        o'rganish uchun" o'rgansangiz — katta natija bo'lmaydi. O'rganishning o'zi maqsad
        bo'lishi shart emas, u faqat <b>VOSITA</b>.
      </li>
    </ul>

    <h3 style="margin-top:2.5rem;color:var(--text);">Metafar — kino va tezlashtirish</h3>
    <p>
      Kino ko'rayapsiz — noutbuk yoki kompyuterda. Voqea qanday tugashini bilish uchun
      kinoni tezlashtirasiz, va kerakli sahna (masalan, jang sahnasi) tezroq yetib keladi.
      <b>Kinoni tezlashtirish mumkin — lekin kinoning O'ZI bo'lmasa, nimani tezlashtirasiz?</b>
    </p>
    <p>
      AI va agentlar bilan ishlash ham xuddi shunday: sizda <b>MAQSAD</b> (kino) bo'lsa,
      AI o'sha yo'lni qisqartiradi va tezlashtiradi. Lekin siz hech qanday harakat
      qilmasangiz — tezlashtiradigan narsaning o'zi yo'q.
    </p>

    <svg viewBox="0 0 680 300" role="img" aria-label="AI va agentlar faqat mavjud maqsadni tezlashtiradi — ko'rsatuvchi diagramma" style="width:100%;height:auto;max-width:680px;display:block;margin:1.5rem auto;">
      <!-- LEFT PANEL -->
      <rect x="16" y="16" width="312" height="268" rx="16" fill="#181a24" stroke="#2a2c3a"/>
      <text x="36" y="46" fill="#7d7df5" font-size="15" font-weight="700" font-family="system-ui">1. Maqsad (kino) + AI</text>
      <!-- film strip -->
      <rect x="36" y="60" width="256" height="72" rx="8" fill="#0e0f15" stroke="#2a2c3a"/>
      <g fill="#2a2c3a">
        <circle cx="50" cy="70" r="2.6"/><circle cx="68" cy="70" r="2.6"/><circle cx="86" cy="70" r="2.6"/><circle cx="104" cy="70" r="2.6"/><circle cx="122" cy="70" r="2.6"/><circle cx="140" cy="70" r="2.6"/><circle cx="158" cy="70" r="2.6"/><circle cx="176" cy="70" r="2.6"/><circle cx="194" cy="70" r="2.6"/><circle cx="212" cy="70" r="2.6"/><circle cx="230" cy="70" r="2.6"/><circle cx="248" cy="70" r="2.6"/><circle cx="266" cy="70" r="2.6"/><circle cx="284" cy="70" r="2.6"/>
        <circle cx="50" cy="122" r="2.6"/><circle cx="68" cy="122" r="2.6"/><circle cx="86" cy="122" r="2.6"/><circle cx="104" cy="122" r="2.6"/><circle cx="122" cy="122" r="2.6"/><circle cx="140" cy="122" r="2.6"/><circle cx="158" cy="122" r="2.6"/><circle cx="176" cy="122" r="2.6"/><circle cx="194" cy="122" r="2.6"/><circle cx="212" cy="122" r="2.6"/><circle cx="230" cy="122" r="2.6"/><circle cx="248" cy="122" r="2.6"/><circle cx="266" cy="122" r="2.6"/>
      </g>
      <line x1="96" y1="62" x2="96" y2="130" stroke="#2a2c3a" stroke-width="2"/>
      <line x1="152" y1="62" x2="152" y2="130" stroke="#2a2c3a" stroke-width="2"/>
      <line x1="208" y1="62" x2="208" y2="130" stroke="#2a2c3a" stroke-width="2"/>
      <line x1="264" y1="62" x2="264" y2="130" stroke="#2a2c3a" stroke-width="2"/>
      <rect x="264" y="62" width="28" height="68" rx="4" fill="#7d7df5" opacity="0.18"/>
      <text x="278" y="104" fill="#7d7df5" font-size="20" text-anchor="middle" font-family="system-ui">★</text>
      <!-- fast-forward arrow -->
      <text x="60" y="162" fill="#9a9ab2" font-size="12" font-family="system-ui">AI tezlashtiradi</text>
      <line x1="60" y1="178" x2="244" y2="178" stroke="#7d7df5" stroke-width="3"/>
      <polygon points="244,170 244,186 262,178" fill="#7d7df5"/>
      <!-- result marker -->
      <circle cx="290" cy="178" r="15" fill="#34d399"/>
      <text x="290" y="184" fill="#062b1a" font-size="16" font-weight="800" text-anchor="middle" font-family="system-ui">✓</text>
      <text x="36" y="278" fill="#34d399" font-size="13" font-weight="700" font-family="system-ui">Natija tezroq yetib keladi</text>

      <!-- RIGHT PANEL -->
      <rect x="352" y="16" width="312" height="268" rx="16" fill="#181a24" stroke="#2a2c3a"/>
      <text x="372" y="46" fill="#ef4444" font-size="15" font-weight="700" font-family="system-ui">2. Faqat AI — maqsad yo'q</text>
      <!-- empty reel -->
      <circle cx="508" cy="105" r="44" fill="none" stroke="#2a2c3a" stroke-width="2" stroke-dasharray="5 5"/>
      <text x="508" y="116" fill="#9a9ab2" font-size="30" text-anchor="middle" font-family="system-ui">?</text>
      <!-- arrow that goes nowhere useful -->
      <text x="372" y="192" fill="#9a9ab2" font-size="12" font-family="system-ui">tezlashtirish?</text>
      <line x1="372" y1="208" x2="456" y2="208" stroke="#ef4444" stroke-width="3"/>
      <polygon points="456,200 456,216 474,208" fill="#ef4444"/>
      <text x="372" y="278" fill="#ef4444" font-size="13" font-weight="700" font-family="system-ui">Tezlashtiradigan narsa yo'q</text>
    </svg>
    <p class="quiz-hint">Chapda — maqsad bor, AI uni tezlashtiradi. O'ngda — faqat vosita, maqsad yo'q; tezlashtiradigan narsaning o'zi mavjud emas.</p>

    <div style="background:color-mix(in srgb,#34d399 12%,transparent);border:1px solid #34d399;border-radius:12px;padding:16px 18px;margin:2rem 0;">
      <strong style="color:#34d399;">XULOSA:</strong>
      Avval maqsad va harakat bo'lsin, keyin AI/agentlarni shu maqsad yo'lida
      <b>vosita sifatida</b> ishlating. AI sizning o'rnipingizda ishlamaydi — u sizning
      yo'lingizni qisqartiradi.
    </div>

    <div style="border:1px dashed var(--border);border-radius:12px;padding:18px 20px;margin-top:2rem;background:var(--surface);">
      <h3 style="margin-top:0;color:var(--accent);">Amaliy topshiriq</h3>
      <p style="color:var(--text);">
        O'zingizning hozirgi <b>maqsadingizni</b> yozing, keyin AI qanday qilib o'sha
        maqsadga tezroq yetishga yordam berishi mumkinligini <b>3 ta band</b> bilan
        tasvirlab bering:
      </p>
      <ol style="color:var(--muted);line-height:2;">
        <li>Maqsadim: ________________________________________________</li>
        <li>AI yordamida tezlashtirish 1: ________________________________</li>
        <li>AI yordamida tezlashtirish 2: ________________________________</li>
        <li>AI yordamida tezlashtirish 3: ________________________________</li>
      </ol>
    </div>
  </section>

  <section style="margin-top:3rem;">
    <h2>8. O'z agent'ingizni o'rnating (MacBook'da)</h2>
    <p>
      Quyidagi agentlar va kutubxonalar bepul va ochiq manba. Ularni o'z
      MacBook'ingizda sinab ko'rishingiz mumkin. Barchasi Python (.venv) orqali
      o'rnatiladi — izolyatsiyalangan joyda, fon-xizmat sifatida emas.
    </p>

    <h3>Ollama — mahalliy (local) AI model</h3>
    <p>
      MacBook'da AI model'larni <b>internet kerak emas</b> holda ishlatish.
      Model: <code>llama3.2</code> (kichik, tekin).
    </p>
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px;overflow:auto;"><code>ollama run llama3.2</code></pre>

    <h3>OpenWebUI — mahalliy ChatGPT interfeysi</h3>
    <p>
      Brauzerda ChatGPT kabi UI, Ollama'ga ulanadi. Docker orqali o'rnatiladi,
      manzil: <code>http://localhost:3000</code>. API key kerak emas, hamma mahalliy.
    </p>
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px;overflow:auto;"><code>docker run -d -p 3000:8080 -v ollama:/root/.ollama \
  -v open-webui:/app/backend/data \
  --name open-webui ghcr.io/open-webui/open-webui</code></pre>

    <h3>CrewAI — ko'p-agent (jamoa) freymvorki</h3>
    <p>
      Bir nechta agent'ni jamoa qilib ishlatish (Role + Goal + Task). Murakkab
      vazifalarni agentlar bo'lib bajaradi. <code>.venv-aiagents</code> ichiga o'rnatiladi.
    </p>
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px;overflow:auto;"><code>source ~/.venv-aiagents/bin/activate
pip install crewai</code></pre>

    <h3>MemGPT (Letta) — xotiraga ega agent</h3>
    <p>
      Uzoq muddatli xotiraga ega agent. Kontekstni eslab qoladi, vault bilan
      bog'lash mumkin.
    </p>
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px;overflow:auto;"><code>pip install pymemgpt</code></pre>

    <h3>AutoGPT — avtonom agent</h3>
    <p>
      O'zi maqsad qo'yib, reja tuzib bajaradigan agent. Vazifa berasiz, u o'zi bajaradi.
    </p>
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px;overflow:auto;"><code>pip install autogpt</code></pre>

    <h3>LangGraph — agent'lar oqimini boshqarish</h3>
    <p>
      Ko'p bosqichli (multi-step) AI agent'larni <b>graf</b> shaklida yaratish
      kutubxonasi (LangChain'dan). Har bir "node" bitta qadam, ular bir-biriga
      ulanadi. Multi-agent tizimlar, murakkab workflow, va aniq nazorat uchun.
    </p>
    <pre style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px;overflow:auto;"><code>source ~/.venv-aiagents/bin/activate
pip install langgraph</code></pre>
    <div style="background:color-mix(in srgb,#34d399 12%,transparent);border:1px solid #34d399;border-radius:12px;padding:14px 16px;margin:1rem 0;">
      <strong style="color:#34d399;">Tekinmi?</strong> Ha — barchasi open-source (MIT
      yoki类似). <code>pip install langgraph</code> bilan o'rnatiladi.
    </div>
  </section>

  <section style="margin-top:3rem;">
    <h2>9. AI Agentlar Ofisi</h2>
    <p>
      Alohida agentlarni birlashtirib, to'liq tizim qurish mumkin. Sinab ko'rilgan
      kombinatsiya:
    </p>
    <ul style="display:flex;flex-direction:column;gap:10px;padding:0;list-style:none;">
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>CrewAI</b> (jamoa) — Planner, Researcher, Writer kabi rol'lardagi agent'lar.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Letta</b> (xotira) — agent'ga uzoq muddatli xotira beradi.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>LangGraph</b> (oqim / marshut) — bot'dan kirgan buyruqni turli agent'larga yo'naltiradi; har bir natijani keyingi qadamga uzatadi, xatolik bo'lsa qayta urinish (retry).</li>
    </ul>
    <p>
      Bu uchala birikmasi — <b>AI Agentlar Ofisi</b>: buyruq kelsa, LangGraph orqali
      kerakli agent'ga yo'naltiriladi, natija yig'iladi va qaytariladi.
    </p>
    <p class="quiz-hint">
      Qo'shimcha o'qish: agent orchestration'da uchta asosiy pattern — <b>Sequential</b>
      (A→B→C), <b>Hierarchical / supervisor</b> (bitta boshqaruvchi mutaxassis agent'ga
      topshiradi), <b>Parallel</b> (bir nechta agent bir vaqtda, natijalar keyin
      birlashtiriladi). Bog'lovchi standart sifatida <b>MCP (Model Context Protocol)</b>
      keng qabul qilingan.
    </p>
  </section>

  <a href={import.meta.env.BASE_URL + 'bog-lanish'} class="start-btn" style="margin-top:2rem;" data-i18n="aa.buy">Kursni sotib olish →</a>
  <a href={import.meta.env.BASE_URL + 'kurslar'} class="course-nav-link" style="margin-left:1rem;" data-i18n="aa.all">← Barcha kurslar</a>

  <Quiz title="O'z bilimingizni tekshiring" titleI18n="aa.quizTitle" questions={questions} />
  <PaymentInstructions course="AI Agentlar nega kerak?" price="$39 · ≈ 490 000 so'm" />
  <CourseTestimonialPlaceholder />
  <LeadMagnetCTA />
</article>

<style>
.agent-visual,.framework-compare{border:1px solid var(--border);border-radius:18px;padding:clamp(1.1rem,3vw,1.75rem);background:var(--surface);overflow:hidden}.agent-visual{background:radial-gradient(circle at 92% 10%,color-mix(in srgb,#38bdf8 16%,transparent),transparent 28%),linear-gradient(135deg,color-mix(in srgb,#7d7df5 10%,var(--surface)),var(--surface))}.agent-visual-heading>span,.framework-heading>span{font-size:.72rem;letter-spacing:.12em;font-weight:800;color:#a5b4fc}.agent-visual h2,.framework-compare h2{margin:.28rem 0 .45rem}.agent-visual-heading p,.framework-heading p{margin:0;color:var(--muted)}.agent-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:stretch;gap:.6rem;margin-top:1.5rem}.agent-step{position:relative;padding:1rem;border:1px solid var(--border);border-radius:14px;background:color-mix(in srgb,var(--bg) 45%,var(--surface));min-height:158px;transition:transform .2s,border-color .2s}.agent-step:hover{transform:translateY(-4px)}.agent-step b{font-size:.68rem;color:var(--muted)}.agent-step-icon{display:grid;place-items:center;width:34px;height:34px;margin:.65rem 0;border-radius:10px;font-size:1.1rem;font-weight:800}.agent-step h3{font-size:1rem;margin:0 0 .35rem}.agent-step p{font-size:.83rem;line-height:1.45;color:var(--muted);margin:0}.agent-step-task{border-color:color-mix(in srgb,#a78bfa 55%,var(--border))}.agent-step-task .agent-step-icon{background:#a78bfa;color:#21134d}.agent-step-plan{border-color:color-mix(in srgb,#38bdf8 55%,var(--border))}.agent-step-plan .agent-step-icon{background:#38bdf8;color:#062a3a}.agent-step-search{border-color:color-mix(in srgb,#fbbf24 55%,var(--border))}.agent-step-search .agent-step-icon{background:#fbbf24;color:#3c2900}.agent-step-result{border-color:color-mix(in srgb,#34d399 55%,var(--border))}.agent-step-result .agent-step-icon{background:#34d399;color:#062b20}.agent-arrow{display:none}.framework-compare{margin-top:1.25rem;background:linear-gradient(135deg,color-mix(in srgb,#fb7185 7%,var(--surface)),var(--surface) 52%,color-mix(in srgb,#34d399 8%,var(--surface)))}.framework-tabs{display:flex;gap:.5rem;margin:1.35rem 0 .85rem}.framework-tab{flex:1;text-align:left;border:1px solid var(--border);border-radius:11px;padding:.8rem 1rem;background:color-mix(in srgb,var(--bg) 45%,var(--surface));color:var(--text);font:inherit;font-weight:800;cursor:pointer}.framework-tab small{display:block;margin-top:.15rem;color:var(--muted);font-size:.75rem;font-weight:600}.framework-tab.is-active{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 17%,var(--surface));box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 30%,transparent)}.framework-tab:focus-visible{outline:2px solid #a5b4fc;outline-offset:2px}.framework-panel{display:grid;grid-template-columns:minmax(180px,.8fr) 1.2fr;gap:1rem;align-items:center;border:1px solid var(--border);border-radius:14px;padding:1rem;background:color-mix(in srgb,var(--bg) 32%,var(--surface));animation:agent-fade .25s ease both}.framework-panel h3{margin:0 0 .45rem}.framework-panel p{margin:.35rem 0;color:var(--muted);line-height:1.55}.framework-illustration{display:flex;flex-wrap:wrap;gap:.35rem;align-items:center;justify-content:center;padding:1rem;border-radius:11px;background:color-mix(in srgb,var(--accent) 7%,var(--bg));font-size:.75rem;font-weight:800}.framework-illustration span{padding:.55rem .45rem;border:1px solid var(--border);border-radius:8px;background:var(--surface)}.framework-illustration i{font-style:normal;font-size:1rem;color:var(--accent)}.crew-illustration span:nth-of-type(1){border-color:#a78bfa}.crew-illustration span:nth-of-type(2){border-color:#38bdf8}.crew-illustration span:nth-of-type(3){border-color:#34d399}.graph-illustration span:nth-of-type(2){border-color:#fbbf24}.framework-tag{display:inline-block!important;padding:.35rem .55rem;border-radius:999px;background:color-mix(in srgb,var(--accent) 15%,transparent);color:#c7d2fe!important;font-size:.78rem;font-weight:700}@keyframes agent-fade{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}@media(max-width:700px){.agent-flow{grid-template-columns:1fr}.agent-step{min-height:0}.agent-arrow{display:block;text-align:center;color:var(--accent);font-size:1.35rem;transform:rotate(90deg);height:18px}.framework-panel{grid-template-columns:1fr}.framework-illustration{min-height:70px}}@media(prefers-reduced-motion:reduce){.agent-step{transition:none}.framework-panel{animation:none}}
</style>
<script>
  document.querySelectorAll('.framework-compare').forEach((section) => {
    const tabs = section.querySelectorAll('[data-framework]');
    const panels = section.querySelectorAll('[data-framework-panel]');
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const key = tab.dataset.framework;
      tabs.forEach((item) => { const active=item===tab; item.classList.toggle('is-active',active); item.setAttribute('aria-selected',String(active)); });
      panels.forEach((panel) => { panel.hidden = panel.dataset.frameworkPanel !== key; });
    }));
  });
</script>


---
import Base from "../../layouts/Base.astro";
import TelegramCTA from "../../components/TelegramCTA.astro";
import Quiz from "../../components/Quiz.astro";
const title = "Prompt Engineering — O'rganamiz";
const description = "Nima uchun kerak, qanday foyda, qayerda qo'llash — amaliy kurs";
const questions = [
  { q: "Prompt — bu nima?", opts: ["AI ga berilgan ko'rsatma", "Rasm fayli", "Kod qatori", "Ma'lumotlar bazasi"], answer: 0 },
  { q: "Few-shot usuli nima?", opts: ["Bitta misol", "Misol orqali o'rgatish", "Hech narsa", "Test rejimi"], answer: 1 },
  { q: "Chain-of-thought qanday yordam beradi?", opts: ["Tezroq yozish uchun", "Murakkab vazifani bosqichlab yechish uchun", "Rang o'zgartirish uchun", "Fayl saqlash uchun"], answer: 1 }
];
---

<Base title={title} description={description}>

<article class="lesson">
  <div class="course-hero">
    <h1>Prompt Engineering</h1>
    <div class="price">
      <span class="now">$29</span>
      <span class="old">$49</span>
      <span class="badge badge-new">-40%</span>
      <span class="badge badge-cert">Sertifikat</span>
      <span class="uzs">≈ 360 000 so'm</span>
    </div>
  </div>

  <p class="lead" data-i18n="pe.lead">
    AI bilan to'g'ri muloqot qilish san'ati. Nima uchun kerak, qanday foyda olish,
    qayerda qo'llash — barchasi amaliy misollar bilan.
  </p>

  <section>
    <h2 data-i18n="pe.modules">Kurs modullari</h2>
    <ol class="modules">
      <li data-i18n="pe.mod1">Nima uchun Prompt Engineering kerak? (AI telepatiya qila olmaydi)</li>
      <li data-i18n="pe.mod2">Prompt tuzilmasi: roll, kontekst, misollar, format</li>
      <li data-i18n="pe.mod3">Amaliy mashq: IELTS essay yozish prompt'i</li>
      <li data-i18n="pe.mod4">Chain-of-thought: murakkab vazifalni bo'lish</li>
      <li data-i18n="pe.mod5">Few-shot: misollar orqali o'rgatish</li>
      <li data-i18n="pe.mod6">Qayerda qo'llash: yozish, kod, tadqiqot, biznes</li>
      <li data-i18n="pe.mod7">Strawberryboo orqali avtomatik capture</li>
    </ol>
  </section>

  <section>
    <h2 data-i18n="pe.benefit">Qanday foyda olasiz?</h2>
    <ul>
      <li data-i18n="pe.ben1">Vaqt tejash — 1 soatlik ishni 5 daqiqaga</li>
      <li data-i18n="pe.ben2">Sifatli natija — aniq, strukturaviy</li>
      <li data-i18n="pe.ben3">Pul ishlash — kontent, kod tezroq</li>
    </ul>
  </section>

  <a href="/bog-lanish" class="start-btn" style="margin-top:2rem;" data-i18n="pe.buy">Kursni sotib olish →</a>
  <a href="/kurslar" class="enroll" style="margin-left:1rem;" data-i18n="pe.all">← Barcha kurslar</a>

  <Quiz title="O'z bilimingizni tekshiring" titleI18n="pe.quizTitle" quizI18n="pe" questions={questions} />
</article>
<TelegramCTA />
</Base>

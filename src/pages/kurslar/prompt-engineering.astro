---
import Base from "../../layouts/Base.astro";
import PaymentInstructions from "../../components/PaymentInstructions.astro";
import CourseProgress from "../../components/CourseProgress.astro";
import CourseSchema from "../../components/CourseSchema.astro";
import Quiz from "../../components/Quiz.astro";
const title = "Prompt Engineering — Tayanch";
const description = "Nima uchun kerak, qanday foyda, qayerda qo'llash — amaliy kurs";
const questions = [
  { q: "Prompt — bu nima?", opts: ["AI ga berilgan ko'rsatma", "Rasm fayli", "Kod qatori", "Ma'lumotlar bazasi"], answer: 0 },
  { q: "Few-shot usuli nima?", opts: ["Bitta misol", "Misol orqali o'rgatish", "Hech narsa", "Test rejimi"], answer: 1 },
  { q: "Chain-of-thought qanday yordam beradi?", opts: ["Tezroq yozish uchun", "Murakkab vazifani bosqichlab yechish uchun", "Rang o'zgartirish uchun", "Fayl saqlash uchun"], answer: 1 }
];
---

<Base title={title} description={description}>
  <CourseProgress courseId="prompt-engineering" title="Prompt Engineering progressi" itemSelector=".modules > li" labelSelector="ol.modules" />
  <CourseSchema name={title} description={description} />

<article class="lesson">
  <div class="course-hero">
    <h1>Prompt Engineering</h1>
    <div class="price">
      <span class="now">$29</span>
      <span class="old">$49</span>
      <span class="badge badge-new">-40%</span>
      <span class="badge badge-cert">Sertifikat</span>
      <span class="uzs">≈ 360 000 so'm</span>
    </div>
  </div>

  <p class="lead" data-i18n="pe.lead">
    AI bilan to'g'ri muloqot qilish san'ati. Nima uchun kerak, qanday foyda olish,
    qayerda qo'llash — barchasi amaliy misollar bilan.
  </p>

  <section class="prompt-lab" aria-labelledby="prompt-lab-title">
    <div class="prompt-lab-head">
      <div>
        <span class="prompt-lab-kicker">AMALIY TAQQOSLASH</span>
        <h2 id="prompt-lab-title">Yomon prompt / Yaxshi prompt</h2>
        <p>Bir xil vazifa uchun ko'rsatmaning aniqligi natijani qanday yo'naltirishini solishtiring.</p>
      </div>
      <div class="prompt-toggle" role="group" aria-label="Prompt turini tanlang">
        <button type="button" class="prompt-toggle-btn is-active" data-prompt-mode="bad" aria-pressed="true">Yomon prompt</button>
        <button type="button" class="prompt-toggle-btn" data-prompt-mode="good" aria-pressed="false">Yaxshi prompt</button>
      </div>
    </div>

    <div class="prompt-compare" data-prompt-compare>
      <article class="prompt-pane prompt-pane-bad" data-prompt-pane="bad">
        <div class="prompt-pane-label"><span aria-hidden="true">!</span> NOANIQ KO'RSATMA</div>
        <p class="prompt-code">“IELTS essayni bahola.”</p>
        <ul>
          <li>Rol ko'rsatilmagan</li>
          <li>Kontekst va cheklov yo'q</li>
          <li>Natija formati aniq emas</li>
        </ul>
      </article>
      <article class="prompt-pane prompt-pane-good" data-prompt-pane="good" hidden>
        <div class="prompt-pane-label"><span aria-hidden="true">✓</span> ANIQLASHTIRILGAN KO'RSATMA</div>
        <p class="prompt-code">“Sen IELTS Writing bo'yicha o'qituvchisan. Quyidagi essay'ni 250 so'z chegarasida baholab, kamchiliklarni (grammatika, coherence, task response) ajratib ko'rsat va har biriga 1 ta tuzatish taklif qil. Natijani jadval ko'rinishida qaytar.”</p>
        <ul>
          <li>Rol: IELTS Writing o'qituvchisi</li>
          <li>Kontekst va aniq cheklovlar bor</li>
          <li>Javob formati ko'rsatilgan</li>
        </ul>
      </article>
    </div>
    <p class="prompt-lab-note" aria-live="polite">Hozir: <b data-prompt-status>Yomon prompt</b> — vazifa bor, lekin AI uchun yo'nalish yetarli emas.</p>
  </section>

  <section>
    <h2 data-i18n="pe.modules">Kurs modullari</h2>
    <p class="rule-legend" aria-label="Modul tuzilma qoidalari"><span><b>C1</b> ≤30 daqiqa</span><span><b>C2</b> hook → nazariya → amaliy → xulosa → mini-test</span><span><b>C3</b> welcome moduli</span><span><b>C4</b> amaliy transformatsiya</span></p>
    <ol class="modules">
      <li class="is-welcome" data-rule="C3 · C2 · C4" data-i18n="pe.mod1">Welcome moduli: Nima uchun Prompt Engineering kerak? (AI telepatiya qila olmaydi)</li>
      <li data-rule="C1 · C2 · C4" data-i18n="pe.mod2">Prompt tuzilmasi: roll, kontekst, misollar, format</li>
      <li data-rule="C1 · C2 · C4" data-i18n="pe.mod3">Amaliy mashq: IELTS essay yozish prompt'i</li>
      <li data-rule="C1 · C2" data-i18n="pe.mod4">Chain-of-thought: murakkab vazifalni bo'lish</li>
      <li data-rule="C1 · C2" data-i18n="pe.mod5">Few-shot: misollar orqali o'rgatish</li>
      <li data-rule="C1 · C2 · C4" data-i18n="pe.mod6">Qayerda qo'llash: yozish, kod, tadqiqot, biznes</li>
      <li data-rule="C1 · C2 · C4" data-i18n="pe.mod7">Tayanch orqali avtomatik capture</li>
    </ol>
  </section>

  <section>
    <h2>1. Nima uchun Prompt Engineering kerak?</h2>
    <p>
      <b>Prompt</b> — bu siz AI'ga beradigan ko'rsatma (instructions). Maqsadi
      AI'ni aniq, kerakli natijaga yo'naltirish. Buni odamga yo'nalish berish
      bilan solishtiring.
    </p>

    <h3>Yo'nalish analogiyasi (directions analogy)</h3>
    <ul>
      <li><b>Noaniq prompt</b> — "Downtown'ga!" deb baqirish kabi. Ehtimol yetib boradi, lekin aynan xohlagan yo'lingiz bilan emas.</li>
      <li><b>Yaxshi prompt</b> — aniq, qadam-baqadam yo'nalish berish kabi. AI aynan nima qilishini tushunadi.</li>
    </ul>

    <h3>Prompt Engineering nima?</h3>
    <p>
      Bu — AI uchun ko'rsatmalarni loyihalash va takomillashtirish mahorati.
      Bu kod yozish emas, balki <b>aniq muloqat</b>. Maqsadingiz — ajoyib AI
      muloqotchisiga aylanish.
    </p>

    <div style="background:var(--accent-soft);border:1px solid var(--accent);border-left:4px solid var(--accent);border-radius:12px;padding:14px 16px;margin:1rem 0;">
      <strong style="color:var(--accent);">ENG MUHIM QOIDA:</strong>
      AI ko'rsatmalarida asosiy qoida — <b>"Quality in, quality out"</b>
      (sifatli kirdi → sifatli chiqdi). AI'ning javobi to'g'ridan-to'g'ri sizning
      prompt'ingiz sifatiga bog'liq.
    </div>
    <p>
      Modelda o'z-o'zidan "vazifa ro'yxati" yo'q — vazifani, rolni, formatni va
      cheklovlarni aynan <b>prompt ichida siz</b> belgilaysiz. Yaxshi prompt →
      yaxshi natija, barcha uchun.
    </p>
  </section>

  <section>
    <h2>2. Prompt tuzilmasi: roll, kontekst, misollar, format</h2>
    <p>Yaxshi prompt odatda to'rt qismdan iborat:</p>
    <ul style="display:flex;flex-direction:column;gap:10px;padding:0;list-style:none;">
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Roll (Role)</b> — "Sen IELTS o'qituvchisan" yoki "Sen tajribali Python dasturchisan" deb boshlang. Bu AI'ga ohang va bilimdo'nani beradi.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Kontekst (Context)</b> — qo'shimcha ma'lumot: kim uchun, qanday vaziyat, qanday cheklovlar. Qanchalik aniq bo'lsa, natija shuncha mos keladi.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Misollar (Examples / Few-shot)</b> — bitta yoki bir nechta namuna ko'rsating; AI xuddi shu uslubda javob beradi ("misol orqali o'rgatish").</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Format</b> — qanday ko'rinishda qaytarishini ayting: ro'yxat, jadval, JSON, qisqa xulosa.</li>
    </ul>

    <h3>Chain-of-thought (bosqichlab fikrlash)</h3>
    <p>
      Murakkab vazifalarni "avval o'ylab chiq, keyin javob ber" deb yo'naltiring —
      "Qadam-baqadam tushuntir" iborasi AI'ga bosqichlarni navbatma-navbat yechishga
      yordam beradi va xatolik kamayadi.
    </p>
    <div style="border:1px dashed var(--border);border-radius:12px;padding:14px 16px;margin:1rem 0;background:var(--surface);">
      <h4 style="margin-top:0;color:var(--accent);">Amaliy mashq — IELTS essay prompt'i</h4>
      <p style="color:var(--text);">
        "Sen IELTS Writing bo'yicha o'qituvchisan. Quyidagi essay'ni 250 so'z
        chegarasida baholab, kamchiliklarni (grammatika, coherence, task response)
        ajratib ko'rsat va har biriga 1 ta tuzatish taklif qil. Natijani jadval
        ko'rinishida qaytar."
      </p>
    </div>
  </section>

  <section>
    <h2>3. AI modellari va studio'lari</h2>
    <p>
      Prompt yozishdan oldin to'g'ri vositani tanlash muhim. Quyida eng
      foydali AI modellari va studio'lari (qisqacha):
    </p>
    <ul style="display:flex;flex-direction:column;gap:10px;padding:0;list-style:none;">
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Claude (Anthropic)</b> — suhbat, kod yozish (Claude Code) va murakkab ko'p bosqichli ishlar uchun. Modellar: Haiku (tez), Sonnet (muvozanatli), Opus (eng kuchli).</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Google AI Studio</b> — Gemini modellari bilan tezkor prototip (bepul, brauzer-asosidagi). API kalit generatsiya qilish uchun ham ishlatiladi. 2026 aprelidan Pro-seriya faqat pullik.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Google Antigravity</b> — agentik dasturlash muhiti (Gemini asosida). Yuqori darajadagi vazifa bersang, reja tuzadi, kod yozadi, serverni ishga tushiradi.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Cursor</b> — AI-native kod muharriri (VS Code asosida). Agent rejimi butun kod bazasini tushunib mustaqil o'zgartiradi.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Grok (xAI)</b> — real vaqtdagi X (Twitter) qidiruv, DeepSearch va "Big Brain" rejimi. Bepul tier juda cheklangan.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>NotebookLM (Google)</b> — hujjat-asosidagi tadqiqot yordamchisi (RAG). Faqat yuklagan manbalar asosida javob beradi, "Audio Overview" podkast yaratadi. To'liq bepul.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>WorkBuddy AI (Tencent)</b> — multi-agent ish stansiyasi. Bitta buyruq → rejalashtirish + bajarish + tayyor natija (hisobot, slayd, jadval, hujjat). Telegram/Discord orqali ham boshqariladi.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Hermes Agent (Nous Research)</b> — ochiq manba, bepul AI agent. Vazifani hal qilib, undan "Skill" yaratadi — vaqt o'tgan sari "o'sib boradi". 400+ model tanlash imkoni.</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Manus</b> — avtonom AI agent (Monica.im). Bitta buyruqdan reja tuzadi, internetda qidiradi, kod yozadi (virtual kompyuter ichida).</li>
      <li style="border:1px solid var(--border);border-radius:12px;padding:12px 14px;background:var(--surface);"><b>Strawberry Browser</b> — ichiga AI agentlari ("Companions") o'rnatilgan "o'zi harakatlanadigan" brauzer. Saytlarda haqiqiy amallar (bosish, forma to'ldirish, parallel tadqiqot) bajara oladi.</li>
    </ul>
    <p class="quiz-hint">
      Baholash uchun: <b>LMArena</b> va <b>Design Arena</b> — AI modellarni
      anonim tarzda solishtirib, foydalanuvchi ovozi bilan reyting beradigan
      bepul platformalar (qaysi model yaxshiroq ekanini xolis bilish uchun).
    </p>
  </section>

  <section>
    <h2>4. Bepul kreditlar va API kalitlar</h2>
    <p>
      Ko'p vosita API kalit talab qiladi. Bepul kvota olishning ikki yo'li:
    </p>
    <ul>
      <li>
        <b>TokenHub (Tencent)</b> — bitta API key orqali 14+ modelga (DeepSeek,
        GLM, Kimi, MiniMax, Hunyuan) kirish. Har bir model uchun <b>1 million bepul
        token</b>; aksiya 2026-yil 31-dekabrgacha. Ro'yxatdan o'tishda real-name
        verification talab qilinishi mumkin (Eslatma: Xitoy kompaniyasi — maxfiy
        ma'lumotlar uchun ma'lumotlar siyosatini tekshiring).
      </li>
      <li>
        <b>Google Cloud Console</b> — Gemini modeli uchun API kalit olish:
        yangi loyiha → "Generative Language API" yoki "Vertex AI API" yoqish →
        API key generatsiya qilish → kalitni skript/plaginga qo'yish.
      </li>
    </ul>
    <div style="background:color-mix(in srgb,#ef4444 10%,transparent);border:1px solid #ef4444;border-radius:12px;padding:14px 16px;margin:1rem 0;">
      <strong style="color:#ef4444;">XAVFSIZLIK:</strong> API kalit hech qachon
      oshkora joyga (public repo, chat, screenshot) joylashtirilmaydi — faqat
      plagin sozlamalarining maxfiy (secret) maydoniga yoki <code>.env</code> fayliga.
    </div>
  </section>

  <section>
    <h2 data-i18n="pe.benefit">Qanday foyda olasiz?</h2>
    <ul>
      <li data-i18n="pe.ben1">Vaqt tejash — 1 soatlik ishni 5 daqiqaga</li>
      <li data-i18n="pe.ben2">Sifatli natija — aniq, strukturaviy</li>
      <li data-i18n="pe.ben3">Pul ishlash — kontent, kod tezroq</li>
    </ul>
  </section>

  <a href={import.meta.env.BASE_URL + 'bog-lanish'} class="start-btn" style="margin-top:2rem;" data-i18n="pe.buy">Kursni sotib olish →</a>
  <a href={import.meta.env.BASE_URL + 'kurslar'} class="course-nav-link" style="margin-left:1rem;" data-i18n="pe.all">← Barcha kurslar</a>

  <Quiz title="O'z bilimingizni tekshiring" titleI18n="pe.quizTitle" quizI18n="pe" questions={questions} />
  <PaymentInstructions course="Prompt Engineering" price="$29 · ≈ 360 000 so'm" />
</article>

<style>
  .prompt-lab{position:relative;overflow:hidden;border:1px solid color-mix(in srgb,var(--accent) 45%,var(--border));border-radius:18px;padding:clamp(1.1rem,3vw,1.75rem);background:linear-gradient(135deg,color-mix(in srgb,#7d7df5 13%,var(--surface)),var(--surface) 60%,color-mix(in srgb,#34d399 8%,var(--surface)));}
  .prompt-lab::after{content:"";position:absolute;width:210px;height:210px;right:-105px;top:-105px;border:1px solid color-mix(in srgb,var(--accent) 45%,transparent);border-radius:50%;box-shadow:0 0 0 25px color-mix(in srgb,var(--accent) 8%,transparent),0 0 0 50px color-mix(in srgb,var(--accent) 5%,transparent);pointer-events:none;}
  .prompt-lab-head{position:relative;z-index:1;display:flex;gap:1.25rem;align-items:flex-start;justify-content:space-between;margin-bottom:1.25rem;}
  .prompt-lab h2{margin:.25rem 0 .4rem;}.prompt-lab p{margin:.35rem 0;color:var(--muted);}.prompt-lab-kicker{font-size:.72rem;font-weight:800;letter-spacing:.12em;color:#a5b4fc;}
  .prompt-toggle{display:flex;gap:.35rem;padding:.3rem;border:1px solid var(--border);border-radius:12px;background:color-mix(in srgb,var(--bg) 68%,transparent);white-space:nowrap;}
  .prompt-toggle-btn{border:0;border-radius:8px;padding:.62rem .75rem;background:transparent;color:var(--muted);font:inherit;font-size:.85rem;font-weight:700;cursor:pointer;transition:background .2s,color .2s,transform .2s;}
  .prompt-toggle-btn:hover{color:var(--text);}.prompt-toggle-btn:focus-visible{outline:2px solid #a5b4fc;outline-offset:2px;}.prompt-toggle-btn.is-active{background:var(--accent);color:white;box-shadow:0 5px 16px color-mix(in srgb,var(--accent) 35%,transparent);}
  .prompt-compare{position:relative;z-index:1;min-height:250px;}.prompt-pane{animation:prompt-in .28s ease both;border:1px solid var(--border);border-radius:14px;padding:1.1rem 1.15rem;background:color-mix(in srgb,var(--bg) 28%,var(--surface));}.prompt-pane-bad{border-color:color-mix(in srgb,#fb7185 55%,var(--border));}.prompt-pane-good{border-color:color-mix(in srgb,#34d399 55%,var(--border));}.prompt-pane-label{display:flex;align-items:center;gap:.5rem;font-size:.75rem;font-weight:800;letter-spacing:.1em;color:var(--muted);}.prompt-pane-label span{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:#fb7185;color:#1d1116;}.prompt-pane-good .prompt-pane-label span{background:#34d399;color:#062b20;}.prompt-code{margin:1rem 0!important;padding:1rem;border-radius:10px;background:color-mix(in srgb,var(--bg) 65%,transparent);border-left:3px solid #fb7185;color:var(--text)!important;font-size:1rem;line-height:1.65;}.prompt-pane-good .prompt-code{border-left-color:#34d399;}.prompt-pane ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;margin:0;padding:0;list-style:none;}.prompt-pane li{padding:.65rem .75rem;border:1px solid color-mix(in srgb,var(--border) 80%,transparent);border-radius:9px;color:var(--muted);font-size:.87rem;}.prompt-lab-note{position:relative;z-index:1;margin-top:1rem!important;font-size:.9rem;}.prompt-lab-note b{color:var(--text);}@keyframes prompt-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  @media(max-width:640px){.prompt-lab-head{flex-direction:column}.prompt-toggle{width:100%;}.prompt-toggle-btn{flex:1;padding:.65rem .45rem;font-size:.78rem}.prompt-compare{min-height:0}.prompt-pane ul{grid-template-columns:1fr}.prompt-code{font-size:.92rem;}}
  @media(prefers-reduced-motion:reduce){.prompt-pane{animation:none}.prompt-toggle-btn{transition:none}}
</style>

<script>
  document.querySelectorAll('[data-prompt-compare]').forEach((compare) => {
    const section = compare.closest('.prompt-lab');
    const buttons = section?.querySelectorAll('[data-prompt-mode]') || [];
    const panes = compare.querySelectorAll('[data-prompt-pane]');
    const status = section?.querySelector('[data-prompt-status]');
    const notes = {
      bad: "Yomon prompt — vazifa bor, lekin AI uchun yo'nalish yetarli emas.",
      good: "Yaxshi prompt — rol, kontekst, cheklov va format bir joyda."
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      const mode = button.dataset.promptMode;
      buttons.forEach((item) => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); });
      panes.forEach((pane) => { pane.hidden = pane.dataset.promptPane !== mode; });
      if (status) status.innerHTML = `<b>${mode === 'bad' ? 'Yomon prompt' : 'Yaxshi prompt'}</b> — ${notes[mode].split(' — ')[1]}`;
    }));
  });
</script>

</Base>

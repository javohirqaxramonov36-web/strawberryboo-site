---
import AcademyPartnership from "../components/AcademyPartnership.astro";
import Base from "../layouts/Base.astro";
import { payments } from "../config/payments";
const title = "Homiylik | Tayanch";
const description = "Tayanch kurslarini bepul va sifatli saqlash uchun ixtiyoriy homiylik. Click, Payme, Paynet va karta orqali.";
const base = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <section class="donate">
    <div class="donate-head">
      <span class="badge badge-free" data-i18n="donate.badge">Homiylik</span>
      <h1 data-i18n="donate.title">Homiylik</h1>
      <p class="lead" data-i18n="donate.lead">
        Tayanch kurslarini bepul va sifatli saqlash uchun yordamingiz kerak. Kichik homiylik ham
        saytning server, domen va yangi kurslariga yordam beradi.
      </p>
      <p class="donate-sub" data-i18n="donate.sub">
        Bu ixtiyoriy. Hech qanday kursga yozilmasdan ham loyihani qo'llab-quvvatlashingiz mumkin.
      </p>
    </div>

    <div class="donate-why">
      <h2 data-i18n="donate.whyTitle">Nima uchun homiylik?</h2>
      <ul class="modules">
        <li data-i18n="donate.why1">Barcha asosiy kurslar (IELTS, AI, Admission) bepul qoladi.</li>
        <li data-i18n="donate.why2">Sayt reklamasiz va sizning shaxsiy ma'lumotlaringizni sigmaydi.</li>
        <li data-i18n="donate.why3">Har bir so'm yangi dars, yangi vosita va ochiq manbali loyihalarga sarflanadi.</li>
      </ul>
    </div>

    <AcademyPartnership lang="uz" />
    <section class="academy-partnership" aria-labelledby="academy-partnership-title">
      <h2 id="academy-partnership-title">Engineering Academy hamkorligi</h2>
      <p>Tayanch kelajakda amaliy STEM ta’limi atrofidagi Engineering Academy tashabbusi uchun ta’lim, kontent va jamoa hamkorlarini izlaydi.</p>
      <ul><li>O‘quv materiallari yoki mentorlik imkoniyatlarini birgalikda muhokama qilish</li><li>Sinov darsi yoki ochiq resursni mas’uliyat bilan rejalash</li><li>Hamkorlik maqsadi, roli va roziliklarini yozma ravishda kelishish</li></ul>
      <p class="donate-note">Bu sahifa moliyaviy va yuridik va’da bermaydi. Aniq hamkorlik doirasi alohida kelishiladi.</p>
    </section>

    <div class="donate-methods">
      <h2 data-i18n="donate.methodsTitle">To'lov usullari</h2>
      <div class="pay-grid">
        {payments.map((m) => (
          <div class="pay-card">
            <div class="pay-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            </div>
            <h3>{m.label}</h3>
            {m.enabled ? (
              m.id === "card" ? (
                <div class="pay-card-body">
                  <div class="pay-card-number">
                    <span class="pay-value">{m.value}</span>
                    <button type="button" class="pay-copy" data-copy={m.copy} aria-label="Karta raqamini nusxalash">Nusxalash</button>
                  </div>
                  {m.owner ? <p class="pay-owner">Karta egasi: <b>{m.owner}</b></p> : null}
                  <p class="pay-security">Bu karta orqali faqat pul yuborish mumkin — hech qachon karta CVV kodi, amal qilish muddati yoki SMS kodni so'ramaymiz va bermang.</p>
                </div>
              ) : (
                <p class="pay-value">{m.value}</p>
              )
            ) : (
              <p>{m.note}</p>
            )}
            {m.enabled && m.url ? (
              <a href={m.url} class="pay-link" target="_blank" rel="noopener">To'lov sahifasiga o'tish →</a>
            ) : !m.enabled ? (
              <span class="pay-soon" data-i18n="donate.soon">Tez orada</span>
            ) : null}
          </div>
        ))}
      </div>
      <p class="donate-note" data-i18n="donate.note">
        Homiylik ixtiyoriy va qo'shimcha majburiyat keltirmaydi. Rahmat!
      </p>
    </div>

    <div class="donate-cta">
      <a href={base + 'kurslar/'} class="start-btn" data-i18n="cta.view">Kurslarni ko'rish</a>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll('.pay-copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var text = btn.getAttribute('data-copy') || '';
      if (!text) return;
      navigator.clipboard.writeText(text).then(function () {
        var old = btn.textContent;
        btn.textContent = 'Nusxalandi ✓';
        setTimeout(function () { btn.textContent = old; }, 1500);
      }).catch(function () {
        btn.textContent = 'Nusxalab bo‘lmadi';
      });
    });
  });
</script>

<style>
  .donate { max-width: 920px; margin: 0 auto; padding: 2.6rem 20px 3rem; }
  .donate-head { text-align: center; margin-bottom: 2.4rem; }
  .donate-head h1 { font-family: var(--font-display); font-size: 2.4rem; margin: .5rem 0 .7rem; letter-spacing: -.02em; }
  .donate-head .lead { color: var(--muted); max-width: 680px; margin: 0 auto; font-size: 1.05rem; line-height: 1.65; }
  .donate-sub { color: var(--accent); font-weight: 600; margin-top: .8rem; }
  .donate-why { margin-bottom: 2.6rem; }
  .academy-partnership{margin:0 0 2.6rem;padding:1.3rem;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.academy-partnership h2{margin:0 0 .6rem;color:var(--accent);font-size:1.25rem}.academy-partnership p,.academy-partnership li{color:var(--muted);line-height:1.6}
  .donate-why h2, .donate-methods h2 { color: var(--accent); font-size: 1.4rem; margin: 0 0 1rem; }
  .pay-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.1rem; }
  .pay-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
    padding: 22px; text-align: center; box-shadow: var(--shadow);
    transition: transform .15s, border-color .15s;
  }
  .pay-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .pay-ic {
    width: 52px; height: 52px; border-radius: 14px; margin: 0 auto 14px;
    display: grid; place-items: center; color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .pay-ic svg { width: 26px; height: 26px; }
  .pay-card h3 { margin: 0 0 .5rem; font-size: 1.1rem; color: var(--text); }
  .pay-card p { color: var(--muted); font-size: .9rem; margin: 0 0 1rem; min-height: 2.6rem; }
  .pay-value {
    color: var(--text) !important; font-weight: 700; font-size: 1rem;
    letter-spacing: .02em; word-break: break-all; background: var(--accent-soft);
    border: 1px dashed var(--accent); border-radius: 10px; padding: 10px 12px;
    min-height: auto !important;
  }
  .pay-card-body { display: flex; flex-direction: column; gap: .5rem; }
  .pay-card-number { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .pay-card-number .pay-value { flex: 1 1 auto; min-width: 0; }
  .pay-copy {
    flex: 0 0 auto; cursor: pointer; border: 1px solid var(--accent); color: var(--accent);
    background: transparent; font-weight: 700; font-size: .82rem; border-radius: 8px;
    padding: 8px 12px; transition: background .15s, color .15s; white-space: nowrap;
  }
  .pay-copy:hover { background: var(--accent); color: #fff; }
  .pay-owner { color: var(--muted); font-size: .9rem; margin: 0; }
  .pay-owner b { color: var(--text); }
  .pay-security {
    color: var(--muted); font-size: .78rem; line-height: 1.5; margin: 0;
    padding: 9px 12px; border: 1px solid var(--border); border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 4%, var(--surface));
  }
  .pay-link {
    display: inline-block; margin-top: .2rem; color: var(--accent); font-weight: 700;
    text-decoration: none; font-size: .9rem;
  }
  .pay-link:hover { text-decoration: underline; }
  .pay-soon {
    display: inline-block; font: 700 12px var(--font-display); letter-spacing: .04em;
    color: var(--accent); background: var(--accent-soft); padding: 6px 14px; border-radius: 999px;
  }
  .donate-note {
    text-align: center; color: var(--muted); font-size: .9rem; margin-top: 1.6rem;
    padding: 14px; border: 1px dashed var(--border); border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 5%, var(--surface));
  }
  .donate-cta { text-align: center; margin-top: 2.4rem; }
  @media (max-width: 560px) { .donate-head h1 { font-size: 1.9rem; } }
</style>

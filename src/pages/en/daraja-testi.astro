---
import Base from '../../layouts/Base.astro';
import PlacementTest from '../../components/PlacementTest.astro';
const base = import.meta.env.BASE_URL;
const alternates = [
  { lang: 'uz', href: base + 'daraja-testi/' },
  { lang: 'ru', href: base + 'ru/daraja-testi/' },
  { lang: 'en', href: base + 'en/daraja-testi/' },
];
---
<Base title="English level test | Tayanch" description="Check your CEFR level for General English." lang="en" localeAlternates={alternates}>
  <PlacementTest lang="en" />
</Base>

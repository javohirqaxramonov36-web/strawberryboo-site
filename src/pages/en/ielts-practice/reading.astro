<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
<title>IELTS Reading practice — Tayanch</title><meta name="description" content="An original IELTS Reading mini practice from Tayanch." /><style>
:root{--bg:#101119;--surface:#181a24;--text:#f1f1f7;--muted:#a6a6bb;--border:#303244;--accent:#8582ff;--ok:#37c97b;--no:#f05a67}html[data-theme="light"]{--bg:#f6f7fb;--surface:#fff;--text:#20212a;--muted:#5f6072;--border:#d9dbea;--accent:#6355db;--ok:#1f9d57;--no:#d23b48}html[data-theme="light"] .top{background:rgba(255,255,255,.92);border-bottom-color:var(--border)}html[data-theme="light"] .notice{background:#eef0f6;border-color:#d9dbea;color:#20212a}html[data-theme="light"] .q select,html[data-theme="light"] .q input{background:#fff;border-color:var(--border);color:var(--text)}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;padding:76px 14px 104px}.top{position:fixed;inset:0 0 auto;height:62px;background:#101119;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:18px;padding:0 24px;z-index:5}.brand{color:var(--text);text-decoration:none;font-weight:800}.brand b{color:var(--accent)}.meta{color:var(--muted);font-size:.85rem;margin-right:auto}.tool{background:var(--surface);border:1px solid var(--border);color:var(--text);padding:7px 10px;border-radius:8px;text-decoration:none}.wrap{max-width:1180px;margin:auto}.notice{margin-bottom:16px;padding:13px 16px;border-radius:10px;background:#201f3d;border:1px solid #393666;color:#d8d7ff}.workspace{display:grid;grid-template-columns:1.05fr .95fr;min-height:620px;border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--surface)}.passage,.questions{padding:28px;overflow:auto}.passage{border-right:1px solid var(--border)}.eyebrow{font-size:.75rem;color:var(--accent);letter-spacing:.12em;font-weight:800}.passage h1{font-size:1.5rem;margin:.3rem 0 1.4rem}.passage p{color:#dedee9}.questions h2{font-size:1.1rem;margin:0 0 .4rem}.hint{color:var(--muted);font-size:.9rem;margin-top:0}.q{display:block;padding:14px 0;border-bottom:1px solid var(--border)}.q b{color:var(--accent);margin-right:6px}.q select,.q input{margin-top:8px;width:100%;font:inherit;color:var(--text);background:#11121a;border:1px solid var(--border);border-radius:7px;padding:8px}.ok{border-color:var(--ok)!important;background:#123126!important}.no{border-color:var(--no)!important;background:#391d26!important}.footer{position:fixed;inset:auto 0 0;background:#171925;border-top:1px solid var(--border);padding:11px;z-index:4}.footin{max-width:1180px;margin:auto;display:flex;gap:12px;align-items:center}.timer{font-weight:800;color:#d8d7ff}.nums{display:flex;flex-wrap:wrap;gap:5px}.nums button{width:29px;height:29px;border:1px solid var(--border);border-radius:5px;background:#252836;color:var(--muted);cursor:pointer}.nums button.done{background:#343166;color:#fff;border-color:var(--accent)}.review{margin-left:auto;background:#29b968;color:#071a0f;border:0;border-radius:7px;padding:9px 13px;font-weight:800;cursor:pointer}@media(max-width:760px){body{padding:70px 8px 140px}.top{padding:0 10px}.meta{display:none}.workspace{grid-template-columns:1fr}.passage{border-right:0;border-bottom:1px solid var(--border);max-height:none}.passage,.questions{padding:20px}.nums{max-width:210px}.review{margin-left:0}}
</style><script is:inline>
window.__i18nRuntime=(function(){function lang(){return document.documentElement.lang||localStorage.getItem('org-lam-lang')||'uz';}function apply(d){var L=lang();document.querySelectorAll('[data-i18n]').forEach(function(el){var k=el.getAttribute('data-i18n');var v=(d[L]&&d[L][k]!=null)?d[L][k]:(d.uz&&d.uz[k]!=null?d.uz[k]:null);if(v!=null)el.textContent=v;});}function t(d,k){var L=lang();var v=(d[L]&&d[L][k]!=null)?d[L][k]:(d.uz&&d.uz[k]!=null?d.uz[k]:k);return v;}return{lang:lang,apply:apply,t:t};})();
</script>
<script is:inline>
const PAGE_I18N = {"uz": {"rp.meta": "IELTS Reading · Original mini practice", "rp.notice": "ⓘ Bu original Reading mini-test. Maqsad: e'tiborsizlik, T/F/NG, word limit va kalit so'zlarni tekshirish.", "rp.qTitle": "Javoblarni tanlang", "rp.hint": "1–4: TRUE / FALSE / NOT GIVEN. 5–6: word limitga rioya qiling.", "rp.themeAriaLight": "Dark modega o‘tish", "rp.themeAriaDark": "Light modega o‘tish", "rp.review": "Tekshirish", "rp.correct": "to'g'ri", "rp.answerPlaceholder": "Javobingizni yozing"}, "ru": {"rp.meta": "IELTS Reading · Оригинальная мини-практика", "rp.notice": "ⓘ Это оригинальный Reading mini-test. Цель: невнимательность, T/F/NG, лимит слов и ключевые слова.", "rp.qTitle": "Выберите ответы", "rp.hint": "1–4: TRUE / FALSE / NOT GIVEN. 5–6: соблюдайте лимит слов.", "rp.themeAriaLight": "Перейти в тёмную тему", "rp.themeAriaDark": "Перейти в светлую тему", "rp.review": "Проверить", "rp.correct": "верно", "rp.answerPlaceholder": "Введите ответ"}, "en": {"rp.meta": "IELTS Reading · Original mini practice", "rp.notice": "ⓘ This is an original Reading mini-test. Goal: carelessness, T/F/NG, word limit and keywords.", "rp.qTitle": "Choose answers", "rp.hint": "1–4: TRUE / FALSE / NOT GIVEN. 5–6: observe the word limit.", "rp.themeAriaLight": "Switch to dark mode", "rp.themeAriaDark": "Switch to light mode", "rp.review": "Check", "rp.correct": "correct", "rp.answerPlaceholder": "Write your answer"}};
</script><link rel="alternate" hreflang="uz" href={base + 'ielts-practice/reading/'} /><link rel="alternate" hreflang="ru" href={base + 'ru/ielts-practice/reading/'} /><link rel="alternate" hreflang="en" href={base + 'en/ielts-practice/reading/'} /><link rel="alternate" hreflang="x-default" href={base + 'ielts-practice/reading/'} /></head><body><header class="top"><a class="brand" href={base}><b>Tayanch</b></a><span class="meta" data-i18n="rp.meta">IELTS Reading · Original mini practice</span><button class="tool" id="theme">☾</button><a class="tool" href={base+'en/kurslar/ielts-listening/'}>Kursga qaytish</a></header><script>(function(){var b=document.getElementById('theme');if(!b)return;function render(){var t=document.documentElement.dataset.theme==='light'?'light':'dark';b.textContent=t==='light'?'☀':'☾';b.setAttribute('aria-label',t==='light'?__i18nRuntime.t(PAGE_I18N,'rp.themeAriaLight'):__i18nRuntime.t(PAGE_I18N,'rp.themeAriaDark'));}render();b.addEventListener('click',function(){var n=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=n;try{localStorage.setItem('theme',n);}catch(e){}render();});})();</script><main class="wrap"><div class="notice" data-i18n="rp.notice">ⓘ Bu original Reading mini-test. Maqsad: e'tiborsizlik, T/F/NG, word limit va kalit so'zlarni tekshirish.</div><section class="workspace"><article class="passage"><div class="eyebrow">PASSAGE 1</div><h1>Eastfield Library</h1><p>Eastfield Library changed its study-floor rules after a student survey. The library did not add more computers; instead, it moved several existing computers closer to natural light.</p><p>Printed books remain on the ground floor, while group tables are now on the second floor. Students may reserve a silent desk one day in advance, but not for an entire week.</p><p>The café has extended its opening hours until 7 p.m. on weekdays. The library will review the changes after three months.</p><p><b>Strategiya:</b> Savoldagi “bought”, “ground floor”, “seven days” kabi kalit so'zlarni matndan qidiring. “did not add” iborasini e'tiborsiz qoldirmang.</p></article><section class="questions"><div class="eyebrow">QUESTIONS 1–6</div><h2 data-i18n="rp.qTitle">Javoblarni tanlang</h2><p class="hint" data-i18n="rp.hint">1–4: TRUE / FALSE / NOT GIVEN. 5–6: word limitga rioya qiling.</p><div id="form"></div></section></section></main><footer class="footer"><div class="footin"><span class="timer" id="timer">20:00</span><div class="nums" id="nums"></div><button class="review" id="review">Review answers</button></div></footer><script>
  document.querySelector('#review').textContent=__i18nRuntime.t(PAGE_I18N,'rp.review');const qs=[['The library bought new computers.','false','select'],['Group tables are on the ground floor.','false','select'],['A silent desk can be reserved for seven days.','false','select'],['The café is open later on weekdays.','true','select'],['How many months later will the changes be reviewed?','three|3','input'],['Where are printed books kept?','ground floor|the ground floor','input']];const f=document.querySelector('#form'),n=document.querySelector('#nums');qs.forEach(([q,,type],i)=>{let control=type==='select'?'<select><option value="">Choose</option><option value="true">TRUE</option><option value="false">FALSE</option><option value="not given">NOT GIVEN</option></select>':'<input placeholder="Write your answer" />';f.insertAdjacentHTML('beforeend',`<label class="q" id="q${i+1}"><b>${i+1}</b>${q}${control}</label>`);n.insertAdjacentHTML('beforeend',`<button data-i="${i}">${i+1}</button>`)});function norm(s){return s.trim().toLowerCase().replace(/\s+/g,' ')}function check(){let c=0;document.querySelectorAll('.q input,.q select').forEach((x,i)=>{let ok=qs[i][1].split('|').some(a=>norm(a)===norm(x.value));x.className=ok?'ok':'no';if(ok)c++});document.querySelector('#review').textContent=`${c}/6 `+__i18nRuntime.t(PAGE_I18N,'rp.correct')};f.addEventListener('input',()=>document.querySelectorAll('.q input,.q select').forEach((x,i)=>n.children[i].classList.toggle('done',!!x.value)));n.onclick=e=>{if(e.target.dataset.i!==undefined)document.querySelector('#q'+(+e.target.dataset.i+1)).scrollIntoView({behavior:'smooth',block:'center'})};document.querySelector('#review').onclick=check;let m=20,s=0;setInterval(()=>{if(s===0){if(!m)return;m--;s=59}else s--;document.querySelector('#timer').textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`},1000);window.__i18nRuntime.apply(PAGE_I18N);</script></body></html>

---
import Base from "../../layouts/Base.astro";
import LocalizedHome from "../../components/localized/LocalizedHome.astro";
const base = import.meta.env.BASE_URL;
const alternates = [{lang:'uz',href:base},{lang:'ru',href:base+'ru/'},{lang:'en',href:base+'en/'}];
---
<Base title="AI, IELTS and admission courses | Tayanch" description="Practical courses in AI, IELTS, admission and personal knowledge management, including free courses." lang="en" localeAlternates={alternates} showDiscountBanner={true}><LocalizedHome lang="en" /></Base>

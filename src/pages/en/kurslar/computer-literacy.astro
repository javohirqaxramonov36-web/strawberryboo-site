---
import Base from '../../../layouts/Base.astro';
import LocalizedStandardCourse from '../../../components/LocalizedStandardCourse.astro';
import { getLocalizedStandardCourse } from '../../../data/localized-standard-courses';
const lang = 'en' as const;
const course = getLocalizedStandardCourse('computer-literacy', lang);
if (!course) throw new Error('Localized course was not found.');
const base = import.meta.env.BASE_URL;
const alternates = [
 { lang: 'uz', href: base + 'kurslar/computer-literacy/' },
 { lang: 'ru', href: base + 'ru/kurslar/computer-literacy/' },
 { lang: 'en', href: base + 'en/kurslar/computer-literacy/' },
];
---
<Base title={course.title + ' | Tayanch'} description={course.description} lang={lang} localeAlternates={alternates}>
 <LocalizedStandardCourse {course} slug="computer-literacy" {lang} />
</Base>

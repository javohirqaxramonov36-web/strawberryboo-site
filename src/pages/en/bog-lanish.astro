---
import Base from '../../layouts/Base.astro';
import LocalizedInfoPage from '../../components/LocalizedInfoPage.astro';
const base = import.meta.env.BASE_URL;
const alternates = [
  { lang: 'uz', href: base + 'bog-lanish/' },
  { lang: 'ru', href: base + 'ru/bog-lanish/' },
  { lang: 'en', href: base + 'en/bog-lanish/' },
];
---
<Base title="Contact — Tayanch" description="Contact us about courses, payment methods or partnership." lang="en" localeAlternates={alternates}>
  <LocalizedInfoPage lang="en" page="contact" />
</Base>

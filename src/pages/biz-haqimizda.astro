---
import Base from '../layouts/Base.astro';
const title = 'Biz haqimizda — Tayanch';
const description = 'Tayanch va uning muallifi Javohir haqida: o‘zbek tilidagi amaliy onlayn kurslar platformasi.';
const base = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <section class="trust-page"><p class="eyebrow">TAYANCH HAQIDA</p><h1>Biz haqimizda</h1><p class="lead">Tayanch — Javohir Qaxramonov tomonidan yaratilayotgan o‘zbek tilidagi amaliy onlayn kurslar platformasi.</p><div class="trust-grid"><article><h2>Bizning yo‘nalishimiz</h2><p>AI, IELTS, admission, dizayn va kundalik raqamli ko‘nikmalarni sodda, amaliy formatda tushuntirish.</p></article><article><h2>Maqsad</h2><p>O‘quvchiga umumiy nazariya emas, o‘z maqsadida qo‘llay oladigan aniq tizim va mashqlar berish.</p></article></div><p class="note">Asoschining shaxsiy tajribasi va Tayanch yaratilish hikoyasi bilan <a href={base + 'mening-yolim/'}>Mening yo‘lim</a> sahifasida tanishing.</p><a class="start-btn" href={base + 'bog-lanish/'}>Bog‘lanish →</a></section><style>.trust-page{max-width:820px;margin:0 auto}.eyebrow{color:var(--accent);font-weight:800;letter-spacing:.12em;font-size:.76rem}.trust-page h1{font-size:clamp(2rem,5vw,3rem);margin:.25rem 0}.lead{font-size:1.15rem;color:var(--muted);line-height:1.65}.trust-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin:2rem 0}.trust-grid article{padding:1.25rem;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.trust-grid h2{font-size:1.1rem}.trust-grid p,.note{color:var(--muted);line-height:1.6}.note{margin-bottom:1.5rem}.note a{color:var(--accent)}@media(max-width:620px){.trust-grid{grid-template-columns:1fr}}</style>
</Base>

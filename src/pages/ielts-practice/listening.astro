---
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="uz"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
<title>Listening Practice — ZiyoNext</title><style>
:root{--bg:#101119;--surface:#181a24;--soft:#202331;--text:#f1f1f7;--muted:#a6a6bb;--border:#303244;--accent:#8582ff;--ok:#37c97b;--no:#f05a67}html[data-theme="light"]{--bg:#f6f7fb;--surface:#fff;--soft:#eef0f6;--text:#20212a;--muted:#5f6072;--border:#d9dbea;--accent:#6355db;--ok:#1f9d57;--no:#d23b48}html[data-theme="light"] .top{background:rgba(255,255,255,.92);border-bottom-color:var(--border)}html[data-theme="light"] .notice{background:#eef0f6;border-color:#d9dbea;color:#20212a}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding:76px 16px 110px}.top{position:fixed;inset:0 0 auto;background:rgba(16,17,25,.97);border-bottom:1px solid var(--border);height:62px;display:flex;align-items:center;z-index:10;padding:0 24px;gap:18px}.brand{color:var(--text);text-decoration:none;font-weight:800}.brand b{color:var(--accent)}.meta{font-size:.85rem;color:var(--muted);margin-right:auto}.tool{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:8px;padding:7px 10px;cursor:pointer}.wrap{max-width:960px;margin:auto}.notice{display:flex;gap:12px;align-items:flex-start;background:#201f3d;border:1px solid #393666;padding:14px 16px;border-radius:12px;color:#d8d7ff;margin-bottom:18px}.player{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;background:var(--surface);border:1px solid var(--border);padding:13px 15px;border-radius:12px;position:sticky;top:76px;z-index:5}.play{border:0;background:var(--accent);color:#fff;border-radius:50%;width:40px;height:40px;font-size:16px;cursor:pointer}.track{height:5px;background:#3b3d4e;border-radius:10px;overflow:hidden}.track i{display:block;background:var(--accent);width:0;height:100%;transition:width .2s}.speed{display:flex;gap:5px}.speed button{border:1px solid var(--border);background:transparent;color:var(--muted);border-radius:6px;padding:4px 7px;cursor:pointer}.speed button.active{color:#fff;background:var(--accent);border-color:var(--accent)}.paper{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:28px;margin-top:18px}.eyebrow{font-size:.76rem;letter-spacing:.12em;color:var(--accent);font-weight:800}.paper h1{font-size:1.5rem;margin:.35rem 0}.paper h2{font-size:1.05rem;margin:1.6rem 0 .65rem}.instructions{color:var(--muted);border-left:3px solid var(--accent);padding-left:12px}.form{display:grid;gap:13px}.q{display:grid;grid-template-columns:34px 1fr;align-items:center;gap:9px}.n{color:var(--accent);font-weight:800}.q input{width:100%;font:inherit;color:var(--text);background:#12131b;border:1px solid var(--border);border-radius:7px;padding:8px 10px}.q input.ok{border-color:var(--ok);background:#123126}.q input.no{border-color:var(--no);background:#391d26}.check{margin-top:20px;border:0;background:var(--accent);color:white;font:inherit;font-weight:800;padding:11px 16px;border-radius:8px;cursor:pointer}.result{font-weight:700;margin-left:12px;color:#d8d7ff}.transcript{margin-top:22px;color:var(--muted);border-top:1px solid var(--border);padding-top:15px}.transcript summary{color:var(--text);cursor:pointer;font-weight:700}.footer{position:fixed;inset:auto 0 0;background:#171925;border-top:1px solid var(--border);padding:11px 16px;z-index:8}.footin{max-width:960px;margin:auto;display:flex;align-items:center;gap:14px}.timer{font-weight:800;color:#d8d7ff;min-width:50px}.nums{display:flex;gap:5px;flex-wrap:wrap}.nums button{width:29px;height:29px;border-radius:5px;border:1px solid var(--border);background:#252836;color:var(--muted);font-size:.75rem;cursor:pointer}.nums button.done{border-color:var(--accent);color:#fff;background:#343166}.nums button.current{outline:2px solid var(--accent)}.review{margin-left:auto;border:0;background:#29b968;color:#071a0f;border-radius:7px;padding:9px 13px;font-weight:800;cursor:pointer}@media(max-width:650px){body{padding:70px 10px 150px}.top{padding:0 12px}.meta{display:none}.paper{padding:20px}.player{top:70px}.footin{align-items:flex-start}.review{margin-left:0}.nums{max-width:210px}}
</style></head><body><header class="top"><a class="brand" href={base}><b>ZiyoNext</b></a><span class="meta">IELTS Listening · Original mini practice</span><button class="tool" id="theme">☾</button><a class="tool" href={base+'kurslar/ielts-prep/'}>Kursga qaytish</a></header><script>(function(){var b=document.getElementById('theme');if(!b)return;function render(){var t=document.documentElement.dataset.theme==='light'?'light':'dark';b.textContent=t==='light'?'☀':'☾';b.setAttribute('aria-label',t==='light'?'Dark modega o‘tish':'Light modega o‘tish');}render();b.addEventListener('click',function(){var n=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=n;try{localStorage.setItem('theme',n);}catch(e){}render();});})();</script><main class="wrap"><div class="notice"><span>ⓘ</span><span>Bu ZiyoNext uchun original mashq. U birlik/ko'plik, raqam va distractor signallarini mashq qilish uchun yozilgan; Cambridge materiali nusxalanmagan.</span></div><section class="player"><button class="play" id="play" aria-label="audio">▶</button><div><div class="track"><i id="progress"></i></div><small id="audioState">Audio tayyor · bir marta eshiting</small></div><div class="speed"><button data-rate="0.8">0.8×</button><button data-rate="1" class="active">1×</button><button data-rate="1.15">1.15×</button></div></section><section class="paper"><div class="eyebrow">SECTION 2 · 10 QUESTIONS</div><h1>Riverside Community Day</h1><p class="instructions">Audio-ni boshlashdan oldin bo'shliqlarga qarang. Javobda ko'plik, imlo va raqamlarga e'tibor bering.</p><h2>Complete the form. Write ONE OR TWO WORDS AND/OR A NUMBER for each answer.</h2><div class="form" id="form"></div><button class="check" id="check">Javoblarni tekshirish</button><span class="result" id="result"></span><details class="transcript"><summary>Transcriptni javobdan keyin oching</summary><p>Good morning, and welcome to Riverside Community Day. Please meet our volunteers at the visitor centre, not at the museum entrance as shown on an old poster. The guided walk begins at 10:15, after the safety briefing. You can leave large bags in the lockers beside reception. For the art activity, walk past the old sculptures, then turn left. Families going to the river area should cross the wooden bridge, not the metal gate. Free printed maps are available at the entrance. The photography talk lasts 12 minutes. If you need a quiet place, the herb gardens are behind the library. Lunch is sold at the cafe, and buses leave from the south side.</p></details></section></main><footer class="footer"><div class="footin"><span class="timer" id="timer">15:00</span><div class="nums" id="nums"></div><button class="review" id="review">Review answers</button></div></footer><script>
const qs=[['First meeting point','visitor centre'],['Guided walk starts at','10:15'],['Bags can be left in the','lockers'],['Art activity is beside the old','sculptures'],['Children cross the wooden','bridge'],['Free printed ___ are available','maps'],['Photography talk lasts ___ minutes','12'],['Quiet area is near the herb','gardens'],['Lunch is bought at the','cafe|café'],['Bus exit is on the ___ side','south']];const form=document.querySelector('#form'),nums=document.querySelector('#nums');qs.forEach(([t],i)=>{form.insertAdjacentHTML('beforeend',`<label class="q" id="question-${i+1}"><span class="n">${i+1}</span><span>${t}: <input autocomplete="off" data-i="${i}" /></span></label>`);nums.insertAdjacentHTML('beforeend',`<button data-j="${i}">${i+1}</button>`)});let rate=1,minutes=15,seconds=0,timerOn=true;const text=document.querySelector('.transcript p').textContent;let utter;function normal(v){return v.trim().toLowerCase().replace(/\s+/g,' ')}function update(){document.querySelectorAll('.q input').forEach((x,i)=>nums.children[i].classList.toggle('done',!!x.value));}form.addEventListener('input',update);nums.addEventListener('click',e=>{if(e.target.dataset.j!==undefined)document.querySelector('#question-'+(+e.target.dataset.j+1)).scrollIntoView({behavior:'smooth',block:'center'})});document.querySelector('#play').onclick=()=>{if(speechSynthesis.speaking){speechSynthesis.cancel();document.querySelector('#play').textContent='▶';return}utter=new SpeechSynthesisUtterance(text);utter.lang='en-GB';utter.rate=rate;utter.onstart=()=>{document.querySelector('#audioState').textContent='Audio o‘qilyapti';document.querySelector('#play').textContent='■';document.querySelector('#progress').style.width='45%'};utter.onend=()=>{document.querySelector('#audioState').textContent='Audio tugadi';document.querySelector('#play').textContent='▶';document.querySelector('#progress').style.width='100%'};speechSynthesis.speak(utter)};document.querySelectorAll('[data-rate]').forEach(b=>b.onclick=()=>{rate=+b.dataset.rate;document.querySelectorAll('[data-rate]').forEach(x=>x.classList.toggle('active',x===b))});document.querySelector('#check').onclick=()=>{let c=0;document.querySelectorAll('.q input').forEach((x,i)=>{let ok=qs[i][1].split('|').some(a=>normal(x.value)===normal(a));x.className=ok?'ok':'no';if(ok)c++});document.querySelector('#result').textContent=`${c}/10 to'g'ri`;};document.querySelector('#review').onclick=()=>{document.querySelector('#check').click();document.querySelector('.paper').scrollIntoView({behavior:'smooth'})};setInterval(()=>{if(!timerOn)return;if(seconds===0){if(minutes===0)return;minutes--;seconds=59}else seconds--;document.querySelector('#timer').textContent=`${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`},1000);document.querySelector('#timer').onclick=()=>timerOn=!timerOn;document.querySelector('#theme').onclick=()=>document.body.classList.toggle('light');</script></body></html>

---
import Base from "../layouts/Base.astro";
const title = "Ko'ngilochar o'yinlar va simulyatsiyalar | Tayanch";
const description = "Kurslar orasida dam oling — 20 ta mini-o'yin va simulyatsiya. Barcha natijalar faqat localStorage'da saqlanadi.";
const base = import.meta.env.BASE_URL;
---

<Base title={title} description={description}>
  <section class="ent-hero">
    <span class="eyebrow">KO'NGILOCHAR</span>
    <h1>Ko'ngilochar bo'limi</h1>
    <p class="lead">Kurslar orasida dam oling. O'yinlar va simulyatsiyalar — barcha natijalar faqat shu brauzerda saqlanadi.</p>
  </section>

  <div class="ls-note">⚠️ Barcha natijalar, holat va reytinglar faqat <b>localStorage</b>'da saqlanadi. Server yoki backend yo'q.</div>

  <section class="static-banner">
    <div class="static-card" id="static-word"></div>
    <div class="static-card" id="static-quote"></div>
    <div class="static-card" id="static-history"></div>
    <div class="static-card" id="static-pomodoro">
      <h4>⏱️ Pomodoro</h4>
      <div class="pomo-time" id="pomo-time">05:00</div>
      <div class="pomo-controls">
        <button id="pomo-start" class="mini-btn">Boshlash</button>
        <button id="pomo-reset" class="mini-btn">Qayta</button>
      </div>
    </div>
  </section>

  <section class="filters-mobile">
    <div class="filter-group">
      <button class="filter-btn active" data-filter="all">Barchasi</button>
      <button class="filter-btn" data-filter="mashq">Mashq</button>
      <button class="filter-btn" data-filter="bilim">Bilim</button>
      <button class="filter-btn" data-filter="simulyatsiya">Simulyatsiya</button>
      <button class="filter-btn" data-filter="ijod">Ijod</button>
    </div>
  </section>

  <section class="games-grid">
    <div id="games-container" class="games-container"></div>
  </section>

  <div id="game-modal" class="game-modal hidden">
    <div class="game-modal-content">
      <button class="game-modal-close" id="game-modal-close">✕</button>
      <h3 id="game-modal-title">O'yin</h3>
      <div id="game-modal-body"></div>
      <div id="game-result" class="game-result hidden"></div>
      <div id="game-share" class="game-share hidden">
        <button id="share-copy" class="mini-btn">📋 Nusxa olish</button>
        <a id="share-telegram" class="mini-btn" target="_blank">📨 Telegram</a>
      </div>
    </div>
  </div>

  <style is:global>
    .ent-hero { text-align: center; padding: 8px 0 18px; }
    .ent-hero .eyebrow { display: inline-block; font-size: 13px; font-weight: 600; color: var(--accent); background: var(--accent-soft); padding: 5px 12px; border-radius: 99px; margin-bottom: 1rem; }
    .ent-hero h1 { font-family: var(--font-display); letter-spacing: -.02em; font-size: 2.4rem; margin: 0 0 .6rem; color: var(--text); }
    .ent-hero .lead { color: var(--muted); max-width: 620px; margin: 0 auto; }

    .ls-note { background: color-mix(in srgb, #f59e0b 14%, var(--surface)); border: 1px solid color-mix(in srgb, #f59e0b 40%, var(--border)); color: var(--text); padding: 10px 15px; border-radius: 14px; font-size: 13px; margin: 0 0 22px; }

    .static-banner { margin-bottom: 26px; }
    .static-grid, .static-banner { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .static-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 15px; font-size: 13px; color: var(--text); }
    .static-card h4 { font-size: 13px; margin-bottom: 8px; color: var(--accent); }
    .pomo-time { font-size: 28px; font-weight: 700; text-align: center; color: var(--accent); margin: 8px 0; }
    .pomo-controls { display: flex; gap: 8px; justify-content: center; }

    .mini-btn { padding: 8px 16px; background: var(--btn-bg); color: #fff; border: none; border-radius: 20px; font-size: 13px; font-weight: 600; cursor: pointer; transition: background .15s; text-decoration: none; display: inline-block; }
    .mini-btn:hover { background: var(--accent-2); }

    .filters-mobile { margin-bottom: 20px; }
    .filter-group { display: flex; flex-wrap: wrap; gap: 10px; }
    .filter-btn { padding: 9px 18px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); border-radius: 20px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s; white-space: nowrap; }
    .filter-btn:hover { border-color: var(--accent); color: var(--accent); }
    .filter-btn.active { background: var(--btn-bg); border-color: var(--accent); color: #fff; }

    .games-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
    .game-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
    .game-card:hover { transform: translateY(-5px); box-shadow: 0 16px 32px -10px rgba(0,0,0,.5); border-color: var(--accent); }
    .game-emoji { font-size: 44px; }
    .game-title { font-size: 16px; font-weight: 700; margin: 10px 0 6px; color: var(--text); }
    .game-desc { font-size: 13px; color: var(--muted); flex: 1; }
    .best-score { font-size: 11px; color: var(--accent); margin-top: 10px; display: block; }
    .best-score.muted { color: var(--muted); opacity: .7; }
    .play-btn { margin-top: 14px; padding: 10px 18px; background: var(--btn-bg); color: #fff; border: none; border-radius: 20px; font-size: 13px; font-weight: 600; cursor: pointer; text-align: center; transition: background .15s; }
    .play-btn:hover { background: var(--accent-2); }
    .no-games { padding: 40px; text-align: center; color: var(--muted); font-style: italic; }

    .game-modal { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px; }
    .game-modal.hidden { display: none; }
    .game-modal-content { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 25px; max-width: 520px; width: 100%; max-height: 90vh; overflow-y: auto; position: relative; }
    .game-modal-close { position: absolute; top: 15px; right: 15px; background: var(--bg); border: 1px solid var(--border); border-radius: 50%; width: 32px; height: 32px; cursor: pointer; font-size: 16px; color: var(--text); }
    .game-modal-content h3 { margin-bottom: 15px; color: var(--text); padding-right: 30px; }
    .game-result { margin-top: 15px; padding: 15px; background: color-mix(in srgb, #22c55e 12%, var(--surface)); border: 1px solid color-mix(in srgb, #22c55e 40%, var(--border)); border-radius: 16px; font-size: 14px; color: var(--text); }
    .game-result.hidden { display: none; }
    .game-result .new-record { color: #22c55e; font-weight: 700; }
    .game-share { margin-top: 15px; display: flex; gap: 10px; }
    .game-share.hidden { display: none; }

    .g-inst { font-size: 13px; color: var(--muted); margin-bottom: 10px; }
    .g-sample { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 12px; font-size: 14px; margin-bottom: 12px; color: var(--text); }
    .g-sample.big { font-size: 20px; text-align: center; }
    .g-hint { font-size: 12px; color: var(--muted); margin-bottom: 10px; }
    .g-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .game-modal-content textarea, .game-modal-content input { width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 12px; font-size: 14px; margin-bottom: 10px; font-family: inherit; background: var(--bg); color: var(--text); }

    .reaction-box { height: 150px; display: flex; align-items: center; justify-content: center; border-radius: 16px; font-size: 18px; font-weight: 700; cursor: pointer; margin-bottom: 12px; }
    .reaction-box.wait { background: color-mix(in srgb, #ef4444 18%, var(--surface)); color: #ef4444; }
    .reaction-box.go { background: color-mix(in srgb, #22c55e 18%, var(--surface)); color: #22c55e; }
    .reaction-box.early { background: color-mix(in srgb, #f59e0b 18%, var(--surface)); color: #f59e0b; }
    .reaction-box.done { background: color-mix(in srgb, #3b82f6 18%, var(--surface)); color: #3b82f6; }

    .wordle-row { display: flex; gap: 6px; justify-content: center; margin-bottom: 6px; }
    .wordle-cell { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border: 2px solid var(--border); border-radius: 8px; font-size: 18px; font-weight: 700; text-transform: uppercase; color: var(--text); }
    .wordle-cell.green { background: #16a34a; color: #fff; border-color: #16a34a; }
    .wordle-cell.yellow { background: #eab308; color: #fff; border-color: #eab308; }
    .wordle-cell.gray { background: var(--muted); color: #fff; border-color: var(--muted); }

    .memory-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 12px; }
    .memory-cell { aspect-ratio: 1; border: none; border-radius: 12px; background: var(--btn-bg); color: #fff; font-size: 11px; font-weight: 600; cursor: pointer; padding: 4px; }

    .tez-timer { font-size: 32px; font-weight: 700; text-align: center; color: #ef4444; margin-bottom: 12px; }

    .opt-btn { display: block; width: 100%; margin-bottom: 8px; padding: 10px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); cursor: pointer; font-size: 14px; text-align: left; color: var(--text); }
    .opt-btn:hover { border-color: var(--accent); color: var(--accent); }

    .band9-col { margin-bottom: 12px; }
    .band9-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: 13px; color: var(--text); }
    .band9-sel { margin-left: auto; padding: 4px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); }

    .fc-card { height: 120px; display: flex; align-items: center; justify-content: center; background: var(--bg); border: 1px solid var(--border); border-radius: 16px; font-size: 24px; font-weight: 700; color: var(--text); margin-bottom: 12px; }
    .hidden { display: none !important; }

    .optical-item { padding: 12px; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 8px; font-size: 14px; cursor: pointer; color: var(--text); }
    .optical-item.selected { background: color-mix(in srgb, var(--accent) 14%, var(--surface)); }

    .budget-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-size: 13px; color: var(--text); }
    .budget-row label { width: 90px; }
    .budget-slider { flex: 1; accent-color: var(--accent); }
    .budget-val { width: 50px; text-align: right; }
    #budget-total { font-weight: 600; margin: 10px 0; }

    .mood-btn { font-size: 32px; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 10px; cursor: pointer; margin: 4px; }
    .mood-btn:hover { border-color: var(--accent); }
    #mood-msg { margin-top: 10px; font-size: 14px; color: var(--text); }

    .avatar-wrap { text-align: center; margin-bottom: 12px; }

    @media (max-width: 640px) {
      .static-grid, .static-banner { grid-template-columns: repeat(2, 1fr); }
      .games-container { grid-template-columns: 1fr; }
      .ent-hero h1 { font-size: 1.9rem; }
      .wordle-cell { width: 34px; height: 34px; font-size: 15px; }
      .memory-grid { grid-template-columns: repeat(3, 1fr); }
    }
  </style>

  <script is:inline>
    const allGames = [
      { id:1, title:"Typing Speed Test", description:"Matn beriladi, yozasiz. WPM va aniqlik hisoblanadi.", emoji:"⌨️", category:"mashq", type:"typing" },
      { id:2, title:"Reaction Time Test", description:"Yashil bo'lganda bosing. Vaqt ms da.", emoji:"⚡", category:"mashq", type:"reaction" },
      { id:3, title:"Word Guess (Wordle)", description:"5 harfli so'zni 6 urinishda toping.", emoji:"🔤", category:"mashq", type:"wordle" },
      { id:4, title:"Memory Match", description:"Kartalarni juftlang.", emoji:"🃏", category:"mashq", type:"memory" },
      { id:5, title:"Anagram Solver", description:"Aralash harflardan so'z toping.", emoji:"🔡", category:"mashq", type:"anagram" },
      { id:6, title:"Xato Topish", description:"Gapdagi grammatik xatoni toping.", emoji:"🔍", category:"bilim", type:"xato" },
      { id:7, title:"Tez fikrla (60s)", description:"60 soniyada qancha so'z yozasiz?", emoji:"💡", category:"mashq", type:"tez" },
      { id:8, title:"Emoji Puzzle", description:"Emojidan ibora toping.", emoji:"😀", category:"bilim", type:"emoji" },
      { id:9, title:"Optical Illusion", description:"Vizual jumboqlar galereyasi.", emoji:"👁️", category:"bilim", type:"optical" },
      { id:10, title:"Trivia (15 savol)", description:"15 ta bilim savoli.", emoji:"🧠", category:"bilim", type:"trivia" },
      { id:11, title:"AI yoki Inson?", description:"Matn AI tomonidanmi yozilgan?", emoji:"🤖", category:"bilim", type:"aihuman" },
      { id:12, title:"Band 9 yozuvchimisiz?", description:"5 ta juftlikni to'g'ri joylashtiring.", emoji:"📝", category:"bilim", type:"band9" },
      { id:13, title:"Flashcard Speed", description:"60 soniyada 8 karta.", emoji:"🗂️", category:"bilim", type:"flashcard" },
      { id:14, title:"AI Detective", description:"Qaysi xabar soxta?", emoji:"🕵️", category:"bilim", type:"detective" },
      { id:15, title:"20 ta savol", description:"Qaror daraxti bo'yicha 20 savol.", emoji:"🌳", category:"simulyatsiya", type:"twenty" },
      { id:16, title:"Startup Idea Generator", description:"Tasodifiy startup g'oyasi.", emoji:"🚀", category:"ijod", type:"startup" },
      { id:17, title:"Byudjet simulyatori", description:"$1000 ni taqsimlang.", emoji:"💰", category:"simulyatsiya", type:"budget" },
      { id:18, title:"Bugungi kayfiyat", description:"Kayfiyatingizni tanlang.", emoji:"😊", category:"ijod", type:"mood" },
      { id:19, title:"Mini avatar", description:"SVG avatar generatsiyasi.", emoji:"🎨", category:"ijod", type:"avatar" },
      { id:20, title:"Prompt Engineering", description:"Prompt tuzing, ball oling.", emoji:"💬", category:"ijod", type:"prompt" }
    ];

    const SCORE_KEY = "strawberry_scores";
    function getScores(){ try { return JSON.parse(localStorage.getItem(SCORE_KEY)) || {}; } catch(e){ return {}; } }
    function getBest(id){ const s = getScores(); return s[id] ? s[id].best : null; }
    function setBest(id, value, label){
      const s = getScores();
      if(!s[id] || value > s[id].best){ s[id] = { best: value, label, ts: Date.now() }; localStorage.setItem(SCORE_KEY, JSON.stringify(s)); return true; }
      return false;
    }

    function renderGames(filter){
      const container = document.getElementById("games-container");
      const list = filter === "all" ? allGames : allGames.filter(g => g.category === filter);
      document.querySelectorAll(".filter-btn").forEach(b => b.classList.toggle("active", b.dataset.filter === filter));
      if(!list.length){ container.innerHTML = `<p class="no-games">O'yin topilmadi.</p>`; return; }
      container.innerHTML = list.map(g => {
        const best = getBest(g.id);
        const bestHtml = best !== null ? `<span class="best-score">🏆 ${best.label}: ${best.best}</span>` : `<span class="best-score muted">🏆 hali yo'q</span>`;
        return `<div class="game-card" data-id="${g.id}">
          <div class="game-emoji">${g.emoji}</div>
          <div class="game-title">${g.title}</div>
          <div class="game-desc">${g.description}</div>
          ${bestHtml}
          <button class="play-btn" data-id="${g.id}">O'ynash →</button>
        </div>`;
      }).join("");
      document.querySelectorAll(".play-btn").forEach(btn => {
        btn.addEventListener("click", () => openGame(parseInt(btn.dataset.id)));
      });
    }

    let activeGame = null;
    let lastResultText = "";
    function openGame(id){
      const game = allGames.find(g => g.id === id);
      if(!game) return;
      activeGame = game;
      document.getElementById("game-modal-title").textContent = game.emoji + " " + game.title;
      document.getElementById("game-modal-body").innerHTML = "";
      document.getElementById("game-result").classList.add("hidden");
      document.getElementById("game-result").innerHTML = "";
      document.getElementById("game-share").classList.add("hidden");
      document.getElementById("game-modal").classList.remove("hidden");
      window["init_" + game.type](document.getElementById("game-modal-body"));
    }
    function closeGame(){
      document.getElementById("game-modal").classList.add("hidden");
      activeGame = null;
    }
    function showResult(html, scoreValue, scoreLabel){
      const r = document.getElementById("game-result");
      r.innerHTML = html;
      r.classList.remove("hidden");
      if(scoreValue !== undefined && scoreLabel){
        const improved = setBest(activeGame.id, scoreValue, scoreLabel);
        if(improved) r.innerHTML += `<p class="new-record">🎉 Yangi rekord!</p>`;
        lastResultText = `${activeGame.emoji} ${activeGame.title} — ${scoreLabel}: ${scoreValue} (Tayanch Ko'ngilochar)`;
        document.getElementById("game-share").classList.remove("hidden");
      }
      renderGames(document.querySelector(".filter-btn.active").dataset.filter);
    }
    document.getElementById("game-modal-close").addEventListener("click", closeGame);
    document.getElementById("game-modal").addEventListener("click", e => { if(e.target.id === "game-modal") closeGame(); });
    document.getElementById("share-copy").addEventListener("click", () => {
      navigator.clipboard.writeText(lastResultText).then(() => alert("Nusxa olindi!")).catch(() => alert("Nusxa olish qo'llab-quvvatlanmaydi."));
    });
    document.getElementById("share-telegram").addEventListener("click", e => {
      e.preventDefault();
      window.open("https://t.me/share/url?url=" + encodeURIComponent(location.origin + location.pathname) + "&text=" + encodeURIComponent(lastResultText), "_blank");
    });

    function initStatic(){
      const words = ["Resilient","Curious","Eloquent","Diligent","Empathy","Innovate","Grit","Clarity","Momentum","Synergy"];
      const quotes = ["Muvaffaqiyat — bu kichik sa'y-larning uyg'unligi.","Har kuni 1% yaxshilash yil davomida 37x natija beradi.","Qo'rquv chegarangiz, lekin qiziqish chegarasiz.","Eng yaxshi vaqt — hozir.","Xato qilish — o'rganishning narxi."];
      const history = ["1888: Kodak kompaniyasi tashkil topdi.","1969: Internetning asosi (ARPANET) yaratildi.","1991: WWW ommaga taqdim etildi.","2007: Birinchi iPhone taqdimoti.","2020: Masofaviy ta'lim globallashdi."];
      const d = new Date();
      const idx = d.getDate() % words.length;
      document.getElementById("static-word").innerHTML = `<h4>📌 So'z kuni</h4><p><b>${words[idx]}</b></p>`;
      document.getElementById("static-quote").innerHTML = `<h4>💬 Hikmat</h4><p>${quotes[d.getMonth() % quotes.length]}</p>`;
      document.getElementById("static-history").innerHTML = `<h4>📅 Bugun tarixda</h4><p>${history[d.getDate() % history.length]}</p>`;
      let pomo = 300, timer = null;
      const timeEl = document.getElementById("pomo-time");
      document.getElementById("pomo-start").addEventListener("click", () => {
        if(timer){ clearInterval(timer); timer = null; return; }
        timer = setInterval(() => {
          if(pomo <= 0){ clearInterval(timer); timer = null; return; }
          pomo--;
          const m = String(Math.floor(pomo/60)).padStart(2,"0");
          const s = String(pomo%60).padStart(2,"0");
          timeEl.textContent = `${m}:${s}`;
        }, 1000);
      });
      document.getElementById("pomo-reset").addEventListener("click", () => { clearInterval(timer); timer = null; pomo = 300; timeEl.textContent = "05:00"; });
    }

    const TYPING_TEXT = "The quick brown fox jumps over the lazy dog while the sun sets behind the hills.";
    function init_typing(root){
      root.innerHTML = `<p class="g-inst">Quyidagi matnni tez va to'g'ri yozing:</p><div class="g-sample">${TYPING_TEXT}</div><textarea id="typing-input" rows="3" placeholder="Bu yerga yozing..."></textarea><div class="g-actions"><button id="typing-done" class="mini-btn">Yakunlash</button></div>`;
      document.getElementById("typing-done").addEventListener("click", () => {
        const input = document.getElementById("typing-input").value.trim();
        const words = input.split(/\s+/).filter(Boolean).length;
        const correct = input.split("").filter((c,i) => c === TYPING_TEXT[i]).length;
        const acc = Math.round((correct / TYPING_TEXT.length) * 100);
        const wpm = Math.max(0, Math.round(words / 1));
        showResult(`<p>WPM: <b>${wpm}</b></p><p>Aniqlik: <b>${acc}%</b></p>`, wpm, "WPM");
      });
    }

    function init_reaction(root){
      root.innerHTML = `<div id="reaction-box" class="reaction-box">Kuting...</div>`;
      const box = document.getElementById("reaction-box");
      let start = 0, active = false;
      function wait(){ box.textContent = "Kuting..."; box.className = "reaction-box wait"; active = false; setTimeout(() => { box.textContent = "ENDI BOSING!"; box.className = "reaction-box go"; start = performance.now(); active = true; }, 1000 + Math.random()*3000); }
      box.addEventListener("click", () => {
        if(!active){ box.textContent = "Juda erta! Qayta urinib ko'ring."; box.className = "reaction-box early"; setTimeout(wait, 1000); return; }
        const ms = Math.round(performance.now() - start);
        box.className = "reaction-box done"; box.textContent = ms + " ms";
        showResult(`<p>Reaksiya vaqti: <b>${ms} ms</b></p>`, ms, "ms");
      });
      wait();
    }

    const WORDLE_WORDS = ["APPLE","BRAIN","CLOUD","DREAM","HEART","LIGHT","MOUSE","PLANT","RIVER","STONE","TRAIN","VOICE","WATCH","YOUTH","BREAD"];
    function init_wordle(root){
      const answer = WORDLE_WORDS[Math.floor(Math.random()*WORDLE_WORDS.length)];
      let row = 0; const grid = [];
      root.innerHTML = `<p class="g-inst">6 urinish. Har qatorda 5 harf.</p><div id="wordle-grid"></div><input id="wordle-input" maxlength="5" placeholder="so'z"><div class="g-actions"><button id="wordle-guess" class="mini-btn">Tahmin</button></div><p class="g-hint">Namuna: ${WORDLE_WORDS[0]}</p>`;
      const gridEl = document.getElementById("wordle-grid");
      for(let i=0;i<6;i++){ const r=document.createElement("div"); r.className="wordle-row"; for(let j=0;j<5;j++){ const c=document.createElement("span"); c.className="wordle-cell"; r.appendChild(c); } gridEl.appendChild(r); grid.push(r); }
      document.getElementById("wordle-guess").addEventListener("click", () => {
        const val = document.getElementById("wordle-input").value.toUpperCase();
        if(val.length!==5) return;
        const cells = grid[row].children; const used = {};
        for(let i=0;i<5;i++){ if(val[i]===answer[i]){ cells[i].className="wordle-cell green"; used[answer[i]]=(used[answer[i]]||0)+1; } }
        for(let i=0;i<5;i++){ if(cells[i].className==="wordle-cell"){ if(answer.includes(val[i]) && (used[val[i]]||0) < answer.split("").filter(x=>x===val[i]).length){ cells[i].className="wordle-cell yellow"; used[val[i]]=(used[val[i]]||0)+1; } else cells[i].className="wordle-cell gray"; } cells[i].textContent=val[i]; }
        if(val===answer){ showResult(`<p>Topdingiz! 🎉 Javob: <b>${answer}</b></p>`, 6-row, "qadam"); return; }
        row++;
        if(row>=6){ showResult(`<p>Afsuski. Javob: <b>${answer}</b></p>`, 0, "qadam"); return; }
        document.getElementById("wordle-input").value="";
      });
    }


      deck.forEach((c,idx)=>{ const el=document.createElement("button"); el.className="memory-cell"; el.textContent="?"; el.dataset.pid=c.id; el.addEventListener("click",()=>{ if(lock||el.textContent!=="?")return; el.textContent=c.t; if(!first){ first=el; } else { if(first.dataset.pid===el.dataset.pid){ matched++; first=null; if(matched===pairs.length){ document.getElementById("memory-msg").textContent="Barchasi juftlandi! 🎉"; showResult(`<p>Juftlar: <b>${pairs.length}</b></p>`, pairs.length, "juft"); } } else { lock=true; setTimeout(()=>{ first.textContent="?"; el.textContent="?"; first=null; lock=false; },800); } } }); g.appendChild(el); });

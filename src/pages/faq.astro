---
import Base from "../layouts/Base.astro";
const title = "Ko'p so'raladigan savollar (FAQ) — Tayanch";
const description = "Kurslar, to'lov usullari, sertifikat va forever access bo'yicha eng ko'p beriladigan savollarga javoblar.";
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    ['Kurslar qanday formatda o‘tadi?', 'Har bir kurs modullarga bo‘lingan: qisqacha video darslar, amaliy mashqlar va kichik Quiz.'],
    ['To‘lovni qanday amalga oshiraman?', 'To‘lov tafsilotlari uchun Telegram orqali yozing.'],
    ['Kursni tugatgach sertifikat beriladimi?', 'Barcha pullik va bepul kurslarda sertifikat mavjud.'],
    ['Forever access nima degani?', 'Bir marta sotib olib, kursga doimiy va cheksiz muddatga kirish mumkin.'],
    ['Bepul kurslar haqiqatan ham bepulmi?', 'Ha, ayrim kurslarimiz ro‘yxatdan o‘tish yoki karta ma’lumotlarisiz bepul ochiladi.']
  ].map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
};
---

<Base title={title} description={description}>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<article class="lesson">
  <h1 data-i18n="faq.h1">Ko'p so'raladigan savollar</h1>
  <p class="lead">
    <span data-i18n="faq.lead">Kurslarimiz, to'lov va sertifikatlar bo'yicha eng ko'p beriladigan savollarga qisqa javoblar. Javobingizni topa olmadingizmi?</span> <a href={import.meta.env.BASE_URL + 'bog-lanish'} style="color:var(--accent)" data-i18n="nav.contact">Bog'lanish</a><span data-i18n="faq.leadEnd"> sahifasi orqali yozing.</span>
  </p>

  <section class="faq">
    <details open>
      <summary data-i18n="faq.q1">Kurslar qanday formatda o'tiladi?</summary>
      <p data-i18n="faq.a1">Har bir kurs modullarga bo'lingan: qisqacha video darslar, amaliy mashqlar va tekshirish uchun kichik test (Quiz). Siz o'z tezligingizda o'rganasiz va bir marta sotib olganingizda forever access olasiz — istalgan vaqtda qayta ko'rish mumkin.</p>
    </details>

    <details>
      <summary data-i18n="faq.q2">To'lovni qanday amalga oshiraman?</summary>
      <p><span data-i18n="faq.a2">To'lov tafsilotlari uchun Telegram orqali yozing:</span> <a href="https://t.me/tayanch_go" style="color:var(--accent)" target="_blank" rel="noopener noreferrer">@tayanch_go</a></p>
    </details>

    <details>
      <summary data-i18n="faq.q3">Kursni tugallagach sertifikat beriladimi?</summary>
      <p data-i18n="faq.a3">Ha. Barcha pullik va bepul kurslarimizda sertifikat mavjud. Kurs materiallarini o'zlashtirganingizdan so'ng sertifikat olish huquqiga ega bo'lasiz.</p>
    </details>

    <details>
      <summary data-i18n="faq.q4">"Forever access" nima degani?</summary>
      <p data-i18n="faq.a4">Bir marta sotib olasiz — va kursga doimiy ravishda, cheksiz muddatga kira olasiz. Yangilanishlar ham shu narxga qo'shiladi, qo'shimcha to'lov talab qilinmaydi.</p>
    </details>

    <details>
      <summary data-i18n="faq.q5">Bepul kurslar haqiqatan ham bepulmi?</summary>
      <p data-i18n="faq.a5">Ha, bir qancha kurslarimiz butunlay bepul: "Tekin AI modellar va agentlar", "Figma / Dizayn" va "Nega chet elda o'qish kerak". Ro'yxatdan o'tish yoki karta ma'lumotlari shart emas — sahifaga kiring va o'rgana boshlang.</p>
    </details>
  </section>

  <a href={import.meta.env.BASE_URL + 'kurslar'} class="start-btn" style="margin-top:2rem;" data-i18n="faq.allBtn">Barcha kurslarni ko'rish →</a>
</article>

<style>
  .faq details {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0 1.1rem;
    margin-bottom: 0.8rem;
    transition: border-color .15s;
  }
  .faq details[open] { border-color: var(--accent); }
  .faq summary {
    cursor: pointer;
    padding: 1rem 0;
    font-weight: 700;
    font-size: 1.02rem;
    list-style: none;
    color: var(--text);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::before {
    content: "+";
    display: inline-block;
    margin-right: 10px;
    color: var(--accent);
    font-weight: 800;
    font-size: 1.2rem;
    transition: transform .15s;
  }
  .faq details[open] summary::before { content: "\2013"; }
  .faq details p {
    color: var(--muted);
    padding: 0 0 1rem;
    margin: 0;
    line-height: 1.7;
  }
</style>
</Base>

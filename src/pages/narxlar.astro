---
import Base from "../layouts/Base.astro";
import { availableCourseCount } from "../config/course-catalog";
const title = "Narxlar — Tayanch";
const description = "Kurslar narxlari: bitta kurs, barcha AI kurslari paketi va to'liq access. Forever access.";
---

<Base title={title} description={description} showDiscountBanner={true}>

<article class="lesson">
  <h1 data-i18n="np.h1">Narxlar</h1>
  <p class="lead" data-i18n="np.lead">Bitta kurs soting yoki barchasini birdaniga oling. Barcha paketlarda <b>forever access</b> — bir marta sotib, doim foydalan.</p>

  <div class="pricing single">
    <!-- 1. Bitta kurs -->
    <div class="plan">
      <span class="plan-name" data-i18n="np.singleName">Bitta kurs</span>
      <p class="plan-desc" data-i18n="np.singleDesc">Tanlagan bitta kursingizga to'liq kirish.</p>
      <div class="plan-price">$19<span class="uzs">≈ 240 000 so'm dan</span></div>
      <ul>
        <li data-i18n="np.singleLi1">1 ta kurs (Prompt, Obsidian, IELTS va b.)</li>
        <li data-i18n="np.forever">Forever access</li>
        <li data-i18n="np.cert">Sertifikat</li>
        <li data-i18n="np.telegram">Telegram orqali savollar</li>
      </ul>
      <a href={import.meta.env.BASE_URL + 'kurslar'} class="start-btn" data-i18n="np.singleBtn">Kursni tanlash →</a>
    </div>
  </div>

  <h2 class="paket-head" data-i18n="np.paketHead">Paketlar</h2>
  <div class="pricing">
    <!-- 2. AI Stack (featured) -->
    <div class="plan featured">
      <span class="badge badge-new" data-i18n="np.bestValue">Eng foydali</span>
      <span class="plan-name" data-i18n="np.aiName">AI Stack</span>
      <p class="plan-desc" data-i18n="np.aiDesc">Prompt Engineering + AI Agentlar + Obsidian PKM — AI yo'nalishida hamma narsa bitta paketda.</p>
      <div class="plan-price"><span class="current-price">$70</span><s class="old-price" aria-label="Oldingi narx">$87</s><span class="uzs">≈ 875 000 so'm</span></div>
      <p class="save-note">Alohida sotib olishdan $17 tejang (taxminan 20%)</p>
      <ul>
        <li data-i18n="np.aiLi1">Prompt Engineering ($29)</li>
        <li data-i18n="np.aiLi2">AI Agentlar ($39)</li>
        <li data-i18n="np.aiLi3">Obsidian PKM ($19)</li>
        <li data-i18n="np.foreverCert">Forever access + sertifikat</li>
      </ul>
      <a href={import.meta.env.BASE_URL + 'bog-lanish'} class="start-btn" data-gumroad-product="ai-stack" target="_blank" rel="noopener noreferrer" data-i18n="np.buyBtn">Sotib olish →</a>
    </div>

    <!-- 3. Full access -->
    <div class="plan">
      <span class="plan-name" data-i18n="np.fullName">Full access</span>
      <p class="plan-desc">Hozir mavjud kurslarga umumiy access. Kelajakdagi kurslar uchun paket shartlari keyin e'lon qilinadi.</p>
      <div class="plan-price">$99<span class="uzs">≈ 1 240 000 so'm</span></div>
      <ul>
        <li>{availableCourseCount} ta hozir mavjud kurs</li>
        <li data-i18n="np.forever">Forever access</li>
        <li data-i18n="np.certAll">Barchasiga sertifikat</li>
        <li>Yangi kurslar bo'yicha shartlar tez orada e'lon qilinadi</li>
      </ul>
      <a href={import.meta.env.BASE_URL + 'bog-lanish'} class="start-btn" data-gumroad-product="full-access" target="_blank" rel="noopener noreferrer" data-i18n="np.buyBtn">Sotib olish →</a>
    </div>
  </div>

  <style>
    .pricing.single { grid-template-columns: minmax(260px, 380px); }
    .paket-head { margin: 2.5rem 0 .5rem; font: 800 22px var(--font-display); color: var(--text); letter-spacing: -.01em; }
    .plan-price { display:flex; flex-wrap:wrap; align-items:baseline; gap:.35rem .65rem; }
    .plan-price .current-price { font: inherit; }
    .plan-price .old-price { color: var(--muted); font-size: .95rem; font-weight: 600; text-decoration-thickness: 2px; }
    .plan-price .uzs { flex-basis:100%; margin-left:0; }
    .save-note { margin: .2rem 0 .9rem; color: var(--accent); font-weight: 600; font-size: .9rem; }
  </style>

  <p class="quiz-hint" style="margin-top:1.5rem">Qaysi kurs sizga kerakligini bilmayapsizmi? <a href={import.meta.env.BASE_URL + 'kurs-tanlash'} style="color:var(--accent)">Kurs tanlash testi →</a></p>
</article>
</Base>

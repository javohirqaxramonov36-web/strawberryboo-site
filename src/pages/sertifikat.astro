---
import Base from '../layouts/Base.astro';
import CertificateTrustPage from '../components/CertificateTrustPage.astro';
const base = import.meta.env.BASE_URL;
const alternates = [
  { lang: 'uz', href: base + 'sertifikat/' },
  { lang: 'ru', href: base + 'ru/sertifikat/' },
  { lang: 'en', href: base + 'en/sertifikat/' },
];
---
<Base title="Sertifikatlar haqida — Tayanch" description="Tayanch sertifikatlari haqida nimani tekshirish mumkinligi va nimani hozircha tekshirib bo‘lmasligi haqida ochiq ma’lumot." lang="uz" localeAlternates={alternates}>
  <CertificateTrustPage lang="uz" />
</Base>

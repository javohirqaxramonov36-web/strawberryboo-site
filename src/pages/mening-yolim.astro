---
import Base from "../layouts/Base.astro";
const title = "Mening yo'lim | ZiyoNext";
const description = "Asoschining halol hikoyasi: qurilishdan boshlab, o'qituvchilik, chet elda mehnat, IELTS 7.0 va Muhandislik Akademiyasi maqsadigacha bo'lgan yo'l.";
---

<Base title={title} description={description}>
  <section class="hero-j">
    <span class="eyebrow">Shaxsiy hikoya</span>
    <h1>Mening yo'lim</h1>
    <p class="lead">
      Quyidagi — reklama emas, balki o'z yo'lim haqidagi halol hikoya. Men kimman
      va nega shu kurslarni yaratayapman, shuni tushuntiradi.
    </p>
  </section>

  <div class="journey">
    <article class="step">
      <div class="step-no">1</div>
      <div class="step-body">
        <h2>Otam bilan qurilishda</h2>
        <p>
          Otam bilan birga ishlagan yillarda devor bo'yash, sirtlarni silliqlash,
          beton quyish ishlarida bo'ldim. Bu ish shoshilmaydi — bir kunningiz
          behuda o'tsa, keyingi qatlamda xato ko'rinadi. Aynan shu yerda mehnat nima
          ekanini va natija uchun sabr kerakligini tushundim.
        </p>
        <p class="lesson">Saboq: Asos mustahkam bo'lmasa, ustiga hech narsa turmaydi — nafaqat devorda, hayotda ham.</p>
      </div>
    </article>

    <article class="step">
      <div class="step-no">2</div>
      <div class="step-body">
        <h2>Sydney maktabida o'qituvchilik</h2>
        <p>
          Bir muddat Sydney maktabida ingliz tili darslarini olib bordim — ba'zida
          bir sinfda 40 tagacha o'quvchi bo'lardi. Har birining savoli, surati
          boshqacha edi. O'rgatish uchun avval o'zingiz tushunishingiz, keyin
          boshqaga tushuntirishingiz kerak. Bu mas'uliyat edi.
        </p>
        <p class="lesson">Saboq: Bilim — u holda foydaliki, agar uni boshqa ham ochishi mumkin bo'lsa.</p>
      </div>
    </article>

    <article class="step">
      <div class="step-no">3</div>
      <div class="step-body">
        <h2>Chet elda — logistika va o'z ta'limim uchun mehnat</h2>
        <p>
          Keyinroq chet elda og'ir jismoniy ishda, logistika sohasida ishladim.
          Kunlik mehnat charchatdi, lekin maqsad aniq edi: o'z ta'limimni o'zim
          moliyalashtirish. Hech kimga qarzdor bo'lmasdan o'rganish imkoniyatini
          o'z qo'lim bilan yaratdim.
        </p>
        <p class="lesson">Saboq: Qiyin yo'l o'z puling bilan o'qishga o'tganda, har bir dars qimmatroq bo'ladi.</p>
      </div>
    </article>

    <article class="step">
      <div class="step-no">4</div>
      <div class="step-body">
        <h2>IELTS — 7.0, pullik kurssiz</h2>
        <p>
          Ingliz tilidan IELTS imtihoniga pullik kurslarga bormasdan, o'zim
          tayyorlandim va 7.0 ball oldim. Bu ajoyib qobiliyat emas — reja,
          izchillik va kunma-kun qilish natijasi. O'zim o'rgangan narsalar
          keyinchalik boshqalarga ham yordam berdi.
        </p>
        <p class="lesson">Saboq: To'g'ri usul va izchillik bo'lsa, qimmat kurs — zarurat emas.</p>
      </div>
    </article>

    <article class="step">
      <div class="step-no">5</div>
      <div class="step-body">
        <h2>Hozirgi maqsad — Muhandislik va Akademiya</h2>
        <p>
          Hozirgi maqsadim aniq: Civil Engineering (Fuqarolik muhandisligi) bo'yicha
          chet elda o'qish va keyinroq o'zim ko'rgan yo'l asosida — Muhandislik
          Akademiyasini qurish. Shu sababli bu saytdagi kurslar ham shunday
          tuzilgan: nazariya emas, amaliy yo'l.
        </p>
        <p class="lesson">Saboq: O'z yo'lingizni o'zingiz yurib o'tganingiz uchunggina, boshqalarga yo'l ko'rsata olasiz.</p>
      </div>
    </article>
  </div>

  <p class="closing">Hikoya davom etmoqda — bu sahifa vaqti bilan to'ldirib boriladi.</p>
</Base>

<style>
  .hero-j { text-align: center; padding: 56px 20px 18px; }
  .hero-j .eyebrow {
    display: inline-block; font-size: 13px; font-weight: 600; color: var(--accent);
    background: var(--accent-soft); padding: 5px 12px; border-radius: 99px; margin-bottom: 1rem;
  }
  .hero-j h1 {
    font-family: var(--font-display); letter-spacing: -.02em;
    font-size: 2.6rem; margin: 0 0 .8rem; color: var(--text);
  }
  .hero-j .lead { color: var(--muted); max-width: 680px; margin: 0 auto; font-size: 1.05rem; }

  .journey { position: relative; max-width: 820px; margin: 2.8rem auto 0; padding: 0 20px; }
  .journey::before {
    content: ""; position: absolute; left: 41px; top: 10px; bottom: 40px;
    width: 2px; background: var(--border);
  }
  .step {
    display: grid; grid-template-columns: 44px 1fr; gap: 20px;
    position: relative; padding-bottom: 2.4rem;
  }
  .step-no {
    width: 44px; height: 44px; border-radius: 50%; z-index: 1;
    background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff;
    display: grid; place-items: center; font-weight: 800; font-size: 1.1rem;
    box-shadow: 0 6px 16px -6px var(--accent);
  }
  .step-body {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 16px; padding: 20px 22px; box-shadow: var(--shadow);
  }
  .step-body h2 { margin: 0 0 .5rem; font-size: 1.2rem; color: var(--text); }
  .step-body p { color: var(--muted); font-size: .97rem; margin: 0; }
  .lesson {
    margin-top: .9rem; padding: .7rem .9rem; border-left: 3px solid var(--accent);
    background: var(--accent-soft); border-radius: 0 10px 10px 0;
    color: var(--text); font-weight: 600; font-size: .95rem;
  }
  .closing {
    max-width: 820px; margin: .5rem auto 0; padding: 0 20px 3rem;
    text-align: center; color: var(--muted); font-style: italic;
  }
  @media (max-width: 540px) {
    .hero-j h1 { font-size: 2rem; }
    .step { grid-template-columns: 38px 1fr; gap: 14px; }
    .step-no { width: 38px; height: 38px; font-size: 1rem; }
    .journey::before { left: 38px; }
  }
</style>

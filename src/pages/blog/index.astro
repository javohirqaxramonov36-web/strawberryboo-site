---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogIndex from '../../components/blog/BlogIndex.astro';
const lang = 'uz' as const;
const posts = (await getCollection('blog', ({ data }) => data.locale === lang && !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const base = import.meta.env.BASE_URL;
const alternates = [{ lang: 'uz', href: base + 'blog/' }, { lang: 'ru', href: base + 'ru/blog/' }, { lang: 'en', href: base + 'en/blog/' }];
---
<Base title="Tayanch blogi — bilimlar va yo‘riqnomalar" description="AI, IELTS, chet elda o‘qish va raqamli ko‘nikmalar bo‘yicha Tayanchning amaliy materiallari." {lang} localeAlternates={alternates}><BlogIndex {lang} {posts} /></Base>

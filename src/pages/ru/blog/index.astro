---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import BlogIndex from '../../../components/blog/BlogIndex.astro';
const lang = 'ru' as const;
const posts = (await getCollection('blog', ({ data }) => data.locale === lang && !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const base = import.meta.env.BASE_URL;
const alternates = [{ lang: 'uz', href: base + 'blog/' }, { lang: 'ru', href: base + 'ru/blog/' }, { lang: 'en', href: base + 'en/blog/' }];
---
<Base title="Блог Tayanch — знания и руководства" description="Практические материалы Tayanch об AI, IELTS, учёбе за рубежом и цифровых навыках." {lang} localeAlternates={alternates}><BlogIndex {lang} {posts} /></Base>

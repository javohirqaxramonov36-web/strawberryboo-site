---
import Base from '../../../layouts/Base.astro';
import { GRADER_WORKER_URL } from '../../../config/grader';
const title = 'IELTS Writing — ИИ-оценка | Tayanch';
const description = 'Оцените своё сочинение по критериям IELTS (0–9) с помощью Google Gemini: Task Achievement, Coherence, Lexical и Grammar.';
const base = import.meta.env.BASE_URL;
// Worker manzili: src/config/grader.ts
---
<Base title={title} description={description}>
  <section class="grader">
    <p class="eyebrow">IELTS WRITING · ИИ-ОЦЕНКА</p>
    <h1>Оцените сочинение за 30 секунд</h1>
    <p class="lead">Оценка на базе Google Gemini по официальным критериям IELTS (Task Achievement, Coherence &amp; Cohesion, Lexical Resource, Grammatical Range &amp; Accuracy) — от 0 до 9. Это не официальный экзамен, только практика.</p>

    <form id="graderForm" class="grader-form" novalidate>
      <div class="field">
        <label for="task">Какая часть?</label>
        <select id="task" name="task">
          <option value="1">Writing Task 1 (по графику/письму)</option>
          <option value="2">Writing Task 2 (эссе/мнение)</option>
        </select>
      </div>
      <div class="field">
        <label for="topic">Тема/задание <span class="opt">(необязательно)</span></label>
        <input id="topic" name="topic" type="text" placeholder="Например: The chart shows the population of cities A and B from 2000 to 2020." />
      </div>
      <div class="field">
        <label for="essay">Ваше сочинение <span class="req">*</span></label>
        <textarea id="essay" name="essay" rows="12" placeholder="Напишите сочинение здесь… (минимум несколько предложений)"></textarea>
        <small id="count" class="count">0 символов</small>
      </div>
      <button type="submit" id="submitBtn" class="grade-btn">Оценить →</button>
      <p id="error" class="error" role="alert" hidden></p>
    </form>

    <div id="result" class="result" hidden>
      <h2>Результат</h2>
      <div class="overall"><span id="overall">—</span><small>общий балл</small></div>
      <ul class="scores">
        <li><span>Task Achievement</span><i id="s-ta"></i><div class="bar"><b id="b-ta"></b></div></li>
        <li><span>Coherence &amp; Cohesion</span><i id="s-cc"></i><div class="bar"><b id="b-cc"></b></div></li>
        <li><span>Lexical Resource</span><i id="s-lr"></i><div class="bar"><b id="b-lr"></b></div></li>
        <li><span>Grammatical Range</span><i id="s-gr"></i><div class="bar"><b id="b-gr"></b></div></li>
      </ul>
      <div class="feedback"><h3>Краткое резюме</h3><p id="feedback"></p></div>
      <section class="detail-block" aria-labelledby="criteria-title">
        <h3 id="criteria-title">Обратная связь по каждому критерию</h3>
        <div class="criteria-grid">
          <article><h4>Task Achievement</h4><p id="cf-ta"></p></article>
          <article><h4>Coherence &amp; Cohesion</h4><p id="cf-cc"></p></article>
          <article><h4>Lexical Resource</h4><p id="cf-lr"></p></article>
          <article><h4>Grammatical Range</h4><p id="cf-gr"></p></article>
        </div>
      </section>
      <section id="mistakesSection" class="detail-block" hidden>
        <h3>Ошибки и улучшения</h3>
        <div id="mistakes" class="mistakes"></div>
      </section>
      <section id="stepsSection" class="detail-block" hidden>
        <h3>3 шага к следующему баллу</h3>
        <ol id="improvementSteps" class="steps"></ol>
      </section>
      <details id="improvedSection" class="detail-block improved" hidden>
        <summary>Посмотреть улучшенный образец ответа</summary>
        <p class="improved-note">Это не гарантия официального балла — пример того, как можно усилить эту мысль.</p>
        <pre id="improvedEssay"></pre>
      </details>
      <p class="saved-note">Результат сохранён в вашем профиле в этом браузере (<a href={base + 'ru/profile/'}>профиль</a>).</p>
    </div>

    <p class="notice">Оценка ИИ — приблизительная. Для официального балла IELTS используется проверка экзаменатором. Личные данные на сервер не отправляются.</p>
  </section>

  <style>
    .grader{max-width:760px;margin:auto;padding:3.2rem min(7vw,40px) 4rem}
    .eyebrow{font-size:.76rem;font-weight:800;letter-spacing:.12em;color:var(--accent);margin:0 0 .7rem}
    .grader h1{font:800 clamp(1.9rem,4vw,2.9rem)/1.05 var(--font-display);letter-spacing:-.04em;margin:0}
    .lead{color:var(--muted);line-height:1.7;margin:1rem 0 1.8rem}
    .grader-form{display:grid;gap:1.1rem}
    .field{display:grid;gap:.4rem}
    .field label{font-weight:700;font-size:.92rem}
    .opt{color:var(--muted);font-weight:500}
    .req{color:#ef4444}
    .field select,.field input,.field textarea{border:1px solid var(--border);border-radius:12px;background:var(--bg);color:var(--text);padding:.8rem .9rem;font:inherit}
    .field textarea{resize:vertical}
    .count{color:var(--muted);font-size:.8rem}
    .grade-btn{border:0;font:700 1rem var(--font-display);border-radius:12px;padding:13px 18px;color:#fff;background:linear-gradient(135deg,var(--btn-bg),#6f62e8);cursor:pointer;justify-self:start;transition:transform .16s,opacity .16s}
    .grade-btn:hover{transform:translateY(-2px)}
    .grade-btn:disabled{opacity:.6;cursor:progress;transform:none}
    .error{color:#fca5a5;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.4);border-radius:12px;padding:.8rem .9rem;margin:0}
    .result{margin-top:2rem;border:1px solid var(--border);border-radius:18px;padding:1.5rem;background:var(--surface)}
    .result h2{margin:.1rem 0 1rem}
    .overall{display:flex;align-items:baseline;gap:.6rem;margin-bottom:1.2rem}
    .overall span{font:800 3rem var(--font-display);color:var(--accent)}
    .overall small{color:var(--muted)}
    .scores{list-style:none;margin:0;padding:0;display:grid;gap:.9rem}
    .scores li{display:grid;grid-template-columns:1fr auto;gap:.3rem .8rem;align-items:center}
    .scores li span{font-weight:600;font-size:.92rem}
    .scores li i{font-style:normal;font-weight:800;color:var(--accent)}
    .bar{grid-column:1/-1;height:9px;border-radius:999px;background:var(--border);overflow:hidden}
    .bar b{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--btn-bg),#6f62e8);transition:width .5s}
    .feedback{margin-top:1.3rem;border-top:1px solid var(--border);padding-top:1rem}
    .feedback h3,.detail-block h3{margin:0 0 .4rem;font-size:.95rem}
    .feedback p,.detail-block p{color:var(--muted);line-height:1.65;margin:0}
    .detail-block{margin-top:1.3rem;border-top:1px solid var(--border);padding-top:1rem}
    .criteria-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-top:.75rem}
    .criteria-grid article{border:1px solid var(--border);border-radius:12px;padding:.85rem;background:color-mix(in srgb,var(--bg) 60%,transparent)}
    .criteria-grid h4{font-size:.86rem;margin:0 0 .35rem}
    .criteria-grid p{font-size:.9rem}
    .mistakes{display:grid;gap:.75rem;margin-top:.75rem}
    .mistake{border:1px solid var(--border);border-radius:12px;padding:.9rem;background:color-mix(in srgb,var(--bg) 60%,transparent)}
    .mistake h4{font-size:.82rem;color:var(--accent);margin:0 0 .55rem}
    .mistake code{display:block;white-space:pre-wrap;word-break:break-word;padding:.45rem .55rem;border-radius:8px;background:rgba(239,68,68,.1);color:var(--text);font:inherit}
    .mistake code + code{margin-top:.45rem;background:rgba(34,197,94,.1)}
    .mistake p{font-size:.9rem;margin-top:.55rem}
    .steps{display:grid;gap:.5rem;padding-left:1.25rem;margin:.75rem 0 0;color:var(--muted);line-height:1.55}
    .improved summary{font-weight:700;cursor:pointer;color:var(--accent)}
    .improved-note{margin-top:.75rem!important;font-size:.88rem}
    .improved pre{white-space:pre-wrap;word-break:break-word;font:inherit;line-height:1.65;margin:.9rem 0 0;padding:1rem;border-radius:12px;background:var(--bg);border:1px solid var(--border)}
    @media(max-width:560px){.criteria-grid{grid-template-columns:1fr}}
    .saved-note{font-size:.82rem;color:var(--muted);margin:1rem 0 0}
    .saved-note a{color:var(--accent)}
    .notice{font-size:.82rem;color:var(--muted);margin-top:1.6rem;border-top:1px dashed var(--border);padding-top:1rem}
  </style>

  <script is:inline define:vars={{ workerUrl: GRADER_WORKER_URL, baseUrl: base }}>
    const form = document.getElementById('graderForm');
    const essayEl = document.getElementById('essay');
    const countEl = document.getElementById('count');
    const btn = document.getElementById('submitBtn');
    const errorEl = document.getElementById('error');
    const resultEl = document.getElementById('result');

    essayEl.addEventListener('input', () => { countEl.textContent = essayEl.value.length + ' символов'; });

    const setBar = (idBar, idVal, value) => {
      document.getElementById(idVal).textContent = Number(value).toFixed(1);
      document.getElementById(idBar).style.width = (Number(value) / 9 * 100) + '%';
    };

    const setText = (id, value) => { document.getElementById(id).textContent = value || '—'; };
    const renderDetailedFeedback = (data) => {
      const criteria = data.criteriaFeedback || {};
      setText('cf-ta', criteria.taskAchievement);
      setText('cf-cc', criteria.coherenceCohesion);
      setText('cf-lr', criteria.lexicalResource);
      setText('cf-gr', criteria.grammaticalRange);

      const mistakes = Array.isArray(data.mistakes) ? data.mistakes : [];
      const mistakesSection = document.getElementById('mistakesSection');
      const mistakesEl = document.getElementById('mistakes');
      mistakesEl.replaceChildren();
      mistakesSection.hidden = !mistakes.length;
      mistakes.forEach((mistake) => {
        const card = document.createElement('article');
        card.className = 'mistake';
        const title = document.createElement('h4');
        title.textContent = mistake.category || 'Точка улучшения';
        const original = document.createElement('code');
        original.textContent = 'Исходный: ' + (mistake.original || '—');
        const corrected = document.createElement('code');
        corrected.textContent = 'Лучше: ' + (mistake.corrected || '—');
        const explanation = document.createElement('p');
        explanation.textContent = mistake.explanation || '';
        card.append(title, original, corrected, explanation);
        mistakesEl.append(card);
      });

      const steps = Array.isArray(data.improvementSteps) ? data.improvementSteps : [];
      const stepsSection = document.getElementById('stepsSection');
      const stepsEl = document.getElementById('improvementSteps');
      stepsEl.replaceChildren();
      stepsSection.hidden = !steps.length;
      steps.forEach((step) => { const item = document.createElement('li'); item.textContent = step; stepsEl.append(item); });

      const improved = data.improvedEssay || '';
      const improvedSection = document.getElementById('improvedSection');
      improvedSection.hidden = !improved;
      document.getElementById('improvedEssay').textContent = improved;
    };

    const saveToProfile = (task, band) => {
      try {
        const key = 'tayanch.mock.results.v1';
        const list = JSON.parse(localStorage.getItem(key) || '[]');
        if (!Array.isArray(list)) return;
        list.push({ module: 'writing', band: Number(band), completedAt: new Date().toISOString(), mockCode: 'Writing · Task ' + task });
        localStorage.setItem(key, JSON.stringify(list.slice(-100)));
        window.dispatchEvent(new StorageEvent('storage', { key }));
      } catch (e) {}
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      resultEl.hidden = true;
      const essay = essayEl.value.trim();
      if (essay.length < 20) {
        errorEl.textContent = 'Пожалуйста, напишите хотя бы несколько предложений.';
        errorEl.hidden = false;
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Оцениваем…';
      try {
        const res = await fetch(workerUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ essay, topic: document.getElementById('topic').value.trim(), task: Number(document.getElementById('task').value) }),
        });
        let data = {};
        try { data = await res.json(); } catch {}
        if (!res.ok) {
          errorEl.textContent = data.error || 'Произошла ошибка. Попробуйте позже.';
          errorEl.hidden = false;
          return;
        }
        setBar('b-ta', 's-ta', data.taskAchievement);
        setBar('b-cc', 's-cc', data.coherenceCohesion);
        setBar('b-lr', 's-lr', data.lexicalResource);
        setBar('b-gr', 's-gr', data.grammaticalRange);
        document.getElementById('overall').textContent = Number(data.overall).toFixed(1);
        document.getElementById('feedback').textContent = data.feedback || '';
        renderDetailedFeedback(data);
        resultEl.hidden = false;
        saveToProfile(document.getElementById('task').value, data.overall);
      } catch (err) {
        errorEl.textContent = 'Не удалось подключиться к серверу. Проверьте интернет или попробуйте позже.';
        errorEl.hidden = false;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Оценить →';
      }
    });
  </script>
</Base>

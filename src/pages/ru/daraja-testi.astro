---
import Base from '../../layouts/Base.astro';
import PlacementTest from '../../components/PlacementTest.astro';
const base = import.meta.env.BASE_URL;
const alternates = [
  { lang: 'uz', href: base + 'daraja-testi/' },
  { lang: 'ru', href: base + 'ru/daraja-testi/' },
  { lang: 'en', href: base + 'en/daraja-testi/' },
];
---
<Base title="Тест уровня английского | Tayanch" description="Определите свой уровень CEFR для General English." lang="ru" localeAlternates={alternates}>
  <PlacementTest lang="ru" />
</Base>

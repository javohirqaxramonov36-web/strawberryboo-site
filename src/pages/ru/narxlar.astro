---
import Base from '../../layouts/Base.astro';
import LocalizedInfoPage from '../../components/LocalizedInfoPage.astro';
const base = import.meta.env.BASE_URL;
const alternates = [
  { lang: 'uz', href: base + 'narxlar/' },
  { lang: 'ru', href: base + 'ru/narxlar/' },
  { lang: 'en', href: base + 'en/narxlar/' },
];
---
<Base title="Цены — Tayanch" description="Стоимость курсов Tayanch: один курс, пакет AI Stack и полный доступ." lang="ru" localeAlternates={alternates} showDiscountBanner={true}>
  <LocalizedInfoPage lang="ru" page="pricing" />
</Base>

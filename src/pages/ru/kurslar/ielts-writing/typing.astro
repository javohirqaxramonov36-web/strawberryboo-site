---
import Base from '../../../../layouts/Base.astro';
import Quiz from '../../../../components/Quiz.astro';
import TypingPractice from '../../../../components/TypingPractice.astro';
import CourseProgress from '../../../../components/CourseProgress.astro';
const lang = 'ru' as const;
const isRu = lang === 'ru';
const lessons = isRu ? [
 { number:'01', title:'Положение пальцев', description:'Найдите домашний ряд и тренируйтесь печатать коротко и точно, не глядя на клавиатуру.', hint:'Сначала точность, затем скорость.', quiz:[{q:'Куда при touch typing в основном нужно смотреть?',opts:['На клавиатуру','На текст на экране','Только на пальцы'],answer:1}] },
 { number:'02', title:'Ритм с IELTS-словами', description:'Печатайте частые слова Academic Writing в ровном ритме и уменьшайте ошибки.', hint:'Чётко нажимайте пробел между каждым словом.', quiz:[{q:'Что следует контролировать прежде скорости?',opts:['Точность','Только WPM','Цвет клавиатуры'],answer:0}] },
 { number:'03', title:'Фрагмент эссе на время', description:'Практикуйтесь с коротким академическим фрагментом в экзаменационном ритме.', hint:'Сначала закончите без ошибок, затем ускоряйтесь.', quiz:[{q:'Какой следующий шаг полезнее всего после timed writing?',opts:['Найти ошибки и перепечатать','Закрыть без результата','Запомнить только WPM'],answer:0}] }
] : [
 { number:'01', title:'Finger placement', description:'Find the home row and practise short, accurate typing without watching the keyboard.', hint:'Accuracy first, then speed.', quiz:[{q:'Where should your eyes mostly be during touch typing?',opts:['On the keyboard','On the text on screen','Only on your fingers'],answer:1}] },
 { number:'02', title:'Rhythm with IELTS vocabulary', description:'Type common Academic Writing words at a steady rhythm and reduce errors.', hint:'Press each space clearly.', quiz:[{q:'What should you control before increasing speed?',opts:['Accuracy','Only WPM','Keyboard colour'],answer:0}] },
 { number:'03', title:'Timed essay excerpt', description:'Practise a short academic excerpt in an exam-like rhythm.', hint:'Finish accurately first, then try to speed up.', quiz:[{q:'What is the most useful next step after timed writing?',opts:['Identify errors and type it again','Close without checking','Remember only WPM'],answer:0}] }
];
const targets=['practice makes progress when every key is pressed calmly','analyse compare demonstrate significant evidence conclusion','The chart illustrates a gradual increase in the number of students who chose online courses.'];
const base=import.meta.env.BASE_URL;
const alternates=[{lang:'uz',href:base+'kurslar/ielts-writing/typing/'},{lang:'ru',href:base+'ru/kurslar/ielts-writing/typing/'},{lang:'en',href:base+'en/kurslar/ielts-writing/typing/'}];
---
<Base title={(isRu ? 'IELTS Writing: печать' : 'IELTS Writing typing') + ' | Tayanch'} description={isRu ? 'Упражнения для быстрой и точной печати в IELTS Writing с quiz, WPM и точностью.' : 'Fast and accurate typing practice for IELTS Writing with quizzes, WPM and accuracy.'} lang={lang} localeAlternates={alternates}>
<CourseProgress courseId="ielts-writing-typing" title={isRu ? 'Прогресс IELTS Writing Typing' : 'IELTS Writing Typing progress'} selector=".typing-course" itemSelector=".lesson" labelSelector="h2" />
<article class="typing-course"><header class="course-hero"><p class="eyebrow">IELTS WRITING · BONUS MINI-COURSE</p><h1>{isRu ? 'Печать: быстро и точно' : 'Typing: fast and accurate'}</h1><p class="lead">{isRu ? 'В computer-delivered экзамене важно свободно печатать свои идеи. В каждом уроке есть короткий quiz и упражнение с WPM и точностью.' : 'In a computer-delivered exam, you need to type your ideas fluently. Each lesson includes a short quiz and a practice widget that measures WPM and accuracy.'}</p></header><section class="how"><h2>{isRu ? 'Как пользоваться' : 'How to use it'}</h2><ol><li>{isRu ? 'Пройдите короткий quiz.' : 'Complete the short quiz.'}</li><li>{isRu ? 'Напечатайте текст в поле точно как показано.' : 'Type the text exactly as shown.'}</li><li>{isRu ? 'Исправьте красные символы и повышайте WPM в следующей попытке.' : 'Correct red characters and improve WPM on the next attempt.'}</li></ol></section>{lessons.map((lesson,i)=><section class="lesson"><p class="lesson-no">{lesson.number} — {isRu?'УРОК':'LESSON'}</p><h2>{lesson.title}</h2><p>{lesson.description}</p><Quiz title={isRu?'Быстрый quiz':'Quick quiz'} questions={lesson.quiz}/><TypingPractice lessonId={lesson.number} target={targets[i]} hint={lesson.hint}/></section>)}<aside class="keyboard-callout"><h2>{isRu?'Совет перед экзаменом':'Before-exam tip'}</h2><p>{isRu?'За несколько недель до экзамена попробуйте и обычную desktop-клавиатуру: расстояние между клавишами и глубина нажатия могут отличаться от ноутбука.' : 'A few weeks before the exam, also try a standard desktop keyboard: its spacing and key travel may differ from your laptop.'}</p></aside><div class="actions"><a class="start-btn" href={base+'ielts-practice/writing/'}>{isRu?'Открыть Writing practice →':'Open Writing practice →'}</a><a href={base+(isRu?'ru/':'en/')+'kurslar/ielts-writing/'}>← IELTS Writing</a></div></article>
</Base>
<style>.typing-course{max-width:930px;margin:auto}.eyebrow,.lesson-no{color:#fbbf24;font-size:.78rem;font-weight:800;letter-spacing:.1em}.lead,.lesson p,.how li{color:var(--muted);line-height:1.65}.how,.lesson,.keyboard-callout{margin:1.35rem 0;padding:clamp(1rem,3vw,1.45rem);border:1px solid var(--border);border-radius:16px;background:var(--surface)}.keyboard-callout{border-color:rgba(251,191,36,.55)}.actions{display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0}</style>

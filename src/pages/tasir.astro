---
import Base from '../layouts/Base.astro';
import ImpactSurvey from '../components/ImpactSurvey.astro';
import ImpactDashboard from '../components/ImpactDashboard.astro';
---
<Base title="Tayanch ta’siri | Ta’limdan real natijagacha" description="Tayanch kurslari bitiruvchilarining ish, freelance va portfolio natijalarini rozilik asosida o‘lchash sahifasi.">
<article class="impact-page"><header class="impact-hero"><p class="eyebrow">TAYANCH TA’SIRI</p><h1>Ta’limni natija bilan tekshiramiz.</h1><p class="lead">Bu sahifada faqat tekshirilgan va shaxssizlashtirilgan natijalar ko‘rsatiladi. Hozirgi raqamlar boshlang‘ich holat: so‘rovlar yig‘ilgach, faqat rozilik berilgan umumiy natijalar yangilanadi.</p></header>
<ImpactDashboard />
<section class="method"><h2>Natijani qanday tekshiramiz?</h2><ol><li>Kurs tugaganidan keyin qisqa so‘rovnoma yuboramiz.</li><li>Foydalanuvchi aniq ish, freelance, portfolio yoki vazifa natijasini ixtiyoriy ravishda yozadi.</li><li>Ommaviy statistikaga faqat shaxssiz va rozilik berilgan ma’lumot qo‘shiladi.</li><li>Testimonial yoki ism alohida roziliksiz e’lon qilinmaydi.</li></ol></section><ImpactSurvey /><p class="back"><a href={import.meta.env.BASE_URL + 'masofaviy-ish/'}>Masofaviy ish qo‘llanmasi →</a> · <a href={import.meta.env.BASE_URL + 'viloyatlar/'}>Viloyatlar dasturi →</a></p></article><style>.impact-page{max-width:960px;margin:auto}.impact-hero{padding:2rem 0}.impact-hero h1{font-size:clamp(2.1rem,5vw,4rem)}.lead{max-width:780px;color:var(--muted);line-height:1.7}.method{margin-top:1rem;padding:1.2rem;border:1px solid var(--border);border-radius:15px;background:var(--surface)}.method li{margin:.55rem 0;color:var(--muted);line-height:1.5}.back{margin:1rem 0 3rem}.back a{color:var(--accent);font-weight:700}</style>
</Base>
